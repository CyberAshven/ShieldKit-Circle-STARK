  "source": "pragma cashscript ^0.13.0;\n\ncontract Grind(bytes32 transcript) {\n    function check(bytes nonce) {\n        bytes32 h = sha256(transcript + nonce);\n        require(h.split(2)[0] == 0x0000);\n    }\n}\n",
