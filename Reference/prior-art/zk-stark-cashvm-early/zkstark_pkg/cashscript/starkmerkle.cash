pragma cashscript ^0.13.0;

// Verifier matching stark.py's hiding-Merkle scheme exactly:
// leaf commitment = sha256(salt(16) || value(8)) ; leafLen passed as arg.
contract StarkMerkle(bytes32 root) {
    function proveAll(bytes leaves, bytes paths, int nQueries, int depth, int leafLen) {
        bytes remLeaves = leaves;
        bytes remPaths = paths;
        for (int q = 0; q < nQueries; q = q + 1) {
            bytes leaf, bytes rl = remLeaves.split(leafLen);
            remLeaves = rl;
            bytes32 cur = sha256(leaf);
            for (int i = 0; i < depth; i = i + 1) {
                bytes dirByte, bytes r1 = remPaths.split(1);
                bytes sib, bytes r2 = r1.split(32);
                remPaths = r2;
                if (int(dirByte) == 0) { cur = sha256(cur + sib); }
                else { cur = sha256(sib + cur); }
            }
            require(cur == root);
        }
    }
}
