    },
    "execution": {
      "type": "object"
    },
    "inputs": {
      "type": "object"
    },
    "materializedSubsetOnly": {
      "const": true
    },
    "oracleOutcomeDigest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "packageId": {
      "const": "evidence:poolactionfv1-refreeze-falsifiers-v1"
    },
    "rejectedAsExpected": {
      "minimum": 1,
      "type": "integer"
    },
    "relationRefreezeAllowed": {
