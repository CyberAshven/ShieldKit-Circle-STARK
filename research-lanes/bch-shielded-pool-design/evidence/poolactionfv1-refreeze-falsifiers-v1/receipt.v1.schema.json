    },
    "staticAgreementScope": {
      "type": "string"
    },
    "status": {
      "const": "BLOCKED_VERSION_PIVOT_NO_REFREEZE"
    },
    "unexpected": {
      "maxItems": 0,
      "type": "array"
    },
    "unresolvedBlockerCount": {
      "const": 4
    },
    "validatedAsExpected": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "agreementPercent",
    "authority",
    "caseCount",
    "closureClaimed",
    "evidenceTier",
    "execution",
    "inputs",
    "materializedSubsetOnly",
    "oracleOutcomeDigest",
    "packageId",
    "rejectedAsExpected",
    "relationRefreezeAllowed",
    "schema",
    "staticAgreementScope",
    "status",
    "unexpected",
    "unresolvedBlockerCount",
    "validatedAsExpected"
