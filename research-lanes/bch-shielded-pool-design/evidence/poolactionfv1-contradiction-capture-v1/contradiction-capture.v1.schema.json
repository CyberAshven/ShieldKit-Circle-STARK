{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/research-lanes/bch-shielded-pool-design/evidence/poolactionfv1-contradiction-capture-v1/contradiction-capture.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "captureId", "status", "authority", "promotionRule", "sourceManifestEntryCount", "stalePlanningCorrection", "items"],
  "properties": {
    "schema": {"const": "shieldkit-labs/evidence/poolactionfv1-contradiction-capture/v1"},
    "captureId": {"const": "evidence:poolactionfv1-contradiction-capture-v1"},
    "status": {"const": "observed-open-blockers-not-a-relation-amendment"},
    "authority": {"const": "none"},
    "promotionRule": {"const": "cannot-qualify-select-or-begin-full-prover"},
    "sourceManifestEntryCount": {"const": 11},
    "stalePlanningCorrection": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"$ref": "#/$defs/network"},
        {"$ref": "#/$defs/contextDigest"},
        {"$ref": "#/$defs/carrierLock"},
        {"$ref": "#/$defs/proofSession"}
      ],
      "items": false
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claimType", "classification", "severity", "status", "gateImpacts", "immediatePhaseImpacts", "observation", "sourceRefs", "nonClaim", "requiredDisposition"],
      "properties": {
        "id": {"type": "string"},
        "claimType": {"enum": ["contradiction", "interface-erasure"]},
        "classification": {"enum": ["source-only", "executable-model", "confounded", "interface-only"]},
        "severity": {"const": "qualification-blocker"},
        "status": {"const": "observed-open-blockers-not-a-relation-amendment"},
        "gateImpacts": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "enum": [1, 4, 5]}},
        "immediatePhaseImpacts": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"const": 1}},
        "observation": {"type": "string", "minLength": 1},
        "sourceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "nonClaim": {"type": "string", "minLength": 1},
        "requiredDisposition": {"type": "string", "minLength": 1}
      }
    },
    "network": {"allOf": [{"$ref": "#/$defs/item"}, {"properties": {"id": {"const": "P0-NETWORK-SCHEMA-CODEC-DRIFT"}, "claimType": {"const": "contradiction"}, "classification": {"const": "source-only"}, "gateImpacts": {"const": [1, 4]}}}]},
    "contextDigest": {"allOf": [{"$ref": "#/$defs/item"}, {"properties": {"id": {"const": "P1-CONTEXT-DIGEST-FACT-INJECTION"}, "claimType": {"const": "contradiction"}, "classification": {"const": "executable-model"}, "gateImpacts": {"const": [1, 5]}}}]},
    "carrierLock": {"allOf": [{"$ref": "#/$defs/item"}, {"properties": {"id": {"const": "P1-CARRIER-LOCK-ANCHOR-ERASURE"}, "claimType": {"const": "interface-erasure"}, "classification": {"const": "confounded"}, "gateImpacts": {"const": [1, 5]}}}]},
    "proofSession": {"allOf": [{"$ref": "#/$defs/item"}, {"properties": {"id": {"const": "P1-PROOF-SESSION-CONTEXT-ERASURE"}, "claimType": {"const": "interface-erasure"}, "classification": {"const": "interface-only"}, "gateImpacts": {"const": [1, 5]}}}]}
  }
}
