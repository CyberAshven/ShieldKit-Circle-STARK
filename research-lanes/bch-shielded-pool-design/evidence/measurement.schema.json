{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/research-lanes/bch-shielded-pool-design/evidence/measurement.schema.json",
  "title": "Circle-FRI BCH measurement evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "measurementId",
    "status",
    "scope",
    "candidateId",
    "sourceCommits",
    "toolchain",
    "provenance",
    "artifactDigests",
    "command",
    "result"
  ],
  "properties": {
    "schema": { "const": "shieldkit-labs/evidence/measurement/v1" },
    "measurementId": { "$ref": "#/$defs/id" },
    "status": { "$ref": "#/$defs/status" },
    "scope": { "enum": ["primitive", "compound-query", "complete-deposit", "complete-withdrawal"] },
    "candidateId": { "$ref": "#/$defs/id" },
    "sourceCommits": { "$ref": "#/$defs/sourceCommits" },
    "toolchain": { "$ref": "#/$defs/toolchain" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "command": { "type": "string", "minLength": 1 },
    "artifactDigests": { "$ref": "#/$defs/artifactDigests" },
    "primitive": { "$ref": "#/$defs/primitiveResult" },
    "corpusSuite": { "$ref": "#/$defs/corpusSuiteResult" },
    "txHex": { "anyOf": [{ "$ref": "#/$defs/hex" }, { "type": "null" }] },
    "sourceOutputsHex": { "anyOf": [{ "$ref": "#/$defs/hex" }, { "type": "null" }] },
    "perInput": { "anyOf": [{ "type": "array", "items": { "$ref": "#/$defs/perInput" }, "uniqueItems": true }, { "type": "null" }] },
    "wholeTransaction": { "anyOf": [{ "$ref": "#/$defs/wholeTransaction" }, { "type": "null" }] },
    "desktop": { "anyOf": [{ "$ref": "#/$defs/desktop" }, { "type": "null" }] },
    "result": { "$ref": "#/$defs/result" },
    "notes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  },
  "allOf": [
    {
      "if": {
        "required": ["scope", "status"],
        "properties": {
          "scope": { "enum": ["complete-deposit", "complete-withdrawal"] },
          "status": { "enum": ["measured", "complete"] }
        }
      },
      "then": {
        "required": ["txHex", "sourceOutputsHex", "perInput", "wholeTransaction", "desktop"],
        "properties": {
          "txHex": { "type": "string", "pattern": "^(?:[0-9a-f]{2})+$" },
          "sourceOutputsHex": { "type": "string", "pattern": "^(?:[0-9a-f]{2})+$" },
          "perInput": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/measuredPerInput" }, "uniqueItems": true },
          "wholeTransaction": { "$ref": "#/$defs/measuredWholeTransaction" },
          "desktop": { "$ref": "#/$defs/measuredDesktop" },
          "provenance": {
            "type": "object",
            "required": ["hostProfileRef"],
            "properties": {
              "sourceKind": { "const": "measured" },
              "hostProfileRef": { "$ref": "#/$defs/ref" }
            }
          },
          "artifactDigests": {
            "type": "object",
            "required": ["tx", "sourceOutputs", "proof", "desktop"],
            "properties": {
              "tx": { "$ref": "#/$defs/sha256" },
              "sourceOutputs": { "$ref": "#/$defs/sha256" },
              "proof": { "$ref": "#/$defs/sha256" },
              "desktop": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["scope", "status"],
        "properties": {
          "scope": { "enum": ["primitive", "compound-query"] },
          "status": { "enum": ["measured", "complete"] }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": ["primitive"],
            "properties": { "primitive": { "$ref": "#/$defs/measuredPrimitiveResult" } }
          },
          {
            "required": ["corpusSuite"],
            "properties": { "corpusSuite": { "$ref": "#/$defs/corpusSuiteResult" } }
          }
        ],
        "properties": {
          "primitive": { "$ref": "#/$defs/measuredPrimitiveResult" },
          "corpusSuite": { "$ref": "#/$defs/corpusSuiteResult" },
          "provenance": {
            "type": "object",
            "required": ["hostProfileRef"],
            "properties": {
              "sourceKind": { "const": "measured" },
              "hostProfileRef": { "$ref": "#/$defs/ref" }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["status"],
        "properties": {
          "status": { "enum": ["measured", "complete"] }
        }
      },
      "then": {
        "properties": {
          "result": {
            "type": "object",
            "properties": {
              "verdict": { "enum": ["pass", "fail", "partial", "killed"] },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["scope", "status"],
        "properties": {
          "scope": { "enum": ["complete-deposit", "complete-withdrawal"] },
          "status": { "const": "complete" }
        }
      },
      "then": {
        "properties": {
          "wholeTransaction": { "$ref": "#/$defs/passingWholeTransaction" },
          "desktop": { "$ref": "#/$defs/passingDesktop" },
          "result": {
            "type": "object",
            "properties": {
              "verdict": { "const": "pass" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*){1,6}$" },
    "ref": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*){1,8}$" },
    "hex": { "type": "string", "pattern": "^(?:[0-9a-f]{2})*$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "status": { "enum": ["planned", "measured", "partial", "unmeasured", "blocked", "killed", "failed", "complete"] },
    "sourceCommits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "commit", "dirty", "paths"],
        "properties": {
          "repository": { "type": "string", "minLength": 1 },
          "commit": { "$ref": "#/$defs/commit" },
          "dirty": { "type": "boolean" },
          "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "compiler", "lockfileDigest"],
      "properties": {
        "runtime": { "type": "string", "minLength": 1 },
        "compiler": { "type": "string", "minLength": 1 },
        "lockfileDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceKind", "sourcePath", "sourceDigest", "generatedAt"],
      "properties": {
        "sourceKind": { "enum": ["measured", "compiled", "derived", "fixture", "unmeasured"] },
        "sourcePath": { "type": "string", "minLength": 1 },
        "sourceDigest": { "$ref": "#/$defs/sha256" },
        "generatedAt": { "type": "string", "minLength": 1 },
        "hostProfileRef": { "$ref": "#/$defs/ref" }
      }
    },
    "artifactDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "source"],
      "properties": {
        "command": { "$ref": "#/$defs/sha256" },
        "source": { "$ref": "#/$defs/sha256" },
        "tx": { "$ref": "#/$defs/sha256" },
        "sourceOutputs": { "$ref": "#/$defs/sha256" },
        "proof": { "$ref": "#/$defs/sha256" },
        "desktop": { "$ref": "#/$defs/sha256" },
        "report": { "$ref": "#/$defs/sha256" },
        "summary": { "$ref": "#/$defs/sha256" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluatedInstructionCount", "signatureCheckCount", "hashDigestIterations", "arithmeticCost", "stackPushedBytes", "operationCost", "stackMaximums", "limits"],
      "properties": {
        "evaluatedInstructionCount": { "type": ["integer", "null"], "minimum": 0 },
        "signatureCheckCount": { "type": ["integer", "null"], "minimum": 0 },
        "hashDigestIterations": { "type": ["integer", "null"], "minimum": 0 },
        "arithmeticCost": { "type": ["integer", "null"], "minimum": 0 },
        "stackPushedBytes": { "type": ["integer", "null"], "minimum": 0 },
        "operationCost": { "type": ["integer", "null"], "minimum": 0 },
        "stackMaximums": { "$ref": "#/$defs/stackMaximums" },
        "limits": { "$ref": "#/$defs/resourceLimits" }
      }
    },
    "measuredMetrics": {
      "allOf": [
        { "$ref": "#/$defs/metrics" },
        {
          "type": "object",
          "properties": {
            "evaluatedInstructionCount": { "type": "integer", "minimum": 0 },
            "signatureCheckCount": { "type": "integer", "minimum": 0 },
            "hashDigestIterations": { "type": "integer", "minimum": 0 },
            "arithmeticCost": { "type": "integer", "minimum": 0 },
            "stackPushedBytes": { "type": "integer", "minimum": 0 },
            "operationCost": { "type": "integer", "minimum": 0 },
            "stackMaximums": { "$ref": "#/$defs/measuredStackMaximums" },
            "limits": { "$ref": "#/$defs/measuredResourceLimits" }
          }
        }
      ]
    },
    "stackMaximums": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryItems", "alternateItems", "definedFunctions", "controlDepth", "functionCallDepth", "cumulativeMemoryItems", "elementBytes"],
      "properties": {
        "primaryItems": { "type": ["integer", "null"], "minimum": 0 },
        "alternateItems": { "type": ["integer", "null"], "minimum": 0 },
        "definedFunctions": { "type": ["integer", "null"], "minimum": 0 },
        "controlDepth": { "type": ["integer", "null"], "minimum": 0 },
        "functionCallDepth": { "type": ["integer", "null"], "minimum": 0 },
        "cumulativeMemoryItems": { "type": ["integer", "null"], "minimum": 0 },
        "elementBytes": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "measuredStackMaximums": {
      "allOf": [
        { "$ref": "#/$defs/stackMaximums" },
        {
          "type": "object",
          "properties": {
            "primaryItems": { "type": "integer", "minimum": 0 },
            "alternateItems": { "type": "integer", "minimum": 0 },
            "definedFunctions": { "type": "integer", "minimum": 0 },
            "controlDepth": { "type": "integer", "minimum": 0 },
            "functionCallDepth": { "type": "integer", "minimum": 0 },
            "cumulativeMemoryItems": { "type": "integer", "minimum": 0 },
            "elementBytes": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "resourceLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumOperationCost", "operationCostHeadroom", "maximumHashDigestIterations", "hashDigestIterationsHeadroom", "maximumSignatureCheckCount", "signatureCheckCountHeadroom", "maximumStackItems", "stackItemsHeadroom", "maximumElementBytes", "elementBytesHeadroom", "maximumLockingBytes", "lockingBytesHeadroom", "maximumUnlockingBytes", "unlockingBytesHeadroom"],
      "properties": {
        "maximumOperationCost": { "type": ["integer", "null"], "minimum": 0 },
        "operationCostHeadroom": { "type": ["integer", "null"] },
        "maximumHashDigestIterations": { "type": ["integer", "null"], "minimum": 0 },
        "hashDigestIterationsHeadroom": { "type": ["integer", "null"] },
        "maximumSignatureCheckCount": { "type": ["integer", "null"], "minimum": 0 },
        "signatureCheckCountHeadroom": { "type": ["integer", "null"] },
        "maximumStackItems": { "type": ["integer", "null"], "minimum": 0 },
        "stackItemsHeadroom": { "type": ["integer", "null"] },
        "maximumElementBytes": { "type": ["integer", "null"], "minimum": 0 },
        "elementBytesHeadroom": { "type": ["integer", "null"] },
        "maximumLockingBytes": { "type": ["integer", "null"], "minimum": 0 },
        "lockingBytesHeadroom": { "type": ["integer", "null"] },
        "maximumUnlockingBytes": { "type": ["integer", "null"], "minimum": 0 },
        "unlockingBytesHeadroom": { "type": ["integer", "null"] }
      }
    },
    "measuredResourceLimits": {
      "allOf": [
        { "$ref": "#/$defs/resourceLimits" },
        {
          "type": "object",
          "properties": {
            "maximumOperationCost": { "type": "integer", "minimum": 0 },
            "operationCostHeadroom": { "type": "integer" },
            "maximumHashDigestIterations": { "type": "integer", "minimum": 0 },
            "hashDigestIterationsHeadroom": { "type": "integer" },
            "maximumSignatureCheckCount": { "type": "integer", "minimum": 0 },
            "signatureCheckCountHeadroom": { "type": "integer" },
            "maximumStackItems": { "type": "integer", "minimum": 0 },
            "stackItemsHeadroom": { "type": "integer" },
            "maximumElementBytes": { "type": "integer", "minimum": 0 },
            "elementBytesHeadroom": { "type": "integer" },
            "maximumLockingBytes": { "type": "integer", "minimum": 0 },
            "lockingBytesHeadroom": { "type": "integer" },
            "maximumUnlockingBytes": { "type": "integer", "minimum": 0 },
            "unlockingBytesHeadroom": { "type": "integer" }
          }
        }
      ]
    },
    "primitiveResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primitiveId", "inputHex", "outputHex", "lockingHex", "unlockingHex", "lockingBytes", "unlockingBytes", "metrics", "engineResults"],
      "properties": {
        "primitiveId": { "$ref": "#/$defs/id" },
        "inputHex": { "type": "array", "items": { "$ref": "#/$defs/hex" } },
        "outputHex": { "$ref": "#/$defs/hex" },
        "lockingHex": { "$ref": "#/$defs/hex" },
        "unlockingHex": { "$ref": "#/$defs/hex" },
        "lockingBytes": { "type": "integer", "minimum": 0 },
        "unlockingBytes": { "type": "integer", "minimum": 0 },
        "metrics": { "$ref": "#/$defs/metrics" },
        "engineResults": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/engineResult" }, "uniqueItems": true }
      }
    },
    "measuredPrimitiveResult": {
      "allOf": [
        { "$ref": "#/$defs/primitiveResult" },
        {
          "type": "object",
          "properties": {
            "metrics": { "$ref": "#/$defs/measuredMetrics" },
            "engineResults": {
              "type": "array",
              "contains": {
                "type": "object",
                "properties": {
                  "status": { "const": "measured" }
                }
              }
            }
          }
        }
      ]
    },
    "corpusSuiteResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suiteId",
        "relation",
        "corpusDigest",
        "seedHex",
        "totalCases",
        "acceptedCases",
        "rejectedCases",
        "firstAttempt",
        "standardMode",
        "operationCounts",
        "fullReport",
        "engines"
      ],
      "properties": {
        "suiteId": { "$ref": "#/$defs/id" },
        "relation": { "type": "string", "minLength": 1 },
        "corpusDigest": { "$ref": "#/$defs/sha256" },
        "seedHex": { "type": "string", "pattern": "^[0-9a-f]+$" },
        "totalCases": { "type": "integer", "minimum": 1 },
        "acceptedCases": { "type": "integer", "minimum": 0 },
        "rejectedCases": { "type": "integer", "minimum": 0 },
        "firstAttempt": { "type": "boolean" },
        "standardMode": { "const": true },
        "operationCounts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operation", "cases", "expectedAccept", "expectedReject"],
            "properties": {
              "operation": { "enum": ["add", "sub", "neg", "mul", "square", "inverseHint"] },
              "cases": { "type": "integer", "minimum": 1 },
              "expectedAccept": { "type": "integer", "minimum": 0 },
              "expectedReject": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "fullReport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bytes", "sha256", "summarySha256"],
          "properties": {
            "bytes": { "type": "integer", "minimum": 1 },
            "sha256": { "$ref": "#/$defs/sha256" },
            "summarySha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "engines": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "engineId",
              "role",
              "version",
              "status",
              "expectedCases",
              "verdictMatches",
              "metricsMeasuredCases",
              "metricUnsupportedCases",
              "artifactDigest"
            ],
            "properties": {
              "engineId": { "enum": ["libauth", "bchn", "leanbch"] },
              "role": { "enum": ["standard-vm-and-metrics", "standard-script-verdict", "formal-cost", "formal-verdict"] },
              "version": { "type": "string", "minLength": 1 },
              "status": { "enum": ["measured", "measured-partial-metrics"] },
              "expectedCases": { "type": "integer", "minimum": 1 },
              "verdictMatches": { "const": true },
              "metricsMeasuredCases": { "type": "integer", "minimum": 0 },
              "metricUnsupportedCases": { "type": "integer", "minimum": 0 },
              "artifactDigest": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "engineResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineId", "version", "status", "accepted", "metrics", "artifactDigest"],
      "properties": {
        "engineId": { "enum": ["libauth", "bchn", "leanbch", "bchd", "other"] },
        "version": { "type": "string", "minLength": 1 },
        "status": { "enum": ["measured", "measured-partial-metrics", "unmeasured", "blocked", "failed", "killed"] },
        "accepted": { "type": ["boolean", "null"] },
        "metrics": { "$ref": "#/$defs/metrics" },
        "artifactDigest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "errorClass": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": {
              "status": { "const": "measured" }
            }
          },
          "then": {
            "properties": {
              "accepted": { "type": "boolean" },
              "metrics": { "$ref": "#/$defs/measuredMetrics" },
              "artifactDigest": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        {
          "if": {
            "required": ["status"],
            "properties": {
              "status": { "const": "measured-partial-metrics" }
            }
          },
          "then": {
            "properties": {
              "accepted": { "type": "boolean" },
              "artifactDigest": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      ]
    },
    "perInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "lockingBytes", "unlockingBytes", "operationCostBudget", "metrics", "engines"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "lockingBytes": { "type": "integer", "minimum": 0 },
        "unlockingBytes": { "type": "integer", "minimum": 0 },
        "operationCostBudget": { "type": ["integer", "null"], "minimum": 0 },
        "metrics": { "$ref": "#/$defs/metrics" },
        "engines": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/engineResult" }, "uniqueItems": true }
      }
    },
    "measuredPerInput": {
      "allOf": [
        { "$ref": "#/$defs/perInput" },
        {
          "type": "object",
          "properties": {
            "operationCostBudget": { "type": "integer", "minimum": 0 },
            "metrics": { "$ref": "#/$defs/measuredMetrics" },
            "engines": {
              "type": "array",
              "contains": {
                "type": "object",
                "properties": {
                  "status": { "const": "measured" }
                }
              }
            }
          }
        }
      ]
    },
    "wholeTransaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completeTxBytes",
        "scriptSigBytes",
        "scriptPubKeyBytes",
        "cashTokenPrefixBytes",
        "outpointAndSequenceBytes",
        "varintBytes",
        "proofCarrierBytes",
        "stateCommitmentBytes",
        "feeInputBytes",
        "payoutOutputBytes",
        "transactionLimitBytes",
        "underLimit",
        "engines"
      ],
      "properties": {
        "completeTxBytes": { "type": "integer", "minimum": 1 },
        "scriptSigBytes": { "type": "integer", "minimum": 0 },
        "scriptPubKeyBytes": { "type": "integer", "minimum": 0 },
        "cashTokenPrefixBytes": { "type": "integer", "minimum": 0 },
        "outpointAndSequenceBytes": { "type": "integer", "minimum": 0 },
        "varintBytes": { "type": "integer", "minimum": 0 },
        "proofCarrierBytes": { "type": "integer", "minimum": 0 },
        "stateCommitmentBytes": { "type": "integer", "minimum": 0 },
        "feeInputBytes": { "type": "integer", "minimum": 0 },
        "payoutOutputBytes": { "type": "integer", "minimum": 0 },
        "transactionLimitBytes": { "const": 100000 },
        "underLimit": { "type": "boolean" },
        "engines": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/txEngine" }, "uniqueItems": true }
      }
    },
    "measuredWholeTransaction": {
      "allOf": [
        { "$ref": "#/$defs/wholeTransaction" },
        {
          "type": "object",
          "properties": {
            "engines": {
              "type": "array",
              "contains": {
                "type": "object",
                "properties": {
                  "status": { "const": "measured" }
                }
              }
            }
          }
        }
      ]
    },
    "passingWholeTransaction": {
      "allOf": [
        { "$ref": "#/$defs/measuredWholeTransaction" },
        {
          "type": "object",
          "properties": {
            "completeTxBytes": { "type": "integer", "minimum": 1, "maximum": 100000 },
            "underLimit": { "const": true },
            "engines": {
              "type": "array",
              "allOf": [
                {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "engineId": { "const": "libauth" },
                      "status": { "const": "measured" },
                      "accepted": { "const": true },
                      "standard": { "const": true }
                    }
                  }
                },
                {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "engineId": { "const": "bchn" },
                      "status": { "const": "measured" },
                      "accepted": { "const": true },
                      "standard": { "const": true }
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "txEngine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineId", "version", "status", "accepted", "standard", "artifactDigest"],
      "properties": {
        "engineId": { "enum": ["libauth", "bchn", "leanbch", "bchd", "other"] },
        "version": { "type": "string", "minLength": 1 },
        "status": { "enum": ["measured", "unmeasured", "blocked", "failed", "killed"] },
        "accepted": { "type": ["boolean", "null"] },
        "standard": { "type": ["boolean", "null"] },
        "artifactDigest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "errorClass": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": {
              "status": { "const": "measured" }
            }
          },
          "then": {
            "properties": {
              "accepted": { "type": "boolean" },
              "standard": { "type": "boolean" },
              "artifactDigest": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      ]
    },
    "desktop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileRef", "status", "coldRuns", "warmRuns", "summary"],
      "properties": {
        "profileRef": { "$ref": "#/$defs/ref" },
        "status": { "enum": ["measured", "unmeasured", "blocked", "failed", "killed"] },
        "coldRuns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/desktopRun" } },
        "warmRuns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/desktopRun" } },
        "summary": { "$ref": "#/$defs/desktopSummary" }
      }
    },
    "measuredDesktop": {
      "allOf": [
        { "$ref": "#/$defs/desktop" },
        {
          "type": "object",
          "properties": {
            "status": { "const": "measured" },
            "coldRuns": {
              "type": "array",
              "minItems": 20,
              "items": { "$ref": "#/$defs/measuredDesktopRun" }
            },
            "warmRuns": {
              "type": "array",
              "minItems": 30,
              "items": { "$ref": "#/$defs/measuredDesktopRun" }
            },
            "summary": { "$ref": "#/$defs/measuredDesktopSummary" }
          }
        }
      ]
    },
    "passingDesktop": {
      "allOf": [
        { "$ref": "#/$defs/measuredDesktop" },
        {
          "type": "object",
          "properties": {
            "summary": {
              "allOf": [
                { "$ref": "#/$defs/measuredDesktopSummary" },
                {
                  "type": "object",
                  "properties": {
                    "failureRate": { "const": 0 },
                    "under60Seconds": { "const": true }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "desktopRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "seed", "wallNs", "peakRssBytes", "threads", "exitCode", "timedOut", "artifactDigest"],
      "properties": {
        "runId": { "$ref": "#/$defs/id" },
        "seed": { "type": "string", "pattern": "^[0-9a-f]+$" },
        "wallNs": { "type": ["integer", "null"], "minimum": 0 },
        "peakRssBytes": { "type": ["integer", "null"], "minimum": 0 },
        "threads": { "type": ["integer", "null"], "minimum": 1 },
        "exitCode": { "type": ["integer", "null"] },
        "timedOut": { "type": "boolean" },
        "artifactDigest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "measuredDesktopRun": {
      "allOf": [
        { "$ref": "#/$defs/desktopRun" },
        {
          "type": "object",
          "properties": {
            "wallNs": { "type": "integer", "minimum": 0 },
            "peakRssBytes": { "type": "integer", "minimum": 0 },
            "threads": { "type": "integer", "minimum": 1 },
            "exitCode": { "type": "integer" },
            "artifactDigest": { "$ref": "#/$defs/sha256" }
          }
        }
      ]
    },
    "desktopSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coldMedianNs", "coldP95Ns", "warmMedianNs", "warmP95Ns", "peakRssBytes", "failureRate", "under60Seconds"],
      "properties": {
        "coldMedianNs": { "type": ["integer", "null"], "minimum": 0 },
        "coldP95Ns": { "type": ["integer", "null"], "minimum": 0 },
        "warmMedianNs": { "type": ["integer", "null"], "minimum": 0 },
        "warmP95Ns": { "type": ["integer", "null"], "minimum": 0 },
        "peakRssBytes": { "type": ["integer", "null"], "minimum": 0 },
        "failureRate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "under60Seconds": { "type": "boolean" }
      }
    },
    "measuredDesktopSummary": {
      "allOf": [
        { "$ref": "#/$defs/desktopSummary" },
        {
          "type": "object",
          "properties": {
            "coldMedianNs": { "type": "integer", "minimum": 0 },
            "coldP95Ns": { "type": "integer", "minimum": 0 },
            "warmMedianNs": { "type": "integer", "minimum": 0 },
            "warmP95Ns": { "type": "integer", "minimum": 0 },
            "peakRssBytes": { "type": "integer", "minimum": 0 },
            "failureRate": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "reason"],
      "properties": {
        "verdict": { "enum": ["pass", "fail", "partial", "unmeasured", "blocked", "killed"] },
        "reason": { "type": ["string", "null"] }
      }
    }
  }
}
