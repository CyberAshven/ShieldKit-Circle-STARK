{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/research-lanes/bch-shielded-pool-design/security/threat-model-fv1.schema.json",
  "title": "PoolActionFv1 threat model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "status",
    "profileRef",
    "assets",
    "adversaries",
    "securityGoals",
    "assumptions",
    "admittedLeakage",
    "outOfScope",
    "threats",
    "pqInventory",
    "promotionRule"
  ],
  "properties": {
    "schema": {
      "const": "shieldkit-labs/poolactionfv1-threat-model/v1"
    },
    "id": {
      "const": "PoolActionFv1ThreatModel"
    },
    "status": {
      "enum": [
        "frozen-unmitigated-gates-open",
        "under-review",
        "qualified"
      ]
    },
    "profileRef": {
      "const": "profile:fixed-ticket-serial-pool"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/namedStatement"
      }
    },
    "adversaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/namedStatement"
      }
    },
    "securityGoals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "class",
          "statement",
          "status"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "class": {
            "enum": [
              "safety",
              "soundness",
              "privacy",
              "authorization",
              "liveness",
              "recoverability",
              "assurance"
            ]
          },
          "statement": {
            "$ref": "#/$defs/nonempty"
          },
          "status": {
            "enum": [
              "required",
              "candidate-unqualified",
              "out-of-scope"
            ]
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonempty"
      }
    },
    "admittedLeakage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonempty"
      }
    },
    "outOfScope": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonempty"
      }
    },
    "threats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "class",
          "attackerIds",
          "assetIds",
          "scenario",
          "requiredControls",
          "mutationIds",
          "gate",
          "status"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "class": {
            "enum": [
              "forgery",
              "replay",
              "substitution",
              "conservation",
              "authorization",
              "privacy",
              "parser",
              "topology",
              "availability",
              "recovery",
              "pq-claim",
              "provenance"
            ]
          },
          "attackerIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "assetIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "scenario": {
            "$ref": "#/$defs/nonempty"
          },
          "requiredControls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/nonempty"
            }
          },
          "mutationIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/vectorRef"
            }
          },
          "gate": {
            "$ref": "#/$defs/nonempty"
          },
          "status": {
            "enum": [
              "control-specified-unmeasured",
              "mitigated-measured",
              "accepted-out-of-scope",
              "open-blocker"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/nonempty"
            },
            "uniqueItems": true
          }
        },
        "allOf": [
          {
            "if": {
              "required": ["status"],
              "properties": {
                "status": { "const": "mitigated-measured" }
              }
            },
            "then": {
              "required": ["evidenceRefs"],
              "properties": {
                "evidenceRefs": {
                  "type": "array",
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "pqInventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "component",
          "securityRole",
          "status",
          "target",
          "classicalDependencies",
          "claimPolicy"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "component": {
            "$ref": "#/$defs/nonempty"
          },
          "securityRole": {
            "$ref": "#/$defs/nonempty"
          },
          "status": {
            "enum": [
              "candidate-unselected",
              "classical-boundary",
              "hash-based-unqualified",
              "qualified"
            ]
          },
          "target": {
            "$ref": "#/$defs/nonempty"
          },
          "classicalDependencies": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/nonempty"
            }
          },
          "claimPolicy": {
            "$ref": "#/$defs/nonempty"
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/nonempty"
            },
            "uniqueItems": true
          }
        },
        "allOf": [
          {
            "if": {
              "required": ["status"],
              "properties": {
                "status": { "const": "qualified" }
              }
            },
            "then": {
              "required": ["evidenceRefs"],
              "properties": {
                "evidenceRefs": {
                  "type": "array",
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "promotionRule": {
      "$ref": "#/$defs/nonempty"
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["status"],
        "properties": {
          "status": { "const": "qualified" }
        }
      },
      "then": {
        "properties": {
          "threats": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "status": {
                  "enum": ["mitigated-measured", "accepted-out-of-scope"]
                }
              }
            }
          },
          "securityGoals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "status": {
                  "enum": ["required", "out-of-scope"]
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9-]{1,63}$"
    },
    "vectorRef": {
      "type": "string",
      "pattern": "^vector:[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"
    },
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "namedStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "statement": {
          "$ref": "#/$defs/nonempty"
        }
      }
    }
  }
}
