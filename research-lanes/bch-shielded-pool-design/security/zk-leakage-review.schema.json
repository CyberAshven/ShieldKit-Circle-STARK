{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/research-lanes/bch-shielded-pool-design/security/zk-leakage-review.schema.json",
  "title": "PoolActionFv1 zero-knowledge leakage review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "reviewId",
    "status",
    "candidateId",
    "relationRef",
    "profileRef",
    "sourceCommits",
    "toolchain",
    "artifactDigests",
    "assumptions",
    "maskedObjects",
    "repeatedProofReview",
    "tests",
    "conclusion"
  ],
  "properties": {
    "schema": { "const": "shieldkit-labs/security/zk-leakage-review/v1" },
    "reviewId": { "$ref": "#/$defs/id" },
    "status": { "$ref": "#/$defs/status" },
    "candidateId": { "$ref": "#/$defs/id" },
    "relationRef": { "$ref": "#/$defs/ref" },
    "profileRef": { "$ref": "#/$defs/ref" },
    "sourceCommits": { "$ref": "#/$defs/sourceCommits" },
    "toolchain": { "$ref": "#/$defs/toolchain" },
    "artifactDigests": { "$ref": "#/$defs/artifactDigests" },
    "assumptions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assumption" }, "uniqueItems": true },
    "maskedObjects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/maskedObject" }, "uniqueItems": true },
    "repeatedProofReview": { "$ref": "#/$defs/repeatedProofReview" },
    "tests": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/test" }, "uniqueItems": true },
    "conclusion": { "$ref": "#/$defs/conclusion" },
    "command": { "type": "string", "minLength": 1 },
    "notes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  },
  "allOf": [
    {
      "if": {
        "required": ["conclusion"],
        "properties": {
          "conclusion": {
            "type": "object",
            "required": ["qualification"],
            "properties": {
              "qualification": { "const": "pass" }
            }
          }
        }
      },
      "then": {
        "properties": {
          "status": { "const": "complete" },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "status": { "const": "supported" },
                "evidenceRefs": { "type": "array", "minItems": 1 }
              }
            }
          },
          "maskedObjects": {
            "type": "array",
            "items": { "$ref": "#/$defs/supportedMaskedObject" }
          },
          "repeatedProofReview": { "$ref": "#/$defs/supportedRepeatedProofReview" },
          "tests": {
            "type": "array",
            "items": { "$ref": "#/$defs/supportedTest" }
          },
          "conclusion": {
            "type": "object",
            "properties": {
              "zeroKnowledgeEstablished": { "const": true }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*){1,6}$" },
    "ref": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*){1,8}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "status": { "enum": ["planned", "measured", "partial", "unmeasured", "blocked", "killed", "failed", "complete"] },
    "reviewStatus": { "enum": ["supported", "refuted", "unmeasured", "blocked", "killed", "failed"] },
    "sourceCommits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "commit", "dirty", "paths"],
        "properties": {
          "repository": { "type": "string", "minLength": 1 },
          "commit": { "$ref": "#/$defs/commit" },
          "dirty": { "type": "boolean" },
          "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "compiler", "lockfileDigest"],
      "properties": {
        "runtime": { "type": "string", "minLength": 1 },
        "compiler": { "type": "string", "minLength": 1 },
        "lockfileDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifactDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "maskConstruction", "leakageCorpus"],
      "properties": {
        "relation": { "$ref": "#/$defs/sha256" },
        "maskConstruction": { "$ref": "#/$defs/sha256" },
        "leakageCorpus": { "$ref": "#/$defs/sha256" },
        "proof": { "$ref": "#/$defs/sha256" },
        "transaction": { "$ref": "#/$defs/sha256" }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assumptionId", "statement", "status", "evidenceRefs"],
      "properties": {
        "assumptionId": { "$ref": "#/$defs/id" },
        "statement": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/reviewStatus" },
        "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "uniqueItems": true }
      }
    },
    "maskedObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectId",
        "kind",
        "maskFamily",
        "status",
        "entropy",
        "constraintPreservation",
        "foldingPreservation",
        "leakageClaim",
        "evidenceRefs"
      ],
      "properties": {
        "objectId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["trace", "composition", "boundary", "quotient", "merkle-leaf", "transcript", "final-polynomial", "other"] },
        "maskFamily": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/reviewStatus" },
        "entropy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "bits", "independentPerProof", "status"],
          "properties": {
            "source": { "type": "string", "minLength": 1 },
            "bits": { "type": ["number", "null"], "minimum": 0 },
            "independentPerProof": { "type": ["boolean", "null"] },
            "status": { "$ref": "#/$defs/reviewStatus" }
          }
        },
        "constraintPreservation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "method", "evidenceRefs"],
          "properties": {
            "status": { "$ref": "#/$defs/reviewStatus" },
            "method": { "type": "string", "minLength": 1 },
            "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "uniqueItems": true }
          }
        },
        "foldingPreservation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "foldScheduleBound", "maskDegreeBound", "evidenceRefs"],
          "properties": {
            "status": { "$ref": "#/$defs/reviewStatus" },
            "foldScheduleBound": { "type": "string", "minLength": 1 },
            "maskDegreeBound": { "type": "string", "minLength": 1 },
            "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "uniqueItems": true }
          }
        },
        "leakageClaim": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claim", "status", "bound", "evidenceRefs"],
          "properties": {
            "claim": { "type": "string", "minLength": 1 },
            "status": { "$ref": "#/$defs/reviewStatus" },
            "bound": { "type": ["string", "null"] },
            "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "uniqueItems": true }
          }
        },
        "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "uniqueItems": true }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": {
              "status": { "const": "supported" }
            }
          },
          "then": {
            "properties": {
              "entropy": {
                "type": "object",
                "properties": {
                  "bits": { "type": "number", "exclusiveMinimum": 0 },
                  "independentPerProof": { "const": true },
                  "status": { "const": "supported" }
                }
              },
              "constraintPreservation": { "$ref": "#/$defs/supportedReviewClaim" },
              "foldingPreservation": {
                "type": "object",
                "properties": {
                  "status": { "const": "supported" },
                  "evidenceRefs": { "type": "array", "minItems": 1 }
                }
              },
              "leakageClaim": {
                "type": "object",
                "properties": {
                  "status": { "const": "supported" },
                  "bound": { "type": "string", "minLength": 1 },
                  "evidenceRefs": { "type": "array", "minItems": 1 }
                }
              },
              "evidenceRefs": { "type": "array", "minItems": 1 }
            }
          }
        }
      ]
    },
    "supportedReviewClaim": {
      "type": "object",
      "properties": {
        "status": { "const": "supported" },
        "evidenceRefs": { "type": "array", "minItems": 1 }
      }
    },
    "supportedMaskedObject": {
      "allOf": [
        { "$ref": "#/$defs/maskedObject" },
        {
          "type": "object",
          "properties": {
            "status": { "const": "supported" }
          }
        }
      ]
    },
    "repeatedProofReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "proofCount", "distinctWitnesses", "maskReuseAllowed", "reuseTests", "evidenceRefs"],
      "properties": {
        "status": { "$ref": "#/$defs/reviewStatus" },
        "proofCount": { "type": "integer", "minimum": 0 },
        "distinctWitnesses": { "type": "integer", "minimum": 0 },
        "maskReuseAllowed": { "type": ["boolean", "null"] },
        "reuseTests": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/test" }, "uniqueItems": true },
        "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "uniqueItems": true }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": {
              "status": { "const": "supported" }
            }
          },
          "then": {
            "properties": {
              "proofCount": { "type": "integer", "minimum": 2 },
              "distinctWitnesses": { "type": "integer", "minimum": 2 },
              "maskReuseAllowed": { "const": false },
              "reuseTests": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/supportedTest" }
              },
              "evidenceRefs": { "type": "array", "minItems": 1 }
            }
          }
        }
      ]
    },
    "supportedRepeatedProofReview": {
      "allOf": [
        { "$ref": "#/$defs/repeatedProofReview" },
        {
          "type": "object",
          "properties": {
            "status": { "const": "supported" }
          }
        }
      ]
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["testId", "family", "status", "expected", "observed", "artifactDigest"],
      "properties": {
        "testId": { "$ref": "#/$defs/id" },
        "family": { "enum": ["single-proof-hiding", "repeated-proof", "mask-reuse", "folding", "degree", "transcript", "merkle", "parser", "cross-candidate", "other"] },
        "status": { "$ref": "#/$defs/reviewStatus" },
        "expected": { "type": "string", "minLength": 1 },
        "observed": { "type": ["string", "null"] },
        "artifactDigest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": {
              "status": { "enum": ["supported", "refuted", "failed"] }
            }
          },
          "then": {
            "properties": {
              "observed": { "type": "string", "minLength": 1 },
              "artifactDigest": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      ]
    },
    "supportedTest": {
      "allOf": [
        { "$ref": "#/$defs/test" },
        {
          "type": "object",
          "properties": {
            "status": { "const": "supported" },
            "observed": { "type": "string", "minLength": 1 },
            "artifactDigest": { "$ref": "#/$defs/sha256" }
          }
        }
      ]
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qualification", "zeroKnowledgeRequired", "zeroKnowledgeEstablished", "selectionAllowed", "reason"],
      "properties": {
        "qualification": { "enum": ["not-qualified", "pass", "fail", "blocked", "unmeasured", "killed"] },
        "zeroKnowledgeRequired": { "const": true },
        "zeroKnowledgeEstablished": { "type": "boolean" },
        "selectionAllowed": { "const": false },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
