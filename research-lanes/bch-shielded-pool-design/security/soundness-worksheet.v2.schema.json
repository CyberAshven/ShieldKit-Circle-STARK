{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/research-lanes/bch-shielded-pool-design/security/soundness-worksheet.v2.schema.json",
  "title": "PoolActionFv1 Circle-FRI prequalification event-DAG worksheet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "qualificationBoundary",
    "worksheetId",
    "status",
    "candidateTupleRef",
    "candidateTupleDigest",
    "relationRef",
    "profileRef",
    "sourceCommits",
    "toolchain",
    "artifactDigests",
    "assumptions",
    "eventDag",
    "completeTransactions",
    "conclusion"
  ],
  "properties": {
    "schema": { "const": "shieldkit-labs/security/soundness-worksheet/v2" },
    "qualificationBoundary": { "const": "prequalification-only" },
    "worksheetId": { "$ref": "#/$defs/id" },
    "status": { "$ref": "#/$defs/worksheetStatus" },
    "candidateTupleRef": { "$ref": "#/$defs/id" },
    "candidateTupleDigest": { "$ref": "#/$defs/sha256" },
    "relationRef": { "const": "relation:pool-action-fv1" },
    "profileRef": { "const": "profile:fixed-ticket-serial-pool" },
    "sourceCommits": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceCommit" }
    },
    "toolchain": { "$ref": "#/$defs/toolchain" },
    "artifactDigests": { "$ref": "#/$defs/artifactDigests" },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/assumption" }
    },
    "eventDag": { "$ref": "#/$defs/eventDag" },
    "completeTransactions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deposit", "withdrawal"],
      "properties": {
        "deposit": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/completeTransaction" }
          ]
        },
        "withdrawal": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/completeTransaction" }
          ]
        }
      }
    },
    "conclusion": { "$ref": "#/$defs/conclusion" },
    "command": { "type": "string", "minLength": 1 },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*){1,8}$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "worksheetStatus": {
      "enum": ["unmeasured", "partial", "measured", "blocked", "failed", "complete"]
    },
    "boundStatus": {
      "enum": ["unmeasured", "derived", "measured", "blocked", "failed"]
    },
    "sourceCommit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "dirty", "paths"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "$ref": "#/$defs/commit" },
        "dirty": { "type": "boolean" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "checker", "lockfileDigest"],
      "properties": {
        "runtime": { "type": "string", "minLength": 1 },
        "checker": { "type": "string", "minLength": 1 },
        "lockfileDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifactDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "candidateTuple", "derivation"],
      "properties": {
        "relation": { "$ref": "#/$defs/sha256" },
        "candidateTuple": { "$ref": "#/$defs/sha256" },
        "derivation": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
        },
        "proof": { "$ref": "#/$defs/sha256" },
        "depositTransaction": { "$ref": "#/$defs/sha256" },
        "withdrawalTransaction": { "$ref": "#/$defs/sha256" }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assumptionId", "statement", "status", "evidenceRefs"],
      "properties": {
        "assumptionId": { "$ref": "#/$defs/id" },
        "statement": { "type": "string", "minLength": 1 },
        "status": { "enum": ["open", "supported", "refuted", "unmeasured", "blocked"] },
        "evidenceRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        }
      }
    },
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)$" },
        "denominator": { "type": "string", "pattern": "^[1-9][0-9]*$" }
      }
    },
    "bound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "form",
        "exactUpperBound",
        "expression",
        "multiplicity",
        "multiplicityIncludedInBound",
        "assumptionRefs",
        "evidenceRefs"
      ],
      "properties": {
        "status": { "$ref": "#/$defs/boundStatus" },
        "form": { "enum": ["exact-rational", "symbolic-upper-bound", "unavailable"] },
        "exactUpperBound": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/rational" }]
        },
        "expression": { "type": "string", "minLength": 1 },
        "multiplicity": { "const": 1 },
        "multiplicityIncludedInBound": { "const": true },
        "assumptionRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "evidenceRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": { "properties": { "form": { "const": "exact-rational" } }, "required": ["form"] },
          "then": { "properties": { "exactUpperBound": { "$ref": "#/$defs/rational" } } }
        },
        {
          "if": { "properties": { "form": { "const": "unavailable" } }, "required": ["form"] },
          "then": { "properties": { "exactUpperBound": { "type": "null" } } }
        },
        {
          "if": {
            "properties": { "status": { "enum": ["derived", "measured"] } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "form": { "enum": ["exact-rational", "symbolic-upper-bound"] },
              "evidenceRefs": { "type": "array", "minItems": 1 }
            }
          }
        }
      ]
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "eventKey", "opportunitySetId", "samplerRefs"],
      "properties": {
        "mode": { "enum": ["systemic-summand", "derivation-only"] },
        "eventKey": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }]
        },
        "opportunitySetId": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }]
        },
        "samplerRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "mode": { "const": "systemic-summand" } },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "eventKey": { "$ref": "#/$defs/id" },
              "opportunitySetId": { "$ref": "#/$defs/id" }
            }
          }
        },
        {
          "if": {
            "properties": { "mode": { "const": "derivation-only" } },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "eventKey": { "type": "null" },
              "opportunitySetId": { "type": "null" }
            }
          }
        }
      ]
    },
    "eventNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "kind", "accounting", "roleRefs", "dependsOn", "bound"],
      "properties": {
        "eventId": { "$ref": "#/$defs/id" },
        "kind": {
          "enum": [
            "air",
            "lookup",
            "fri",
            "deep",
            "challenge-sampler",
            "fiat-shamir",
            "hash-binding",
            "grinding",
            "parser-canonicality",
            "zero-knowledge"
          ]
        },
        "accounting": { "$ref": "#/$defs/accounting" },
        "roleRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["B", "D", "E", "F_batch", "F_fri", "F_deep", "Q_deep", "F_hash", "H_outer"]
          },
          "uniqueItems": true
        },
        "dependsOn": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "bound": { "$ref": "#/$defs/bound" }
      }
    },
    "systemicUnion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summandRefs",
        "method",
        "boundExpression",
        "exactUpperBound",
        "floorSecurityBits",
        "evidenceRefs"
      ],
      "properties": {
        "status": { "$ref": "#/$defs/boundStatus" },
        "summandRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "method": { "const": "union-bound" },
        "boundExpression": { "const": "min(1,sum(unique systemic summands))" },
        "exactUpperBound": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/rational" }]
        },
        "floorSecurityBits": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "evidenceRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "enum": ["derived", "measured"] } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "exactUpperBound": { "$ref": "#/$defs/rational" },
              "floorSecurityBits": { "type": "integer", "minimum": 0 },
              "evidenceRefs": { "type": "array", "minItems": 1 }
            }
          }
        }
      ]
    },
    "eventDag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "systemicUnion"],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/eventNode" }
        },
        "systemicUnion": { "$ref": "#/$defs/systemicUnion" }
      }
    },
    "completeTransaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurementRef",
        "transactionDigest",
        "transactionBytes",
        "standardnessEngineRef",
        "standardAccepted",
        "proofVerified",
        "evidenceRefs"
      ],
      "properties": {
        "measurementRef": { "$ref": "#/$defs/id" },
        "transactionDigest": { "$ref": "#/$defs/sha256" },
        "transactionBytes": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "standardnessEngineRef": { "$ref": "#/$defs/id" },
        "standardAccepted": { "const": true },
        "proofVerified": { "const": true },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        }
      }
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qualification", "targetBits", "minimumBits", "selectionAllowed", "fallbackAuthorized", "reason"],
      "properties": {
        "qualification": { "enum": ["unmeasured", "not-qualified", "blocked", "failed"] },
        "targetBits": { "const": 128 },
        "minimumBits": { "const": 100 },
        "selectionAllowed": { "const": false },
        "fallbackAuthorized": { "const": false },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
