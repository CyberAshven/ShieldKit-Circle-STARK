{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/research-lanes/bch-shielded-pool-design/security/soundness-worksheet.schema.json",
  "title": "PoolActionFv1 Circle-FRI soundness worksheet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "worksheetId",
    "status",
    "candidateId",
    "relationRef",
    "profileRef",
    "sourceCommits",
    "toolchain",
    "artifactDigests",
    "assumptions",
    "parameters",
    "terms",
    "unionBound",
    "systemic",
    "conclusion"
  ],
  "properties": {
    "schema": { "const": "shieldkit-labs/security/soundness-worksheet/v1" },
    "worksheetId": { "$ref": "#/$defs/id" },
    "status": { "$ref": "#/$defs/status" },
    "candidateId": { "$ref": "#/$defs/id" },
    "relationRef": { "$ref": "#/$defs/ref" },
    "profileRef": { "$ref": "#/$defs/ref" },
    "sourceCommits": { "$ref": "#/$defs/sourceCommits" },
    "toolchain": { "$ref": "#/$defs/toolchain" },
    "artifactDigests": { "$ref": "#/$defs/artifactDigests" },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/assumption" },
      "uniqueItems": true
    },
    "parameters": { "$ref": "#/$defs/parameters" },
    "terms": { "$ref": "#/$defs/terms" },
    "unionBound": { "$ref": "#/$defs/unionBound" },
    "systemic": { "$ref": "#/$defs/systemic" },
    "conclusion": { "$ref": "#/$defs/conclusion" },
    "command": { "type": "string", "minLength": 1 },
    "notes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  },
  "allOf": [
    {
      "if": {
        "required": ["conclusion"],
        "properties": {
          "conclusion": {
            "type": "object",
            "required": ["qualification"],
            "properties": {
              "qualification": { "const": "128-bit-pass" }
            }
          }
        }
      },
      "then": {
        "properties": {
          "status": { "const": "complete" },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "status": { "const": "supported" },
                "evidenceRefs": { "type": "array", "minItems": 1 }
              }
            }
          },
          "terms": {
            "type": "object",
            "properties": {
              "air": { "$ref": "#/$defs/qualifiedTerm" },
              "fri": { "$ref": "#/$defs/qualifiedTerm" },
              "fiatShamir": { "$ref": "#/$defs/qualifiedTerm" },
              "hash": { "$ref": "#/$defs/qualifiedTerm" },
              "challenge": { "$ref": "#/$defs/qualifiedTerm" },
              "field": { "$ref": "#/$defs/qualifiedTerm" }
            }
          },
          "unionBound": { "$ref": "#/$defs/qualifiedUnionBound" },
          "systemic": { "$ref": "#/$defs/qualifiedSystemic" },
          "conclusion": {
            "type": "object",
            "properties": {
              "completeTransactionMeasured": { "const": true }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*){1,6}$" },
    "ref": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*){1,8}$" },
    "hex": { "type": "string", "pattern": "^(?:[0-9a-f]{2})*$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "status": {
      "enum": ["planned", "measured", "partial", "unmeasured", "blocked", "killed", "failed", "complete"]
    },
    "termStatus": {
      "enum": ["measured", "derived", "unmeasured", "blocked", "killed", "failed"]
    },
    "sourceCommits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "commit", "dirty", "paths"],
        "properties": {
          "repository": { "type": "string", "minLength": 1 },
          "commit": { "$ref": "#/$defs/commit" },
          "dirty": { "type": "boolean" },
          "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "compiler", "lockfileDigest"],
      "properties": {
        "runtime": { "type": "string", "minLength": 1 },
        "compiler": { "type": "string", "minLength": 1 },
        "lockfileDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifactDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "parameters", "derivation"],
      "properties": {
        "relation": { "$ref": "#/$defs/sha256" },
        "parameters": { "$ref": "#/$defs/sha256" },
        "derivation": { "$ref": "#/$defs/sha256" },
        "proof": { "$ref": "#/$defs/sha256" },
        "transaction": { "$ref": "#/$defs/sha256" }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assumptionId", "statement", "status", "evidenceRefs"],
      "properties": {
        "assumptionId": { "$ref": "#/$defs/id" },
        "statement": { "type": "string", "minLength": 1 },
        "status": { "enum": ["open", "supported", "refuted", "unmeasured", "blocked"] },
        "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "uniqueItems": true }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseField", "extensionTower", "domainSize", "blowup", "foldArity", "queries", "grindBits", "finalDegree"],
      "properties": {
        "baseField": { "type": "string", "minLength": 1 },
        "extensionTower": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "domainSize": { "type": "integer", "minimum": 1 },
        "blowup": { "type": "integer", "minimum": 1 },
        "foldArity": { "type": "integer", "minimum": 2 },
        "queries": { "type": "integer", "minimum": 1 },
        "grindBits": { "type": "integer", "minimum": 0 },
        "finalDegree": { "type": "integer", "minimum": 0 },
        "rounds": { "type": "integer", "minimum": 0 }
      }
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "lowerBits", "boundExpression", "assumptionRefs", "evidenceRefs"],
      "properties": {
        "status": { "$ref": "#/$defs/termStatus" },
        "lowerBits": { "type": ["number", "null"], "minimum": 0 },
        "boundExpression": { "type": "string", "minLength": 1 },
        "assumptionRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "uniqueItems": true },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": {
              "status": { "enum": ["measured", "derived"] }
            }
          },
          "then": {
            "properties": {
              "lowerBits": { "type": "number", "minimum": 0 },
              "evidenceRefs": { "type": "array", "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "required": ["status"],
            "properties": {
              "status": { "enum": ["unmeasured", "blocked", "killed", "failed"] }
            }
          },
          "then": {
            "properties": {
              "lowerBits": { "type": "null" }
            }
          }
        }
      ]
    },
    "qualifiedTerm": {
      "allOf": [
        { "$ref": "#/$defs/term" },
        {
          "type": "object",
          "properties": {
            "status": { "enum": ["measured", "derived"] },
            "lowerBits": { "type": "number", "minimum": 0 },
            "evidenceRefs": { "type": "array", "minItems": 1 }
          }
        }
      ]
    },
    "terms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["air", "fri", "fiatShamir", "hash", "challenge", "field"],
      "properties": {
        "air": { "$ref": "#/$defs/term" },
        "fri": { "$ref": "#/$defs/term" },
        "fiatShamir": { "$ref": "#/$defs/term" },
        "hash": { "$ref": "#/$defs/term" },
        "challenge": { "$ref": "#/$defs/term" },
        "field": { "$ref": "#/$defs/term" }
      }
    },
    "unionBound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "opportunityClasses", "totalOpportunities", "penaltyBits", "boundExpression", "evidenceRefs"],
      "properties": {
        "status": { "$ref": "#/$defs/termStatus" },
        "opportunityClasses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["classId", "count", "termRefs"],
            "properties": {
              "classId": { "$ref": "#/$defs/id" },
              "count": { "type": "integer", "minimum": 1 },
              "termRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
            }
          },
          "uniqueItems": true
        },
        "totalOpportunities": { "type": "integer", "minimum": 1 },
        "penaltyBits": { "type": ["number", "null"], "minimum": 0 },
        "boundExpression": { "type": "string", "minLength": 1 },
        "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "uniqueItems": true }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": {
              "status": { "enum": ["measured", "derived"] }
            }
          },
          "then": {
            "properties": {
              "penaltyBits": { "type": "number", "minimum": 0 },
              "evidenceRefs": { "type": "array", "minItems": 1 }
            }
          }
        }
      ]
    },
    "qualifiedUnionBound": {
      "allOf": [
        { "$ref": "#/$defs/unionBound" },
        {
          "type": "object",
          "properties": {
            "status": { "enum": ["measured", "derived"] },
            "penaltyBits": { "type": "number", "minimum": 0 },
            "evidenceRefs": { "type": "array", "minItems": 1 }
          }
        }
      ]
    },
    "systemic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "lowerBits", "boundExpression", "requiredTargetBits", "minimumAllowedBits", "evidenceRefs"],
      "properties": {
        "status": { "$ref": "#/$defs/termStatus" },
        "lowerBits": { "type": ["number", "null"], "minimum": 0 },
        "boundExpression": { "type": "string", "minLength": 1 },
        "requiredTargetBits": { "const": 128 },
        "minimumAllowedBits": { "const": 100 },
        "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "uniqueItems": true }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": {
              "status": { "enum": ["measured", "derived"] }
            }
          },
          "then": {
            "properties": {
              "lowerBits": { "type": "number", "minimum": 0 },
              "evidenceRefs": { "type": "array", "minItems": 1 }
            }
          }
        }
      ]
    },
    "qualifiedSystemic": {
      "allOf": [
        { "$ref": "#/$defs/systemic" },
        {
          "type": "object",
          "properties": {
            "status": { "enum": ["measured", "derived"] },
            "lowerBits": { "type": "number", "minimum": 128 },
            "evidenceRefs": { "type": "array", "minItems": 1 }
          }
        }
      ]
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qualification", "targetBits", "minimumBits", "completeTransactionMeasured", "selectionAllowed", "reason"],
      "properties": {
        "qualification": { "enum": ["not-qualified", "128-bit-pass", "fail", "blocked", "unmeasured"] },
        "targetBits": { "const": 128 },
        "minimumBits": { "const": 100 },
        "completeTransactionMeasured": { "type": "boolean" },
        "selectionAllowed": { "const": false },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
