{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/poolaction-fv2/relation-input/v1",
  "title": "PoolActionFv2 closed relation input",
  "type": "object",
  "additionalProperties": false,
  "required": ["relationId", "relationVersion", "networkId", "proofSuiteManifestDigestHex", "authenticatedTxView", "provenanceDag", "proofSessionEnvelope"],
  "properties": {
    "relationId": {"const": "PoolActionFv2"},
    "relationVersion": {"const": 2},
    "networkId": {"enum": ["mainnet", "chipnet", "regtest"]},
    "proofSuiteManifestDigestHex": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authenticatedTxView": {"$ref": "https://shieldkit-labs.local/poolaction-fv2/authenticated-tx-view/v1"},
    "provenanceDag": {"$ref": "https://shieldkit-labs.local/poolaction-fv2/provenance-dag/v1"},
    "proofSessionEnvelope": {"$ref": "https://shieldkit-labs.local/poolaction-fv2/proof-session-envelope/v1"}
  }
}
