{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/poolaction-fv2/authenticated-tx-view/v1",
  "title": "PoolActionFv2 canonical authenticated transaction view",
  "type": "object",
  "additionalProperties": false,
  "required": ["viewVersion", "networkId", "transactionVersion", "locktime", "activeInputIndex", "envelopeBearingInputIndex", "normalizedEnvelopeSlot", "inputs", "outputs", "stateBundle", "carrierBundle", "action", "feePolicy", "currentBchIntrospection"],
  "properties": {
    "viewVersion": {"const": 1},
    "networkId": {"enum": ["mainnet", "chipnet", "regtest"]},
    "transactionVersion": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "locktime": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "activeInputIndex": {"type": "integer", "minimum": 0, "maximum": 65535},
    "envelopeBearingInputIndex": {"type": "integer", "minimum": 0, "maximum": 65535},
    "normalizedEnvelopeSlot": {"$ref": "#/$defs/normalizedEnvelopeSlot"},
    "inputs": {"type": "array", "minItems": 1, "maxItems": 65536, "items": {"$ref": "#/$defs/input"}},
    "outputs": {"type": "array", "minItems": 1, "maxItems": 65536, "items": {"$ref": "#/$defs/output"}},
    "stateBundle": {"$ref": "#/$defs/stateBundle"},
    "carrierBundle": {"$ref": "#/$defs/carrierBundle"},
    "action": {"$ref": "#/$defs/action"},
    "feePolicy": {"$ref": "#/$defs/feePolicy"},
    "currentBchIntrospection": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/introspection"}}
  },
  "$defs": {
    "bytes32": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bytes128": {"type": "string", "pattern": "^[0-9a-f]{256}$"},
    "hex": {"type": "string", "pattern": "^(?:[0-9a-f]{2})*$"},
    "nonEmptyHex": {"type": "string", "pattern": "^(?:[0-9a-f]{2})+$", "maxLength": 20000},
    "u64": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$"},
    "tokenNone": {"type": "object", "additionalProperties": false, "required": ["kind", "categoryHex", "capability", "commitmentHex", "amount"], "properties": {"kind": {"const": "NONE"}, "categoryHex": {"const": ""}, "capability": {"const": "none"}, "commitmentHex": {"const": ""}, "amount": {"const": "0"}}},
    "stateToken": {"type": "object", "additionalProperties": false, "required": ["kind", "categoryHex", "capability", "commitmentHex", "amount"], "properties": {"kind": {"const": "CASH_TOKEN"}, "categoryHex": {"$ref": "#/$defs/bytes32"}, "capability": {"const": "mutable"}, "commitmentHex": {"$ref": "#/$defs/bytes128"}, "amount": {"const": "0"}}},
    "token": {"oneOf": [{"$ref": "#/$defs/tokenNone"}, {"$ref": "#/$defs/stateToken"}]},
    "outpoint": {"type": "object", "additionalProperties": false, "required": ["txidWireHex", "index"], "properties": {"txidWireHex": {"$ref": "#/$defs/bytes32"}, "index": {"type": "integer", "minimum": 0, "maximum": 4294967295}}},
    "input": {"type": "object", "additionalProperties": false, "required": ["index", "role", "roleOrdinal", "outpoint", "sequence", "sourceValueSats", "sourceLockingBytecodeHex", "sourceToken"], "properties": {"index": {"type": "integer", "minimum": 0, "maximum": 65535}, "role": {"enum": ["STATE", "VERIFIER_CARRIER", "DEPOSIT_FUNDING", "FEE_FUNDING"]}, "roleOrdinal": {"type": "integer", "minimum": 0, "maximum": 65535}, "outpoint": {"$ref": "#/$defs/outpoint"}, "sequence": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "sourceValueSats": {"$ref": "#/$defs/u64"}, "sourceLockingBytecodeHex": {"$ref": "#/$defs/nonEmptyHex"}, "sourceToken": {"$ref": "#/$defs/token"}}},
    "output": {"type": "object", "additionalProperties": false, "required": ["index", "role", "roleOrdinal", "valueSats", "lockingBytecodeHex", "token"], "properties": {"index": {"type": "integer", "minimum": 0, "maximum": 65535}, "role": {"enum": ["STATE_SUCCESSOR", "VERIFIER_CARRIER_SUCCESSOR", "PAYOUT", "TRANSPARENT_CHANGE"]}, "roleOrdinal": {"type": "integer", "minimum": 0, "maximum": 65535}, "valueSats": {"$ref": "#/$defs/u64"}, "lockingBytecodeHex": {"$ref": "#/$defs/nonEmptyHex"}, "token": {"$ref": "#/$defs/token"}}},
    "normalizedEnvelopeSlot": {"type": "object", "additionalProperties": false, "required": ["inputIndex", "normalization", "normalizedUnlockingBytecodeHex"], "properties": {"inputIndex": {"type": "integer", "minimum": 0, "maximum": 65535}, "normalization": {"const": "RAW_ENVELOPE_REPLACED_BY_EMPTY"}, "normalizedUnlockingBytecodeHex": {"const": ""}}},
    "stateBundle": {"type": "object", "additionalProperties": false, "required": ["inputIndex", "outputIndex", "categoryHex", "sourceCommitmentHex", "successorCommitmentHex"], "properties": {"inputIndex": {"type": "integer", "minimum": 0, "maximum": 65535}, "outputIndex": {"type": "integer", "minimum": 0, "maximum": 65535}, "categoryHex": {"$ref": "#/$defs/bytes32"}, "sourceCommitmentHex": {"$ref": "#/$defs/bytes128"}, "successorCommitmentHex": {"$ref": "#/$defs/bytes128"}}},
    "carrierBundle": {"type": "object", "additionalProperties": false, "required": ["predecessorTxidWireHex", "inputIndices", "successorOutputIndices"], "properties": {"predecessorTxidWireHex": {"$ref": "#/$defs/bytes32"}, "inputIndices": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0, "maximum": 65535}}, "successorOutputIndices": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0, "maximum": 65535}}}},
    "action": {"type": "object", "additionalProperties": false, "required": ["kind", "ticketSats", "reserveDeltaSats", "withdrawalPayout"], "properties": {"kind": {"enum": ["DEPOSIT", "WITHDRAWAL"]}, "ticketSats": {"const": "10000000"}, "reserveDeltaSats": {"enum": ["10000000", "-10000000"]}, "withdrawalPayout": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["outputIndex", "valueSats", "lockingBytecodeHex", "token"], "properties": {"outputIndex": {"type": "integer", "minimum": 0, "maximum": 65535}, "valueSats": {"const": "10000000"}, "lockingBytecodeHex": {"$ref": "#/$defs/nonEmptyHex"}, "token": {"$ref": "#/$defs/tokenNone"}}}]}}},
    "feePolicy": {"type": "object", "additionalProperties": false, "required": ["externalInputIndex", "externalInputRole", "feeSats", "maxFeeSats", "transparentChangeOutputIndex", "poolSubsidySats", "externalTokens"], "properties": {"externalInputIndex": {"type": "integer", "minimum": 0, "maximum": 65535}, "externalInputRole": {"enum": ["DEPOSIT_FUNDING", "FEE_FUNDING"]}, "feeSats": {"$ref": "#/$defs/u64"}, "maxFeeSats": {"$ref": "#/$defs/u64"}, "transparentChangeOutputIndex": {"type": ["integer", "null"], "minimum": 0, "maximum": 65535}, "poolSubsidySats": {"const": "0"}, "externalTokens": {"const": "NONE"}}},
    "introspection": {"type": "object", "additionalProperties": false, "required": ["fieldPath", "mappingId", "status"], "properties": {"fieldPath": {"type": "string", "pattern": "^/[A-Za-z0-9_/-]+$"}, "mappingId": {"type": "string", "pattern": "^[A-Z0-9_:-]{3,128}$"}, "status": {"const": "REQUIRED_NOT_ASSERTED_BY_THIS_ARTIFACT"}}}
  }
}
