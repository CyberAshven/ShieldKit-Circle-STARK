{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/poolaction-fv2/verifier-role-consumption-matrix/v1",
  "title": "PoolActionFv2 verifier-role consumption matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["matrixVersion", "roles"],
  "properties": {
    "matrixVersion": {"const": 1},
    "roles": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/role"}}
  },
  "$defs": {
    "role": {"type": "object", "additionalProperties": false, "required": ["role", "consumesRaw", "recomputes", "comparisonOnly", "proofSuiteRequirement", "unselectedSuiteResult"], "properties": {"role": {"enum": ["STATE_COVENANT", "VERIFIER_CARRIER"]}, "consumesRaw": {"type": "array", "minItems": 1, "items": {"enum": ["networkId", "authenticatedTxView", "rawEnvelopeBytes", "provenanceDag", "proofSuiteManifestDigest"]}}, "recomputes": {"type": "array", "minItems": 1, "items": {"enum": ["canonicalAuthenticatedTxView", "provenanceRoot", "contextDigest", "envelopeRoot", "sectionSchedule", "sessionDigest"]}}, "comparisonOnly": {"type": "array", "items": {"enum": ["contextDigest", "envelopeRoot", "sectionSchedule", "sessionDigest"]}}, "proofSuiteRequirement": {"const": "SELECTED_MANIFEST_REQUIRED_FOR_PROOF_ACCEPTANCE"}, "unselectedSuiteResult": {"const": "REJECT_UNSELECTED_PROOF_SUITE"}}}
  }
}
