{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/poolaction-fv2/provenance-dag/v1",
  "title": "PoolActionFv2 lock and deployment provenance DAG",
  "type": "object",
  "additionalProperties": false,
  "required": ["dagVersion", "nodes", "edges", "provenanceRootHex", "concreteLocks", "genesisRecipe"],
  "properties": {
    "dagVersion": {"const": 1},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/edge"}},
    "provenanceRootHex": {"$ref": "#/$defs/bytes32"},
    "concreteLocks": {"type": "object", "additionalProperties": false, "required": ["state", "carriers"], "properties": {"state": {"$ref": "#/$defs/concreteLock"}, "carriers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/concreteLock"}}}},
    "genesisRecipe": {"type": "object", "additionalProperties": false, "required": ["recipeVersion", "networkId", "transactionTemplateHex", "stateOutputIndex", "carrierOutputIndices", "derivationNodeId"], "properties": {"recipeVersion": {"const": 1}, "networkId": {"enum": ["mainnet", "chipnet", "regtest"]}, "transactionTemplateHex": {"type": "string", "pattern": "^(?:[0-9a-f]{2})+$"}, "stateOutputIndex": {"const": 0}, "carrierOutputIndices": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1, "maximum": 65535}}, "derivationNodeId": {"$ref": "#/$defs/nodeId"}}}
  },
  "$defs": {
    "bytes32": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nodeId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "node": {"type": "object", "additionalProperties": false, "required": ["id", "type", "canonicalPayloadHex", "digestHex"], "properties": {"id": {"$ref": "#/$defs/nodeId"}, "type": {"enum": ["NORMALIZED_TEMPLATE", "TYPED_PARAMETERS", "PINNED_TOOLCHAIN", "PROTOCOL_TEMPLATE_DIGEST", "POOL_INSTANCE_INPUTS", "MANIFEST_INPUTS", "CONCRETE_STATE_LOCK", "CONCRETE_CARRIER_LOCK", "GENESIS_RECIPE"]}, "canonicalPayloadHex": {"type": "string", "pattern": "^(?:[0-9a-f]{2})*$"}, "digestHex": {"$ref": "#/$defs/bytes32"}}},
    "edge": {"type": "object", "additionalProperties": false, "required": ["from", "to", "kind"], "properties": {"from": {"$ref": "#/$defs/nodeId"}, "to": {"$ref": "#/$defs/nodeId"}, "kind": {"enum": ["DERIVES", "CONSUMES"]}}},
    "concreteLock": {"type": "object", "additionalProperties": false, "required": ["nodeId", "lockingBytecodeHex", "byteOrigins"], "properties": {"nodeId": {"$ref": "#/$defs/nodeId"}, "lockingBytecodeHex": {"type": "string", "pattern": "^(?:[0-9a-f]{2})+$", "maxLength": 20000}, "byteOrigins": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["byteOffset", "originNodeId", "originByteOffset"], "properties": {"byteOffset": {"type": "integer", "minimum": 0, "maximum": 9999}, "originNodeId": {"$ref": "#/$defs/nodeId"}, "originByteOffset": {"type": "integer", "minimum": 0, "maximum": 9999999}}}}}}
  }
}
