{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/poolaction-fv2/proof-session-envelope/v1",
  "title": "PoolActionFv2 versioned proof-session envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["envelopeVersion", "rawEnvelopeHex", "directory", "sectionScheduleHex", "envelopeRootHex", "contextDigestHex", "proofSuiteManifestDigestHex", "sessionDigestHex", "proofSuiteStatus", "proofBoundaryResult"],
  "properties": {
    "envelopeVersion": {"const": 1},
    "rawEnvelopeHex": {"type": "string", "pattern": "^(?:[0-9a-f]{2})+$"},
    "directory": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/section"}},
    "sectionScheduleHex": {"type": "string", "pattern": "^(?:[0-9a-f]{2})+$"},
    "envelopeRootHex": {"$ref": "#/$defs/bytes32"},
    "contextDigestHex": {"$ref": "#/$defs/bytes32"},
    "proofSuiteManifestDigestHex": {"$ref": "#/$defs/bytes32"},
    "sessionDigestHex": {"$ref": "#/$defs/bytes32"},
    "proofSuiteStatus": {"const": "UNSELECTED"},
    "proofBoundaryResult": {"const": "REJECT_UNSELECTED_PROOF_SUITE"}
  },
  "$defs": {
    "bytes32": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "section": {"type": "object", "additionalProperties": false, "required": ["type", "critical", "ordinal", "offset", "length"], "properties": {"type": {"const": "OPAQUE_SUITE_PAYLOAD"}, "critical": {"const": true}, "ordinal": {"const": 0}, "offset": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "length": {"type": "integer", "minimum": 1, "maximum": 4294967295}}}
  }
}
