{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shieldkit-labs/bch-shielded-pool-design/spec/poolaction-fv2-falsifier-contract-v3/source-pins/v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packageId",
    "status",
    "authority",
    "pins",
    "requiredPinIds",
    "nonClaims"
  ],
  "properties": {
    "schema": {
      "const": "shieldkit-labs/poolaction-fv2/falsifier-contract/source-pins/v3"
    },
    "packageId": {
      "const": "poolaction-fv2-falsifier-contract-v3"
    },
    "status": {
      "const": "SOURCE_PINNED_STATIC_ONLY"
    },
    "authority": {
      "const": "bounded-contract-only"
    },
    "pins": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/pin"
      }
    },
    "requiredPinIds": {
      "const": [
        "ABI3-NORMATIVE-CHARTER-V3",
        "ABI3-SUCCESSOR-CHECKPOINT",
        "ABI2-STATIC-REDTEAM-HOLD",
        "ABI2-FALSIFIER-CONTRACT",
        "ABI2-CHARTER",
        "ABI2-RELATION-PACKAGE-MANIFEST"
      ]
    },
    "nonClaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9-]+$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

