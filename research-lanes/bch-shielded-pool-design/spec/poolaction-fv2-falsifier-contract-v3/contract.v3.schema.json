{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shieldkit-labs/poolaction-fv2/falsifier-contract/v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "relationId",
    "relationVersion",
    "abiVersion",
    "status",
    "authority",
    "namespacePolicy",
    "retainedV2FamilyCount",
    "additiveAbi3FamilyCount",
    "rowCount",
    "materializedVariantCount",
    "executedVariantCount",
    "passedVariantCount",
    "statusCounts",
    "lineageCounts",
    "requiredAdditiveFamilyIds",
    "statusModel",
    "retainedSource",
    "rows"
  ],
  "properties": {
    "contractId": {
      "const": "PoolActionFv2/falsifier-contract/v3"
    },
    "relationId": {
      "const": "PoolActionFv2"
    },
    "relationVersion": {
      "const": 2
    },
    "abiVersion": {
      "const": 3
    },
    "status": {
      "const": "AUTHORIZED_SUCCESSOR_STATIC_FALSIFIER_CONTRACT_ONLY"
    },
    "authority": {
      "const": "bounded-contract-only"
    },
    "namespacePolicy": {
      "$ref": "#/$defs/namespacePolicy"
    },
    "retainedV2FamilyCount": {
      "const": 73
    },
    "additiveAbi3FamilyCount": {
      "const": 26
    },
    "rowCount": {
      "const": 99
    },
    "materializedVariantCount": {
      "const": 0
    },
    "executedVariantCount": {
      "const": 0
    },
    "passedVariantCount": {
      "const": 0
    },
    "statusCounts": {
      "$ref": "#/$defs/statusCounts"
    },
    "lineageCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "V2_RETAINED",
        "ABI3_ADDITIVE"
      ],
      "properties": {
        "V2_RETAINED": {
          "const": 73
        },
        "ABI3_ADDITIVE": {
          "const": 26
        }
      }
    },
    "requiredAdditiveFamilyIds": {
      "type": "array",
      "const": [
        "A3-MANIFEST-MUTATION-ORIGINAL-LOCKS",
        "A3-MANIFEST-STATE-CATEGORY-COORDINATED",
        "A3-REDEEM-REPLACEMENT-UNCHANGED-LOCK",
        "A3-N3-ORDINAL-LOCK-REDEEM-FRAME-SOURCE-SWAPS",
        "A3-ACTION-DISPLAY-FLIP-REMOVAL",
        "A3-STATE-DELTA-BOUNDARIES-BOTH-TOPOLOGIES",
        "A3-SOURCE-TABLE-LEAF-COVERAGE",
        "A3-RUNTIME-INTEGER-BOUNDARIES",
        "A3-DEPENDENCY-CYCLE-INJECTION",
        "A3-DIRECT-GENESIS-PROVENANCE-MISMATCH",
        "A3-V2-NAMESPACE-MAGIC-DOMAIN-SCHEMA-REUSE",
        "A3-GENERIC-CARRIER-LOCK-SUBSTITUTION",
        "A3-CARRIER-NONMINIMAL-FINAL-REDEEM-WRAPPER-SUFFIX",
        "A3-TOKEN-AMBIGUITY-LANGUAGE-ESCAPES",
        "A3-PHYSICAL-CHAIN-IDENTITY-CLAIM",
        "A3-ROLE-LOCAL-INPUTINDEX-MISMATCH"
        ,"A3-STATE-POOL-ID-FOREIGN-OLD-NEW"
        ,"A3-PAF1-CODEC-VERSION-RESERVED"
        ,"A3-SEQUENCE-WRAP"
        ,"A3-STATE-BASE-CAPACITY-VALUE-EQUATION"
        ,"A3-PROOF-SUITE-STATUS-DIGEST-PAIRS"
        ,"A3-POOL-IDENTITY-FREE-MISCOMPUTED"
        ,"A3-CARRIER-COUNT-BOUNDARIES-N0-N484"
        ,"A3-CARRIER-SIZE-OVERLIMITS"
        ,"A3-TX-FIXED-VERSION-LOCKTIME-SEQUENCES"
        ,"A3-MONEYRANGE-AGGREGATE-OVERFLOW"
      ]
    },
    "statusModel": {
      "$ref": "#/$defs/statusModel"
    },
    "retainedSource": {
      "$ref": "#/$defs/retainedSource"
    },
    "rows": {
      "type": "array",
      "minItems": 99,
      "maxItems": 99,
      "items": {
        "$ref": "#/$defs/row"
      }
    }
  },
  "$defs": {
    "namespacePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageNamespace",
        "abiNamespace",
        "binaryVersion",
        "runtimeMagic",
        "hashDomainSuffix",
        "forbiddenV2Tokens"
      ],
      "properties": {
        "packageNamespace": {
          "const": "spec/poolaction-fv2-falsifier-contract-v3"
        },
        "abiNamespace": {
          "const": "shieldkit-labs/poolaction-fv2/falsifier-contract/v3"
        },
        "binaryVersion": {
          "const": 3
        },
        "runtimeMagic": {
          "const": "P3"
        },
        "hashDomainSuffix": {
          "const": "/v3"
        },
        "forbiddenV2Tokens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "statusCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "PLANNED",
        "MATERIALIZED",
        "EXECUTED",
        "PASSED"
      ],
      "properties": {
        "PLANNED": {
          "const": 99
        },
        "MATERIALIZED": {
          "const": 0
        },
        "EXECUTED": {
          "const": 0
        },
        "PASSED": {
          "const": 0
        }
      }
    },
    "statusModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "states",
        "transitions",
        "metaValidationDoesNotAdvanceStatus"
      ],
      "properties": {
        "states": {
          "const": [
            "PLANNED",
            "MATERIALIZED",
            "EXECUTED",
            "PASSED"
          ]
        },
        "transitions": {
          "const": [
            "PLANNED->MATERIALIZED",
            "MATERIALIZED->EXECUTED",
            "EXECUTED->PASSED"
          ]
        },
        "metaValidationDoesNotAdvanceStatus": {
          "const": true
        }
      }
    },
    "retainedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "contractPath",
        "contractSha256",
        "familyCount",
        "sourceStatus"
      ],
      "properties": {
        "package": {
          "const": "spec:poolaction-fv2-falsifier-contract-v2"
        },
        "contractPath": {
          "type": "string",
          "minLength": 1
        },
        "contractSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "familyCount": {
          "const": 73
        },
        "sourceStatus": {
          "const": "ABI_V2_IMMUTABLE_FAILED_ROUTE_EVIDENCE_ONLY"
        }
      }
    },
    "mutationMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutationKind",
        "targetFields",
        "mutationModes",
        "preserve",
        "expectedOutcome",
        "runtimeNamespace",
        "requiredBeforeGate1"
      ],
      "properties": {
        "mutationKind": {
          "enum": [
            "MIGRATED_V2_OBLIGATION",
            "ABI3_MANDATORY"
          ]
        },
        "targetFields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "preserve": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expectedOutcome": {
          "type": "string",
          "minLength": 1
        },
        "runtimeNamespace": {
          "const": "PoolActionFv2/falsifier-contract/v3"
        },
        "requiredBeforeGate1": {
          "type": "boolean"
        },
        "priority": {
          "type": "string"
        },
        "mutationModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "familyId",
        "lineage",
        "sourceFamilyId",
        "sourceGroup",
        "sourceClassification",
        "sourceLayer",
        "sourceDependencyGate",
        "sourceMinStableVariants",
        "sourceStatus",
        "status",
        "metaValidation",
        "mutationMetadata"
      ],
      "properties": {
        "familyId": {
          "type": "string",
          "pattern": "^(RF|F2|A3)-[A-Z0-9-]+$"
        },
        "lineage": {
          "enum": [
            "V2_RETAINED",
            "ABI3_ADDITIVE"
          ]
        },
        "sourceFamilyId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceGroup": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceClassification": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceLayer": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceDependencyGate": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceMinStableVariants": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceStatus": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "PLANNED",
            "MATERIALIZED",
            "EXECUTED",
            "PASSED"
          ]
        },
        "metaValidation": {
          "const": "SCHEMA_AND_CONTRACT_ONLY"
        },
        "mutationMetadata": {
          "$ref": "#/$defs/mutationMetadata"
        }
      }
    }
  }
}
