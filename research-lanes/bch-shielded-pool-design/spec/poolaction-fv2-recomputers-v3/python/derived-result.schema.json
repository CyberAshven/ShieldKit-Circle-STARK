{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shieldkit-labs/poolaction-fv2/recomputers-v3/python/derived-result",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "verdict", "manifest", "provenance", "action", "state", "txViewHex", "carriers", "contextDigest", "sessionDigest", "sourceTableVerdict", "dependencyVerdict", "nonClaims"],
  "properties": {
    "status": {"const": "STRUCTURAL_RECOMPUTE"},
    "verdict": {"const": "REJECT_UNSELECTED_PROOF_SUITE"},
    "manifest": {"type": "object"},
    "provenance": {"type": "object"},
    "action": {"type": "object"},
    "state": {"type": "object"},
    "txViewHex": {"type": "string", "pattern": "^[0-9a-f]+$"},
    "carriers": {"type": "object"},
    "contextDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sessionDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceTableVerdict": {"type": "object"},
    "dependencyVerdict": {"type": "object"},
    "nonClaims": {"type": "array", "items": {"type": "string"}}
  }
}
