{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shieldkit-labs/poolaction-fv2/recomputers-v3/python/raw-evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lockSelectedManifestCoreHex",
    "stateActiveRedeemHex",
    "transaction",
    "anchor",
    "genesisInitialStateValueLeHex",
    "sourceTable",
    "dependencyGraph"
  ],
  "properties": {
    "lockSelectedManifestCoreHex": {"type": "string", "pattern": "^[0-9a-f]*$"},
    "stateActiveRedeemHex": {"type": "string", "pattern": "^[0-9a-f]*$"},
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["versionLeHex", "locktimeLeHex", "inputs", "outputs"],
      "properties": {
        "versionLeHex": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "locktimeLeHex": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/input"}},
        "outputs": {"type": "array", "items": {"$ref": "#/$defs/output"}}
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["txHashOpcodeOrder", "outputIndexBeHex"],
      "properties": {
        "txHashOpcodeOrder": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "outputIndexBeHex": {"type": "string", "pattern": "^[0-9a-f]{8}$"}
      }
    },
    "genesisInitialStateValueLeHex": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "sourceTable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leaves"],
      "properties": {
        "leaves": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["leaf", "sourceClass"],
            "properties": {
              "leaf": {"type": "string", "minLength": 1},
              "sourceClass": {"enum": ["CODEC_CONSTANT", "LOCK_SELECTED_EMBEDDED", "INTROSPECTED", "DERIVED_AND_CHECKED"]}
            }
          }
        }
      }
    },
    "dependencyGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edges"],
      "properties": {
        "edges": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 1}}}
      }
    },
    "provenanceClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["genesisTransactionHashOpcodeOrder", "genesisOutpointIndexLeHex"],
      "properties": {
        "genesisTransactionHashOpcodeOrder": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "genesisOutpointIndexLeHex": {"type": "string", "pattern": "^[0-9a-f]{16}$"}
      }
    }
  },
  "$defs": {
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extendedCategoryHex", "commitmentHex", "amountLeHex"],
      "properties": {
        "extendedCategoryHex": {"type": "string", "pattern": "^[0-9a-f]*$"},
        "commitmentHex": {"type": "string", "pattern": "^[0-9a-f]*$"},
        "amountLeHex": {"type": "string", "pattern": "^[0-9a-f]{16}$"}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outpointTxHashOpcodeOrder", "outpointIndexLeHex", "sequenceLeHex", "sourceValueLeHex", "sourceLockingBytecode", "unlockingBytecode", "tokenObservation"],
      "properties": {
        "outpointTxHashOpcodeOrder": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "outpointIndexLeHex": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "sequenceLeHex": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "sourceValueLeHex": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "sourceLockingBytecode": {"type": "string", "pattern": "^[0-9a-f]*$"},
        "unlockingBytecode": {"type": "string", "pattern": "^[0-9a-f]*$"},
        "tokenObservation": {"$ref": "#/$defs/token"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valueLeHex", "lockingBytecode", "tokenObservation"],
      "properties": {
        "valueLeHex": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "lockingBytecode": {"type": "string", "pattern": "^[0-9a-f]*$"},
        "tokenObservation": {"$ref": "#/$defs/token"}
      }
    }
  }
}
