{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/research-lanes/bch-shielded-pool-design/spec/pool-state-fv1.schema.json",
  "title": "Decoded PoolStateFv1 native CashToken commitment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "magic",
    "stateCodecVersion",
    "reservedHex",
    "sequence",
    "depositCount",
    "withdrawalCount",
    "poolInstanceIdHex",
    "noteRootHex",
    "nullifierRootHex",
    "serializedHex"
  ],
  "properties": {
    "schema": {
      "const": "shieldkit-labs/pool-state-fv1/v1"
    },
    "magic": {
      "const": "PAF1"
    },
    "stateCodecVersion": {
      "const": 1
    },
    "reservedHex": {
      "const": "0000"
    },
    "sequence": {
      "$ref": "#/$defs/uint64Decimal"
    },
    "depositCount": {
      "$ref": "#/$defs/uint64Decimal"
    },
    "withdrawalCount": {
      "$ref": "#/$defs/uint64Decimal"
    },
    "poolInstanceIdHex": {
      "$ref": "#/$defs/bytes32"
    },
    "noteRootHex": {
      "$ref": "#/$defs/bytes32"
    },
    "nullifierRootHex": {
      "$ref": "#/$defs/bytes32"
    },
    "serializedHex": {
      "type": "string",
      "pattern": "^[0-9a-f]{256}$"
    }
  },
  "$defs": {
    "uint64Decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "bytes32": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
