{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/poolaction-fv2/v2/verifier-role-consumption",
  "title": "PoolActionFv2 verifier-role consumption evidence interchange",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "matrixVersion", "roles"],
  "properties": {
    "schema": {"const": "shieldkit-labs/poolaction-fv2/verifier-role-consumption/v2"},
    "matrixVersion": {"const": 2},
    "roles": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/role"}}
  },
  "$defs": {
    "role": {"type": "object", "additionalProperties": false, "required": ["role", "runtimeInputs", "embeddedConstants", "recomputes", "localChecks", "unselectedSuiteResult"], "properties": {"role": {"enum": ["STATE_COVENANT", "VERIFIER_CARRIER"]}, "runtimeInputs": {"type": "array", "minItems": 1, "items": {"enum": ["current-bch-introspection", "full-carrier-unlocking-bytecodes"]}}, "embeddedConstants": {"type": "array", "minItems": 1, "items": {"enum": ["deployment-commitment", "manifest-role-map", "proof-suite-status", "proof-suite-manifest-digest"]}}, "recomputes": {"type": "array", "minItems": 1, "items": {"enum": ["deployment-manifest-core-bytes", "tx-view-bytes", "carrier-session-bytes", "carrier-session-root", "reconstructed-envelope-bytes", "schedule-bytes", "envelope-root", "context-digest", "session-digest"]}}, "localChecks": {"type": "array", "minItems": 1, "items": {"enum": ["input-index-equals-fixed-role-index", "all-carrier-bytecode-consumed", "unselected-suite-reject"]}}, "unselectedSuiteResult": {"const": "REJECT_UNSELECTED_PROOF_SUITE"}}}
  }
}
