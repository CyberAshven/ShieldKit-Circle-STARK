{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/poolaction-fv2/v2/tx-view",
  "title": "PoolActionFv2 TxViewV2 evidence interchange",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "abiVersion", "actionKind", "transactionVersion", "locktime", "carrierCount", "inputs", "outputs", "economics"],
  "properties": {
    "schema": {"const": "shieldkit-labs/poolaction-fv2/tx-view/v2"},
    "abiVersion": {"const": 2},
    "actionKind": {"enum": ["DEPOSIT", "WITHDRAWAL"]},
    "transactionVersion": {"$ref": "#/$defs/runtimeU64"},
    "locktime": {"$ref": "#/$defs/runtimeU64"},
    "carrierCount": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "inputs": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/input"}},
    "outputs": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/output"}},
    "economics": {"$ref": "#/$defs/economics"}
  },
  "$defs": {
    "bytes32": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bytes128": {"type": "string", "pattern": "^[0-9a-f]{256}$"},
    "hex": {"type": "string", "pattern": "^(?:[0-9a-f]{2})*$"},
    "nonEmptyBytecode": {"type": "string", "pattern": "^(?:[0-9a-f]{2})+$", "maxLength": 20000},
    "runtimeU64": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,18})$"},
    "noneObservation": {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "NONE"}}},
    "stateObservation": {"type": "object", "additionalProperties": false, "required": ["kind", "categoryWireHex", "commitmentHex"], "properties": {"kind": {"const": "STATE_MUTABLE_NFT_ZERO"}, "categoryWireHex": {"$ref": "#/$defs/bytes32"}, "commitmentHex": {"$ref": "#/$defs/bytes128"}}},
    "tokenObservation": {"oneOf": [{"$ref": "#/$defs/noneObservation"}, {"$ref": "#/$defs/stateObservation"}]},
    "input": {"type": "object", "additionalProperties": false, "required": ["wireIndex", "role", "roleOrdinal", "outpointTxHashOpcodeOrderHex", "outpointIndex", "sequence", "sourceValueSats", "sourceLockingBytecodeHex", "tokenObservation", "unlockingDisposition"], "properties": {"wireIndex": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "role": {"enum": ["STATE", "VERIFIER_CARRIER", "DEPOSIT_FUNDING", "FEE_FUNDING"]}, "roleOrdinal": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "outpointTxHashOpcodeOrderHex": {"$ref": "#/$defs/bytes32"}, "outpointIndex": {"$ref": "#/$defs/runtimeU64"}, "sequence": {"$ref": "#/$defs/runtimeU64"}, "sourceValueSats": {"$ref": "#/$defs/runtimeU64"}, "sourceLockingBytecodeHex": {"$ref": "#/$defs/nonEmptyBytecode"}, "tokenObservation": {"$ref": "#/$defs/tokenObservation"}, "unlockingDisposition": {"enum": ["LOCAL_STATE", "CARRIER_SESSION", "EXTERNAL_AUTH"]}}},
    "output": {"type": "object", "additionalProperties": false, "required": ["wireIndex", "role", "roleOrdinal", "valueSats", "lockingBytecodeHex", "tokenObservation"], "properties": {"wireIndex": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "role": {"enum": ["STATE_SUCCESSOR", "VERIFIER_CARRIER_SUCCESSOR", "PAYOUT", "TRANSPARENT_CHANGE"]}, "roleOrdinal": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "valueSats": {"$ref": "#/$defs/runtimeU64"}, "lockingBytecodeHex": {"$ref": "#/$defs/nonEmptyBytecode"}, "tokenObservation": {"$ref": "#/$defs/tokenObservation"}}},
    "economics": {"type": "object", "additionalProperties": false, "required": ["ticketSats", "reserveDirection", "feeSats", "feePolicyMaxSats", "payoutPresent", "payoutOutputIndex", "changePresent", "changeOutputIndex"], "properties": {"ticketSats": {"const": "10000000"}, "reserveDirection": {"enum": ["INCREASE", "DECREASE"]}, "feeSats": {"$ref": "#/$defs/runtimeU64"}, "feePolicyMaxSats": {"$ref": "#/$defs/runtimeU64"}, "payoutPresent": {"type": "boolean"}, "payoutOutputIndex": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "changePresent": {"type": "boolean"}, "changeOutputIndex": {"type": "integer", "minimum": 0, "maximum": 4294967295}}}
  }
}
