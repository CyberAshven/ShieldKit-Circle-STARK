{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/poolaction-fv2/v2/carrier-session",
  "title": "PoolActionFv2 carrier session evidence interchange",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "abiVersion", "carrierSegments"],
  "properties": {
    "schema": {"const": "shieldkit-labs/poolaction-fv2/carrier-session/v2"},
    "abiVersion": {"const": 2},
    "carrierSegments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/segment"}}
  },
  "$defs": {
    "segment": {"type": "object", "additionalProperties": false, "required": ["ordinal", "inputIndex", "fullUnlockingBytecodeHex"], "properties": {"ordinal": {"type": "integer", "minimum": 0, "maximum": 4294967294}, "inputIndex": {"type": "integer", "minimum": 1, "maximum": 4294967295}, "fullUnlockingBytecodeHex": {"type": "string", "pattern": "^(?:[0-9a-f]{2})+$", "maxLength": 20000}}}
  }
}
