{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/poolaction-fv2/v2/provenance-evidence",
  "title": "PoolActionFv2 off-chain structural provenance evidence interchange",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "evidenceVersion", "runtimeAuthority", "templateSet", "anchor", "deploymentManifest", "initialStateValueSats", "byteOriginIntervals"],
  "properties": {
    "schema": {"const": "shieldkit-labs/poolaction-fv2/provenance-evidence/v2"},
    "evidenceVersion": {"const": 2},
    "runtimeAuthority": {"const": "OFF_CHAIN_EVIDENCE_ONLY"},
    "templateSet": {"$ref": "#/$defs/templateSet"},
    "anchor": {"$ref": "#/$defs/anchor"},
    "deploymentManifest": {"$ref": "https://shieldkit-labs.local/poolaction-fv2/v2/deployment-manifest"},
    "initialStateValueSats": {"$ref": "#/$defs/runtimeU64"},
    "byteOriginIntervals": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/interval"}}
  },
  "$defs": {
    "bytes32": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hexNonEmpty": {"type": "string", "pattern": "^(?:[0-9a-f]{2})+$"},
    "runtimeU64": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,18})$"},
    "templateSet": {"type": "object", "additionalProperties": false, "required": ["toolchainId", "normalizedStateTemplateHex", "normalizedCarrierTemplateHex"], "properties": {"toolchainId": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000]+$"}, "normalizedStateTemplateHex": {"$ref": "#/$defs/hexNonEmpty"}, "normalizedCarrierTemplateHex": {"$ref": "#/$defs/hexNonEmpty"}}},
    "anchor": {"type": "object", "additionalProperties": false, "required": ["anchorTxHashOpcodeOrderHex", "anchorOutputIndex"], "properties": {"anchorTxHashOpcodeOrderHex": {"$ref": "#/$defs/bytes32"}, "anchorOutputIndex": {"type": "integer", "minimum": 0, "maximum": 4294967295}}},
    "interval": {"type": "object", "additionalProperties": false, "required": ["role", "artifact", "start", "endExclusive", "origin"], "properties": {"role": {"enum": ["STATE", "VERIFIER_CARRIER"]}, "artifact": {"enum": ["STRUCTURAL_REDEEM", "STRUCTURAL_LOCK"]}, "start": {"type": "integer", "minimum": 0, "maximum": 9999}, "endExclusive": {"type": "integer", "minimum": 1, "maximum": 10000}, "origin": {"enum": ["ROLE_BINDING_DIGEST", "FIXED_COMPILER_OPCODE", "HASH160_OUTPUT"]}}}
  }
}
