{
  "$defs": {
    "finiteAxis": {
      "additionalProperties": false,
      "properties": {
        "appliesToFamilies": {
          "items": {
            "pattern": "^RF-[A-Z0-9-]+$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "axisId": {
          "pattern": "^[A-Z0-9_]+$",
          "type": "string"
        },
        "expansionRule": {
          "minLength": 1,
          "type": "string"
        },
        "values": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "appliesToFamilies",
        "axisId",
        "expansionRule",
        "values"
      ],
      "type": "object"
    },
    "selectedAxis": {
      "additionalProperties": false,
      "properties": {
        "axisId": {
          "pattern": "^[A-Z0-9_]+$",
          "type": "string"
        },
        "closureBlocker": {
          "minLength": 1,
          "type": "string"
        },
        "selectedValue": {
          "type": "null"
        },
        "semanticRejectionStage": {
          "type": "null"
        }
      },
      "required": [
        "axisId",
        "closureBlocker",
        "selectedValue",
        "semanticRejectionStage"
      ],
      "type": "object"
    }
  },
  "$id": "shieldkit-labs/poolactionfv1-refreeze-falsifier-contract/variant-expansion/v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority": {
      "const": "none"
    },
    "executableRowCount": {
      "const": 0
    },
    "executableRows": {
      "maxItems": 0,
      "type": "array"
    },
    "finalVariantCount": {
      "type": "null"
    },
    "knownFiniteAxes": {
      "items": {
        "$ref": "#/$defs/finiteAxis"
      },
      "maxItems": 20,
      "minItems": 20,
      "type": "array",
      "uniqueItems": true
    },
    "packageId": {
      "const": "spec:poolactionfv1-refreeze-falsifier-contract-v2"
    },
    "schema": {
      "const": "shieldkit-labs/poolactionfv1-refreeze-falsifier-contract/variant-expansion/v2"
    },
    "selectedArtifactAxes": {
      "items": {
        "$ref": "#/$defs/selectedAxis"
      },
      "maxItems": 9,
      "minItems": 9,
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "const": "BLOCKED_VERSION_PIVOT_NO_REFREEZE"
    },
    "variantRoster": {
      "const": false
    }
  },
  "required": [
    "authority",
    "executableRowCount",
    "executableRows",
    "finalVariantCount",
    "knownFiniteAxes",
    "packageId",
    "schema",
    "selectedArtifactAxes",
    "status",
    "variantRoster"
  ],
  "type": "object"
}
