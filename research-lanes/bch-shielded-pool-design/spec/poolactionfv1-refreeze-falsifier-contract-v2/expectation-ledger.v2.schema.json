{
  "$id": "shieldkit-labs/poolactionfv1-refreeze-falsifier-contract/expectation-ledger/v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attemptId": {
      "minLength": 1,
      "type": "string"
    },
    "authority": {
      "const": "none"
    },
    "expectationLedgerComplete": {
      "const": true
    },
    "expectations": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "expectedDisposition": {
                  "const": "ACCEPT"
                }
              },
              "required": [
                "expectedDisposition"
              ]
            },
            "then": {
              "properties": {
                "antecedentCaseIds": {
                  "maxItems": 0,
                  "type": "array"
                },
                "expectedSemanticStage": {
                  "const": "FINAL_ACCEPT",
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "expectedDisposition": {
                  "const": "REJECT"
                }
              },
              "required": [
                "expectedDisposition"
              ]
            },
            "then": {
              "properties": {
                "antecedentCaseIds": {
                  "minItems": 1,
                  "type": "array"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "expectedDisposition": {
                  "const": "REFUSE"
                }
              },
              "required": [
                "expectedDisposition"
              ]
            },
            "then": {
              "properties": {
                "expectedSemanticStage": {
                  "const": "PRECONDITION_REFUSAL",
                  "type": "string"
                }
              }
            }
          }
        ],
        "properties": {
          "antecedentCaseIds": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          },
          "caseId": {
            "minLength": 1,
            "type": "string"
          },
          "expectedDisposition": {
            "enum": [
              "ACCEPT",
              "REJECT",
              "REFUSE"
            ]
          },
          "expectedSemanticStage": {
            "enum": [
              "FINAL_ACCEPT",
              "INPUT_DECODE",
              "NETWORK_DOMAIN_BINDING",
              "DEPLOYMENT_MANIFEST_BINDING",
              "TXCONTEXT_GRAMMAR",
              "TXCONTEXT_FULL_CONSUMPTION",
              "TXCONTEXT_IDENTITY",
              "TXCONTEXT_DIGEST_RECOMPUTATION",
              "PAST_PROJECTION",
              "TOKEN_INTROSPECTION_PROJECTION",
              "TOKEN_DEPLOYMENT_BINDING",
              "LOCK_BYTE_IDENTITY",
              "LOCK_PROVENANCE",
              "LOCK_CYCLE_CHECK",
              "SESSION_WRAPPER_GRAMMAR",
              "SESSION_ANCHOR_BINDING",
              "SESSION_ROOT_RECOMPUTATION",
              "SESSION_MEMBERSHIP_RECOMPUTATION",
              "SESSION_SECTION_BINDING",
              "PROOF_BYTE_COVERAGE",
              "PUSH_CANONICALITY",
              "SCRIPT_STANDARDNESS",
              "TRANSACTION_STANDARDNESS",
              "TRANSACTION_SESSION_BINDING",
              "PRECONDITION_REFUSAL"
            ]
          },
          "familyId": {
            "pattern": "^RF-[A-Z0-9-]+$",
            "type": "string"
          },
          "inputRawSha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "mutationDescription": {
            "minLength": 1,
            "type": "string"
          },
          "singleInvariant": {
            "const": true
          },
          "variantId": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "antecedentCaseIds",
          "caseId",
          "expectedDisposition",
          "expectedSemanticStage",
          "familyId",
          "inputRawSha256",
          "mutationDescription",
          "singleInvariant",
          "variantId"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "frozenVariantCount": {
      "minimum": 1,
      "type": "integer"
    },
    "independentReview": {
      "additionalProperties": false,
      "properties": {
        "ledgerRawSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "reviewArtifactRawSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "reviewed": {
          "const": true
        }
      },
      "required": [
        "ledgerRawSha256",
        "reviewArtifactRawSha256",
        "reviewed"
      ],
      "type": "object"
    },
    "schema": {
      "const": "shieldkit-labs/poolactionfv1-refreeze-falsifier-contract/expectation-ledger/v2"
    },
    "status": {
      "const": "FROZEN_PRE_EXECUTION"
    }
  },
  "required": [
    "attemptId",
    "authority",
    "expectationLedgerComplete",
    "expectations",
    "frozenVariantCount",
    "independentReview",
    "schema",
    "status"
  ],
  "title": "Future immutable PoolActionFv1 falsifier expectation ledger",
  "type": "object"
}
