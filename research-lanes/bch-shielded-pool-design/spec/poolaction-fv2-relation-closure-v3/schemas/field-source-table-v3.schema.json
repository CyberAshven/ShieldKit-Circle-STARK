{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shieldkit-labs/poolaction-fv2/field-source-table/v3",
  "title": "PoolActionFv2 ABI-v3 exhaustive field-source table",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "relationId", "relationVersion", "abiVersion", "fixtureTables"],
  "properties": {
    "schema": {"const": "shieldkit-labs/poolaction-fv2/field-source-table/v3"},
    "relationId": {"const": "PoolActionFv2"},
    "relationVersion": {"const": 2},
    "abiVersion": {"const": 3},
    "fixtureTables": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/fixtureTable"}}
  },
  "$defs": {
    "fixtureTable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtureId", "carrierCount", "inputCount", "outputCount", "rows"],
      "properties": {
        "fixtureId": {"enum": ["deposit-n1", "deposit-n3", "withdrawal-n1", "withdrawal-n3"]},
        "carrierCount": {"enum": [1, 3]},
        "inputCount": {"type": "integer", "minimum": 3},
        "outputCount": {"type": "integer", "minimum": 3},
        "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row"}}
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leafId", "sourceClass", "dependencyNodes"],
      "properties": {
        "leafId": {"type": "string", "minLength": 1, "pattern": "^[^*]+$"},
        "sourceClass": {"enum": ["CODEC_CONSTANT", "LOCK_SELECTED_EMBEDDED", "INTROSPECTED", "DERIVED_AND_CHECKED"]},
        "dependencyNodes": {"type": "array", "uniqueItems": true, "items": {"enum": ["lockSelectedManifest", "introspectedTransaction", "deploymentCommitment", "txViewBytes", "contextDigest", "proofPublicInput", "carrierPayloads", "carrierSessionBytes", "reconstructedEnvelopeBytes", "scheduleBytes", "carrierSessionRoot", "envelopeRoot", "sessionDigest"]}}
      },
      "allOf": [
        {"if": {"properties": {"sourceClass": {"const": "DERIVED_AND_CHECKED"}}}, "then": {"properties": {"dependencyNodes": {"type": "array", "minItems": 1}}}, "else": {"properties": {"dependencyNodes": {"type": "array", "maxItems": 0}}}}
      ]
    }
  },
  "description": "Every ABI-v3 leaf receives exactly one permitted source class. Derived leaves must name existing acyclic dependency nodes."
}
