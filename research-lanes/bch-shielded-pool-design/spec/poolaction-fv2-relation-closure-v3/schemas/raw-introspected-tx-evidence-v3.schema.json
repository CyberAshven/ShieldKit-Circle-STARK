{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shieldkit-labs/poolaction-fv2/raw-introspected-tx-evidence/v3",
  "title": "PoolActionFv2 ABI-v3 raw/introspected transaction evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["versionLeHex", "locktimeLeHex", "inputs", "outputs"],
  "properties": {
    "versionLeHex": {"$ref": "#/$defs/runtimeLe8"},
    "locktimeLeHex": {"$ref": "#/$defs/runtimeLe8"},
    "inputs": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/input"}},
    "outputs": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/output"}}
  },
  "$defs": {
    "hex": {"type": "string", "pattern": "^(?:[0-9a-f]{2})*$"},
    "runtimeLe8": {"type": "string", "pattern": "^[0-9a-f]{14}[0-7][0-9a-f]$", "description": "Exact nonnegative runtime u64 little-endian hexadecimal. The high bit of the final byte is clear, so values greater than 0x7fffffffffffffff are rejected."},
    "projection": {"type": "object", "additionalProperties": false, "required": ["categoryWireHex", "commitmentHex", "amountLeHex"], "properties": {"categoryWireHex": {"$ref": "#/$defs/hex", "description": "Exact observed OP_*TOKENCATEGORY bytes. ABI-v3 state roles require Cwire||01 (33 bytes); a native token prefix is not an introspection field and is forbidden."}, "commitmentHex": {"$ref": "#/$defs/hex"}, "amountLeHex": {"$ref": "#/$defs/runtimeLe8"}}},
    "input": {"type": "object", "additionalProperties": false, "required": ["outpointTxHashOpcodeOrderHex", "outpointIndexLeHex", "sequenceLeHex", "sourceValueSatsLeHex", "sourceLockingBytecodeHex", "tokenProjection"], "properties": {"outpointTxHashOpcodeOrderHex": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "outpointIndexLeHex": {"$ref": "#/$defs/runtimeLe8"}, "sequenceLeHex": {"$ref": "#/$defs/runtimeLe8"}, "sourceValueSatsLeHex": {"$ref": "#/$defs/runtimeLe8"}, "sourceLockingBytecodeHex": {"$ref": "#/$defs/hex"}, "tokenProjection": {"$ref": "#/$defs/projection"}}},
    "output": {"type": "object", "additionalProperties": false, "required": ["valueSatsLeHex", "lockingBytecodeHex", "tokenProjection"], "properties": {"valueSatsLeHex": {"$ref": "#/$defs/runtimeLe8"}, "lockingBytecodeHex": {"$ref": "#/$defs/hex"}, "tokenProjection": {"$ref": "#/$defs/projection"}}}
  }
}
