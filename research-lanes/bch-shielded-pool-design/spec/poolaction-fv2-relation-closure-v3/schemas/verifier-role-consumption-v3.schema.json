{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shieldkit-labs/poolaction-fv2/verifier-role-consumption/v3",
  "title": "PoolActionFv2 ABI-v3 verifier-role local consumption",
  "type": "object",
  "additionalProperties": false,
  "required": ["roleTagHex", "ordinalLeHex", "observedInputIndexLeHex"],
  "properties": {
    "roleTagHex": {"enum": ["00", "01"]},
    "ordinalLeHex": {"$ref": "#/$defs/runtimeLe8"},
    "observedInputIndexLeHex": {"$ref": "#/$defs/runtimeLe8"}
  },
  "allOf": [
    {
      "if": {"properties": {"roleTagHex": {"const": "00"}}},
      "then": {"properties": {"ordinalLeHex": {"const": "0000000000000000"}, "observedInputIndexLeHex": {"const": "0000000000000000"}}},
      "else": {"properties": {"observedInputIndexLeHex": {"not": {"const": "0000000000000000"}}}}
    }
  ],
  "$defs": {
    "runtimeLe8": {"type": "string", "pattern": "^[0-9a-f]{14}[0-7][0-9a-f]$"}
  },
  "description": "Evaluation-site local OP_INPUTINDEX evidence; excluded from every shared digest."
}
