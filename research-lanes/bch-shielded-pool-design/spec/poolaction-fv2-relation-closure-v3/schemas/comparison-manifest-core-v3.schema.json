{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shieldkit-labs/poolaction-fv2/comparison-manifest-core/v3",
  "title": "PoolActionFv2 ABI-v3 comparison-only manifest core",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "comparisonOnly", "deploymentManifestCoreHex"],
  "properties": {
    "schema": {"const": "shieldkit-labs/poolaction-fv2/comparison-manifest-core/v3"},
    "comparisonOnly": {"const": true},
    "deploymentManifestCoreHex": {"type": "string", "pattern": "^(?:[0-9a-f]{2})+$"}
  },
  "description": "Never a relation-input authority. Runtime manifest bytes must instead be parsed from lock-selected redeems."
}
