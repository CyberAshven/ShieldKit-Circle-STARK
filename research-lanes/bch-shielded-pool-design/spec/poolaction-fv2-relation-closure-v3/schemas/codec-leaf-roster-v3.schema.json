{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shieldkit-labs/poolaction-fv2/codec-leaf-roster/v3",
  "title": "PoolActionFv2 ABI-v3 exact codec leaf roster",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "relationId", "relationVersion", "abiVersion", "fixtureRosters"],
  "properties": {
    "schema": {"const": "shieldkit-labs/poolaction-fv2/codec-leaf-roster/v3"},
    "relationId": {"const": "PoolActionFv2"},
    "relationVersion": {"const": 2},
    "abiVersion": {"const": 3},
    "fixtureRosters": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/$defs/fixtureRoster"}
    }
  },
  "$defs": {
    "fixtureRoster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtureId", "carrierCount", "inputCount", "outputCount", "leaves"],
      "properties": {
        "fixtureId": {"enum": ["deposit-n1", "deposit-n3", "withdrawal-n1", "withdrawal-n3"]},
        "carrierCount": {"enum": [1, 3]},
        "inputCount": {"type": "integer", "minimum": 3},
        "outputCount": {"type": "integer", "minimum": 3},
        "leaves": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[^*]+$"}}
      }
    }
  },
  "description": "No grouped or wildcard leaf can stand for ABI-v3 binary bytes. Exact coverage is checked by validateFieldSourceCoverageV3."
}
