{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shieldkit-labs/poolaction-fv2/structural-provenance/v3",
  "title": "PoolActionFv2 ABI-v3 structural provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["templateSetHex", "protocolTemplateDigestHex", "anchorTxHashOpcodeOrderHex", "anchorOutputIndexLeHex", "preExistingAnchorDigestHex", "poolIdentityConfigHex", "poolInstanceIdHex", "stateCategoryWireHex", "genesisAncestryDigestHex", "deploymentManifestCoreHex", "deploymentCommitmentHex", "genesisInitialStateValueSatsLeHex", "roles", "structuralOnly", "nonDeployable", "proofSuite"],
  "properties": {
    "templateSetHex": {"$ref": "#/$defs/nonemptyHex"},
    "protocolTemplateDigestHex": {"$ref": "#/$defs/bytes32Hex"},
    "anchorTxHashOpcodeOrderHex": {"$ref": "#/$defs/bytes32Hex"},
    "anchorOutputIndexLeHex": {"$ref": "#/$defs/runtimeLe8"},
    "preExistingAnchorDigestHex": {"$ref": "#/$defs/bytes32Hex"},
    "poolIdentityConfigHex": {"$ref": "#/$defs/nonemptyHex"},
    "poolInstanceIdHex": {"$ref": "#/$defs/bytes32Hex"},
    "stateCategoryWireHex": {"$ref": "#/$defs/bytes32Hex"},
    "genesisAncestryDigestHex": {"$ref": "#/$defs/bytes32Hex"},
    "deploymentManifestCoreHex": {"$ref": "#/$defs/nonemptyHex"},
    "deploymentCommitmentHex": {"$ref": "#/$defs/bytes32Hex"},
    "genesisInitialStateValueSatsLeHex": {"$ref": "#/$defs/runtimeLe8"},
    "roles": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/role"}},
    "structuralOnly": {"const": true},
    "nonDeployable": {"const": true},
    "proofSuite": {"const": "UNSELECTED"}
  },
  "$defs": {
    "nonemptyHex": {"type": "string", "pattern": "^(?:[0-9a-f]{2})+$"},
    "bytes32Hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtimeLe8": {"type": "string", "pattern": "^[0-9a-f]{14}[0-7][0-9a-f]$"},
    "byteOriginInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "origin"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0},
        "origin": {"enum": ["LOCK_SELECTED_EMBEDDED:manifestMinimalPush", "LOCK_SELECTED_EMBEDDED:roleMinimalPush", "CODEC_CONSTANT:OP_DROP", "CODEC_CONSTANT:OP_FALSE", "CODEC_CONSTANT:OP_HASH160", "CODEC_CONSTANT:Push20", "CODEC_CONSTANT:OP_EQUAL", "DERIVED_AND_CHECKED:HASH160(redeem)"]}
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roleClass", "ordinalLeHex", "roleInstanceHex", "redeemHex", "lockHex", "redeemIntervals", "lockIntervals"],
      "properties": {
        "roleClass": {"enum": ["STATE", "CARRIER"]},
        "ordinalLeHex": {"$ref": "#/$defs/runtimeLe8"},
        "roleInstanceHex": {"type": "string", "pattern": "^[0-9a-f]{38}$"},
        "redeemHex": {"$ref": "#/$defs/nonemptyHex"},
        "lockHex": {"type": "string", "pattern": "^[0-9a-f]{46}$"},
        "redeemIntervals": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/byteOriginInterval"}},
        "lockIntervals": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/byteOriginInterval"}}
      },
      "allOf": [
        {
          "if": {"properties": {"roleClass": {"const": "STATE"}}},
          "then": {"properties": {"ordinalLeHex": {"const": "0000000000000000"}}}
        }
      ]
    }
  },
  "description": "Off-chain provenance only; it cannot enter a relation input, context, session, proof, or manifest core. The runtime compiler validates byte-origin coverage, ordering, and hashes in addition to this closed shape."
}
