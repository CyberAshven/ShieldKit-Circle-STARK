{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shieldkit-labs/poolaction-fv2/carrier-session/v3",
  "title": "PoolActionFv2 ABI-v3 carrier session evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "carrierUnlockingBytecodesHex"],
  "properties": {
    "schema": {"const": "shieldkit-labs/poolaction-fv2/carrier-session/v3"},
    "carrierUnlockingBytecodesHex": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(?:[0-9a-f]{2})+$"}}
  },
  "description": "Every item is one complete canonical two-push unlocking bytecode, not a proof-acceptance claim."
}
