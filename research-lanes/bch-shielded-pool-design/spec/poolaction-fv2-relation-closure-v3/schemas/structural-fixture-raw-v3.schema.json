{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shieldkit-labs/poolaction-fv2/structural-fixture-raw/v3",
  "title": "PoolActionFv2 ABI-v3 structural proof-rejected fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "fixtureId", "classification", "relationInput", "structuralProvenance", "nonClaims"],
  "properties": {
    "schema": {"const": "shieldkit-labs/poolaction-fv2/structural-fixture-raw/v3"},
    "fixtureId": {"enum": ["deposit-n1", "deposit-n3", "withdrawal-n1", "withdrawal-n3"]},
    "classification": {"const": "STRUCTURAL_PROOF_REJECTED_NONDEPLOYABLE"},
    "relationInput": {"$ref": "../relation-input/v3"},
    "structuralProvenance": {"$ref": "../structural-provenance/v3"},
    "nonClaims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "description": "Fixture wrapper only. It is structural, non-deployable, and proof-rejected; it is not BCH VM, complete-transaction, standardness, qualification, deployment, or activation evidence."
}
