{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shieldkit-labs/poolaction-fv2/derived-result/v3",
  "title": "PoolActionFv2 ABI-v3 derived structural result",
  "type": "object",
  "additionalProperties": false,
  "required": ["relationId", "relationVersion", "abiVersion", "action", "actionTagHex", "deploymentManifestCoreHex", "poolIdentityConfigHex", "poolInstanceIdHex", "deploymentCommitmentHex", "roleArtifacts", "txViewBytesHex", "carrierSessionBytesHex", "reconstructedEnvelopeBytesHex", "scheduleBytesHex", "carrierSessionRootHex", "envelopeRootHex", "contextDigestHex", "sessionDigestHex", "proofSuiteStatus", "proofAccepted", "verdict", "structuralOnly"],
  "properties": {
    "relationId": {"const": "PoolActionFv2"},
    "relationVersion": {"const": 2},
    "abiVersion": {"const": 3},
    "action": {"enum": ["DEPOSIT", "WITHDRAWAL"]},
    "actionTagHex": {"enum": ["00", "01"]},
    "deploymentManifestCoreHex": {"$ref": "#/$defs/nonemptyHex"},
    "poolIdentityConfigHex": {"$ref": "#/$defs/nonemptyHex"},
    "poolInstanceIdHex": {"$ref": "#/$defs/bytes32Hex"},
    "deploymentCommitmentHex": {"$ref": "#/$defs/bytes32Hex"},
    "roleArtifacts": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/roleArtifact"}},
    "txViewBytesHex": {"$ref": "#/$defs/nonemptyHex"},
    "carrierSessionBytesHex": {"$ref": "#/$defs/nonemptyHex"},
    "reconstructedEnvelopeBytesHex": {"$ref": "#/$defs/nonemptyHex"},
    "scheduleBytesHex": {"$ref": "#/$defs/nonemptyHex"},
    "carrierSessionRootHex": {"$ref": "#/$defs/bytes32Hex"},
    "envelopeRootHex": {"$ref": "#/$defs/bytes32Hex"},
    "contextDigestHex": {"$ref": "#/$defs/bytes32Hex"},
    "sessionDigestHex": {"$ref": "#/$defs/bytes32Hex"},
    "proofSuiteStatus": {"const": "UNSELECTED"},
    "proofAccepted": {"const": false},
    "verdict": {"const": "REJECT_UNSELECTED_PROOF_SUITE"},
    "structuralOnly": {"const": true}
  },
  "allOf": [
    {"if": {"properties": {"action": {"const": "DEPOSIT"}}}, "then": {"properties": {"actionTagHex": {"const": "00"}}}, "else": {"properties": {"actionTagHex": {"const": "01"}}}}
  ],
  "$defs": {
    "nonemptyHex": {"type": "string", "pattern": "^(?:[0-9a-f]{2})+$"},
    "bytes32Hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "roleArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roleClass", "ordinal", "roleInstanceHex", "redeemHex", "lockHex"],
      "properties": {
        "roleClass": {"enum": ["STATE", "CARRIER"]},
        "ordinal": {"type": "integer", "minimum": 0},
        "roleInstanceHex": {"type": "string", "pattern": "^[0-9a-f]{38}$"},
        "redeemHex": {"$ref": "#/$defs/nonemptyHex"},
        "lockHex": {"type": "string", "pattern": "^[0-9a-f]{46}$"}
      }
    }
  },
  "description": "Every value is a recomputed structural output. No caller-supplied digest or accepting proof result is admitted."
}
