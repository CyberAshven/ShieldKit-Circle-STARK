{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shieldkit-labs/poolaction-fv2/relation-input/v3",
  "title": "PoolActionFv2 ABI-v3 relation input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "relationId", "relationVersion", "abiVersion", "transaction", "stateActiveRedeemHex", "carrierUnlockingBytecodesHex", "verifierRoleConsumptions"],
  "properties": {
    "schema": {"const": "shieldkit-labs/poolaction-fv2/relation-input/v3"},
    "relationId": {"const": "PoolActionFv2"},
    "relationVersion": {"const": 2},
    "abiVersion": {"const": 3},
    "transaction": {"$ref": "../raw-introspected-tx-evidence/v3"},
    "stateActiveRedeemHex": {"type": "string", "pattern": "^(?:[0-9a-f]{2})+$"},
    "carrierUnlockingBytecodesHex": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(?:[0-9a-f]{2})+$"}},
    "verifierRoleConsumptions": {"type": "array", "minItems": 2, "items": {"$ref": "../verifier-role-consumption/v3"}}
  },
  "description": "Caller action labels and caller-derived digests are deliberately absent."
}
