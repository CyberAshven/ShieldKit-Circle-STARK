{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shieldkit-labs/poolaction-fv2/dependency-graph/v3",
  "title": "PoolActionFv2 ABI-v3 dependency graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "relationId", "relationVersion", "abiVersion", "nodes", "edges"],
  "properties": {
    "schema": {"const": "shieldkit-labs/poolaction-fv2/dependency-graph/v3"},
    "relationId": {"const": "PoolActionFv2"},
    "relationVersion": {"const": 2},
    "abiVersion": {"const": 3},
    "nodes": {"type": "array", "minItems": 13, "uniqueItems": true, "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/edge"}}
  },
  "$defs": {
    "node": {"enum": ["lockSelectedManifest", "introspectedTransaction", "deploymentCommitment", "txViewBytes", "contextDigest", "proofPublicInput", "carrierPayloads", "carrierSessionBytes", "reconstructedEnvelopeBytes", "scheduleBytes", "carrierSessionRoot", "envelopeRoot", "sessionDigest"]},
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {"from": {"$ref": "#/$defs/node"}, "to": {"$ref": "#/$defs/node"}}
    }
  }
}
