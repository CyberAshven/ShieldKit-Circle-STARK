{
  "schema": "shieldkit-labs/poolactionfv1-responsibility-map/v1",
  "status": "responsibilities-frozen-controls-unmeasured",
  "relationRef": "relation:pool-action-fv1",
  "rule": "Every safety, authorization, privacy, liveness, and assurance responsibility has an explicit enforcement layer and at least one planned single-invariant vector. A proof system is never treated as a substitute for transaction settlement or wallet lifecycle responsibilities.",
  "enforcementLayers": [
    "PoolConfigFv1 genesis audit",
    "PoolStateFv1 codec",
    "Circle-FRI AIR",
    "Circle-FRI verifier carriers",
    "state settlement covenant",
    "external funding-input authorization",
    "whole-transaction BCH consensus and policy",
    "wallet construction and recovery FSM",
    "qualification and provenance harness"
  ],
  "responsibilities": [
    {
      "id": "R-PROFILE-DOMAIN",
      "statement": "Only the fixed-ticket PoolActionFv1 profile, pool, network, action, and security profile are accepted.",
      "enforcedBy": [
        "PoolConfigFv1 genesis audit",
        "Circle-FRI AIR",
        "Circle-FRI verifier carriers",
        "state settlement covenant"
      ],
      "mutationIds": [
        "vector:semantic:action-selector",
        "vector:semantic:cross-pool",
        "vector:semantic:cross-network"
      ]
    },
    {
      "id": "R-UNIQUE-LINEAGE",
      "statement": "A pre-existing deployment anchor and acyclic identity derivation precede one recorded genesis state; destroyed minting authority and valid successors define the only authoritative lineage.",
      "enforcedBy": [
        "PoolConfigFv1 genesis audit",
        "state settlement covenant",
        "wallet construction and recovery FSM"
      ],
      "mutationIds": [
        "vector:topology:identity-cycle",
        "vector:topology:state-category",
        "vector:topology:state-genesis",
        "vector:topology:genesis-multiple-state",
        "vector:topology:minting-authority"
      ]
    },
    {
      "id": "R-STATE-CODEC",
      "statement": "The complete native 128-byte state has one encoding, valid counters, immutable identity, and exact successor rules.",
      "enforcedBy": [
        "PoolStateFv1 codec",
        "Circle-FRI AIR",
        "state settlement covenant"
      ],
      "mutationIds": [
        "vector:semantic:state-reserved",
        "vector:semantic:state-counter",
        "vector:parser:state-trailing"
      ]
    },
    {
      "id": "R-FIXED-TICKET",
      "statement": "Every deposit and withdrawal changes the reserve and state by exactly 10,000,000 satoshis and no variable amount exists.",
      "enforcedBy": [
        "Circle-FRI AIR",
        "state settlement covenant",
        "whole-transaction BCH consensus and policy"
      ],
      "mutationIds": [
        "vector:semantic:ticket-value",
        "vector:transaction:state-value-delta",
        "vector:transaction:payout-value"
      ]
    },
    {
      "id": "R-RESERVE-CONSERVATION",
      "statement": "State value equals base plus outstanding tickets, carriers preserve value, and the pool never funds fees.",
      "enforcedBy": [
        "Circle-FRI AIR",
        "state settlement covenant",
        "whole-transaction BCH consensus and policy"
      ],
      "mutationIds": [
        "vector:transaction:state-token-amount",
        "vector:transaction:pool-fee-subsidy",
        "vector:transaction:carrier-value",
        "vector:semantic:reserve-equation"
      ]
    },
    {
      "id": "R-NOTE-COMMITMENT",
      "statement": "A deposit note binds pool, fixed value, public insertion index, owner commitment, rho, and recovery version.",
      "enforcedBy": [
        "Circle-FRI AIR"
      ],
      "mutationIds": [
        "vector:semantic:deposit-note",
        "vector:semantic:deposit-index"
      ]
    },
    {
      "id": "R-NOTE-INSERTION",
      "statement": "Deposit replaces exactly the empty leaf at old depositCount and changes no other note leaf or nullifier state.",
      "enforcedBy": [
        "Circle-FRI AIR"
      ],
      "mutationIds": [
        "vector:semantic:note-insertion-path",
        "vector:semantic:deposit-nullifier-root"
      ]
    },
    {
      "id": "R-NOTE-MEMBERSHIP",
      "statement": "Withdrawal proves the private note is a canonical member of the old note root at its private index.",
      "enforcedBy": [
        "Circle-FRI AIR"
      ],
      "mutationIds": [
        "vector:semantic:note-membership-path",
        "vector:semantic:note-private-index"
      ]
    },
    {
      "id": "R-SPEND-AUTHORITY",
      "statement": "Withdrawal proves knowledge of the owner secret committed by the spent note.",
      "enforcedBy": [
        "Circle-FRI AIR"
      ],
      "mutationIds": [
        "vector:semantic:owner-secret",
        "vector:semantic:owner-commitment"
      ]
    },
    {
      "id": "R-NULLIFIER-DERIVATION",
      "statement": "The public nullifier is canonically derived from the same pool, note index, owner secret, and rho.",
      "enforcedBy": [
        "Circle-FRI AIR"
      ],
      "mutationIds": [
        "vector:semantic:nullifier-derivation"
      ]
    },
    {
      "id": "R-NULLIFIER-UNIQUENESS",
      "statement": "Withdrawal proves old-root non-membership and deterministic insertion of exactly one nullifier.",
      "enforcedBy": [
        "Circle-FRI AIR"
      ],
      "mutationIds": [
        "vector:semantic:nullifier-reuse",
        "vector:semantic:nullifier-nonmembership",
        "vector:semantic:nullifier-insertion"
      ]
    },
    {
      "id": "R-PAYOUT-BINDING",
      "statement": "Withdrawal creates exactly one fixed-position token-free payout of one ticket to the statement lock; deposit creates none.",
      "enforcedBy": [
        "state settlement covenant",
        "whole-transaction BCH consensus and policy"
      ],
      "mutationIds": [
        "vector:transaction:payout-lock",
        "vector:transaction:payout-value",
        "vector:transaction:deposit-payout"
      ]
    },
    {
      "id": "R-FEE-BINDING",
      "statement": "Exactly one final token-free external input funds the transparent fee and optional final change under an immutable fee cap.",
      "enforcedBy": [
        "state settlement covenant",
        "external funding-input authorization",
        "whole-transaction BCH consensus and policy"
      ],
      "mutationIds": [
        "vector:transaction:fee-input",
        "vector:transaction:funding-sighash-mode",
        "vector:transaction:fee-change",
        "vector:transaction:fee-cap"
      ]
    },
    {
      "id": "R-CONTEXT-BINDING",
      "statement": "All non-circular transaction sources, fields, roles, ordering, outputs, and token data are in the canonical context digest.",
      "enforcedBy": [
        "Circle-FRI verifier carriers",
        "state settlement covenant",
        "qualification and provenance harness"
      ],
      "mutationIds": [
        "vector:transaction:input-order",
        "vector:transaction:statement-context-disagreement",
        "vector:transaction:output-order",
        "vector:transaction:extra-input",
        "vector:transaction:extra-output",
        "vector:transaction:sequence",
        "vector:transaction:state-outpoint"
      ]
    },
    {
      "id": "R-CARRIER-LIFECYCLE",
      "statement": "Every fixed verifier role consumes output i+1 from the same predecessor transaction as state output zero and creates its exact persistent successor in the next atomic bundle without a warehouse or replenisher.",
      "enforcedBy": [
        "Circle-FRI verifier carriers",
        "state settlement covenant",
        "whole-transaction BCH consensus and policy"
      ],
      "mutationIds": [
        "vector:topology:carrier-predecessor-bundle",
        "vector:topology:carrier-zero",
        "vector:topology:carrier-omit",
        "vector:topology:carrier-substitute",
        "vector:topology:carrier-cross-splice",
        "vector:topology:carrier-successor"
      ]
    },
    {
      "id": "R-PROOF-SESSION",
      "statement": "All carrier inputs verify one security profile, statement, transcript/proof session, and unique exhaustive section schedule.",
      "enforcedBy": [
        "Circle-FRI verifier carriers"
      ],
      "mutationIds": [
        "vector:proof:section-duplicate",
        "vector:proof:section-omit",
        "vector:proof:session-cross-splice"
      ]
    },
    {
      "id": "R-CANONICAL-PARSER",
      "statement": "Every state, field, extension, point, transcript, proof, role, and length encoding has one fully consumed representation.",
      "enforcedBy": [
        "PoolStateFv1 codec",
        "Circle-FRI verifier carriers",
        "state settlement covenant",
        "qualification and provenance harness"
      ],
      "mutationIds": [
        "vector:parser:trailing-bytes",
        "vector:parser:field-noncanonical",
        "vector:parser:off-circle",
        "vector:parser:length-alias"
      ]
    },
    {
      "id": "R-SOUNDNESS",
      "statement": "AIR, Circle-FRI, Fiat-Shamir, hash, challenge, field, and union-bound terms jointly meet the selected systemic target.",
      "enforcedBy": [
        "Circle-FRI verifier carriers",
        "qualification and provenance harness"
      ],
      "mutationIds": [
        "vector:proof:byte-flip",
        "vector:proof:fri-fold",
        "vector:proof:final-polynomial"
      ]
    },
    {
      "id": "R-ZERO-KNOWLEDGE",
      "statement": "Fresh masks hide every private witness observation through commitments, composition, openings, folding, and repeated proofs.",
      "enforcedBy": [
        "Circle-FRI AIR",
        "qualification and provenance harness"
      ],
      "mutationIds": [
        "vector:zk:mask-omit",
        "vector:zk:mask-reuse",
        "vector:zk:fold-leakage"
      ]
    },
    {
      "id": "R-RECOVERY-LIVENESS",
      "statement": "Wallets reconstruct from public state, preserve private backups, discard stale proofs, and retry races/reorgs without a coordinator.",
      "enforcedBy": [
        "wallet construction and recovery FSM",
        "qualification and provenance harness"
      ],
      "mutationIds": [
        "vector:recovery:stale-tip",
        "vector:recovery:crash-after-proof",
        "vector:recovery:reorg",
        "vector:liveness:race-storm",
        "vector:liveness:carrier-exhaustion",
        "vector:liveness:accumulator-capacity",
        "vector:liveness:mempool-eviction"
      ]
    },
    {
      "id": "R-EVIDENCE-SCOPE",
      "statement": "Only exact PoolActionFv1, current-profile, content-pinned, complete-transaction evidence may support qualification or selection.",
      "enforcedBy": [
        "qualification and provenance harness"
      ],
      "mutationIds": [
        "vector:proof:wrong-relation",
        "vector:proof:wrong-security-profile",
        "vector:proof:evidence-estimate-as-measured",
        "vector:proof:evidence-dirty-unpinned",
        "vector:zk:pq-claim-proof-only",
        "vector:zk:pq-claim-fee-signature",
        "vector:zk:pq-claim-wallet-storage"
      ]
    }
  ]
}
