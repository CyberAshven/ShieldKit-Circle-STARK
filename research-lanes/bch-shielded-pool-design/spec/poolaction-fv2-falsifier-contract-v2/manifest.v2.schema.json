{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"shieldkit-labs/poolaction-fv2/falsifier-contract/manifest/v2",
  "type":"object",
  "additionalProperties":false,
  "required":["packageId","schema","status","authority","fileCount","files","checksumFile","checksumRule","materializedVariantCount","executedVariantCount"],
  "properties":{
    "packageId":{"const":"spec:poolaction-fv2-falsifier-contract-v2"},
    "schema":{"const":"shieldkit-labs/poolaction-fv2/falsifier-contract/manifest/v2"},
    "status":{"const":"CONTRACT_SOURCE_PINNED_NO_EXECUTION"},
    "authority":{"const":"bounded-contract-only"},
    "fileCount":{"const":8},
    "files":{"type":"array","const":["README.md","contract.v2.json","contract.v2.schema.json","manifest.v2.schema.json","source-pins.v2.json","source-pins.v2.schema.json","validate.mjs","validate.test.mjs"]},
    "checksumFile":{"const":"SHA256SUMS"},
    "checksumRule":{"const":"SHA256SUMS covers every listed file and MANIFEST.json; it excludes itself"},
    "materializedVariantCount":{"const":0},
    "executedVariantCount":{"const":0}
  }
}
