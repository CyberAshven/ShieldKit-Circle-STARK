{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "additionalProperties":false,
  "required":["packageId","schema","status","authority","charter","retainedRoster","outsideReviewAnchor","supersededV1Charter","bchnSourceCommit","nonClaims","packageLocalEnvelope"],
  "properties":{
    "packageId":{"const":"spec:poolaction-fv2-falsifier-contract-v2"},
    "schema":{"const":"shieldkit-labs/poolaction-fv2/falsifier-contract/source-pins/v2"},
    "status":{"const":"CONTRACT_SOURCE_PINNED_NO_EXECUTION"},
    "authority":{"const":"bounded-contract-only"},
    "charter":{"$ref":"#/$defs/pin"},
    "retainedRoster":{"$ref":"#/$defs/pin"},
    "outsideReviewAnchor":{"$ref":"#/$defs/pin"},
    "supersededV1Charter":{"$ref":"#/$defs/pin"},
    "bchnSourceCommit":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "nonClaims":{"type":"array","minItems":1,"items":{"type":"string"}},
    "packageLocalEnvelope":{"type":"object","additionalProperties":false,"required":["manifest","checksums","checksumRule"],"properties":{"manifest":{"const":"MANIFEST.json"},"checksums":{"const":"SHA256SUMS"},"checksumRule":{"type":"string"}}}
  },
  "$defs":{"pin":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","minLength":1},"bytes":{"type":"integer","minimum":1},"lines":{"type":"integer","minimum":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"familyCount":{"type":"integer","minimum":1},"reviewedTranscription":{"type":"boolean"},"executionPerformed":{"type":"boolean"},"use":{"type":"string"}}}}
}
