{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/research-lanes/bch-shielded-pool-design/research/circle-fri-candidate-matrix.v2.schema.json",
  "title": "Circle-FRI prequalification component registry",
  "description": "Field-family prequalification records only. This schema cannot represent a candidate tuple or any exact Circle, DEEP, hash, or embedding descriptor; an additive future schema is required for those objects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "matrixId",
    "status",
    "registryKind",
    "tupleRepresentation",
    "relationRef",
    "profileRef",
    "environmentProfileRef",
    "legacyComponentMatrix",
    "sourcePins",
    "fieldSpecs",
    "circleDomains",
    "deepQuotients",
    "algebraicHashes",
    "outerHashChannels",
    "embeddings",
    "tuples",
    "legacyEvidenceBindings",
    "decisionPolicy"
  ],
  "properties": {
    "schema": {
      "const": "shieldkit-labs/circle-fri-candidate-matrix/v2"
    },
    "matrixId": {
      "const": "matrix:circle-fri-poolactionfv1-v2"
    },
    "status": {
      "const": "research-only-no-selection"
    },
    "registryKind": {
      "const": "prequalification-component-registry"
    },
    "tupleRepresentation": {
      "const": "unsupported-requires-additive-future-schema"
    },
    "relationRef": {
      "const": "relation:pool-action-fv1"
    },
    "profileRef": {
      "const": "profile:fixed-ticket-serial-pool"
    },
    "environmentProfileRef": {
      "const": "profile:bch-current-2026-08-08"
    },
    "legacyComponentMatrix": {
      "$ref": "#/$defs/legacyComponentMatrix"
    },
    "sourcePins": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/sourcePin" },
      "uniqueItems": true
    },
    "fieldSpecs": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": { "$ref": "#/$defs/fieldSpec" },
      "uniqueItems": true
    },
    "circleDomains": {
      "$ref": "#/$defs/unsupportedCompositionAxis"
    },
    "deepQuotients": {
      "$ref": "#/$defs/unsupportedCompositionAxis"
    },
    "algebraicHashes": {
      "$ref": "#/$defs/unsupportedCompositionAxis"
    },
    "outerHashChannels": {
      "$ref": "#/$defs/unsupportedCompositionAxis"
    },
    "embeddings": {
      "$ref": "#/$defs/unsupportedCompositionAxis"
    },
    "tuples": {
      "$ref": "#/$defs/unsupportedCompositionAxis"
    },
    "legacyEvidenceBindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/legacyEvidenceBinding" },
      "uniqueItems": true
    },
    "decisionPolicy": {
      "$ref": "#/$defs/decisionPolicy"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*){1,8}$"
    },
    "ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*){1,8}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "qualificationLabels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "casReview", "evidenceClassification", "selection"],
      "properties": {
        "status": { "const": "generic-math-unqualified" },
        "casReview": { "const": "not-cas-reviewed" },
        "evidenceClassification": { "const": "not-evidence" },
        "selection": { "const": "none" }
      }
    },
    "sourcePin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "path", "sha256", "kind", "role"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/ref" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "kind": {
          "enum": ["research-contract", "generic-math-certificate-fixture"]
        },
        "role": {
          "enum": [
            "prequalification-registry-boundary-no-selection",
            "mersenne-primality-and-rejection-checks-no-selection",
            "m89-d2-rabin-irreducibility-check-no-selection"
          ]
        },
        "qualification": { "$ref": "#/$defs/qualificationLabels" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": { "const": "generic-math-certificate-fixture" }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "qualification": { "$ref": "#/$defs/qualificationLabels" }
            },
            "required": ["qualification"]
          },
          "else": {
            "properties": {
              "qualification": false
            }
          }
        }
      ]
    },
    "legacyComponentMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schema", "matrixId", "sha256", "rowCount"],
      "properties": {
        "path": {
          "const": "research/circle-fri-candidate-matrix.v1.json"
        },
        "schema": {
          "const": "shieldkit-labs/circle-fri-candidate-matrix/v1"
        },
        "matrixId": {
          "const": "matrix:circle-fri-poolactionfv1"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "rowCount": {
          "const": 33
        }
      }
    },
    "fieldSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fieldSpecId",
        "kind",
        "freezingStatus",
        "evidenceState",
        "disposition",
        "mersenneExponent",
        "extensionDegree",
        "baseLimbBytes",
        "rawElementBytes",
        "legacyComponentRowRef",
        "exactAlgebraStatus",
        "encodingStatus",
        "description",
        "sourceRefs",
        "certificateRefs",
        "evidenceRefs"
      ],
      "properties": {
        "fieldSpecId": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": ["mersenne-family", "rejected-composite-control"]
        },
        "freezingStatus": {
          "enum": ["family-unfrozen", "killed"]
        },
        "evidenceState": {
          "enum": ["unmeasured", "measured-neutral-control", "eliminated"]
        },
        "disposition": {
          "enum": [
            "analytical-domain-control",
            "measured-base-control",
            "raw-capacity-control",
            "first-arithmetic-shortlist",
            "dormant-escalator",
            "killed"
          ]
        },
        "mersenneExponent": {
          "type": "integer",
          "minimum": 2
        },
        "extensionDegree": {
          "type": "integer",
          "minimum": 1
        },
        "baseLimbBytes": {
          "type": "integer",
          "minimum": 1
        },
        "rawElementBytes": {
          "type": "integer",
          "minimum": 1
        },
        "legacyComponentRowRef": {
          "anyOf": [
            { "$ref": "#/$defs/ref" },
            { "type": "null" }
          ]
        },
        "exactAlgebraStatus": {
          "enum": ["unfrozen", "base-arithmetic-measured-neutral", "not-applicable"]
        },
        "encodingStatus": {
          "enum": ["unfrozen", "implemented-neutral-control", "not-applicable"]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ref" },
          "uniqueItems": true
        },
        "certificateRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ref" },
          "uniqueItems": true
        },
        "evidenceRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ref" },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": { "const": "rejected-composite-control" }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "freezingStatus": { "const": "killed" },
              "evidenceState": { "const": "eliminated" },
              "disposition": { "const": "killed" },
              "exactAlgebraStatus": { "const": "not-applicable" },
              "encodingStatus": { "const": "not-applicable" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidenceState": { "const": "measured-neutral-control" }
            },
            "required": ["evidenceState"]
          },
          "then": {
            "properties": {
              "kind": { "const": "mersenne-family" },
              "freezingStatus": { "const": "family-unfrozen" },
              "disposition": { "const": "measured-base-control" },
              "exactAlgebraStatus": { "const": "base-arithmetic-measured-neutral" },
              "encodingStatus": { "const": "implemented-neutral-control" },
              "evidenceRefs": { "type": "array", "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidenceState": { "const": "unmeasured" }
            },
            "required": ["evidenceState"]
          },
          "then": {
            "properties": {
              "freezingStatus": { "const": "family-unfrozen" },
              "exactAlgebraStatus": { "const": "unfrozen" },
              "encodingStatus": { "const": "unfrozen" }
            }
          }
        }
      ]
    },
    "unsupportedCompositionAxis": {
      "type": "array",
      "maxItems": 0,
      "items": false
    },
    "legacyEvidenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingId",
        "evidencePath",
        "evidenceSha256",
        "candidateRowRef",
        "classification",
        "claimedRoles",
        "tupleRef",
        "scope",
        "notes"
      ],
      "properties": {
        "bindingId": { "$ref": "#/$defs/id" },
        "evidencePath": { "type": "string", "minLength": 1 },
        "evidenceSha256": { "$ref": "#/$defs/sha256" },
        "candidateRowRef": { "$ref": "#/$defs/ref" },
        "classification": { "const": "component-only-neutral-control" },
        "claimedRoles": {
          "type": "array",
          "maxItems": 0,
          "items": false
        },
        "tupleRef": { "type": "null" },
        "scope": { "type": "string", "minLength": 1 },
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "decisionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectionStatus", "selectionAuthority", "reason"],
      "properties": {
        "selectionStatus": { "const": "closed" },
        "selectionAuthority": { "const": "root-with-sol-review" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
