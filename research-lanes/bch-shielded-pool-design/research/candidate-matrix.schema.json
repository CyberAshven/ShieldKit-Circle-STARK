{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/research-lanes/bch-shielded-pool-design/research/candidate-matrix.schema.json",
  "title": "First-principles Circle-FRI candidate matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "matrixId",
    "status",
    "relationRef",
    "profileRef",
    "environmentProfileRef",
    "sourcePins",
    "hardTargets",
    "requiredAxes",
    "rows",
    "parameterSearchSpace",
    "decisionPolicy"
  ],
  "properties": {
    "schema": {
      "const": "shieldkit-labs/circle-fri-candidate-matrix/v1"
    },
    "matrixId": {
      "$ref": "#/$defs/id"
    },
    "status": {
      "const": "research-only-no-selection"
    },
    "relationRef": {
      "const": "relation:pool-action-fv1"
    },
    "profileRef": {
      "const": "profile:fixed-ticket-serial-pool"
    },
    "environmentProfileRef": {
      "const": "profile:bch-current-2026-08-08"
    },
    "sourcePins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourcePin"
      }
    },
    "hardTargets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticketSats",
        "targetSoundnessBits",
        "minimumFallbackBits",
        "completeTransactionLimitBytes",
        "withdrawalProvingLimitSeconds",
        "fallbackAuthorized"
      ],
      "properties": {
        "ticketSats": {
          "const": 10000000
        },
        "targetSoundnessBits": {
          "const": 128
        },
        "minimumFallbackBits": {
          "const": 100
        },
        "completeTransactionLimitBytes": {
          "const": 100000
        },
        "withdrawalProvingLimitSeconds": {
          "const": 60
        },
        "fallbackAuthorized": {
          "const": false
        }
      }
    },
    "requiredAxes": {
      "const": [
        "field-extension",
        "circle-domain",
        "hash-transcript",
        "zk-masking",
        "air",
        "fri",
        "nullifier-set",
        "authorization",
        "verifier-topology"
      ]
    },
    "rows": {
      "type": "array",
      "minItems": 9,
      "items": {
        "$ref": "#/$defs/row"
      }
    },
    "parameterSearchSpace": {
      "$ref": "#/$defs/parameterSearchSpace"
    },
    "decisionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectionAuthority",
        "selectionStatus",
        "requiredBeforeSelection",
        "fallbackRule",
        "componentEvidenceRule"
      ],
      "properties": {
        "selectionAuthority": {
          "const": "root-with-sol-review"
        },
        "selectionStatus": {
          "const": "closed"
        },
        "requiredBeforeSelection": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "fallbackRule": {
          "type": "string",
          "minLength": 1
        },
        "componentEvidenceRule": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*){1,7}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "sourcePin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "location",
        "pinStatus",
        "role"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "repository",
            "paper",
            "local-artifact",
            "tool-inventory",
            "environment"
          ]
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "dirty": {
          "type": "boolean"
        },
        "pinStatus": {
          "enum": [
            "commit-pinned",
            "content-pinned",
            "commit-and-content-pinned",
            "uri-only-blocking",
            "dirty-commit-control-only"
          ]
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "axis",
        "candidate",
        "status",
        "epistemicState",
        "description",
        "canonicalEncodingStatus",
        "assumptions",
        "dependencies",
        "requiredMeasurements",
        "pqClass",
        "cheapKillGate",
        "escalationCondition",
        "selection",
        "elimination"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "axis": {
          "enum": [
            "field-extension",
            "circle-domain",
            "hash-transcript",
            "zk-masking",
            "air",
            "fri",
            "nullifier-set",
            "authorization",
            "verifier-topology"
          ]
        },
        "candidate": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "unmeasured",
            "control-only",
            "blocked-source-pin",
            "killed",
            "measured-nonselected"
          ]
        },
        "epistemicState": {
          "enum": [
            "hypothesis",
            "derived-unmeasured",
            "source-supported-control",
            "measured",
            "eliminated"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "canonicalEncodingStatus": {
          "enum": [
            "unspecified",
            "specified-unimplemented",
            "implemented-unqualified",
            "qualified",
            "not-applicable"
          ]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "requiredMeasurements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "pqClass": {
          "enum": [
            "hash-oriented-unqualified",
            "algebraic-and-hash-assumptions",
            "classical-control",
            "not-applicable",
            "rejected"
          ]
        },
        "cheapKillGate": {
          "$ref": "#/$defs/killGate"
        },
        "escalationCondition": {
          "type": "string",
          "minLength": 1
        },
        "selection": {
          "const": false
        },
        "elimination": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reason",
                "evidenceRefs",
                "reopeningCondition"
              ],
              "properties": {
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "evidenceRefs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/id"
                  },
                  "uniqueItems": true
                },
                "reopeningCondition": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": {
              "status": { "const": "killed" }
            }
          },
          "then": {
            "properties": {
              "epistemicState": { "const": "eliminated" },
              "cheapKillGate": {
                "type": "object",
                "properties": {
                  "status": { "const": "fail" }
                }
              },
              "elimination": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "required": ["status"],
            "properties": {
              "status": { "const": "blocked-source-pin" }
            }
          },
          "then": {
            "properties": {
              "cheapKillGate": {
                "type": "object",
                "properties": {
                  "status": { "const": "blocked" }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["status"],
            "properties": {
              "status": { "const": "measured-nonselected" }
            }
          },
          "then": {
            "required": ["evidenceRefs"],
            "properties": {
              "epistemicState": { "const": "measured" },
              "canonicalEncodingStatus": {
                "enum": ["implemented-unqualified", "qualified", "not-applicable"]
              },
              "cheapKillGate": {
                "type": "object",
                "properties": {
                  "status": { "const": "pass" },
                  "evidenceRefs": {
                    "type": "array",
                    "minItems": 1
                  }
                }
              },
              "evidenceRefs": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "killGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "method",
        "passCriteria",
        "status",
        "evidenceRefs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "passCriteria": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "unrun",
            "pass",
            "fail",
            "blocked"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": {
              "status": { "enum": ["pass", "fail"] }
            }
          },
          "then": {
            "properties": {
              "evidenceRefs": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "parameterSearchSpace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseFields",
        "extensionDegrees",
        "foldArities",
        "blowups",
        "queries",
        "grindingBits",
        "finalChecks",
        "querySchedules",
        "deepSchedules",
        "concreteTupleRule"
      ],
      "properties": {
        "baseFields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "extensionDegrees": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "foldArities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              2,
              4,
              8
            ]
          },
          "uniqueItems": true
        },
        "blowups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 2
          },
          "uniqueItems": true
        },
        "queries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "grindingBits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        },
        "finalChecks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "querySchedules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "deepSchedules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "concreteTupleRule": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
