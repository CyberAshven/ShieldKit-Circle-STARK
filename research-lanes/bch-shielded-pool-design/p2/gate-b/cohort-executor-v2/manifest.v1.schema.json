{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shieldkit-labs/p2/gate-b/cohort-executor-v2/manifest.v1.schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "files", "schemaBinding", "contentDigest"],
  "properties": {
    "schema": {"const": "shieldkit-labs/p2/gate-b/cohort-executor-v2/manifest/v1"},
    "status": {"const": "authorized-unexecuted"},
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "schemaBinding": {"$ref": "#/$defs/file"},
    "contentDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "rawSha256", "contentDigest", "byteLength"], "properties": {"path": {"type": "string", "minLength": 1}, "rawSha256": {"$ref": "#/$defs/sha"}, "contentDigest": {"$ref": "#/$defs/sha"}, "byteLength": {"type": "integer", "minimum": 1}}},
    "digest": {"type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "domain", "frame", "value"], "properties": {"algorithm": {"const": "sha256"}, "canonicalization": {"const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"}, "domain": {"const": "shieldkit-labs/p2/gate-b/cohort-executor-v2/manifest/v1/root"}, "frame": {"const": "utf8(domain)||0x00||canonical-json-utf8"}, "value": {"$ref": "#/$defs/sha"}}}
  }
}
