{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shieldkit-labs/p2/gate-b/cohort-executor-v2/authorization.v2.schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "authorizationId", "status", "executionAllowed", "epochId", "contractBinding", "attempt", "schedule", "outputPolicy", "executorStartup", "engines", "runtime", "runtimeDependencyTrees", "leanBuildToolchain", "sourceBindings", "schemaBindings", "evidenceManifestSchema", "obligationAccounting", "ranking", "selection", "contentDigest"],
  "properties": {
    "schema": {"const": "shieldkit-labs/p2/gate-b/cohort-executor-v2/authorization/v2"},
    "authorizationId": {"const": "authorization:cohort-executor-v2:attempt-000"},
    "status": {"const": "authorized-unexecuted"},
    "executionAllowed": {"const": true},
    "epochId": {"const": "execution-epoch:gate-b-v2"},
    "contractBinding": {"$ref": "#/$defs/binding"},
    "attempt": {"type": "object", "additionalProperties": false, "required": ["index", "retries", "warmups"], "properties": {"index": {"const": 0}, "retries": {"const": 0}, "warmups": {"const": 0}}},
    "schedule": {"type": "object", "additionalProperties": false, "required": ["engineOrder", "batchCount", "batchSize", "timeoutMs", "maxBufferBytes", "maxConcurrency", "serial"], "properties": {"engineOrder": {"const": ["engine:native", "engine:libauth", "engine:bchn", "engine:leanbch"]}, "batchCount": {"const": 4}, "batchSize": {"const": 4732}, "timeoutMs": {"const": 600000}, "maxBufferBytes": {"const": 134217728}, "maxConcurrency": {"const": 1}, "serial": {"const": true}}},
    "outputPolicy": {"type": "object", "additionalProperties": false, "required": ["basePath", "baseRealpath", "exactOutputPath"], "properties": {"basePath": {"type": "string", "minLength": 1}, "baseRealpath": {"type": "string", "minLength": 1}, "exactOutputPath": {"type": "string", "minLength": 1}}},
    "executorStartup": {"type": "object", "additionalProperties": false, "required": ["environment", "policy", "argv"], "properties": {"environment": {"const": {"NODE_ENV": "production"}}, "policy": {"const": "env-i-exact-node-env-production"}, "argv": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 1}}}},
    "leanBuildToolchain": {"type": "object", "additionalProperties": false, "required": ["declaredToolchain", "commands", "commandsDigest", "hostDefaultPreflightDiagnostic"], "properties": {"declaredToolchain": {"const": "leanprover/lean4:v4.31.0"}, "commands": {"type": "array", "minItems": 2, "items": {"type": "object"}}, "commandsDigest": {"$ref": "#/$defs/sha"}, "hostDefaultPreflightDiagnostic": {"type": "object", "additionalProperties": false, "required": ["classification", "rawSha256"], "properties": {"classification": {"const": "host-default-diagnostic-not-build-toolchain-proof"}, "rawSha256": {"$ref": "#/$defs/sha"}}}}},
    "engines": {"type": "array", "prefixItems": [{"$ref": "#/$defs/engine"}, {"$ref": "#/$defs/engine"}, {"$ref": "#/$defs/engine"}, {"$ref": "#/$defs/engine"}], "items": false, "minItems": 4, "maxItems": 4},
    "runtime": {"type": "object", "additionalProperties": false, "required": ["nodeExecutable", "nodeExecutableRawSha256", "nodeExecutableByteLength", "nodeVersion", "platform", "arch", "runtimeDigest"], "properties": {"nodeExecutable": {"type": "string", "minLength": 1}, "nodeExecutableRawSha256": {"$ref": "#/$defs/sha"}, "nodeExecutableByteLength": {"type": "integer", "minimum": 1}, "nodeVersion": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"}, "platform": {"const": "linux"}, "arch": {"const": "x64"}, "runtimeDigest": {"$ref": "#/$defs/sha"}}},
    "runtimeDependencyTrees": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/runtimeTree"}},
    "sourceBindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/binding"}},
    "schemaBindings": {"type": "array", "minItems": 9, "items": {"$ref": "#/$defs/binding"}}, "evidenceManifestSchema": {"$ref": "#/$defs/binding"},
    "obligationAccounting": {"const": {"total": 18928, "preflightUnsupported": 496, "executable": 18432, "perEngine": 4732}},
    "ranking": {"type": "null"}, "selection": {"type": "null"},
    "contentDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {"type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "domain", "frame", "value"], "properties": {"algorithm": {"const": "sha256"}, "canonicalization": {"const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"}, "domain": {"const": "shieldkit-labs/p2/gate-b/cohort-executor-v2/authorization/v2/root"}, "frame": {"const": "utf8(domain)||0x00||canonical-json-utf8"}, "value": {"$ref": "#/$defs/sha"}}},
    "genericDigest": {"type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "domain", "frame", "value"], "properties": {"algorithm": {"const": "sha256"}, "canonicalization": {"const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"}, "domain": {"type": "string", "minLength": 1}, "frame": {"const": "utf8(domain)||0x00||canonical-json-utf8"}, "value": {"$ref": "#/$defs/sha"}}},
    "binding": {"type": "object", "additionalProperties": false, "required": ["path", "rawSha256", "contentDigest"], "properties": {"path": {"type": "string", "minLength": 1}, "rawSha256": {"$ref": "#/$defs/sha"}, "schemaPath": {"type": "string"}, "schemaSha256": {"$ref": "#/$defs/sha"}, "contentDigest": {"$ref": "#/$defs/sha"}, "byteLength": {"type": "integer", "minimum": 1}}},
    "entrypoint": {"type": "object", "additionalProperties": false, "required": ["realpath", "rawSha256", "byteLength"], "properties": {"realpath": {"type": "string", "minLength": 1}, "rawSha256": {"$ref": "#/$defs/sha"}, "byteLength": {"type": "integer", "minimum": 1}}},
    "regularFile": {"type": "object", "additionalProperties": false, "required": ["realpath", "rawSha256", "byteLength"], "properties": {"realpath": {"type": "string", "minLength": 1}, "rawSha256": {"$ref": "#/$defs/sha"}, "byteLength": {"type": "integer", "minimum": 1}}},
    "closure": {"type": "object", "additionalProperties": false, "required": ["root", "files", "closureDigest"], "properties": {"root": {"type": "string", "minLength": 1}, "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/regularFile"}}, "closureDigest": {"$ref": "#/$defs/genericDigest"}}},
    "runtimeTree": {"type": "object", "additionalProperties": false, "required": ["root", "files", "treeDigest"], "properties": {"root": {"type": "string", "minLength": 1}, "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/regularFile"}}, "treeDigest": {"$ref": "#/$defs/genericDigest"}}},
    "engine": {"type": "object", "additionalProperties": false, "required": ["engineId", "ordinal", "recordPath", "recordRawSha256", "recordContentDigest", "recordSchemaPath", "recordSchemaSha256", "entrypoint", "entrypointArgv", "secondaryEntrypoint", "secondaryEntrypointArgv", "kind", "cwd", "environment", "engineRuntime", "stdinCodec", "implementationDigest", "repositoryRoots", "sourceClosure", "closureClassification"], "properties": {"engineId": {"enum": ["engine:native", "engine:libauth", "engine:bchn", "engine:leanbch"]}, "ordinal": {"type": "integer", "minimum": 0, "maximum": 3}, "recordPath": {"type": "string"}, "recordRawSha256": {"$ref": "#/$defs/sha"}, "recordContentDigest": {"$ref": "#/$defs/sha"}, "recordSchemaPath": {"type": "string"}, "recordSchemaSha256": {"$ref": "#/$defs/sha"}, "entrypoint": {"$ref": "#/$defs/entrypoint"}, "entrypointArgv": {"type": "array", "items": {"type": "string"}}, "secondaryEntrypoint": {"anyOf": [{"$ref": "#/$defs/entrypoint"}, {"type": "null"}]}, "secondaryEntrypointArgv": {"anyOf": [{"type": "array", "items": {"type": "string"}}, {"type": "null"}]}, "kind": {"enum": ["module", "external"]}, "cwd": {"type": "string", "minLength": 1}, "environment": {"type": "object", "additionalProperties": {"type": "string"}}, "engineRuntime": {"type": "object"}, "stdinCodec": {"type": "string", "minLength": 1}, "implementationDigest": {"$ref": "#/$defs/sha"}, "repositoryRoots": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "sourceClosure": {"$ref": "#/$defs/closure"}, "closureClassification": {"type": "string", "minLength": 1}}}
  }
}
