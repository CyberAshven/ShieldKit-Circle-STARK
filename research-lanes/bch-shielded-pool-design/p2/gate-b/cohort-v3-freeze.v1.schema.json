{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-v3-freeze.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "freezeId", "status", "evidenceClassification", "executionAllowed", "metricsAllowed", "ranking", "selection", "packageRoots", "inherited", "contentDigest"],
  "properties": {
    "$schema": {"const": "https://shieldkit-labs.local/p2/gate-b/cohort-v3-freeze.v1.schema.json"},
    "schema": {"const": "shieldkit-labs/p2/gate-b/cohort-v3-freeze/v1"},
    "freezeId": {"const": "cohort-v3-freeze:execution-v3+executor-v3"},
    "status": {"const": "frozen-unexecuted"},
    "evidenceClassification": {"const": "contract-only-not-execution-evidence"},
    "executionAllowed": {"const": false},
    "metricsAllowed": {"const": false},
    "ranking": {"type": "null"},
    "selection": {"type": "null"},
    "packageRoots": {"type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [{"$ref": "#/$defs/packageRoot"}, {"$ref": "#/$defs/packageRoot"}, {"$ref": "#/$defs/packageRoot"}], "items": false},
    "inherited": {"$ref": "#/$defs/inherited"},
    "contentDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {"type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "domain", "frame", "value"], "properties": {"algorithm": {"const": "sha256"}, "canonicalization": {"const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"}, "domain": {"type": "string", "minLength": 1}, "frame": {"const": "utf8(domain)||0x00||canonical-json-utf8"}, "value": {"$ref": "#/$defs/sha"}}},
    "packageRoot": {"type": "object", "additionalProperties": false, "required": ["packageRoot", "manifestPath", "manifestRawSha256", "manifestByteLength", "manifestContentDigest", "manifestSchemaPath", "manifestSchemaRawSha256", "checksumsPath", "checksumsRawSha256", "checksumsByteLength", "listedPayloadCount", "status"], "properties": {"packageRoot": {"enum": ["research-lanes/bch-shielded-pool-design/p2/gate-b/cohort-execution-v3", "research-lanes/bch-shielded-pool-design/p2/gate-b/cohort-executor-v3", "research-lanes/bch-shielded-pool-design/p2/gate-b/cohort-commit-helper-v1"]}, "manifestPath": {"type": "string", "minLength": 1}, "manifestRawSha256": {"$ref": "#/$defs/sha"}, "manifestByteLength": {"type": "integer", "minimum": 1}, "manifestContentDigest": {"$ref": "#/$defs/digest"}, "manifestSchemaPath": {"type": "string", "minLength": 1}, "manifestSchemaRawSha256": {"$ref": "#/$defs/sha"}, "checksumsPath": {"type": "string", "minLength": 1}, "checksumsRawSha256": {"$ref": "#/$defs/sha"}, "checksumsByteLength": {"type": "integer", "minimum": 1}, "listedPayloadCount": {"type": "integer", "minimum": 1}, "status": {"enum": ["frozen-unexecuted", "static-unexecuted-no-authorization", "reproducible-local-build"]}}},
    "inheritedBinding": {"type": "object", "additionalProperties": false, "required": ["identity", "path", "rawSha256", "status"], "properties": {"identity": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "rawSha256": {"$ref": "#/$defs/sha"}, "status": {"type": "string", "minLength": 1}}},
    "inheritedRetry": {"type": "object", "additionalProperties": false, "required": ["identity", "path", "rawSha256", "contentDigest"], "properties": {"identity": {"const": "retry-wrapper:execution-epoch-gate-b-v2:attempt-001"}, "path": {"const": "research-lanes/bch-shielded-pool-design/p2/gate-b/cohort-retry-v1/attempt-001.retry-wrapper.v1.json"}, "rawSha256": {"$ref": "#/$defs/sha"}, "contentDigest": {"$ref": "#/$defs/digest"}}},
    "inheritedAccounting": {"type": "object", "additionalProperties": false, "required": ["identity", "rootPath", "rootRawSha256", "rootContentDigest", "manifestPath", "manifestRawSha256"], "properties": {"identity": {"const": "attempt-accounting:cohort-execution-v2:attempt-000:v1"}, "rootPath": {"const": "research-lanes/bch-shielded-pool-design/p2/gate-b/cohort-attempt-accounting-v1/attempt-accounting-root.v1.json"}, "rootRawSha256": {"$ref": "#/$defs/sha"}, "rootContentDigest": {"$ref": "#/$defs/digest"}, "manifestPath": {"const": "research-lanes/bch-shielded-pool-design/p2/gate-b/cohort-attempt-accounting-v1/attempt-manifest.v1.json"}, "manifestRawSha256": {"$ref": "#/$defs/sha"}}},
    "inherited": {"type": "object", "additionalProperties": false, "required": ["freezeV2", "retryV1", "accountingV1"], "properties": {"freezeV2": {"$ref": "#/$defs/inheritedBinding"}, "retryV1": {"$ref": "#/$defs/inheritedRetry"}, "accountingV1": {"$ref": "#/$defs/inheritedAccounting"}}}
  }
}
