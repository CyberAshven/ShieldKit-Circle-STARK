{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-executor-v3-snapshot-v1/snapshot.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "snapshotDigest", "valuesRootDigest", "values", "records", "runtime", "sourcePlans"],
  "properties": {
    "kind": {"const": "cohort-executor-v3-retained-byte-snapshot/v1"},
    "snapshotDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "valuesRootDigest": {"$ref": "#/$defs/digest"},
    "values": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtureRoster", "workItemRoster", "corpus", "epoch", "campaign", "sourceSet"],
      "properties": {"fixtureRoster": {}, "workItemRoster": {}, "corpus": {}, "epoch": {}, "campaign": {}, "sourceSet": {}}
    },
    "records": {
      "type": "object",
      "minProperties": 91,
      "maxProperties": 91,
      "additionalProperties": false,
      "required": ["authorityCatalog", "fixtureRoster", "workItemRoster", "corpus", "epoch", "campaign", "sourceSet"],
      "properties": {"authorityCatalog": {}, "fixtureRoster": {}, "workItemRoster": {}, "corpus": {}, "epoch": {}, "campaign": {}, "sourceSet": {}},
      "patternProperties": {"^plan-(?:hex|map):.+$": {}}
    },
    "sourcePlans": {
      "type": "array",
      "minItems": 42,
      "maxItems": 42,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["planId", "planOrder", "redeemBytes", "expectedOperandCount", "sourceMapDigest", "sourceSetBinding", "hexKey", "mapKey"],
        "properties": {
          "planId": {"type": "string", "minLength": 1},
          "planOrder": {"type": "integer", "minimum": 0, "maximum": 41},
          "redeemBytes": {},
          "expectedOperandCount": {"type": "integer", "minimum": 0},
          "sourceMapDigest": {"$ref": "#/$defs/digest"},
          "sourceSetBinding": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rootPath", "rootRawSha256", "contentDigest", "planIndexEntrySha256"],
            "properties": {
              "rootPath": {"type": "string", "minLength": 1},
              "rootRawSha256": {"$ref": "#/$defs/sha"},
              "contentDigest": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
              "planIndexEntrySha256": {"$ref": "#/$defs/sha"}
            }
          },
          "hexKey": {"type": "string", "minLength": 1},
          "mapKey": {"type": "string", "minLength": 1}
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["procSelfExe", "executable", "executableRealpath", "processExecPath", "executableIdentity", "rawSha256", "byteLength", "bytes", "stat", "descriptor", "version", "platform", "arch"],
      "properties": {
        "procSelfExe": {"const": "/proc/self/exe"},
        "executable": {"type": "string", "minLength": 1},
        "executableRealpath": {"type": "string", "minLength": 1},
        "processExecPath": {"type": "string", "minLength": 1},
        "executableIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["procSelfExe", "readlinkTarget", "realpath", "processExecPath"],
          "properties": {
            "procSelfExe": {"const": "/proc/self/exe"},
            "readlinkTarget": {"type": "string", "minLength": 1},
            "realpath": {"type": "string", "minLength": 1},
            "processExecPath": {"type": "string", "minLength": 1}
          }
        },
        "rawSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byteLength": {"type": "integer", "minimum": 1},
        "bytes": {},
        "stat": {"$ref": "#/$defs/stat"},
        "descriptor": {"$ref": "#/$defs/descriptor"},
        "version": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "arch": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "domain", "frame", "value"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "canonicalization": {"const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"},
        "domain": {"type": "string", "minLength": 1},
        "frame": {"const": "utf8(domain)||0x00||canonical-json-utf8"},
        "value": {"$ref": "#/$defs/sha"}
      }
    },
    "stat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dev", "ino", "mode", "uid", "gid", "nlink", "size"],
      "properties": {
        "dev": {"type": "integer"}, "ino": {"type": "integer"}, "mode": {"type": "integer"},
        "uid": {"type": "integer"}, "gid": {"type": "integer"}, "nlink": {"type": "integer"}, "size": {"type": "integer"}
      }
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "fd", "state", "before", "after", "receipt"],
      "properties": {
        "label": {"const": "/proc/self/exe"},
        "fd": {"type": "integer", "minimum": 0},
        "state": {"const": "open"},
        "before": {"$ref": "#/$defs/stat"},
        "after": {"$ref": "#/$defs/stat"},
        "receipt": {"type": "null"}
      }
    }
  }
}
