{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-executor-v3-snapshot-v1/authority-catalog.v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "status", "executionAllowed", "metricsAllowed", "counts", "frozen", "source", "plans", "corpusContentDigest", "fixtureRosterContentDigest", "workItemRosterContentDigest", "contentDigest"],
  "properties": {
    "schema": {"const": "shieldkit-labs/p2/gate-b/cohort-executor-v3-snapshot-v1/authority-catalog/v1"},
    "status": {"const": "retained-byte-input-catalog"}, "executionAllowed": {"const": false}, "metricsAllowed": {"const": false},
    "counts": {"type": "object", "additionalProperties": false, "required": ["fixtures", "corpusCases", "workItems", "sourcePlans", "preflightFixtures", "eligiblePerEngine"], "properties": {"fixtures": {"const": 4732}, "corpusCases": {"const": 1288}, "workItems": {"const": 18928}, "sourcePlans": {"const": 42}, "preflightFixtures": {"const": 124}, "eligiblePerEngine": {"const": 4608}}},
    "frozen": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/binding"}}, "source": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/binding"}},
    "plans": {"type": "array", "minItems": 42, "maxItems": 42, "items": {"type": "object", "additionalProperties": false, "required": ["planId", "orderIndex", "hex", "map", "expectedOperandCount"], "properties": {"planId": {"type": "string"}, "orderIndex": {"type": "integer", "minimum": 0}, "hex": {"$ref": "#/$defs/planByte"}, "map": {"$ref": "#/$defs/binding"}, "expectedOperandCount": {"type": "integer", "minimum": 0}}}},
    "corpusContentDigest": {"$ref": "#/$defs/digest"}, "fixtureRosterContentDigest": {"$ref": "#/$defs/digest"}, "workItemRosterContentDigest": {"$ref": "#/$defs/digest"}, "contentDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {"type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "domain", "frame", "value"], "properties": {"algorithm": {"const": "sha256"}, "canonicalization": {"const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"}, "domain": {"type": "string", "minLength": 1}, "frame": {"const": "utf8(domain)||0x00||canonical-json-utf8"}, "value": {"$ref": "#/$defs/sha"}}},
    "binding": {"type": "object", "additionalProperties": false, "required": ["path", "rawSha256", "byteLength", "contentDigest"], "properties": {"path": {"type": "string"}, "rawSha256": {"$ref": "#/$defs/sha"}, "byteLength": {"type": "integer", "minimum": 0}, "contentDigest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]} }},
    "planByte": {"type": "object", "additionalProperties": false, "required": ["path", "rawSha256", "byteLength", "bytecodeSha256", "bytecodeBytes"], "properties": {"path": {"type": "string"}, "rawSha256": {"$ref": "#/$defs/sha"}, "byteLength": {"type": "integer", "minimum": 1}, "bytecodeSha256": {"$ref": "#/$defs/sha"}, "bytecodeBytes": {"type": "integer", "minimum": 1}}}
  }
}
