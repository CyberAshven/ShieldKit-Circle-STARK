{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-executor-v3-snapshot-v1/capture.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshotKind", "snapshotDigest", "endpoints"],
  "properties": {
    "snapshotKind": {"const": "cohort-executor-v3-retained-byte-snapshot/v1"},
    "snapshotDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "endpoints": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["endpointOrdinal", "engineId", "endpointRole", "stdin", "stdout", "stderr", "outcome", "checkpoints"],
        "properties": {
          "endpointOrdinal": {"type": "integer", "minimum": 0, "maximum": 4},
          "engineId": {"enum": ["engine:native", "engine:libauth", "engine:bchn", "engine:leanbch"]},
          "endpointRole": {"enum": ["primary", "secondary"]},
          "stdin": {"$ref": "#/$defs/stream"},
          "stdout": {"$ref": "#/$defs/stream"},
          "stderr": {"$ref": "#/$defs/stream"},
          "outcome": {
            "type": "object",
            "additionalProperties": false,
            "required": ["captureClosed"],
            "properties": {"captureClosed": {"const": true}}
          },
          "checkpoints": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/checkpoint"}}
        }
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dev", "ino", "mode", "uid", "gid", "nlink", "size"],
      "properties": {
        "dev": {"type": "integer", "minimum": 0}, "ino": {"type": "integer", "minimum": 0}, "mode": {"type": "integer", "minimum": 0},
        "uid": {"type": "integer", "minimum": 0}, "gid": {"type": "integer", "minimum": 0}, "nlink": {"type": "integer", "minimum": 1}, "size": {"type": "integer", "minimum": 0}
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "bytes", "byteLength", "rawSha256", "fsynced", "stat"],
      "properties": {
        "role": {"enum": ["stdin", "stdout", "stderr"]},
        "bytes": {},
        "byteLength": {"type": "integer", "minimum": 0},
        "rawSha256": {"$ref": "#/$defs/sha"},
        "fsynced": {"const": true},
        "stat": {"$ref": "#/$defs/stat"}
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "event", "monotonicNanoseconds", "stream", "stat"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "event": {"enum": ["stdin-opened", "stdin-fsynced", "spawn-observed", "stdout-fsynced", "stderr-fsynced", "close-observed", "capture-sealed"]},
        "monotonicNanoseconds": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)$"},
        "stream": {"enum": ["stdin", "stdout", "stderr", "endpoint"]},
        "stat": {"anyOf": [{"$ref": "#/$defs/stat"}, {"type": "null"}]}
      }
    }
  }
}
