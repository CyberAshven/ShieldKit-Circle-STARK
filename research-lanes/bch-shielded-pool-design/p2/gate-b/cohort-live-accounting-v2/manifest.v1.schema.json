{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-live-accounting-v2/manifest.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "manifestId", "status", "evidenceClassification", "executionAllowed", "metricsAllowed", "ranking", "selection", "coverage", "files", "contentDigest"],
  "properties": {
    "schema": {"const": "shieldkit-labs/p2/gate-b/cohort-live-accounting-v2/package-manifest/v1"},
    "manifestId": {"const": "manifest:cohort-live-accounting-v2-package"},
    "status": {"const": "authority-neutral-schema-only"},
    "evidenceClassification": {"const": "failure-recovery-grammar-not-execution-evidence"},
    "executionAllowed": {"const": false}, "metricsAllowed": {"const": false}, "ranking": {"type": "null"}, "selection": {"type": "null"},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["packageRoot", "listedPayloadCount", "selfManifestExcluded", "checksumsExcluded", "symlinksForbidden"], "properties": {"packageRoot": {"const": "research-lanes/bch-shielded-pool-design/p2/gate-b/cohort-live-accounting-v2"}, "listedPayloadCount": {"type": "integer", "minimum": 1}, "selfManifestExcluded": {"const": true}, "checksumsExcluded": {"const": true}, "symlinksForbidden": {"const": true}}},
    "files": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "rawSha256", "byteLength"], "properties": {"path": {"type": "string", "pattern": "^research-lanes/bch-shielded-pool-design/p2/gate-b/cohort-live-accounting-v2/[A-Za-z0-9._/-]+$"}, "rawSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "byteLength": {"type": "integer", "minimum": 0}}}},
    "contentDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "domain", "frame", "value"], "properties": {"algorithm": {"const": "sha256"}, "canonicalization": {"const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"}, "domain": {"const": "shieldkit-labs/p2/gate-b/cohort-live-accounting-v2/package-manifest/root"}, "frame": {"const": "utf8(domain)||0x00||canonical-json-utf8"}, "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
}
