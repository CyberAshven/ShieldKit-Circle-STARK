{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-live-accounting-v2/checkpoint-manifest.v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "manifestId", "attemptIndex", "checkpointBindings", "streamBindings", "contentDigest"],
  "properties": {
    "schema": {"const": "shieldkit-labs/p2/gate-b/cohort-live-accounting-v2/checkpoint-manifest/v2"},
    "manifestId": {"const": "checkpoint-manifest:execution-epoch-gate-b-v2:attempt-001:v2"},
    "attemptIndex": {"const": 1},
    "checkpointBindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/binding"}},
    "streamBindings": {"type": "array", "items": {"$ref": "#/$defs/streamBinding"}},
    "contentDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {"type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "domain", "frame", "value"], "properties": {"algorithm": {"const": "sha256"}, "canonicalization": {"const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"}, "domain": {"type": "string", "minLength": 1}, "frame": {"const": "utf8(domain)||0x00||canonical-json-utf8"}, "value": {"$ref": "#/$defs/sha"}}},
    "binding": {"type": "object", "additionalProperties": false, "required": ["path", "rawSha256", "byteLength", "contentDigest"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"}, "rawSha256": {"$ref": "#/$defs/sha"}, "byteLength": {"type": "integer", "minimum": 0}, "contentDigest": {"$ref": "#/$defs/digest"}}},
    "streamBinding": {"type": "object", "additionalProperties": false, "required": ["endpointOrdinal", "streamRole", "path", "rawSha256", "byteLength", "captureStatus", "fsynced"], "properties": {"endpointOrdinal": {"type": "integer", "minimum": 0, "maximum": 4}, "streamRole": {"enum": ["stdin", "stdout", "stderr"]}, "path": {"type": "string", "pattern": "^streams/[A-Za-z0-9._/-]+$"}, "rawSha256": {"$ref": "#/$defs/sha"}, "byteLength": {"type": "integer", "minimum": 0}, "captureStatus": {"enum": ["complete", "partial"]}, "fsynced": {"const": true}}}
  }
}
