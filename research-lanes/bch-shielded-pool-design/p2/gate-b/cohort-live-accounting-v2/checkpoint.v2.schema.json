{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-live-accounting-v2/checkpoint.v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "checkpointId", "attemptIndex", "ordinal", "event", "previousCheckpointDigest", "contentDigest"],
  "properties": {
    "schema": {"const": "shieldkit-labs/p2/gate-b/cohort-live-accounting-v2/checkpoint/v2"},
    "checkpointId": {"type": "string", "pattern": "^checkpoint:attempt-001:[0-9]+$"},
    "attemptIndex": {"const": 1},
    "ordinal": {"type": "integer", "minimum": 0},
    "event": {"$ref": "#/$defs/event"},
    "previousCheckpointDigest": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "contentDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {"type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "domain", "frame", "value"], "properties": {"algorithm": {"const": "sha256"}, "canonicalization": {"const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"}, "domain": {"type": "string", "minLength": 1}, "frame": {"const": "utf8(domain)||0x00||canonical-json-utf8"}, "value": {"$ref": "#/$defs/sha"}}},
    "streamSlot": {"type": "object", "additionalProperties": false, "required": ["streamRole", "captureStatus", "path", "rawSha256", "byteLength", "fsynced"], "properties": {"streamRole": {"enum": ["stdin", "stdout", "stderr"]}, "captureStatus": {"enum": ["complete", "partial", "unavailable"]}, "path": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^streams/[A-Za-z0-9._/-]+$"}]}, "rawSha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]}, "byteLength": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]}, "fsynced": {"type": "boolean"}}},
    "modulePrefix": {"type": "object", "additionalProperties": false, "required": ["completedRowCount", "completedLfByteLength", "completedLfRawSha256", "trailingFragmentByteLength", "trailingFragmentRawSha256"], "properties": {"completedRowCount": {"type": "integer", "minimum": 0}, "completedLfByteLength": {"type": "integer", "minimum": 0}, "completedLfRawSha256": {"$ref": "#/$defs/sha"}, "trailingFragmentByteLength": {"type": "integer", "minimum": 0}, "trailingFragmentRawSha256": {"$ref": "#/$defs/sha"}}},
    "capture": {"type": "object", "additionalProperties": false, "required": ["endpointKind", "slots", "modulePrefix"], "properties": {"endpointKind": {"enum": ["module-ndjson", "external-process"]}, "slots": {"type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [{"$ref": "#/$defs/streamSlot"}, {"$ref": "#/$defs/streamSlot"}, {"$ref": "#/$defs/streamSlot"}], "items": false}, "modulePrefix": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/modulePrefix"}]}}},
    "event": {"type": "object", "additionalProperties": false, "required": ["phase", "kind", "endpointOrdinal", "endpointId", "endpointKind", "controllerFailureKind", "capture"], "properties": {"phase": {"enum": ["controller", "endpoint", "recovery"]}, "kind": {"enum": ["controller-before-endpoint", "controller-between-endpoints", "controller-after-endpoint", "abrupt-before-start", "abrupt-module-death", "external-terminal", "module-terminal", "recovery-sealed"]}, "endpointOrdinal": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 0, "maximum": 4}]}, "endpointId": {"anyOf": [{"type": "null"}, {"type": "string"}]}, "endpointKind": {"anyOf": [{"type": "null"}, {"enum": ["module-ndjson", "external-process"]}]}, "controllerFailureKind": {"anyOf": [{"type": "null"}, {"enum": ["builder", "materializer", "validator", "commit", "recovery"]}]}, "capture": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/capture"}]}}}
  }
}
