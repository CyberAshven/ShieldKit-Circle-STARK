{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-live-accounting-v2/live-failure.v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "failureId", "attemptIndex", "status", "executionAllowed", "metricsAllowed", "ranking", "selection", "resultReuse", "endpointOrder", "completedEndpointPrefix", "terminal", "selectedNotStarted", "authorizationCopy", "claimCopy", "checkpointManifestBinding", "recovery", "contentDigest"],
  "properties": {
    "schema": {"const": "shieldkit-labs/p2/gate-b/cohort-live-accounting-v2/live-failure/v2"},
    "failureId": {"const": "live-failure:execution-epoch-gate-b-v2:attempt-001:v2"},
    "attemptIndex": {"const": 1},
    "status": {"const": "sealed-live-failure-recovery-only"},
    "executionAllowed": {"const": false},
    "metricsAllowed": {"const": false},
    "ranking": {"type": "null"},
    "selection": {"type": "null"},
    "resultReuse": {"type": "null"},
    "endpointOrder": {"$ref": "#/$defs/endpointOrder"},
    "completedEndpointPrefix": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 4}, "uniqueItems": true},
    "terminal": {"$ref": "#/$defs/terminal"},
    "selectedNotStarted": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 4}, "uniqueItems": true},
    "authorizationCopy": {"$ref": "#/$defs/authorizationCopyPair"},
    "claimCopy": {"$ref": "#/$defs/claimCopyPair"},
    "checkpointManifestBinding": {"$ref": "#/$defs/binding"},
    "recovery": {"$ref": "#/$defs/recovery"},
    "contentDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {"type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "domain", "frame", "value"], "properties": {"algorithm": {"const": "sha256"}, "canonicalization": {"const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"}, "domain": {"type": "string", "minLength": 1}, "frame": {"const": "utf8(domain)||0x00||canonical-json-utf8"}, "value": {"$ref": "#/$defs/sha"}}},
    "binding": {"type": "object", "additionalProperties": false, "required": ["path", "rawSha256", "byteLength", "contentDigest"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"}, "rawSha256": {"$ref": "#/$defs/sha"}, "byteLength": {"type": "integer", "minimum": 0}, "contentDigest": {"$ref": "#/$defs/digest"}}},
    "authorizationDigest": {"type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "domain", "frame", "value"], "properties": {"algorithm": {"const": "sha256"}, "canonicalization": {"const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"}, "domain": {"const": "shieldkit-labs/p2/gate-b/cohort-executor-v3/authorization/v3/root"}, "frame": {"const": "utf8(domain)||0x00||canonical-json-utf8"}, "value": {"$ref": "#/$defs/sha"}}},
    "claimDigest": {"type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "domain", "frame", "value"], "properties": {"algorithm": {"const": "sha256"}, "canonicalization": {"const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"}, "domain": {"const": "shieldkit-labs/p2/gate-b/cohort-executor-v3/execution-claim/v3/root"}, "frame": {"const": "utf8(domain)||0x00||canonical-json-utf8"}, "value": {"$ref": "#/$defs/sha"}}},
    "authorizationBinding": {"type": "object", "additionalProperties": false, "required": ["path", "rawSha256", "byteLength", "contentDigest"], "properties": {"path": {"const": "authorization.copy.json"}, "rawSha256": {"$ref": "#/$defs/sha"}, "byteLength": {"type": "integer", "minimum": 0}, "contentDigest": {"$ref": "#/$defs/authorizationDigest"}}},
    "claimBinding": {"type": "object", "additionalProperties": false, "required": ["path", "rawSha256", "byteLength", "contentDigest"], "properties": {"path": {"const": "execution-claim.copy.json"}, "rawSha256": {"$ref": "#/$defs/sha"}, "byteLength": {"type": "integer", "minimum": 0}, "contentDigest": {"$ref": "#/$defs/claimDigest"}}},
    "authorizationCopyPair": {"type": "object", "additionalProperties": false, "required": ["copyBinding", "authorityBinding"], "properties": {"copyBinding": {"$ref": "#/$defs/authorizationBinding"}, "authorityBinding": {"$ref": "#/$defs/authorizationBinding"}}},
    "claimCopyPair": {"type": "object", "additionalProperties": false, "required": ["copyBinding", "authorityBinding"], "properties": {"copyBinding": {"$ref": "#/$defs/claimBinding"}, "authorityBinding": {"$ref": "#/$defs/claimBinding"}}},
    "endpointOrder": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "string"}, "prefixItems": [{"const": "engine:native/primary"}, {"const": "engine:libauth/primary"}, {"const": "engine:bchn/primary"}, {"const": "engine:leanbch/primary"}, {"const": "engine:leanbch/secondary"}], "items": false},
    "terminal": {"type": "object", "additionalProperties": false, "required": ["phase", "failureKind", "endpointOrdinal"], "properties": {"phase": {"enum": ["controller-before-endpoint", "controller-between-endpoints", "controller-after-endpoint", "abrupt-before-start", "abrupt-module-death", "endpoint-failure"]}, "failureKind": {"enum": ["builder", "materializer", "validator", "commit", "recovery", "external-process", "module-error", "abrupt-before-start", "abrupt-module-death"]}, "endpointOrdinal": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 0, "maximum": 4}]}}},
    "recovery": {"type": "object", "additionalProperties": false, "required": ["disposition", "endpointReinvoked", "reusable", "resultReuse", "recoverySealed"], "properties": {"disposition": {"enum": ["sealed-no-endpoint", "sealed-before-start", "sealed-partial-prefix", "sealed-after-terminal"]}, "endpointReinvoked": {"const": false}, "reusable": {"const": false}, "resultReuse": {"type": "null"}, "recoverySealed": {"const": true}}}
  }
}
