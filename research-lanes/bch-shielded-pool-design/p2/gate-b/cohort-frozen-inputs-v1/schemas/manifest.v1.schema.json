{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://shieldkit-labs.local/p2/gate-b/cohort-frozen-inputs/v1/manifest.v1.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":["contentDigest","directories","directoryCount","executionAllowed","fileCount","files","manifestRosterDigest","packageRoot","schema","status"],
  "properties":{
    "contentDigest":{"$ref":"#/$defs/manifestDigest"},
    "directories":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["mode","path"],"properties":{"mode":{"const":493},"path":{"type":"string"}}}},
    "directoryCount":{"const":3},
    "executionAllowed":{"const":false},
    "fileCount":{"type":"integer","minimum":1},
    "files":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/file"}},
    "manifestRosterDigest":{"$ref":"#/$defs/rosterDigest"},
    "packageRoot":{"const":"research-lanes/bch-shielded-pool-design/p2/gate-b/cohort-frozen-inputs-v1"},
    "schema":{"const":"shieldkit-labs/p2/gate-b/cohort-frozen-inputs/v1/manifest"},
    "status":{"const":"static-content-addressed"}
  },
  "$defs":{
    "hex":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "canonicalDigest":{"type":"object","additionalProperties":false,"required":["algorithm","canonicalization","domain","frame","value"],"properties":{"algorithm":{"const":"sha256"},"canonicalization":{"const":"recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"},"domain":{"type":"string"},"frame":{"type":"string"},"value":{"$ref":"#/$defs/hex"}}},
    "manifestDigest":{"allOf":[{"$ref":"#/$defs/canonicalDigest"},{"type":"object","properties":{"domain":{"const":"shieldkit-labs/p2/gate-b/cohort-frozen-inputs/v1/manifest"},"frame":{"const":"utf8(domain)||0x00||canonical-json-utf8-with-top-level-contentDigest-omitted"}}}]},
    "rosterDigest":{"allOf":[{"$ref":"#/$defs/canonicalDigest"},{"type":"object","properties":{"domain":{"const":"shieldkit-labs/p2/gate-b/cohort-frozen-inputs/v1/manifest-roster"},"frame":{"const":"utf8(domain)||0x00||canonical-json-roster-v1"}}}]},
    "rawFileDigest":{"type":"object","additionalProperties":false,"required":["algorithm","domain","frame","value"],"properties":{"algorithm":{"const":"sha256"},"domain":{"const":"shieldkit-labs/p2/gate-b/cohort-frozen-inputs/v1/file"},"frame":{"const":"utf8(domain)||0x00||raw-file-bytes"},"value":{"$ref":"#/$defs/hex"}}},
    "file":{"type":"object","additionalProperties":false,"required":["bytes","fileContentDigest","mode","path","rawSha256"],"properties":{"bytes":{"type":"integer","minimum":1},"fileContentDigest":{"$ref":"#/$defs/rawFileDigest"},"mode":{"const":420},"path":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^\\u0000]+$"},"rawSha256":{"$ref":"#/$defs/hex"}}}
  }
}
