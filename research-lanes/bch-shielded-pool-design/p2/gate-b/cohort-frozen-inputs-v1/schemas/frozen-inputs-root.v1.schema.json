{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://shieldkit-labs.local/p2/gate-b/cohort-frozen-inputs/v1/frozen-inputs-root.v1.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":["artifactId","classification","contentDigest","executionAllowed","leafClosure","packageId","schema","schemaBindings","status"],
  "properties":{
    "artifactId":{"const":"artifact:gate-b:cohort-frozen-inputs-v1"},
    "classification":{"type":"object","additionalProperties":false,"required":["buildTooling","runtimeAuthority"],"properties":{"buildTooling":{"const":"static-generator-validator-tests-outside-runtime-authority"},"runtimeAuthority":{"const":"empty"}}},
    "contentDigest":{"$ref":"#/$defs/rootDigest"},
    "executionAllowed":{"const":false},
    "leafClosure":{"type":"object","additionalProperties":false,"required":["leafCount","leaves"],"properties":{"leafCount":{"const":2},"leaves":{"type":"array","prefixItems":[{"oneOf":[{"$ref":"#/$defs/sourceLeaf"}]},{"oneOf":[{"$ref":"#/$defs/freezeLeaf"}]}],"items":false,"minItems":2,"maxItems":2}}},
    "packageId":{"const":"cohort-frozen-inputs-v1"},
    "schema":{"const":"shieldkit-labs/p2/gate-b/cohort-frozen-inputs/v1/root"},
    "schemaBindings":{"type":"array","prefixItems":[{"$ref":"#/$defs/file"},{"$ref":"#/$defs/file"}],"items":false,"minItems":2,"maxItems":2},
    "status":{"const":"static-content-addressed-frozen-inputs"}
  },
  "$defs":{
    "hex":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "canonicalDigest":{"type":"object","additionalProperties":false,"required":["algorithm","canonicalization","domain","frame","value"],"properties":{"algorithm":{"const":"sha256"},"canonicalization":{"const":"recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"},"domain":{"type":"string"},"frame":{"type":"string"},"value":{"$ref":"#/$defs/hex"}}},
    "rootDigest":{"allOf":[{"$ref":"#/$defs/canonicalDigest"},{"type":"object","properties":{"domain":{"const":"shieldkit-labs/p2/gate-b/cohort-frozen-inputs/v1/root"},"frame":{"const":"utf8(domain)||0x00||canonical-json-utf8-with-top-level-contentDigest-omitted"}}}]},
    "leafDigest":{"allOf":[{"$ref":"#/$defs/canonicalDigest"},{"type":"object","properties":{"frame":{"const":"utf8(domain)||0x00||canonical-json-utf8-with-top-level-leafDigest-omitted"}}}]},
    "rawFileDigest":{"type":"object","additionalProperties":false,"required":["algorithm","domain","frame","value"],"properties":{"algorithm":{"const":"sha256"},"domain":{"const":"shieldkit-labs/p2/gate-b/cohort-frozen-inputs/v1/file"},"frame":{"const":"utf8(domain)||0x00||raw-file-bytes"},"value":{"$ref":"#/$defs/hex"}}},
    "file":{"type":"object","additionalProperties":false,"required":["bytes","fileContentDigest","path","rawSha256"],"properties":{"bytes":{"type":"integer","minimum":1},"fileContentDigest":{"$ref":"#/$defs/rawFileDigest"},"path":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^\\u0000]+$"},"rawSha256":{"$ref":"#/$defs/hex"}}},
    "sourceLeaf":{"type":"object","additionalProperties":false,"required":["id","leafDigest","nativeSemanticDigest","packageRoot","wrapper"],"properties":{"id":{"const":"source-set-v1"},"leafDigest":{"$ref":"#/$defs/leafDigest"},"nativeSemanticDigest":{"allOf":[{"$ref":"#/$defs/canonicalDigest"},{"type":"object","properties":{"domain":{"const":"shieldkit-labs/p2/source-set/v1/root"},"frame":{"const":"utf8(domain)||0x00||canonical-json-utf8"},"value":{"const":"58e7765b066b1917b1fa0b4b96182010ad7f5c8ce8bce601c083bc764845482e"}}}]},"packageRoot":{"const":"research-lanes/bch-shielded-pool-design/p2/source-set-v1"},"wrapper":{"$ref":"#/$defs/wrapper"}}},
    "freezeLeaf":{"type":"object","additionalProperties":false,"required":["artifactSemanticDigest","id","leafDigest","packageRoot","wrapper"],"properties":{"artifactSemanticDigest":{"allOf":[{"$ref":"#/$defs/canonicalDigest"},{"type":"object","properties":{"domain":{"const":"shieldkit-labs/p2/gate-b/execution-epoch/v2/root"},"frame":{"const":"utf8(domain)||0x00||canonical-json-utf8"},"value":{"const":"6fcbaba3bb52d5e1eb9c6f1cb04b1d46cb65e2c91eba20ca38356dc323ebb11e"}}}]},"id":{"const":"cohort-freeze-v2"},"leafDigest":{"$ref":"#/$defs/leafDigest"},"packageRoot":{"const":"research-lanes/bch-shielded-pool-design/p2/gate-b/cohort-freeze-v2"},"wrapper":{"$ref":"#/$defs/wrapper"}}},
    "wrapper":{"type":"object","additionalProperties":false,"required":["manifest","root","sums"],"properties":{"manifest":{"$ref":"#/$defs/file"},"root":{"$ref":"#/$defs/file"},"sums":{"$ref":"#/$defs/file"}}}
  }
}
