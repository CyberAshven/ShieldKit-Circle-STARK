{
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-endpoint-modules/v1/endpoint-contract.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "required": [
    "abi",
    "canonicalOutput",
    "deadlineAndCap",
    "executionAllowed",
    "expectedCorpusValues",
    "isolation",
    "parser",
    "rowSet",
    "runtimeRef",
    "schema",
    "semanticExecutionPerformed",
    "stderrAuthority"
  ],
  "type": "object",
  "properties": {
    "abi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brandTransit", "controllerAdmission", "forbiddenWorkerRowKeys", "inputAuthority", "libauthInputKeys", "nativeInputKeys", "workerRowKeys"],
      "properties": {
        "brandTransit": {"const": "forbidden-across-structured-clone"},
        "controllerAdmission": {"const": "future-private-controller-WeakSet-AdmittedDispatch-only"},
        "forbiddenWorkerRowKeys": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string"}},
        "inputAuthority": {"const": "private-controller-admitted-row-projection"},
        "libauthInputKeys": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
        "nativeInputKeys": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string"}},
        "workerRowKeys": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"type": "string"}}
      }
    },
    "canonicalOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["emptyStderr", "exactRowKeys", "format", "lineTerminator", "outputCardinality", "rowVocabulary", "stdout"],
      "properties": {
        "emptyStderr": {"type": "object", "additionalProperties": false, "required": ["bytes", "sha256"], "properties": {"bytes": {"const": 0}, "sha256": {"const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"}}},
        "exactRowKeys": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "string"}},
        "format": {"const": "canonical-lf-ndjson-v1"},
        "lineTerminator": {"const": "LF"},
        "outputCardinality": {"const": 4608},
        "rowVocabulary": {"type": "object", "additionalProperties": false, "required": ["failureStage", "metrics", "phase", "terminalStatus", "txChecks", "verdict"], "properties": {"failureStage": {"type": "string"}, "metrics": {"type": "string"}, "phase": {"type": "object"}, "terminalStatus": {"const": "observed"}, "txChecks": {"const": "unsupported"}, "verdict": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}}}},
        "stdout": {"type": "string"}
      }
    },
    "deadlineAndCap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["combinedOutputCapBytes", "deadlineMilliseconds", "monotonicDeadline", "policyStatus"],
      "properties": {"combinedOutputCapBytes": {"const": 134217728}, "deadlineMilliseconds": {"const": 600000}, "monotonicDeadline": {"const": true}, "policyStatus": {"const": "future-isolation-policy-only"}}
    },
    "executionAllowed": {"const": false},
    "expectedCorpusValues": {"const": "forbidden"},
    "isolation": {"const": "worker-thread"},
    "parser": {"type": "string"},
    "rowSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cardinalityPerEndpoint", "controllerRule", "executionContract", "moduleBootstrap", "orderRoots", "repeatedCopyAndRehash", "resultAttributionTuple", "rowDigestDomain"],
      "properties": {
        "cardinalityPerEndpoint": {"const": 4608},
        "controllerRule": {"type": "string"},
        "executionContract": {"type": "object", "additionalProperties": false, "required": ["path", "rawSha256"], "properties": {"path": {"type": "string"}, "rawSha256": {"type": "string"}}},
        "moduleBootstrap": {"type": "string"},
        "orderRoots": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["endpoint", "endpointOrdinal", "value"], "properties": {"endpoint": {"type": "string"}, "endpointOrdinal": {"type": "integer"}, "value": {"type": "string"}}}},
        "repeatedCopyAndRehash": {"type": "string"},
        "resultAttributionTuple": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "string"}},
        "rowDigestDomain": {"type": "string"}
      }
    },
    "runtimeRef": {"const": "controller-node"},
    "schema": {"const": "shieldkit-labs/p2/gate-b/cohort-endpoint-modules/v1/endpoint-contract"},
    "semanticExecutionPerformed": {"const": false},
    "stderrAuthority": {"const": "empty-only-on-success"}
  }
}
