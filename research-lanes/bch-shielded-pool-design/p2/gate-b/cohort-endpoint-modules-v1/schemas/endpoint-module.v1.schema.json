{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-endpoint-modules/v1/endpoint-module.v1.schema.json",
  "additionalProperties": false,
  "required": [
    "dependencyClosure",
    "endpointId",
    "executionAllowed",
    "expectedCorpusValues",
    "export",
    "file",
    "inputAuthority",
    "isolation",
    "moduleMode",
    "runtimeRef",
    "schema",
    "semanticExecutionPerformed"
  ],
  "type": "object",
  "properties": {
    "dependencyClosure": {"type": "object"},
    "controller": {"type": "object"},
    "endpointId": {"enum": ["engine:native", "engine:libauth"]},
    "executionAllowed": {"const": false},
    "expectedCorpusValues": {"const": "forbidden"},
    "export": {"type": "string"},
    "file": {"type": "object"},
    "inputAuthority": {"const": "private-controller-admitted-row-projection"},
    "isolation": {"const": "worker-thread"},
    "moduleMode": {"type": "string"},
    "runtimeRef": {"const": "controller-node"},
    "schema": {"const": "shieldkit-labs/p2/gate-b/cohort-endpoint-modules/v1/endpoint-module"},
    "semanticExecutionPerformed": {"const": false},
    "vmContract": {"type": "object"}
  }
}
