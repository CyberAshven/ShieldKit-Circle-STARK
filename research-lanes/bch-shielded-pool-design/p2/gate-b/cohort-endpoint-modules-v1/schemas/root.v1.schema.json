{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-endpoint-modules/v1/root.v1.schema.json",
  "additionalProperties": false,
  "required": [
    "artifactId",
    "attempt",
    "authorization",
    "claim",
    "contentDigest",
    "cohort",
    "endpointContract",
    "endpoints",
    "evidence",
    "executionAllowed",
    "metrics",
    "packageId",
    "packageClosure",
    "ranking",
    "run",
    "schema",
    "schemaBindings",
    "selection",
    "semanticExecutionPerformed",
    "status",
    "tests"
  ],
  "type": "object",
  "properties": {
    "artifactId": {"const": "artifact:gate-b:cohort-endpoint-modules-v1"},
    "attempt": {"const": null},
    "authorization": {"const": null},
    "claim": {"const": null},
    "contentDigest": {"type": "object"},
    "cohort": {"type": "object"},
    "endpointContract": {"const": "endpoint-contract.v1.json"},
    "endpoints": {"type": "array", "minItems": 2, "maxItems": 2},
    "evidence": {"const": null},
    "executionAllowed": {"const": false},
    "metrics": {"const": null},
    "packageId": {"const": "cohort-endpoint-modules-v1"},
    "packageClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpointBindings", "envelopeRule", "manifest", "sha256sums", "validator"],
      "properties": {
        "endpointBindings": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["controller", "descriptor", "endpointId", "module"],
            "properties": {
              "controller": {
                "type": "object",
                "additionalProperties": false,
                "required": ["bytes", "contentDigest", "domain", "rawSha256", "startOffset"],
                "properties": {
                  "bytes": {"type": "integer"},
                  "contentDigest": {"type": "string"},
                  "domain": {"type": "string"},
                  "rawSha256": {"type": "string"},
                  "startOffset": {"type": "integer"}
                }
              },
              "descriptor": {
                "type": "object",
                "additionalProperties": false,
                "required": ["bytes", "path", "rawSha256"],
                "properties": {
                  "bytes": {"type": "integer"},
                  "path": {"type": "string"},
                  "rawSha256": {"type": "string"}
                }
              },
              "endpointId": {"type": "string"},
              "module": {
                "type": "object",
                "additionalProperties": false,
                "required": ["bytes", "contentDigest", "path", "rawSha256"],
                "properties": {
                  "bytes": {"type": "integer"},
                  "contentDigest": {"type": "string"},
                  "path": {"type": "string"},
                  "rawSha256": {"type": "string"}
                }
              }
            }
          }
        },
        "envelopeRule": {"type": "string"},
        "manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bytes", "contentDigest", "path", "rawSha256", "rosterDigest", "schemaRawSha256"],
          "properties": {
            "bytes": {"type": "integer"},
            "contentDigest": {
              "type": "object",
              "additionalProperties": false,
              "required": ["algorithm", "domain", "value"],
              "properties": {
                "algorithm": {"const": "sha256"},
                "domain": {"type": "string"},
                "value": {"type": "string"}
              }
            },
            "path": {"const": "MANIFEST.json"},
            "rawSha256": {"type": "string"},
            "rosterDigest": {
              "type": "object",
              "additionalProperties": false,
              "required": ["algorithm", "domain", "value"],
              "properties": {
                "algorithm": {"const": "sha256"},
                "domain": {"type": "string"},
                "value": {"type": "string"}
              }
            },
            "schemaRawSha256": {"type": "string"}
          }
        },
        "sha256sums": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bytes", "path", "rawSha256"],
          "properties": {
            "bytes": {"type": "integer"},
            "path": {"const": "SHA256SUMS"},
            "rawSha256": {"type": "string"}
          }
        },
        "validator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bytes", "contentDigest", "path", "rawSha256"],
          "properties": {
            "bytes": {"type": "integer"},
            "contentDigest": {"type": "string"},
            "path": {"const": "semantic-validator.mjs"},
            "rawSha256": {"type": "string"}
          }
        }
      }
    },
    "ranking": {"const": null},
    "run": {"const": null},
    "schema": {"const": "shieldkit-labs/p2/gate-b/cohort-endpoint-modules/v1/root"},
    "schemaBindings": {"type": "array", "minItems": 5, "maxItems": 5},
    "selection": {"const": null},
    "semanticExecutionPerformed": {"const": false},
    "status": {"const": "static-endpoint-modules-materialized-unexecuted"},
    "tests": {"type": "array"}
  }
}
