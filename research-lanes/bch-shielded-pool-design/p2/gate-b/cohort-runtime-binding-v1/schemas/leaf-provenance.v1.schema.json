{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-runtime-binding/v1/leaf-provenance.v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["leafId", "packageId", "packageRoot", "root", "schemaBindings", "manifest", "nativeManifest", "roster", "sums", "materialization", "records", "runtime"],
  "properties": {
    "leafId": {"const": "E"}, "packageId": {"const": "cohort-endpoint-modules-v1"}, "packageRoot": {"type": "string", "pattern": "^research-lanes/bch-shielded-pool-design/p2/gate-b/cohort-endpoint-modules-v1$"},
    "root": {"$ref": "#/$defs/fileBinding"}, "schemaBindings": {"type": "array", "prefixItems": [{"$ref": "#/$defs/schemaBinding"}, {"$ref": "#/$defs/schemaBinding"}, {"$ref": "#/$defs/schemaBinding"}, {"$ref": "#/$defs/schemaBinding"}, {"$ref": "#/$defs/schemaBinding"}], "items": false, "minItems": 5, "maxItems": 5}, "manifest": {"$ref": "#/$defs/fileBinding"}, "nativeManifest": {"$ref": "#/$defs/nativeManifest"}, "roster": {"$ref": "#/$defs/roster"}, "sums": {"$ref": "#/$defs/rawBinding"}, "materialization": {"$ref": "#/$defs/fileBinding"}, "records": {"type": "array", "prefixItems": [{"$ref": "#/$defs/record"}, {"$ref": "#/$defs/record"}, {"$ref": "#/$defs/record"}, {"$ref": "#/$defs/record"}, {"$ref": "#/$defs/record"}, {"$ref": "#/$defs/record"}], "items": false, "minItems": 6, "maxItems": 6}, "runtime": {"type": "object"}
  },
  "$defs": {
    "hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^\\u0000]+$"},
    "fileBinding": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "rawSha256", "contentDigest"], "properties": {"path": {"$ref": "#/$defs/path"}, "bytes": {"type": "integer", "minimum": 1}, "rawSha256": {"$ref": "#/$defs/hex"}, "contentDigest": {"$ref": "#/$defs/hex"}}},
    "rawBinding": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "rawSha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "bytes": {"type": "integer", "minimum": 1}, "rawSha256": {"$ref": "#/$defs/hex"}}},
    "schemaBinding": {"type": "object", "additionalProperties": false, "required": ["id", "path", "bytes", "rawSha256", "contentDigest"], "properties": {"id": {"type": "string", "format": "uri"}, "path": {"$ref": "#/$defs/path"}, "bytes": {"type": "integer", "minimum": 1}, "rawSha256": {"$ref": "#/$defs/hex"}, "contentDigest": {"$ref": "#/$defs/hex"}}},
    "roster": {"type": "object", "additionalProperties": false, "required": ["algorithm", "domain", "frame", "value"], "properties": {"algorithm": {"const": "sha256"}, "domain": {"type": "string"}, "frame": {"const": "utf8(domain)||0x00||canonical-json-roster-v1"}, "value": {"$ref": "#/$defs/hex"}}},
    "nativeManifest": {"type": "object", "additionalProperties": false, "required": ["kind", "contentDigest", "rosterDigest", "rosterDomain"], "properties": {"kind": {"const": "endpoint-modules-manifest"}, "contentDigest": {"$ref": "#/$defs/hex"}, "rosterDigest": {"$ref": "#/$defs/hex"}, "rosterDomain": {"type": "string"}}},
    "record": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "rawSha256", "contentDigest", "role"], "properties": {"path": {"$ref": "#/$defs/path"}, "bytes": {"type": "integer", "minimum": 1}, "rawSha256": {"$ref": "#/$defs/hex"}, "contentDigest": {"$ref": "#/$defs/hex"}, "role": {"type": "string"}}}
  }
}
