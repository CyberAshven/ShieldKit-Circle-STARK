{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-runtime-binding/v1/runtime-binding.v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["algorithm", "domain", "frame", "value"],
  "properties": {"algorithm": {"const": "sha256"}, "domain": {"const": "shieldkit-labs/p2/gate-b/cohort-runtime-binding/v1/runtime-authority"}, "frame": {"const": "utf8(domain)||0x00||canonical-json-utf8-with-digest-omitted"}, "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
