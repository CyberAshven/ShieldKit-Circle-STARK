  "type": "object",
  "additionalProperties": false,
  "required": ["artifactId", "contentDigest", "endpointUnion", "executionAllowed", "packageClosure", "packageId", "runtimeAuthority", "schema", "schemaBindings", "status", "tests"],
  "properties": {
    "artifactId": {"const": "artifact:gate-b:cohort-runtime-binding-v1"},
    "contentDigest": {"$ref": "#/$defs/contentDigest"},
    "endpointUnion": {"$ref": "#/$defs/endpointUnion"},
    "executionAllowed": {"const": false},
