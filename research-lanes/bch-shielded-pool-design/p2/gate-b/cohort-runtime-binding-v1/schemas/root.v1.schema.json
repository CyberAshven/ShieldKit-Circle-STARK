    "schema": {"const": "shieldkit-labs/p2/gate-b/cohort-runtime-binding/v1/root"},
    "schemaBindings": {"type": "array", "prefixItems": [{"$ref": "#/$defs/schemaBinding"}, {"$ref": "#/$defs/schemaBinding"}, {"$ref": "#/$defs/schemaBinding"}, {"$ref": "#/$defs/schemaBinding"}, {"$ref": "#/$defs/schemaBinding"}], "items": false, "minItems": 5, "maxItems": 5},
    "status": {"const": "static-runtime-binding-materialized-unexecuted"},
    "tests": {"type": "array", "minItems": 2, "items": {"type": "string"}}
  },
  "$defs": {
    "hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonEmptyRelative": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^\\u0000]+$"},
    "contentDigest": {"type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "domain", "frame", "value"], "properties": {"algorithm": {"const": "sha256"}, "canonicalization": {"const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"}, "domain": {"const": "shieldkit-labs/p2/gate-b/cohort-runtime-binding/v1/root"}, "frame": {"const": "utf8(domain)||0x00||canonical-json-utf8-with-contentDigest-omitted"}, "value": {"$ref": "#/$defs/hex"}}},
    "schemaBinding": {"type": "object", "additionalProperties": false, "required": ["id", "path", "bytes", "rawSha256", "contentDigest"], "properties": {"id": {"type": "string", "format": "uri"}, "path": {"$ref": "#/$defs/nonEmptyRelative"}, "bytes": {"type": "integer", "minimum": 1}, "rawSha256": {"$ref": "#/$defs/hex"}, "contentDigest": {"$ref": "#/$defs/hex"}}},
    "fileBinding": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "rawSha256", "contentDigest"], "properties": {"path": {"$ref": "#/$defs/nonEmptyRelative"}, "bytes": {"type": "integer", "minimum": 1}, "rawSha256": {"$ref": "#/$defs/hex"}, "contentDigest": {"$ref": "#/$defs/hex"}}},
    "rawBinding": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "rawSha256"], "properties": {"path": {"$ref": "#/$defs/nonEmptyRelative"}, "bytes": {"type": "integer", "minimum": 1}, "rawSha256": {"$ref": "#/$defs/hex"}}},
    "roster": {"type": "object", "additionalProperties": false, "required": ["algorithm", "domain", "frame", "value"], "properties": {"algorithm": {"const": "sha256"}, "domain": {"type": "string"}, "frame": {"const": "utf8(domain)||0x00||canonical-json-roster-v1"}, "value": {"$ref": "#/$defs/hex"}}},
    "record": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "rawSha256", "contentDigest", "role"], "properties": {"path": {"$ref": "#/$defs/nonEmptyRelative"}, "bytes": {"type": "integer", "minimum": 1}, "rawSha256": {"$ref": "#/$defs/hex"}, "contentDigest": {"$ref": "#/$defs/hex"}, "role": {"type": "string"}}},
    "leaf": {"type": "object", "additionalProperties": false, "required": ["id", "packageId", "packageRoot", "root", "schemaBindings", "manifest", "nativeManifest", "roster", "sums", "materialization", "records", "runtime"], "properties": {"id": {"enum": ["N", "E", "X"]}, "packageId": {"type": "string"}, "packageRoot": {"type": "string", "pattern": "^research-lanes/bch-shielded-pool-design/p2/gate-b/[^/]+$"}, "root": {"$ref": "#/$defs/fileBinding"}, "schemaBindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/schemaBinding"}}, "manifest": {"$ref": "#/$defs/fileBinding"}, "nativeManifest": {"oneOf": [{"$ref": "#/$defs/nativeNodeManifest"}, {"$ref": "#/$defs/nativeEndpointManifest"}, {"$ref": "#/$defs/nativeExternalManifest"}]}, "roster": {"$ref": "#/$defs/roster"}, "sums": {"$ref": "#/$defs/rawBinding"}, "materialization": {"$ref": "#/$defs/fileBinding"}, "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record"}}, "runtime": {"type": "object"}}},
    "nativeNodeManifest": {"type": "object", "additionalProperties": false, "required": ["kind", "contentDigest", "rosterDigest", "rosterDomain"], "properties": {"kind": {"const": "node-runtime-manifest"}, "contentDigest": {"$ref": "#/$defs/hex"}, "rosterDigest": {"$ref": "#/$defs/hex"}, "rosterDomain": {"type": "string"}}},
    "nativeEndpointManifest": {"type": "object", "additionalProperties": false, "required": ["kind", "contentDigest", "rosterDigest", "rosterDomain"], "properties": {"kind": {"const": "endpoint-modules-manifest"}, "contentDigest": {"$ref": "#/$defs/hex"}, "rosterDigest": {"$ref": "#/$defs/hex"}, "rosterDomain": {"type": "string"}}},
    "nativeExternalManifest": {"type": "object", "additionalProperties": false, "required": ["kind", "contentField", "rosterDigest"], "properties": {"kind": {"const": "external-runtime-manifest"}, "contentField": {"const": "absent"}, "rosterDigest": {"$ref": "#/$defs/hex"}}},
    "packageClosure": {"type": "object", "additionalProperties": false, "required": ["leafCount", "leaves"], "properties": {"leafCount": {"const": 3}, "leaves": {"type": "array", "prefixItems": [{"$ref": "#/$defs/leaf"}, {"$ref": "#/$defs/leaf"}, {"$ref": "#/$defs/leaf"}], "items": false, "minItems": 3, "maxItems": 3}}},
    "authorityDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtimeAuthority": {"type": "object", "additionalProperties": false, "required": ["digest", "common", "module", "external"], "properties": {"digest": {"$ref": "#/$defs/authorityDigest"}, "common": {"type": "object"}, "module": {"type": "object"}, "external": {"type": "object"}}},
    "workdir": {"type": "object", "additionalProperties": false, "required": ["template", "mode", "rootPolicy", "imagePolicy"], "properties": {"template": {"type": "string", "pattern": "^work/0[0-4]-[a-z-]+$"}, "mode": {"const": 448}, "rootPolicy": {"const": "future-attempt-root-relative"}, "imagePolicy": {"const": "provenanceOnly/nonLiveCwd"}}},
    "codec": {"type": "object", "additionalProperties": false, "required": ["stdin", "stdout", "parser", "stderr"], "properties": {"stdin": {"type": "string"}, "stdout": {"const": "canonical-lf-ndjson-v1"}, "parser": {"const": "strict-utf8-json-lf-ndjson-static-contract-v1"}, "stderr": {"const": "empty-only-on-success"}}},
    "moduleEndpoint": {"type": "object", "additionalProperties": false, "required": ["id", "endpointOrdinal", "kind", "leaf", "runtimeRef", "isolation", "workdir", "codec", "deadline", "output", "workerRow", "brandPrecondition", "moduleIdentity", "controllerIdentity"], "properties": {"id": {"enum": ["engine:native", "engine:libauth"]}, "endpointOrdinal": {"enum": [0, 1]}, "kind": {"const": "module"}, "leaf": {"const": "E"}, "runtimeRef": {"const": "controller-node"}, "isolation": {"const": "worker-thread"}, "workdir": {"$ref": "#/$defs/workdir"}, "codec": {"$ref": "#/$defs/codec"}, "deadline": {"$ref": "#/$defs/moduleDeadline"}, "output": {"$ref": "#/$defs/output"}, "workerRow": {"$ref": "#/$defs/workerRow"}, "brandPrecondition": {"$ref": "#/$defs/brandPrecondition"}, "moduleIdentity": {"$ref": "#/$defs/moduleIdentity"}, "controllerIdentity": {"$ref": "#/$defs/controllerIdentity"}}},
    "externalEndpoint": {"type": "object", "additionalProperties": false, "required": ["id", "endpointOrdinal", "kind", "leaf", "runtimeRef", "workdir", "codec", "deadline", "output", "loader", "binary", "dsoClosure", "argv", "environment", "stdio", "shell", "extraInheritedFds", "hostFallback", "imageWorkdir"], "properties": {"id": {"enum": ["engine:bchn", "engine:leanbch:primary", "engine:leanbch:secondary"]}, "endpointOrdinal": {"enum": [2, 3, 4]}, "kind": {"const": "external"}, "leaf": {"const": "X"}, "runtimeRef": {"type": "string"}, "workdir": {"$ref": "#/$defs/workdir"}, "codec": {"$ref": "#/$defs/codec"}, "deadline": {"$ref": "#/$defs/externalDeadline"}, "output": {"$ref": "#/$defs/output"}, "loader": {"$ref": "#/$defs/fileBinding"}, "binary": {"$ref": "#/$defs/fileBinding"}, "dsoClosure": {"type": "object", "additionalProperties": false, "required": ["count", "records"], "properties": {"count": {"const": 17}, "records": {"type": "array", "minItems": 17, "maxItems": 17, "items": {"$ref": "#/$defs/fileBinding"}}}}, "argv": {"type": "object", "additionalProperties": false, "required": ["mode", "values"], "properties": {"mode": {"const": "structured-direct-loader-argv"}, "values": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}, "environment": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"BCHN_DEBUG": {"const": "0"}, "LEANBCH_SECP": {"const": "reject"}}}, "stdio": {"const": {"0": "captured-stdin", "1": "captured-stdout", "2": "captured-stderr"}}, "shell": {"const": false}, "extraInheritedFds": {"const": []}, "hostFallback": {"const": "forbidden"}, "imageWorkdir": {"type": "object", "additionalProperties": false, "required": ["path", "policy"], "properties": {"path": {"type": "string", "pattern": "^image/workdirs/(bchn|leanbch)$"}, "policy": {"const": "provenanceOnly/nonLiveCwd"}}}}},
    "endpointUnion": {"type": "object", "additionalProperties": false, "required": ["expectedRows", "order", "entries"], "properties": {"expectedRows": {"const": 4608}, "order": {"const": ["engine:native", "engine:libauth", "engine:bchn", "engine:leanbch:primary", "engine:leanbch:secondary"]}, "entries": {"type": "array", "prefixItems": [{"$ref": "#/$defs/moduleEndpoint"}, {"$ref": "#/$defs/moduleEndpoint"}, {"$ref": "#/$defs/externalEndpoint"}, {"$ref": "#/$defs/externalEndpoint"}, {"$ref": "#/$defs/externalEndpoint"}], "items": false, "minItems": 5, "maxItems": 5}}},
    "moduleDeadline": {"type": "object", "additionalProperties": false, "required": ["milliseconds", "clock", "policy"], "properties": {"milliseconds": {"const": 600000}, "clock": {"const": "monotonic"}, "policy": {"const": "single-endpoint-deadline"}}},
    "externalDeadline": {"type": "object", "additionalProperties": false, "required": ["milliseconds", "clock", "policy"], "properties": {"milliseconds": {"enum": [600000, "shared-600000"]}, "clock": {"const": "monotonic"}, "policy": {"type": "string"}}},
    "output": {"type": "object", "additionalProperties": false, "required": ["combinedCapBytes", "terminationGraceMilliseconds"], "properties": {"combinedCapBytes": {"const": 134217728}, "terminationGraceMilliseconds": {"const": 5000}}},
    "workerRow": {"type": "object", "additionalProperties": false, "required": ["exactKeys", "forbiddenKeys", "inputAuthority", "admission", "repeatedCopyRehash"], "properties": {"exactKeys": {"type": "array", "const": ["byteBindings", "case", "endpoint", "endpointOrdinal", "fixture", "inputs", "plan", "rowDigest", "rowIndex", "work"]}, "forbiddenKeys": {"type": "array", "const": ["snapshotBrand", "expected", "caseEntry", "capability"]}, "inputAuthority": {"const": "private-controller-admitted-row-projection"}, "admission": {"const": "private-controller-WeakSet-AdmittedDispatch-only"}, "repeatedCopyRehash": {"const": "rehash-every-byte-field-and-rowDigest-after-construction-and-before-postMessage; reject-any-drift"}}},
    "brandPrecondition": {"type": "object", "additionalProperties": false, "required": ["brandTransit", "precondition", "workerBoundary"], "properties": {"brandTransit": {"const": "forbidden-across-structured-clone"}, "precondition": {"const": "private-controller-admitted-brand-required-before-every-copy-or-worker-dispatch"}, "workerBoundary": {"const": "worker-receives-clone-safe-projection-without-brand"}}},
    "coreIdentity": {"type": "object", "additionalProperties": false, "required": ["bytes", "rawSha256", "contentDigest", "role"], "properties": {"bytes": {"type": "integer", "minimum": 1}, "rawSha256": {"$ref": "#/$defs/hex"}, "contentDigest": {"$ref": "#/$defs/hex"}, "role": {"enum": ["native-frozen-kernel", "libauth-materialized-bundle"]}}},
    "moduleIdentity": {"type": "object", "additionalProperties": false, "required": ["descriptor", "module", "core", "export"], "properties": {"descriptor": {"$ref": "#/$defs/fileBinding"}, "module": {"$ref": "#/$defs/fileBinding"}, "core": {"$ref": "#/$defs/coreIdentity"}, "export": {"type": "string"}}},
    "controllerIdentity": {"type": "object", "additionalProperties": false, "required": ["marker", "bytes", "rawSha256", "contentDigest", "export"], "properties": {"marker": {"enum": ["\n/* WorkerRow controller boundary.", "\n/*\n * Cohort endpoint controller"]}, "bytes": {"type": "integer", "minimum": 1}, "rawSha256": {"$ref": "#/$defs/hex"}, "contentDigest": {"$ref": "#/$defs/hex"}, "export": {"type": "string"}}}
  }
}
