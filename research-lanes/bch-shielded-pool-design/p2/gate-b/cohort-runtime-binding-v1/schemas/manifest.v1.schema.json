{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-runtime-binding/v1/manifest.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contentDigest", "directories", "directoryCount", "domainSeparator", "executionAllowed", "fileCount", "files", "schema", "status"],
  "properties": {
    "contentDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "directories": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["mode", "path"], "properties": {"mode": {"type": "integer"}, "path": {"type": "string"}}}},
    "directoryCount": {"type": "integer", "minimum": 1},
    "domainSeparator": {"const": "shieldkit-labs/p2/gate-b/cohort-runtime-binding/v1/file-content"},
    "executionAllowed": {"const": false},
    "fileCount": {"type": "integer", "minimum": 1},
    "files": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["bytes", "contentDigest", "mode", "path", "rawSha256"], "properties": {"bytes": {"type": "integer", "minimum": 1}, "contentDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "mode": {"type": "integer"}, "path": {"type": "string"}, "rawSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "schema": {"const": "shieldkit-labs/p2/gate-b/cohort-runtime-binding/v1/manifest"},
    "status": {"const": "static-content-addressed"}
  }
}
