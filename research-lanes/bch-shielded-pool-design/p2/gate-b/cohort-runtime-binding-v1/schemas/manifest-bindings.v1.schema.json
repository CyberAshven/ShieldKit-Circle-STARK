{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-runtime-binding/v1/manifest-bindings.v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["algorithm", "contentDomain", "rawAlgorithm", "rosterAlgorithm", "leafBindingRule"],
  "properties": {"algorithm": {"const": "sha256"}, "contentDomain": {"const": "shieldkit-labs/p2/gate-b/cohort-runtime-binding/v1/file-content"}, "rawAlgorithm": {"const": "sha256(file-bytes)"}, "rosterAlgorithm": {"const": "sha256(domain||NUL||canonical-json-roster-v1)"}, "leafBindingRule": {"const": "root/schema/manifest/roster/sums/materialization and every record are raw/content/byte bound"}}
}
