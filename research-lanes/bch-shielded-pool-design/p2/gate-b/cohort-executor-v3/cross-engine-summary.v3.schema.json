{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-executor-v3/cross-engine-summary.v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "evidenceId", "epochId", "attemptIndex", "status", "rawArtifactDigests", "normalizedArtifactDigests", "fixtureRows", "metricAgreementRows", "verdictAgreement", "metricCoverageAgreement", "ranking", "selection", "contentDigest"],
  "properties": {
    "schema": {"const": "shieldkit-labs/p2/gate-b/cohort-executor-v3/cross-engine-summary/v3"}, "evidenceId": {"const": "evidence:execution-epoch-gate-b-v2:attempt-001"}, "epochId": {"const": "execution-epoch:gate-b-v2"}, "attemptIndex": {"const": 1},
    "status": {"enum": ["not-started", "complete", "incomplete", "failed"]}, "rawArtifactDigests": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/sha"}}, "normalizedArtifactDigests": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/sha"}},
    "fixtureRows": {"type": "array", "minItems": 4732, "maxItems": 4732, "items": {"$ref": "#/$defs/fixtureRow"}}, "metricAgreementRows": {"type": "array", "minItems": 70980, "maxItems": 70980, "items": {"$ref": "#/$defs/metricAgreement"}},
    "verdictAgreement": {"enum": ["not-started", "complete-eligible-only", "incomplete", "disagreement"]}, "metricCoverageAgreement": {"enum": ["not-started", "complete-eligible-only", "incomplete", "disagreement"]}, "ranking": {"type": "null"}, "selection": {"type": "null"}, "contentDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "digest": {"type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "domain", "frame", "value"], "properties": {"algorithm": {"const": "sha256"}, "canonicalization": {"const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"}, "domain": {"type": "string", "minLength": 1}, "frame": {"const": "utf8(domain)||0x00||canonical-json-utf8"}, "value": {"$ref": "#/$defs/sha"}}},
    "engineId": {"enum": ["engine:native", "engine:libauth", "engine:bchn", "engine:leanbch"]},
    "engineCell": {"type": "object", "additionalProperties": false, "required": ["engineId", "workItemId", "terminalCellId", "terminalStatus", "observedVerdict", "comparable", "rawRowDigest", "normalizedRowDigest"], "properties": {"engineId": {"$ref": "#/$defs/engineId"}, "workItemId": {"type": "string", "minLength": 1}, "terminalCellId": {"type": "string", "minLength": 1}, "terminalStatus": {"enum": ["observed", "preflight-limit-unsupported", "process-failure", "timeout", "parser-failure", "engine-unsupported-incomplete", "not-run-incomplete"]}, "observedVerdict": {"anyOf": [{"enum": ["accept", "reject"]}, {"type": "null"}]}, "comparable": {"type": "boolean"}, "rawRowDigest": {"$ref": "#/$defs/sha"}, "normalizedRowDigest": {"$ref": "#/$defs/sha"}}},
    "fixtureRow": {"type": "object", "additionalProperties": false, "required": ["fixtureKey", "terminalCellId", "fixtureRecordDigest", "expectedVerdict", "engines", "agreementStatus", "contentDigest"], "properties": {"fixtureKey": {"type": "string", "pattern": "^fixture:[0-9a-f]{64}$"}, "terminalCellId": {"type": "string", "minLength": 1}, "fixtureRecordDigest": {"$ref": "#/$defs/sha"}, "expectedVerdict": {"enum": ["accept", "reject"]}, "engines": {"type": "array", "minItems": 4, "maxItems": 4, "prefixItems": [{"$ref": "#/$defs/nativeCell"}, {"$ref": "#/$defs/libauthCell"}, {"$ref": "#/$defs/bchnCell"}, {"$ref": "#/$defs/leanCell"}], "items": false}, "agreementStatus": {"enum": ["agree", "disagree", "not-comparable", "incomplete", "preflight-unsupported"]}, "contentDigest": {"$ref": "#/$defs/digest"}}},
    "nativeCell": {"allOf": [{"$ref": "#/$defs/engineCell"}, {"type": "object", "properties": {"engineId": {"const": "engine:native"}}}]}, "libauthCell": {"allOf": [{"$ref": "#/$defs/engineCell"}, {"type": "object", "properties": {"engineId": {"const": "engine:libauth"}}}]}, "bchnCell": {"allOf": [{"$ref": "#/$defs/engineCell"}, {"type": "object", "properties": {"engineId": {"const": "engine:bchn"}}}]}, "leanCell": {"allOf": [{"$ref": "#/$defs/engineCell"}, {"type": "object", "properties": {"engineId": {"const": "engine:leanbch"}}}]},
    "metricCell": {"type": "object", "additionalProperties": false, "required": ["engineId", "workItemId", "terminalCellId", "rawRowDigest", "normalizedRowDigest", "metricCellDigest", "status", "valueDigest", "comparable"], "properties": {"engineId": {"$ref": "#/$defs/engineId"}, "workItemId": {"type": "string", "minLength": 1}, "terminalCellId": {"type": "string", "minLength": 1}, "rawRowDigest": {"$ref": "#/$defs/sha"}, "normalizedRowDigest": {"$ref": "#/$defs/sha"}, "metricCellDigest": {"$ref": "#/$defs/sha"}, "status": {"enum": ["measured", "measured-noncomparable", "derived-common", "derived-engine", "not-reached", "not-exposed", "not-applicable", "preflight-limit-unsupported"]}, "valueDigest": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]}, "comparable": {"type": "boolean"}}},
    "metricAgreement": {"type": "object", "additionalProperties": false, "required": ["fixtureKey", "metricOrdinal", "metricId", "cells", "agreementStatus", "comparableEngineIds", "incomparableEngineIds", "valueDigests", "contentDigest"], "properties": {"fixtureKey": {"type": "string", "pattern": "^fixture:[0-9a-f]{64}$"}, "metricOrdinal": {"type": "integer", "minimum": 0, "maximum": 14}, "metricId": {"enum": ["verdict", "lockingBytes", "unlockingBytes", "sourceBytes", "opcodeHistogram", "mulByteProduct", "divByteProduct", "modByteProduct", "resultPushBytes", "vmCost", "opCost", "stackMax", "elementMax", "limits", "headroom"]}, "cells": {"type": "array", "minItems": 4, "maxItems": 4, "prefixItems": [{"$ref": "#/$defs/nativeMetric"}, {"$ref": "#/$defs/libauthMetric"}, {"$ref": "#/$defs/bchnMetric"}, {"$ref": "#/$defs/leanMetric"}], "items": false}, "agreementStatus": {"enum": ["agree", "disagree", "not-comparable", "incomplete", "preflight-unsupported"]}, "comparableEngineIds": {"type": "array", "items": {"$ref": "#/$defs/engineId"}}, "incomparableEngineIds": {"type": "array", "items": {"$ref": "#/$defs/engineId"}}, "valueDigests": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]}}, "contentDigest": {"$ref": "#/$defs/digest"}}},
    "nativeMetric": {"allOf": [{"$ref": "#/$defs/metricCell"}, {"type": "object", "properties": {"engineId": {"const": "engine:native"}}}]}, "libauthMetric": {"allOf": [{"$ref": "#/$defs/metricCell"}, {"type": "object", "properties": {"engineId": {"const": "engine:libauth"}}}]}, "bchnMetric": {"allOf": [{"$ref": "#/$defs/metricCell"}, {"type": "object", "properties": {"engineId": {"const": "engine:bchn"}}}]}, "leanMetric": {"allOf": [{"$ref": "#/$defs/metricCell"}, {"type": "object", "properties": {"engineId": {"const": "engine:leanbch"}}}]}
  }
}
