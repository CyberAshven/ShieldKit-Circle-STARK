{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-executor-v3/raw-engine-observation.v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "evidenceId", "epochId", "attemptIndex", "engineId", "engineBatchOrdinal", "shardIndex", "shardCount", "status", "workItemOrderDigest", "engineBinding", "invocation", "lifecycle", "rows", "contentDigest"],
  "properties": {
    "schema": {"const": "shieldkit-labs/p2/gate-b/cohort-executor-v3/raw-engine-observation/v3"},
    "evidenceId": {"const": "evidence:execution-epoch-gate-b-v2:attempt-001"},
    "epochId": {"const": "execution-epoch:gate-b-v2"},
    "attemptIndex": {"const": 1},
    "engineId": {"enum": ["engine:native", "engine:libauth", "engine:bchn", "engine:leanbch"]},
    "engineBatchOrdinal": {"type": "integer", "minimum": 0, "maximum": 3},
    "shardIndex": {"const": 0},
    "shardCount": {"const": 1},
    "status": {"enum": ["not-started", "complete", "incomplete", "failed"]},
    "workItemOrderDigest": {"$ref": "#/$defs/digest"},
    "engineBinding": {"$ref": "#/$defs/engineBinding"},
    "invocation": {"$ref": "#/$defs/invocation"},
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "rows": {"type": "array", "minItems": 4732, "maxItems": 4732, "items": {"$ref": "#/$defs/row"}},
    "contentDigest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {"if": {"properties": {"engineId": {"const": "engine:native"}}, "required": ["engineId"]}, "then": {"properties": {"engineBatchOrdinal": {"const": 0}, "invocation": {"$ref": "#/$defs/moduleInvocation"}}}},
    {"if": {"properties": {"engineId": {"const": "engine:libauth"}}, "required": ["engineId"]}, "then": {"properties": {"engineBatchOrdinal": {"const": 1}, "invocation": {"$ref": "#/$defs/moduleInvocation"}}}},
    {"if": {"properties": {"engineId": {"const": "engine:bchn"}}, "required": ["engineId"]}, "then": {"properties": {"engineBatchOrdinal": {"const": 2}, "invocation": {"$ref": "#/$defs/externalInvocation"}}}},
    {"if": {"properties": {"engineId": {"const": "engine:leanbch"}}, "required": ["engineId"]}, "then": {"properties": {"engineBatchOrdinal": {"const": 3}, "invocation": {"$ref": "#/$defs/leanInvocation"}}}}
  ],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {"type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "domain", "frame", "value"], "properties": {"algorithm": {"const": "sha256"}, "canonicalization": {"const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"}, "domain": {"type": "string", "minLength": 1}, "frame": {"const": "utf8(domain)||0x00||canonical-json-utf8"}, "value": {"$ref": "#/$defs/sha"}}},
    "engineBinding": {"type": "object", "additionalProperties": false, "required": ["engineId", "path", "rawSha256", "contentDigest"], "properties": {"engineId": {"enum": ["engine:native", "engine:libauth", "engine:bchn", "engine:leanbch"]}, "path": {"type": "string", "minLength": 1}, "rawSha256": {"$ref": "#/$defs/sha"}, "contentDigest": {"$ref": "#/$defs/digest"}}},
    "stream": {"type": "object", "additionalProperties": false, "required": ["path", "rawSha256", "byteLength", "mediaType", "manifestPath", "manifestEntryDigest"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"}, "rawSha256": {"$ref": "#/$defs/sha"}, "byteLength": {"type": "integer", "minimum": 0}, "mediaType": {"enum": ["application/octet-stream", "text/plain-utf8"]}, "manifestPath": {"const": "evidence-manifest.v3.json"}, "manifestEntryDigest": {"$ref": "#/$defs/digest"}}},
    "environment": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["NODE_ENV"], "properties": {"NODE_ENV": {"const": "production"}}}, {"type": "object", "additionalProperties": false, "required": ["BCHN_DEBUG"], "properties": {"BCHN_DEBUG": {"const": "0"}}}, {"type": "object", "additionalProperties": false, "required": ["LEANBCH_SECP"], "properties": {"LEANBCH_SECP": {"const": "reject"}}}]},
    "runtime": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["arch", "platform", "runtime", "version"], "properties": {"arch": {"const": "x64"}, "platform": {"const": "linux"}, "runtime": {"const": "node"}, "version": {"const": "v22.23.1"}}}, {"type": "object", "additionalProperties": false, "required": ["arch", "platform", "runtime"], "properties": {"arch": {"const": "x64"}, "platform": {"const": "linux"}, "runtime": {"const": "native-bchn-leg"}}}, {"type": "object", "additionalProperties": false, "required": ["arch", "platform", "runtime", "declaredToolchain"], "properties": {"arch": {"const": "x64"}, "platform": {"const": "linux"}, "runtime": {"const": "lean"}, "declaredToolchain": {"const": "leanprover/lean4:v4.31.0"}}}]},
    "endpoint": {"type": "object", "additionalProperties": false, "required": ["role", "endpointKind", "path", "rawSha256", "argv", "cwd", "environment", "runtime", "stdin", "stdout", "stderr", "exitCode", "signal", "timedOut", "parserStatus", "captureClosed"], "properties": {"role": {"enum": ["primary", "secondary"]}, "endpointKind": {"enum": ["module-ndjson", "external-process"]}, "path": {"type": "string", "minLength": 1}, "rawSha256": {"$ref": "#/$defs/sha"}, "argv": {"anyOf": [{"type": "null"}, {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}]}, "cwd": {"type": "string", "minLength": 1}, "environment": {"$ref": "#/$defs/environment"}, "runtime": {"$ref": "#/$defs/runtime"}, "stdin": {"$ref": "#/$defs/stream"}, "stdout": {"$ref": "#/$defs/stream"}, "stderr": {"$ref": "#/$defs/stream"}, "exitCode": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 255}, {"type": "null"}]}, "signal": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}, "timedOut": {"type": "boolean"}, "parserStatus": {"enum": ["complete", "failure", "not-run"]}, "captureClosed": {"type": "boolean"}}},
    "stdinCodec": {"enum": ["canonical-raw-operands-bottom-to-top-v2", "in-process-authentication-program-from-exact-synthetic-transaction-v2", "vmb-json-array-transaction-and-source-outputs-v2", "expected-id-transaction-sourceOutputs-inputIndex-lines-v2", "expected-id-transaction-sourceOutputs-inputIndex-lines-v2-with-KERNEL-expected-token"]},
    "invocation": {"type": "object", "additionalProperties": false, "required": ["entrypointKind", "entrypoints", "stdinCodecs", "implementationDigest"], "properties": {"entrypointKind": {"enum": ["module", "external", "paired"]}, "entrypoints": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/endpoint"}}, "stdinCodecs": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/stdinCodec"}}, "implementationDigest": {"$ref": "#/$defs/sha"}}},
    "moduleEndpoint": {"allOf": [{"$ref": "#/$defs/endpoint"}, {"type": "object", "properties": {"role": {"const": "primary"}, "endpointKind": {"const": "module-ndjson"}, "argv": {"type": "null"}, "exitCode": {"type": "null"}, "signal": {"type": "null"}}}]},
    "externalPrimary": {"allOf": [{"$ref": "#/$defs/endpoint"}, {"type": "object", "properties": {"role": {"const": "primary"}, "endpointKind": {"const": "external-process"}, "argv": {"type": "array", "minItems": 1}}}]},
    "externalSecondary": {"allOf": [{"$ref": "#/$defs/endpoint"}, {"type": "object", "properties": {"role": {"const": "secondary"}, "endpointKind": {"const": "external-process"}, "argv": {"type": "array", "minItems": 1}}}]},
    "moduleInvocation": {"allOf": [{"$ref": "#/$defs/invocation"}, {"type": "object", "properties": {"entrypointKind": {"const": "module"}, "entrypoints": {"type": "array", "minItems": 1, "maxItems": 1, "prefixItems": [{"$ref": "#/$defs/moduleEndpoint"}], "items": false}}}]},
    "externalInvocation": {"allOf": [{"$ref": "#/$defs/invocation"}, {"type": "object", "properties": {"entrypointKind": {"const": "external"}, "entrypoints": {"type": "array", "minItems": 1, "maxItems": 1, "prefixItems": [{"$ref": "#/$defs/externalPrimary"}], "items": false}}}]},
    "leanInvocation": {"allOf": [{"$ref": "#/$defs/invocation"}, {"type": "object", "properties": {"entrypointKind": {"const": "paired"}, "entrypoints": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"$ref": "#/$defs/externalPrimary"}, {"$ref": "#/$defs/externalSecondary"}], "items": false}}}]},
    "lifecycleEndpoint": {"type": "object", "additionalProperties": false, "required": ["role", "status", "exitCode", "signal", "timedOut", "parserStatus", "captureClosed"], "properties": {"role": {"enum": ["primary", "secondary"]}, "status": {"enum": ["not-started", "complete", "incomplete", "failed"]}, "exitCode": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 255}, {"type": "null"}]}, "signal": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}, "timedOut": {"type": "boolean"}, "parserStatus": {"enum": ["complete", "failure", "not-run"]}, "captureClosed": {"type": "boolean"}}},
    "lifecycle": {"type": "object", "additionalProperties": false, "required": ["status", "endpoints"], "properties": {"status": {"enum": ["not-started", "complete", "incomplete", "failed"]}, "endpoints": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/lifecycleEndpoint"}}}},
    "preflight": {"type": "object", "additionalProperties": false, "required": ["kind", "executionCeilingBytes", "scriptSig", "redeem", "reason"], "properties": {"kind": {"const": "preflight-limit"}, "executionCeilingBytes": {"const": 10000}, "scriptSig": {"type": "boolean"}, "redeem": {"type": "boolean"}, "reason": {"const": "preflight-limit-unsupported-no-engine-invocation"}}},
    "unsupported": {"type": "object", "additionalProperties": false, "required": ["kind", "reason", "engineId", "eligible", "agreementEligible"], "properties": {"kind": {"const": "engine-unsupported-incomplete"}, "reason": {"const": "lean-costprobe-skip"}, "engineId": {"const": "engine:leanbch"}, "eligible": {"const": true}, "agreementEligible": {"const": false}}},
    "notRun": {"type": "object", "additionalProperties": false, "required": ["kind", "reason", "agreementEligible"], "properties": {"kind": {"const": "not-run-incomplete"}, "reason": {"const": "prior-engine-batch-failure"}, "agreementEligible": {"const": false}}},
    "sourceStream": {"type": "object", "additionalProperties": false, "required": ["path", "artifactRawSha256", "artifactByteLength", "byteStart", "byteEnd", "lineStart", "lineEnd", "spanSha256", "manifestPath", "manifestEntryDigest"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"}, "artifactRawSha256": {"$ref": "#/$defs/sha"}, "artifactByteLength": {"type": "integer", "minimum": 0}, "byteStart": {"type": "integer", "minimum": 0}, "byteEnd": {"type": "integer", "minimum": 1}, "lineStart": {"type": "integer", "minimum": 1}, "lineEnd": {"type": "integer", "minimum": 1}, "spanSha256": {"$ref": "#/$defs/sha"}, "manifestPath": {"const": "evidence-manifest.v3.json"}, "manifestEntryDigest": {"$ref": "#/$defs/digest"}}},
    "payload": {"type": "object", "additionalProperties": false, "required": ["workItemId", "verdict", "failureStage", "metrics", "txChecks", "phase", "terminalStatus", "sourceStream"], "properties": {"workItemId": {"type": "string", "minLength": 1}, "verdict": {"anyOf": [{"enum": ["accept", "reject"]}, {"type": "null"}]}, "failureStage": {"anyOf": [{"enum": ["accept", "coefficient-range-check-before-arithmetic", "unused-high-bit-check-before-numeric-decode", "exact-extension-element-length-check-before-limb-decode", "relation-check", "inverse-relation-check", "process", "timeout", "parser"]}, {"type": "null"}]}, "metrics": {"anyOf": [{"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}, {"type": "null"}]}, "txChecks": {"const": "unsupported"}, "phase": {"type": "string", "minLength": 1}, "terminalStatus": {"enum": ["observed", "process-failure", "timeout", "parser-failure", "engine-unsupported-incomplete"]}, "sourceStream": {"$ref": "#/$defs/sourceStream"}}},
    "structuredObservation": {"type": "object", "additionalProperties": false, "required": ["kind", "status", "rawObservationDigest", "endpointRole", "exitCode", "parserStatus", "payload"], "properties": {"kind": {"const": "structured"}, "status": {"const": "observed"}, "rawObservationDigest": {"$ref": "#/$defs/digest"}, "endpointRole": {"enum": ["primary", "secondary"]}, "exitCode": {"type": "integer", "minimum": 0, "maximum": 255}, "parserStatus": {"enum": ["complete", "failure"]}, "payload": {"$ref": "#/$defs/payload"}}},
    "row": {"type": "object", "additionalProperties": false, "required": ["workItemId", "fixtureKey", "terminalCellId", "workItemOrdinal", "fixtureRecordDigest", "disposition", "preflightBinding", "unsupportedBinding", "notRunBinding", "rawObservation", "rawRowDigest"], "properties": {"workItemId": {"type": "string", "minLength": 1}, "fixtureKey": {"type": "string", "pattern": "^fixture:[0-9a-f]{64}$"}, "terminalCellId": {"type": "string", "minLength": 1}, "workItemOrdinal": {"type": "integer", "minimum": 0, "maximum": 4731}, "fixtureRecordDigest": {"$ref": "#/$defs/sha"}, "disposition": {"enum": ["observed", "preflight-limit-unsupported", "engine-unsupported-incomplete", "not-run-incomplete"]}, "preflightBinding": {"anyOf": [{"$ref": "#/$defs/preflight"}, {"type": "null"}]}, "unsupportedBinding": {"anyOf": [{"$ref": "#/$defs/unsupported"}, {"type": "null"}]}, "notRunBinding": {"anyOf": [{"$ref": "#/$defs/notRun"}, {"type": "null"}]}, "rawObservation": {"anyOf": [{"$ref": "#/$defs/structuredObservation"}, {"type": "null"}]}, "rawRowDigest": {"$ref": "#/$defs/digest"}}, "allOf": [
      {"if": {"properties": {"disposition": {"const": "preflight-limit-unsupported"}}, "required": ["disposition"]}, "then": {"properties": {"preflightBinding": {"$ref": "#/$defs/preflight"}, "unsupportedBinding": {"type": "null"}, "notRunBinding": {"type": "null"}, "rawObservation": {"type": "null"}}}},
      {"if": {"properties": {"disposition": {"const": "engine-unsupported-incomplete"}}, "required": ["disposition"]}, "then": {"properties": {"preflightBinding": {"type": "null"}, "unsupportedBinding": {"$ref": "#/$defs/unsupported"}, "notRunBinding": {"type": "null"}, "rawObservation": {"$ref": "#/$defs/structuredObservation"}}}},
      {"if": {"properties": {"disposition": {"const": "not-run-incomplete"}}, "required": ["disposition"]}, "then": {"properties": {"preflightBinding": {"type": "null"}, "unsupportedBinding": {"type": "null"}, "notRunBinding": {"$ref": "#/$defs/notRun"}, "rawObservation": {"type": "null"}}}},
      {"if": {"properties": {"disposition": {"const": "observed"}}, "required": ["disposition"]}, "then": {"properties": {"preflightBinding": {"type": "null"}, "unsupportedBinding": {"type": "null"}, "notRunBinding": {"type": "null"}, "rawObservation": {"$ref": "#/$defs/structuredObservation"}}}}
    ]},
    "jsonValue": {"anyOf": [{"type": "null"}, {"type": "boolean"}, {"type": "number"}, {"type": "string"}, {"type": "array", "items": {"$ref": "#/$defs/jsonValue"}}, {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}]}
  }
}
