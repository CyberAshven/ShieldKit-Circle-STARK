{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-executor-v3/execution-claim.v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "claimId", "status", "attemptIndex", "authorizationBinding", "contractBinding", "outputRoot", "runtime", "nonreusePolicy", "contentDigest"],
  "properties": {
    "schema": {"const": "shieldkit-labs/p2/gate-b/cohort-executor-v3/execution-claim/v3"},
    "claimId": {"const": "execution-claim:cohort-executor-v3:attempt-001"},
    "status": {"const": "claimed-unexecuted"},
    "attemptIndex": {"const": 1},
    "authorizationBinding": {"$ref": "#/$defs/contentBinding"},
    "contractBinding": {"$ref": "#/$defs/contentBinding"},
    "outputRoot": {"const": "research-lanes/bch-shielded-pool-design/p2/gate-b/cohort-execution-runs-v3/attempt-001"},
    "runtime": {"$ref": "#/$defs/runtime"},
    "nonreusePolicy": {"const": "exclusive-one-use-claim-consumes-attempt-001-even-if-output-absent"},
    "contentDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {"type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "domain", "frame", "value"], "properties": {"algorithm": {"const": "sha256"}, "canonicalization": {"const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"}, "domain": {"type": "string", "minLength": 1}, "frame": {"const": "utf8(domain)||0x00||canonical-json-utf8"}, "value": {"$ref": "#/$defs/sha"}}},
    "contentBinding": {"type": "object", "additionalProperties": false, "required": ["path", "rawSha256", "byteLength", "contentDigest"], "properties": {"path": {"type": "string", "minLength": 1}, "rawSha256": {"$ref": "#/$defs/sha"}, "byteLength": {"type": "integer", "minimum": 1}, "contentDigest": {"$ref": "#/$defs/digest"}}},
    "runtime": {"type": "object", "additionalProperties": false, "required": ["executable", "rawSha256", "byteLength", "version", "platform", "arch", "runtimeDigest"], "properties": {"executable": {"type": "string", "minLength": 1}, "rawSha256": {"$ref": "#/$defs/sha"}, "byteLength": {"type": "integer", "minimum": 1}, "version": {"type": "string", "minLength": 1}, "platform": {"const": "linux"}, "arch": {"const": "x64"}, "runtimeDigest": {"$ref": "#/$defs/digest"}}}
  }
}
