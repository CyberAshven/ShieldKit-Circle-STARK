{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-executor-v3/normalized-engine-result.v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "evidenceId", "epochId", "attemptIndex", "engineId", "engineBatchOrdinal", "shardIndex", "shardCount", "status", "workItemOrderDigest", "rawArtifactDigest", "rows", "metricCellCount", "contentDigest"],
  "properties": {
    "schema": {"const": "shieldkit-labs/p2/gate-b/cohort-executor-v3/normalized-engine-result/v3"}, "evidenceId": {"const": "evidence:execution-epoch-gate-b-v2:attempt-001"}, "epochId": {"const": "execution-epoch:gate-b-v2"}, "attemptIndex": {"const": 1},
    "engineId": {"enum": ["engine:native", "engine:libauth", "engine:bchn", "engine:leanbch"]}, "engineBatchOrdinal": {"type": "integer", "minimum": 0, "maximum": 3}, "shardIndex": {"const": 0}, "shardCount": {"const": 1}, "status": {"enum": ["not-started", "complete", "incomplete", "failed"]},
    "workItemOrderDigest": {"$ref": "#/$defs/digest"}, "rawArtifactDigest": {"$ref": "#/$defs/sha"}, "rows": {"type": "array", "minItems": 4732, "maxItems": 4732, "items": {"$ref": "#/$defs/row"}}, "metricCellCount": {"const": 70980}, "contentDigest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {"type": "object", "if": {"type": "object", "properties": {"engineId": {"const": "engine:native"}}, "required": ["engineId"]}, "then": {"type": "object", "properties": {"engineBatchOrdinal": {"const": 0}}}},
    {"type": "object", "if": {"type": "object", "properties": {"engineId": {"const": "engine:libauth"}}, "required": ["engineId"]}, "then": {"type": "object", "properties": {"engineBatchOrdinal": {"const": 1}}}},
    {"type": "object", "if": {"type": "object", "properties": {"engineId": {"const": "engine:bchn"}}, "required": ["engineId"]}, "then": {"type": "object", "properties": {"engineBatchOrdinal": {"const": 2}}}},
    {"type": "object", "if": {"type": "object", "properties": {"engineId": {"const": "engine:leanbch"}}, "required": ["engineId"]}, "then": {"type": "object", "properties": {"engineBatchOrdinal": {"const": 3}}}}
  ],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {"type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "domain", "frame", "value"], "properties": {"algorithm": {"const": "sha256"}, "canonicalization": {"const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"}, "domain": {"type": "string", "minLength": 1}, "frame": {"const": "utf8(domain)||0x00||canonical-json-utf8"}, "value": {"$ref": "#/$defs/sha"}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["sourceArtifactDigest", "method"], "properties": {"sourceArtifactDigest": {"$ref": "#/$defs/sha"}, "method": {"enum": ["raw-observation-verdict-v3", "raw-engine-metric-v3", "frozen-fixture-byte-binding-v1"]}}},
    "jsonValue": {"anyOf": [{"type": "null"}, {"type": "boolean"}, {"type": "number"}, {"type": "string"}, {"type": "array", "items": {"$ref": "#/$defs/jsonValue"}}, {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}]},
    "metric": {"type": "object", "additionalProperties": false, "required": ["metricId", "status", "value", "provenance", "reason", "comparable", "contentDigest"], "properties": {"metricId": {"enum": ["verdict", "lockingBytes", "unlockingBytes", "sourceBytes", "opcodeHistogram", "mulByteProduct", "divByteProduct", "modByteProduct", "resultPushBytes", "vmCost", "opCost", "stackMax", "elementMax", "limits", "headroom"]}, "status": {"enum": ["measured", "measured-noncomparable", "derived-common", "derived-engine", "not-reached", "not-exposed", "not-applicable", "preflight-limit-unsupported"]}, "value": {"$ref": "#/$defs/jsonValue"}, "provenance": {"anyOf": [{"$ref": "#/$defs/provenance"}, {"type": "null"}]}, "reason": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}, "comparable": {"type": "boolean"}, "contentDigest": {"$ref": "#/$defs/digest"}}, "allOf": [
      {"type": "object", "if": {"type": "object", "properties": {"status": {"enum": ["measured", "measured-noncomparable", "derived-common", "derived-engine"]}}, "required": ["status"]}, "then": {"type": "object", "properties": {"value": {"not": {"type": "null"}}, "provenance": {"$ref": "#/$defs/provenance"}, "reason": {"type": "null"}}}, "else": {"type": "object", "properties": {"value": {"type": "null"}, "provenance": {"type": "null"}, "reason": {"type": "string", "minLength": 1}, "comparable": {"const": false}}}}
    ]},
    "preflightMetric": {"allOf": [{"$ref": "#/$defs/metric"}, {"type": "object", "properties": {"status": {"const": "preflight-limit-unsupported"}, "value": {"type": "null"}, "provenance": {"type": "null"}, "reason": {"const": "preflight-limit-unsupported"}, "comparable": {"const": false}}}]},
    "unsupportedMetric": {"allOf": [{"$ref": "#/$defs/metric"}, {"type": "object", "properties": {"status": {"const": "not-applicable"}, "value": {"type": "null"}, "provenance": {"type": "null"}, "reason": {"const": "lean-costprobe-skip"}, "comparable": {"const": false}}}]},
    "notRunMetric": {"allOf": [{"$ref": "#/$defs/metric"}, {"type": "object", "properties": {"status": {"const": "not-reached"}, "value": {"type": "null"}, "provenance": {"type": "null"}, "reason": {"const": "not-run-after-prior-engine-batch-failure"}, "comparable": {"const": false}}}]},
    "expected": {"type": "object", "additionalProperties": false, "required": ["verdict", "stage"], "properties": {"verdict": {"enum": ["accept", "reject"]}, "stage": {"enum": ["accept", "coefficient-range-check-before-arithmetic", "unused-high-bit-check-before-numeric-decode", "exact-extension-element-length-check-before-limb-decode", "relation-check", "inverse-relation-check"]}}},
    "observed": {"type": "object", "additionalProperties": false, "required": ["verdict", "failureStage"], "properties": {"verdict": {"anyOf": [{"enum": ["accept", "reject"]}, {"type": "null"}]}, "failureStage": {"anyOf": [{"enum": ["accept", "coefficient-range-check-before-arithmetic", "unused-high-bit-check-before-numeric-decode", "exact-extension-element-length-check-before-limb-decode", "relation-check", "inverse-relation-check", "preflight-limit", "process", "timeout", "parser", "not-run-incomplete", "outer-transaction-or-token"]}, {"type": "null"}]}}},
    "unsupported": {"type": "object", "additionalProperties": false, "required": ["reason", "agreementEligible"], "properties": {"reason": {"const": "lean-costprobe-skip"}, "agreementEligible": {"const": false}}},
    "notRun": {"type": "object", "additionalProperties": false, "required": ["reason", "agreementEligible"], "properties": {"reason": {"const": "prior-engine-batch-failure"}, "agreementEligible": {"const": false}}},
    "row": {"type": "object", "additionalProperties": false, "required": ["workItemId", "fixtureKey", "terminalCellId", "workItemOrdinal", "fixtureRecordDigest", "disposition", "expected", "terminalStatus", "observed", "rawObservationDigest", "unsupportedBinding", "notRunBinding", "metrics", "contentDigest"], "properties": {"workItemId": {"type": "string", "minLength": 1}, "fixtureKey": {"type": "string", "pattern": "^fixture:[0-9a-f]{64}$"}, "terminalCellId": {"type": "string", "minLength": 1}, "workItemOrdinal": {"type": "integer", "minimum": 0, "maximum": 4731}, "fixtureRecordDigest": {"$ref": "#/$defs/sha"}, "disposition": {"enum": ["observed", "preflight-limit-unsupported", "engine-unsupported-incomplete", "not-run-incomplete"]}, "expected": {"$ref": "#/$defs/expected"}, "terminalStatus": {"enum": ["observed", "preflight-limit-unsupported", "process-failure", "timeout", "parser-failure", "engine-unsupported-incomplete", "not-run-incomplete"]}, "observed": {"$ref": "#/$defs/observed"}, "rawObservationDigest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}, "unsupportedBinding": {"anyOf": [{"$ref": "#/$defs/unsupported"}, {"type": "null"}]}, "notRunBinding": {"anyOf": [{"$ref": "#/$defs/notRun"}, {"type": "null"}]}, "metrics": {"type": "array", "minItems": 15, "maxItems": 15, "prefixItems": [{"$ref": "#/$defs/metricVerdict"}, {"$ref": "#/$defs/metricLockingBytes"}, {"$ref": "#/$defs/metricUnlockingBytes"}, {"$ref": "#/$defs/metricSourceBytes"}, {"$ref": "#/$defs/metricOpcodeHistogram"}, {"$ref": "#/$defs/metricMulByteProduct"}, {"$ref": "#/$defs/metricDivByteProduct"}, {"$ref": "#/$defs/metricModByteProduct"}, {"$ref": "#/$defs/metricResultPushBytes"}, {"$ref": "#/$defs/metricVmCost"}, {"$ref": "#/$defs/metricOpCost"}, {"$ref": "#/$defs/metricStackMax"}, {"$ref": "#/$defs/metricElementMax"}, {"$ref": "#/$defs/metricLimits"}, {"$ref": "#/$defs/metricHeadroom"}], "items": false}, "contentDigest": {"$ref": "#/$defs/digest"}}, "allOf": [
      {"type": "object", "if": {"type": "object", "properties": {"disposition": {"const": "preflight-limit-unsupported"}}, "required": ["disposition"]}, "then": {"type": "object", "properties": {"terminalStatus": {"const": "preflight-limit-unsupported"}, "observed": {"const": {"verdict": null, "failureStage": "preflight-limit"}}, "rawObservationDigest": {"type": "null"}, "unsupportedBinding": {"type": "null"}, "notRunBinding": {"type": "null"}, "metrics": {"type": "array", "items": {"$ref": "#/$defs/preflightMetric"}}}}},
      {"type": "object", "if": {"type": "object", "properties": {"disposition": {"const": "engine-unsupported-incomplete"}}, "required": ["disposition"]}, "then": {"type": "object", "properties": {"terminalStatus": {"const": "engine-unsupported-incomplete"}, "observed": {"const": {"verdict": null, "failureStage": "process"}}, "rawObservationDigest": {"$ref": "#/$defs/digest"}, "unsupportedBinding": {"$ref": "#/$defs/unsupported"}, "notRunBinding": {"type": "null"}, "metrics": {"type": "array", "items": {"$ref": "#/$defs/unsupportedMetric"}}}}},
      {"type": "object", "if": {"type": "object", "properties": {"disposition": {"const": "not-run-incomplete"}}, "required": ["disposition"]}, "then": {"type": "object", "properties": {"terminalStatus": {"const": "not-run-incomplete"}, "observed": {"const": {"verdict": null, "failureStage": "not-run-incomplete"}}, "rawObservationDigest": {"type": "null"}, "unsupportedBinding": {"type": "null"}, "notRunBinding": {"$ref": "#/$defs/notRun"}, "metrics": {"type": "array", "items": {"$ref": "#/$defs/notRunMetric"}}}}},
      {"type": "object", "if": {"type": "object", "properties": {"disposition": {"const": "observed"}}, "required": ["disposition"]}, "then": {"type": "object", "properties": {"terminalStatus": {"enum": ["observed", "process-failure", "timeout", "parser-failure"]}, "rawObservationDigest": {"$ref": "#/$defs/digest"}, "unsupportedBinding": {"type": "null"}, "notRunBinding": {"type": "null"}}}}
    ]},
    "metricVerdict": {"allOf": [{"$ref": "#/$defs/metric"}, {"type": "object", "properties": {"metricId": {"const": "verdict"}, "status": {"not": {"const": "measured-noncomparable"}}}}]},
    "metricLockingBytes": {"allOf": [{"$ref": "#/$defs/metric"}, {"type": "object", "properties": {"metricId": {"const": "lockingBytes"}}}]}, "metricUnlockingBytes": {"allOf": [{"$ref": "#/$defs/metric"}, {"type": "object", "properties": {"metricId": {"const": "unlockingBytes"}}}]}, "metricSourceBytes": {"allOf": [{"$ref": "#/$defs/metric"}, {"type": "object", "properties": {"metricId": {"const": "sourceBytes"}}}]}, "metricOpcodeHistogram": {"allOf": [{"$ref": "#/$defs/metric"}, {"type": "object", "properties": {"metricId": {"const": "opcodeHistogram"}}}]}, "metricMulByteProduct": {"allOf": [{"$ref": "#/$defs/metric"}, {"type": "object", "properties": {"metricId": {"const": "mulByteProduct"}}}]}, "metricDivByteProduct": {"allOf": [{"$ref": "#/$defs/metric"}, {"type": "object", "properties": {"metricId": {"const": "divByteProduct"}}}]}, "metricModByteProduct": {"allOf": [{"$ref": "#/$defs/metric"}, {"type": "object", "properties": {"metricId": {"const": "modByteProduct"}}}]}, "metricResultPushBytes": {"allOf": [{"$ref": "#/$defs/metric"}, {"type": "object", "properties": {"metricId": {"const": "resultPushBytes"}}}]}, "metricVmCost": {"allOf": [{"$ref": "#/$defs/metric"}, {"type": "object", "properties": {"metricId": {"const": "vmCost"}}}]}, "metricOpCost": {"allOf": [{"$ref": "#/$defs/metric"}, {"type": "object", "properties": {"metricId": {"const": "opCost"}}}]}, "metricStackMax": {"allOf": [{"$ref": "#/$defs/metric"}, {"type": "object", "properties": {"metricId": {"const": "stackMax"}}}]}, "metricElementMax": {"allOf": [{"$ref": "#/$defs/metric"}, {"type": "object", "properties": {"metricId": {"const": "elementMax"}}}]}, "metricLimits": {"allOf": [{"$ref": "#/$defs/metric"}, {"type": "object", "properties": {"metricId": {"const": "limits"}}}]}, "metricHeadroom": {"allOf": [{"$ref": "#/$defs/metric"}, {"type": "object", "properties": {"metricId": {"const": "headroom"}}}]}
  }
}
