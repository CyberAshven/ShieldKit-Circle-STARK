{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-executor-v3/evidence-manifest.v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "manifestId", "status", "attemptIndex", "evidenceRootExcluded", "selfManifestExcluded", "files", "inventoryDigest", "contentDigest"],
  "properties": {
    "schema": {"const": "shieldkit-labs/p2/gate-b/cohort-executor-v3/evidence-manifest/v3"}, "manifestId": {"const": "evidence-manifest:cohort-executor-v3:attempt-001"}, "status": {"const": "complete"}, "attemptIndex": {"const": 1}, "evidenceRootExcluded": {"const": true}, "selfManifestExcluded": {"const": true},
    "files": {"type": "array", "minItems": 26, "maxItems": 26, "items": {"$ref": "#/$defs/entry"}}, "inventoryDigest": {"$ref": "#/$defs/digest"}, "contentDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "digest": {"type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "domain", "frame", "value"], "properties": {"algorithm": {"const": "sha256"}, "canonicalization": {"const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"}, "domain": {"type": "string", "minLength": 1}, "frame": {"const": "utf8(domain)||0x00||canonical-json-utf8"}, "value": {"$ref": "#/$defs/sha"}}},
    "entry": {"type": "object", "additionalProperties": false, "required": ["ordinal", "kind", "engineId", "endpointRole", "streamRole", "path", "rawSha256", "byteLength", "manifestEntryDigest"], "properties": {"ordinal": {"type": "integer", "minimum": 0, "maximum": 25}, "kind": {"enum": ["raw-artifact", "raw-stream", "normalized-artifact", "cross-engine-summary", "authorization-copy", "execution-claim-copy"]}, "engineId": {"anyOf": [{"enum": ["engine:native", "engine:libauth", "engine:bchn", "engine:leanbch"]}, {"type": "null"}]}, "endpointRole": {"anyOf": [{"enum": ["primary", "secondary"]}, {"type": "null"}]}, "streamRole": {"anyOf": [{"enum": ["stdin", "stdout", "stderr"]}, {"type": "null"}]}, "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"}, "rawSha256": {"$ref": "#/$defs/sha"}, "byteLength": {"type": "integer", "minimum": 0}, "manifestEntryDigest": {"$ref": "#/$defs/digest"}}}
  }
}
