{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-executor-v3/evidence-root.v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "evidenceId", "epochId", "attemptIndex", "status", "componentAndScriptEngineOnly", "bchnTxChecks", "contractBinding", "manifestBinding", "authorizationCopy", "claimCopy", "rawArtifacts", "normalizedArtifacts", "crossSummary", "obligationAccounting", "ranking", "selection", "contentDigest"],
  "properties": {
    "schema": {"const": "shieldkit-labs/p2/gate-b/cohort-executor-v3/evidence-root/v3"}, "evidenceId": {"const": "evidence:execution-epoch-gate-b-v2:attempt-001"}, "epochId": {"const": "execution-epoch:gate-b-v2"}, "attemptIndex": {"const": 1}, "status": {"const": "complete"}, "componentAndScriptEngineOnly": {"const": true}, "bchnTxChecks": {"const": "unsupported"},
    "contractBinding": {"$ref": "#/$defs/contentBinding"}, "manifestBinding": {"$ref": "#/$defs/manifestBinding"}, "authorizationCopy": {"$ref": "#/$defs/contentBinding"}, "claimCopy": {"$ref": "#/$defs/contentBinding"},
    "rawArtifacts": {"type": "array", "minItems": 4, "maxItems": 4, "prefixItems": [{"$ref": "#/$defs/rawNative"}, {"$ref": "#/$defs/rawLibauth"}, {"$ref": "#/$defs/rawBchn"}, {"$ref": "#/$defs/rawLean"}], "items": false},
    "normalizedArtifacts": {"type": "array", "minItems": 4, "maxItems": 4, "prefixItems": [{"$ref": "#/$defs/normalizedNative"}, {"$ref": "#/$defs/normalizedLibauth"}, {"$ref": "#/$defs/normalizedBchn"}, {"$ref": "#/$defs/normalizedLean"}], "items": false},
    "crossSummary": {"$ref": "#/$defs/summary"}, "obligationAccounting": {"const": {"total": 18928, "preflightUnsupported": 496, "executable": 18432, "metricCells": 283920}}, "ranking": {"type": "null"}, "selection": {"type": "null"}, "contentDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "digest": {"type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "domain", "frame", "value"], "properties": {"algorithm": {"const": "sha256"}, "canonicalization": {"const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"}, "domain": {"type": "string", "minLength": 1}, "frame": {"const": "utf8(domain)||0x00||canonical-json-utf8"}, "value": {"$ref": "#/$defs/sha"}}},
    "contentBinding": {"type": "object", "additionalProperties": false, "required": ["path", "rawSha256", "byteLength", "contentDigest"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"}, "rawSha256": {"$ref": "#/$defs/sha"}, "byteLength": {"type": "integer", "minimum": 1}, "contentDigest": {"$ref": "#/$defs/digest"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["engineId", "batchOrdinal", "shardIndex", "shardCount", "path", "rawSha256", "byteLength", "contentDigest", "status"], "properties": {"engineId": {"enum": ["engine:native", "engine:libauth", "engine:bchn", "engine:leanbch"]}, "batchOrdinal": {"type": "integer", "minimum": 0, "maximum": 3}, "shardIndex": {"const": 0}, "shardCount": {"const": 1}, "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"}, "rawSha256": {"$ref": "#/$defs/sha"}, "byteLength": {"type": "integer", "minimum": 1}, "contentDigest": {"$ref": "#/$defs/sha"}, "status": {"const": "complete"}}},
    "rawNative": {"allOf": [{"$ref": "#/$defs/artifact"}, {"type": "object", "properties": {"engineId": {"const": "engine:native"}, "batchOrdinal": {"const": 0}}}]}, "rawLibauth": {"allOf": [{"$ref": "#/$defs/artifact"}, {"type": "object", "properties": {"engineId": {"const": "engine:libauth"}, "batchOrdinal": {"const": 1}}}]}, "rawBchn": {"allOf": [{"$ref": "#/$defs/artifact"}, {"type": "object", "properties": {"engineId": {"const": "engine:bchn"}, "batchOrdinal": {"const": 2}}}]}, "rawLean": {"allOf": [{"$ref": "#/$defs/artifact"}, {"type": "object", "properties": {"engineId": {"const": "engine:leanbch"}, "batchOrdinal": {"const": 3}}}]},
    "normalizedNative": {"allOf": [{"$ref": "#/$defs/artifact"}, {"type": "object", "properties": {"engineId": {"const": "engine:native"}, "batchOrdinal": {"const": 0}}}]}, "normalizedLibauth": {"allOf": [{"$ref": "#/$defs/artifact"}, {"type": "object", "properties": {"engineId": {"const": "engine:libauth"}, "batchOrdinal": {"const": 1}}}]}, "normalizedBchn": {"allOf": [{"$ref": "#/$defs/artifact"}, {"type": "object", "properties": {"engineId": {"const": "engine:bchn"}, "batchOrdinal": {"const": 2}}}]}, "normalizedLean": {"allOf": [{"$ref": "#/$defs/artifact"}, {"type": "object", "properties": {"engineId": {"const": "engine:leanbch"}, "batchOrdinal": {"const": 3}}}]},
    "summary": {"type": "object", "additionalProperties": false, "required": ["path", "rawSha256", "byteLength", "contentDigest", "status"], "properties": {"path": {"const": "cross-engine-summary.v3.json"}, "rawSha256": {"$ref": "#/$defs/sha"}, "byteLength": {"type": "integer", "minimum": 1}, "contentDigest": {"$ref": "#/$defs/sha"}, "status": {"const": "complete"}}},
    "manifestBinding": {"type": "object", "additionalProperties": false, "required": ["path", "schemaPath", "rawSha256", "schemaSha256", "contentDigest", "inventoryDigest", "listedPayloadCount", "selfManifestExcluded", "evidenceRootExcluded"], "properties": {"path": {"const": "evidence-manifest.v3.json"}, "schemaPath": {"type": "string", "minLength": 1}, "rawSha256": {"$ref": "#/$defs/sha"}, "schemaSha256": {"$ref": "#/$defs/sha"}, "contentDigest": {"$ref": "#/$defs/sha"}, "inventoryDigest": {"$ref": "#/$defs/sha"}, "listedPayloadCount": {"const": 26}, "selfManifestExcluded": {"const": true}, "evidenceRootExcluded": {"const": true}}}
  }
}
