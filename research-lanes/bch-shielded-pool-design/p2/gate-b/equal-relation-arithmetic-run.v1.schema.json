{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/equal-relation-arithmetic-run.v1.schema.json",
  "title": "Gate-B0 arithmetic component run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runId",
    "runMode",
    "trackId",
    "trackOrder",
    "trackPosition",
    "cohortEpochId",
    "status",
    "contentDigest",
    "selection",
    "tupleRef",
    "evidenceClassification",
    "descriptorBinding",
    "campaignBinding",
    "hostProfileBinding",
    "corpus",
    "toolchains",
    "artifacts",
    "artifactSchemaBindings",
    "engines",
    "crossEngineSummary"
  ],
  "properties": {
    "schema": { "const": "shieldkit-labs/p2-gate-b/equal-relation-arithmetic-run/v1" },
    "runId": { "$ref": "#/$defs/id" },
    "runMode": { "enum": ["non-ranking-harness-shakedown", "full-cohort-epoch"] },
    "trackId": { "enum": ["track:canonical-schoolbook", "track:optimized"] },
    "trackOrder": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "enum": ["track:canonical-schoolbook", "track:optimized"] }, "uniqueItems": true },
    "trackPosition": { "type": "integer", "minimum": 0, "maximum": 1 },
    "cohortEpochId": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
    "status": { "enum": ["measured-component-only", "failed", "formal-coverage-blocked"] },
    "contentDigest": { "$ref": "#/$defs/contentDigest" },
    "selection": { "const": "none" },
    "tupleRef": { "type": "null" },
    "evidenceClassification": { "const": "gate-b0-primitive-evidence-only" },
    "descriptorBinding": { "$ref": "#/$defs/contentBinding" },
    "campaignBinding": { "$ref": "#/$defs/contentBinding" },
    "hostProfileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "profileRef"],
      "properties": {
        "path": { "const": "profiles/bch-current-2026-08-08.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "profileRef": { "const": "profile:bch-current-2026-08-08" }
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seedHex", "generator", "digest", "counts"],
      "properties": {
        "seedHex": { "const": "0123456789abcdef" },
        "generator": { "const": "sha256-counter-rejection-v2" },
        "digest": { "$ref": "#/$defs/sha256" },
        "counts": { "type": "array", "minItems": 15, "maxItems": 15, "items": { "$ref": "#/$defs/count" }, "uniqueItems": true }
      }
    },
    "toolchains": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/toolchain" }, "uniqueItems": true },
    "artifacts": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "$ref": "#/$defs/artifact" }, "uniqueItems": true },
    "artifactSchemaBindings": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/artifactSchemaBinding" }, "uniqueItems": true },
    "engines": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/engine" }, "uniqueItems": true },
    "crossEngineSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdictAgreement", "metricCoverageAgreement", "summaryArtifactDigest"],
      "properties": {
        "verdictAgreement": { "type": "boolean" },
        "metricCoverageAgreement": { "type": "boolean" },
        "summaryArtifactDigest": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "runMode": { "const": "non-ranking-harness-shakedown" } }, "required": ["runMode"] },
      "then": { "properties": { "cohortEpochId": { "type": "null" } } },
      "else": { "properties": { "cohortEpochId": { "$ref": "#/$defs/id" } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*){1,8}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
    "contentDigest": { "type": "object", "additionalProperties": false, "required": ["algorithm", "value"], "properties": { "algorithm": { "const": "sha256-jcs-omit-contentDigest" }, "value": { "$ref": "#/$defs/sha256" } } },
    "contentBinding": { "type": "object", "additionalProperties": false, "required": ["path", "fileDigest", "contentDigest"], "properties": { "path": { "$ref": "#/$defs/path" }, "fileDigest": { "$ref": "#/$defs/sha256" }, "contentDigest": { "$ref": "#/$defs/sha256" } } },
    "count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationId", "categoryId", "cases", "operandSamples", "limbSamples"],
      "properties": {
        "relationId": { "enum": ["relation:e-mac", "relation:e-square-mac", "relation:e-inverse-check"] },
        "categoryId": { "enum": ["category:valid", "category:boundary", "category:random", "category:metamorphic", "category:malformed"] },
        "cases": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
        "operandSamples": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
        "limbSamples": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineId", "sourceCommit", "sourceStatusPath", "sourceStatusDigest", "lockfilePath", "lockfileDigest", "buildManifestPath", "buildDigest", "commandPath", "commandDigest", "dirty"],
      "properties": {
        "engineId": { "enum": ["engine:native", "engine:libauth", "engine:bchn", "engine:leanbch"] },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "sourceStatusPath": { "$ref": "#/$defs/path" },
        "sourceStatusDigest": { "$ref": "#/$defs/sha256" },
        "lockfilePath": { "$ref": "#/$defs/path" },
        "lockfileDigest": { "$ref": "#/$defs/sha256" },
        "buildManifestPath": { "$ref": "#/$defs/path" },
        "buildDigest": { "$ref": "#/$defs/sha256" },
        "commandPath": { "$ref": "#/$defs/path" },
        "commandDigest": { "$ref": "#/$defs/sha256" },
        "dirty": { "type": "boolean", "description": "True iff any source root used by this engine was dirty; dirty state is admissible only when the bound source-status artifact records it exactly." }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "kind", "artifactSchema", "path", "sha256"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["corpus", "native-result", "libauth-result", "bchn-result", "leanbch-result", "metric-report", "cross-engine-summary"] },
        "artifactSchema": { "enum": ["content-addressed-corpus", "shieldkit-labs/p2-gate-b/arithmetic-engine-result/v1", "shieldkit-labs/p2-gate-b/arithmetic-metric-report/v1", "shieldkit-labs/p2-gate-b/arithmetic-cross-engine-summary/v1"] },
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifactSchemaBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaId", "path", "sha256"],
      "properties": {
        "schemaId": { "enum": ["shieldkit-labs/p2-gate-b/arithmetic-engine-result/v1", "shieldkit-labs/p2-gate-b/arithmetic-metric-report/v1", "shieldkit-labs/p2-gate-b/arithmetic-cross-engine-summary/v1"] },
        "path": { "enum": ["p2/gate-b/equal-relation-arithmetic-engine-result.v1.schema.json", "p2/gate-b/equal-relation-arithmetic-metric-report.v1.schema.json", "p2/gate-b/equal-relation-arithmetic-cross-engine-summary.v1.schema.json"] },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineId", "status", "rawArtifactDigest", "metricIds"],
      "properties": {
        "engineId": { "enum": ["engine:native", "engine:libauth", "engine:bchn", "engine:leanbch"] },
        "status": { "enum": ["measured", "failed", "explicit-unsupported"] },
        "rawArtifactDigest": { "$ref": "#/$defs/sha256" },
        "metricIds": { "type": "array", "description": "Exact metric records present in the engine artifact. Presence requires an explicit measured, derived-common, not-applicable, or not-exposed status; it does not claim native exposure for every metric.", "items": { "enum": ["verdict", "lockingBytes", "unlockingBytes", "sourceBytes", "opcodeHistogram", "mulByteProduct", "divByteProduct", "modByteProduct", "resultPushBytes", "vmCost", "opCost", "stackMax", "elementMax", "limits", "headroom"] }, "uniqueItems": true }
      }
    }
  }
}
