{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shieldkit-labs/p2/gate-b/gate-b1-relation-version-pivot-decision-language/v1/pivot-trigger/v1",
  "title": "Gate B1 Relation Version Pivot Decision Language Pivot Trigger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordKind",
    "triggerId",
    "status",
    "triggerClass",
    "basisRefs",
    "affectedBranchSlotIds",
    "relationRef",
    "relationSemanticsId",
    "authority",
    "credit"
  ],
  "properties": {
    "recordKind": {
      "type": "string",
      "const": "PIVOT_TRIGGER"
    },
    "triggerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "status": {
      "enum": [
        "PROPOSED_NO_CREDIT",
        "REJECTED_NO_CREDIT",
        "ACCEPTED_FOR_FEASIBILITY_REVIEW_NO_CREDIT"
      ]
    },
    "triggerClass": {
      "enum": [
        "SOURCE_CONTRADICTION",
        "INTERFACE_ERASURE",
        "VERSION_INCOMPATIBILITY",
        "SUPERVISORY_REVIEW_REQUEST"
      ]
    },
    "basisRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
      }
    },
    "affectedBranchSlotIds": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
      }
    },
    "relationRef": {
      "type": "null",
      "const": null
    },
    "relationSemanticsId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value"
      ],
      "properties": {
        "status": {
          "const": "UNASSIGNED"
        },
        "value": {
          "type": "null",
          "const": null
        }
      }
    },
    "authority": {
      "const": "NONE"
    },
    "credit": {
      "const": "NONE"
    }
  },
  "allOf": [
    true
  ]
}
