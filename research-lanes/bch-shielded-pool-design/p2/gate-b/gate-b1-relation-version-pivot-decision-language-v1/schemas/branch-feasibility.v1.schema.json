{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shieldkit-labs/p2/gate-b/gate-b1-relation-version-pivot-decision-language/v1/branch-feasibility/v1",
  "title": "Gate B1 Relation Version Pivot Decision Language Branch Feasibility v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordKind",
    "feasibilityId",
    "status",
    "triggerId",
    "branchSlotId",
    "criterionRefs",
    "unresolvedBlockerIds",
    "relationRef",
    "relationSemanticsId",
    "authority",
    "credit"
  ],
  "properties": {
    "recordKind": {
      "type": "string",
      "const": "BRANCH_FEASIBILITY"
    },
    "feasibilityId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "status": {
      "enum": [
        "PLANNED_NO_CREDIT",
        "INFEASIBLE_NO_CREDIT",
        "FEASIBLE_FOR_BRANCH_RULING_NO_CREDIT"
      ]
    },
    "triggerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "branchSlotId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "criterionRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
      }
    },
    "unresolvedBlockerIds": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
      }
    },
    "relationRef": {
      "type": "null",
      "const": null
    },
    "relationSemanticsId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value"
      ],
      "properties": {
        "status": {
          "const": "UNASSIGNED"
        },
        "value": {
          "type": "null",
          "const": null
        }
      }
    },
    "authority": {
      "const": "NONE"
    },
    "credit": {
      "const": "NONE"
    }
  },
  "allOf": [
    true
  ]
}
