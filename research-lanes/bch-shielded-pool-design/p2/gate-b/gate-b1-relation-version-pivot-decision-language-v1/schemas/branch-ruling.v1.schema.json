{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shieldkit-labs/p2/gate-b/gate-b1-relation-version-pivot-decision-language/v1/branch-ruling/v1",
  "title": "Gate B1 Relation Version Pivot Decision Language Branch Ruling v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordKind",
    "rulingId",
    "status",
    "triggerId",
    "feasibilityIds",
    "subjectBranchSlotId",
    "selectedBranchSlotId",
    "relationRef",
    "relationSemanticsId",
    "authority",
    "credit"
  ],
  "properties": {
    "recordKind": {
      "type": "string",
      "const": "BRANCH_RULING"
    },
    "rulingId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "status": {
      "enum": [
        "NO_BRANCH_SELECTED",
        "BRANCH_REJECTED_NO_CREDIT",
        "BRANCH_SELECTED_PENDING_SEPARATE_RELATION_SEMANTICS_AUTHORITY_NO_CREDIT"
      ]
    },
    "triggerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "feasibilityIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
      }
    },
    "subjectBranchSlotId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "selectedBranchSlotId": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
        }
      ]
    },
    "relationRef": {
      "type": "null",
      "const": null
    },
    "relationSemanticsId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value"
      ],
      "properties": {
        "status": {
          "const": "UNASSIGNED"
        },
        "value": {
          "type": "null",
          "const": null
        }
      }
    },
    "authority": {
      "const": "NONE"
    },
    "credit": {
      "const": "NONE"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "NO_BRANCH_SELECTED"
          }
        }
      },
      "then": {
        "properties": {
          "selectedBranchSlotId": {
            "type": "null",
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "BRANCH_REJECTED_NO_CREDIT"
          }
        }
      },
      "then": {
        "properties": {
          "selectedBranchSlotId": {
            "type": "null",
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "BRANCH_SELECTED_PENDING_SEPARATE_RELATION_SEMANTICS_AUTHORITY_NO_CREDIT"
          }
        }
      },
      "then": {
        "properties": {
          "selectedBranchSlotId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
          }
        }
      }
    }
  ]
}
