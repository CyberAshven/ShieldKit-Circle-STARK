{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://shieldkit-labs.local/p2/gate-b/cohort-attempt-accounting-v1/causal-batch-state.v1.schema.json",
  "type":"object", "additionalProperties":false,
  "required":["schema","attemptIndex","engineOrder","states","agreementEligible","reusable","normalized","crossEngine","ranking","selection","status","contentDigest"],
  "properties":{
    "schema":{"const":"shieldkit-labs/p2/gate-b/cohort-attempt-accounting-v1/causal-batch-state/v1"}, "attemptIndex":{"const":1},
    "engineOrder":{"const":["engine:native","engine:libauth","engine:bchn","engine:leanbch"]}, "states":{"type":"array","minItems":5,"maxItems":5,"items":{"$ref":"https://shieldkit-labs.local/p2/gate-b/cohort-attempt-accounting-v1/future-endpoint.v1.schema.json#/$defs/state"}},
    "agreementEligible":{"const":false}, "reusable":{"const":false}, "normalized":{"type":"null"}, "crossEngine":{"type":"null"}, "ranking":{"type":"null"}, "selection":{"type":"null"}, "status":{"const":"failure-causal-record-only"}, "contentDigest":{"$ref":"#/$defs/digest"}
  },
  "$defs":{
