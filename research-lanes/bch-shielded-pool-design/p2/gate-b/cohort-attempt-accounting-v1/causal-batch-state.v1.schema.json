    "digest":{"type":"object","additionalProperties":false,"required":["algorithm","canonicalization","domain","frame","value"],"properties":{"algorithm":{"const":"sha256"},"canonicalization":{"const":"recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"},"domain":{"type":"string"},"frame":{"const":"utf8(domain)||0x00||canonical-json-utf8"},"value":{"$ref":"#/$defs/sha"}}},
    "state":{"$ref":"https://shieldkit-labs.local/p2/gate-b/cohort-attempt-accounting-v1/future-endpoint.v1.schema.json#/$defs/state"}
  }
