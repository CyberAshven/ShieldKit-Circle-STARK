{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-attempt-accounting-v1/future-endpoint.v1.schema.json",
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "exitCode": {"type": "integer", "minimum": 0, "maximum": 255},
    "monotonicNanoseconds": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)$"},
    "signalName": {"enum": ["SIGABRT", "SIGALRM", "SIGBUS", "SIGCHLD", "SIGCONT", "SIGFPE", "SIGHUP", "SIGILL", "SIGINT", "SIGIO", "SIGIOT", "SIGKILL", "SIGPIPE", "SIGPOLL", "SIGPROF", "SIGPWR", "SIGQUIT", "SIGSEGV", "SIGSTKFLT", "SIGSTOP", "SIGSYS", "SIGTERM", "SIGTRAP", "SIGTSTP", "SIGTTIN", "SIGTTOU", "SIGURG", "SIGUSR1", "SIGUSR2", "SIGVTALRM", "SIGWINCH", "SIGXCPU", "SIGXFSZ"]},
    "digest": {"type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "domain", "frame", "value"], "properties": {"algorithm": {"const": "sha256"}, "canonicalization": {"const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"}, "domain": {"type": "string", "minLength": 1}, "frame": {"const": "utf8(domain)||0x00||canonical-json-utf8"}, "value": {"$ref": "#/$defs/sha"}}},
    "binding": {"type": "object", "additionalProperties": false, "required": ["path", "rawSha256", "contentDigest"], "properties": {"path": {"type": "string", "minLength": 1}, "rawSha256": {"$ref": "#/$defs/sha"}, "contentDigest": {"$ref": "#/$defs/digest"}}},
    "opaqueBinding": {"type": "object", "additionalProperties": false, "required": ["path", "rawSha256"], "properties": {"path": {"type": "string", "minLength": 1}, "rawSha256": {"$ref": "#/$defs/sha"}}},
    "invocation": {"type": "object", "additionalProperties": false, "required": ["argv", "cwd", "environment", "runtime", "engineBinding", "entrypointBinding", "entrypointKind"], "properties": {"argv": {"anyOf": [{"type": "null"}, {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}]}, "cwd": {"type": "string", "minLength": 1}, "environment": {"type": "object", "additionalProperties": {"type": "string"}}, "runtime": {"type": "object", "additionalProperties": false, "required": ["executable", "version", "platform", "arch"], "properties": {"executable": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "platform": {"type": "string", "minLength": 1}, "arch": {"type": "string", "minLength": 1}}}, "engineBinding": {"$ref": "#/$defs/binding"}, "entrypointBinding": {"$ref": "#/$defs/opaqueBinding"}, "entrypointKind": {"enum": ["module", "external"]}}},
    "outcome": {"type": "object", "additionalProperties": false, "required": ["observedExitCode", "observedSignal", "observedCloseAtMonotonicNanoseconds", "observedOutcomeAttribution", "terminalClosure"], "properties": {"observedExitCode": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/exitCode"}]}, "observedSignal": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/signalName"}]}, "observedCloseAtMonotonicNanoseconds": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/monotonicNanoseconds"}]}, "observedOutcomeAttribution": {"anyOf": [{"type": "null"}, {"const": "not-attributed-to-requested-signal"}]}, "terminalClosure": {"enum": ["not-started", "module-complete", "module-error", "exit", "signal", "timeout", "capture-limit", "spawn-error", "executor-abort", "abrupt-unobserved", "parser-after-complete"]}}},
    "dispatchError": {"type": "object", "additionalProperties": false, "required": ["name", "code", "messageRawSha256"], "properties": {"name": {"type": "string", "minLength": 1}, "code": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]}, "messageRawSha256": {"$ref": "#/$defs/sha"}}},
    "dispatchResult": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["kind", "value", "error"], "properties": {"kind": {"const": "returned"}, "value": {"type": "boolean"}, "error": {"type": "null"}}}, {"type": "object", "additionalProperties": false, "required": ["kind", "value", "error"], "properties": {"kind": {"const": "threw"}, "value": {"type": "null"}, "error": {"$ref": "#/$defs/dispatchError"}}}]},
    "killAttempt": {"type": "object", "additionalProperties": false, "required": ["ordinal", "reason", "signal", "graceMilliseconds", "requestedAtMonotonicNanoseconds", "closeObservedBeforeRequest", "dispatchResult"], "properties": {"ordinal": {"type": "integer", "minimum": 0, "maximum": 1}, "reason": {"enum": ["timeout", "capture-limit", "executor-abort"]}, "signal": {"enum": ["SIGTERM", "SIGKILL"]}, "graceMilliseconds": {"type": "integer", "minimum": 0}, "requestedAtMonotonicNanoseconds": {"$ref": "#/$defs/monotonicNanoseconds"}, "closeObservedBeforeRequest": {"const": false}, "dispatchResult": {"$ref": "#/$defs/dispatchResult"}}},
    "lifecycle": {"type": "object", "additionalProperties": false, "required": ["kind", "spawnAttempted", "spawnSucceeded", "startObserved", "exitEventObserved", "closeEventObserved", "stdoutEndObserved", "stderrEndObserved", "observedExitCode", "observedSignal", "killAttempts", "capExceeded", "spawnError", "stdinWriteError", "transportError", "controllerError", "streamsFsynced", "terminationKind", "invocationStarted", "returned", "threw", "moduleErrorClass", "moduleErrorMessageDigest", "captureClosed"], "properties": {"kind": {"enum": ["external-process", "module-ndjson"]}, "spawnAttempted": {"type": "boolean"}, "spawnSucceeded": {"type": "boolean"}, "startObserved": {"type": "boolean"}, "exitEventObserved": {"type": "boolean"}, "closeEventObserved": {"type": "boolean"}, "stdoutEndObserved": {"type": "boolean"}, "stderrEndObserved": {"type": "boolean"}, "observedExitCode": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/exitCode"}]}, "observedSignal": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/signalName"}]}, "killAttempts": {"type": "array", "minItems": 0, "maxItems": 2, "items": {"$ref": "#/$defs/killAttempt"}}, "capExceeded": {"type": "boolean"}, "spawnError": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/dispatchError"}]}, "stdinWriteError": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/dispatchError"}]}, "transportError": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/dispatchError"}]}, "controllerError": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/dispatchError"}]}, "streamsFsynced": {"type": "boolean"}, "terminationKind": {"enum": ["not-started", "exit", "signal", "timeout", "capture-limit", "spawn-error", "executor-abort", "abrupt-unobserved", "parser-after-complete", "module-complete", "module-error"]}, "invocationStarted": {"type": "boolean"}, "returned": {"type": "boolean"}, "threw": {"type": "boolean"}, "moduleErrorClass": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]}, "moduleErrorMessageDigest": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]}, "captureClosed": {"type": "boolean"}}},
    "prefix": {"type": "object", "additionalProperties": false, "required": ["byteLength", "rawSha256", "completedRowCount", "trailingFragmentByteLength", "trailingFragmentRawSha256"], "properties": {"byteLength": {"type": "integer", "minimum": 0}, "rawSha256": {"$ref": "#/$defs/sha"}, "completedRowCount": {"type": "integer", "minimum": 0}, "trailingFragmentByteLength": {"type": "integer", "minimum": 0}, "trailingFragmentRawSha256": {"$ref": "#/$defs/sha"}}},
    "stream": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["streamRole", "path", "byteLength", "rawSha256", "captureStatus", "lineAligned", "fsynced"], "properties": {"streamRole": {"enum": ["stdin", "stdout", "stderr"]}, "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"}, "byteLength": {"type": "integer", "minimum": 0}, "rawSha256": {"$ref": "#/$defs/sha"}, "captureStatus": {"enum": ["complete", "partial"]}, "lineAligned": {"type": "boolean"}, "fsynced": {"const": true}}}, {"type": "object", "additionalProperties": false, "required": ["streamRole", "path", "byteLength", "rawSha256", "captureStatus", "lineAligned", "fsynced"], "properties": {"streamRole": {"enum": ["stdin", "stdout", "stderr"]}, "path": {"type": "null"}, "byteLength": {"type": "null"}, "rawSha256": {"type": "null"}, "captureStatus": {"const": "unavailable"}, "lineAligned": {"const": false}, "fsynced": {"const": false}}}]},
    "endpoint": {"type": "object", "additionalProperties": false, "required": ["schema", "attemptIndex", "engineId", "engineOrdinal", "endpointRole", "endpointKind", "invocation", "status", "outcome", "lifecycle", "streams", "combinedOutputBytes", "fsyncOnClose", "moduleNdjsonPrefix", "rowPrefixCardinality", "fsyncPerCompletedRow", "contentDigest"], "properties": {"schema": {"const": "shieldkit-labs/p2/gate-b/cohort-attempt-accounting-v1/endpoint-stream-binding/v1"}, "attemptIndex": {"const": 1}, "engineId": {"enum": ["engine:native", "engine:libauth", "engine:bchn", "engine:leanbch"]}, "engineOrdinal": {"type": "integer", "minimum": 0, "maximum": 3}, "endpointRole": {"enum": ["primary", "secondary"]}, "endpointKind": {"enum": ["external-process", "module-ndjson"]}, "invocation": {"$ref": "#/$defs/invocation"}, "status": {"enum": ["started", "not-started"]}, "outcome": {"$ref": "#/$defs/outcome"}, "lifecycle": {"$ref": "#/$defs/lifecycle"}, "streams": {"type": "array", "items": {"$ref": "#/$defs/stream"}}, "combinedOutputBytes": {"type": "integer", "minimum": 0}, "fsyncOnClose": {"type": "boolean"}, "moduleNdjsonPrefix": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/prefix"}]}, "rowPrefixCardinality": {"type": "integer", "minimum": 0}, "fsyncPerCompletedRow": {"type": "boolean"}, "contentDigest": {"$ref": "#/$defs/digest"}}},
    "inventory": {"type": "object", "additionalProperties": false, "required": ["engineId", "engineOrdinal", "endpointRole", "streamRole", "path", "byteLength", "rawSha256", "captureStatus", "lineAligned", "fsynced"], "properties": {"engineId": {"enum": ["engine:native", "engine:libauth", "engine:bchn", "engine:leanbch"]}, "engineOrdinal": {"type": "integer", "minimum": 0, "maximum": 3}, "endpointRole": {"enum": ["primary", "secondary"]}, "streamRole": {"enum": ["stdin", "stdout", "stderr"]}, "path": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"}]}, "byteLength": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]}, "rawSha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]}, "captureStatus": {"enum": ["complete", "partial", "unavailable"]}, "lineAligned": {"type": "boolean"}, "fsynced": {"type": "boolean"}}},
    "state": {"type": "object", "additionalProperties": false, "required": ["causalOrdinal", "engineId", "engineOrdinal", "endpointRole", "state", "basis", "failureStage", "endpointObservedExitCode", "streams", "observations", "verdicts", "metrics", "agreementEligible", "reusable"], "properties": {"causalOrdinal": {"type": "integer", "minimum": 0, "maximum": 4}, "engineId": {"enum": ["engine:native", "engine:libauth", "engine:bchn", "engine:leanbch"]}, "engineOrdinal": {"type": "integer", "minimum": 0, "maximum": 3}, "endpointRole": {"enum": ["primary", "secondary"]}, "state": {"enum": ["complete-captured-unpublished", "failed", "incomplete", "not-started"]}, "basis": {"enum": ["durable-capture", "durable-endpoint-outcome", "durable-controller-event", "control-flow-inference"]}, "failureStage": {"anyOf": [{"type": "null"}, {"enum": ["parser", "process-exit", "process-signal", "timeout", "capture-limit", "capture-write", "spawn-error", "executor-abort", "abrupt-unobserved", "module-error"]}]}, "endpointObservedExitCode": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/exitCode"}]}, "streams": {"type": "null"}, "observations": {"type": "null"}, "verdicts": {"type": "null"}, "metrics": {"type": "null"}, "agreementEligible": {"const": false}, "reusable": {"const": false}}}
  }
}
