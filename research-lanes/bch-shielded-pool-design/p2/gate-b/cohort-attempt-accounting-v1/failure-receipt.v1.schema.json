{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-attempt-accounting-v1/failure-receipt.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receiptId", "attemptIndex", "status", "authorizationBinding", "contractBinding", "epochBinding", "retryBinding", "claimBinding", "endpointOrder", "endpoints", "causalStates", "observedExitCode", "observedSignal", "observedCloseAtMonotonicNanoseconds", "observedOutcomeAttribution", "terminalClosure", "cap", "parser", "agreementEligible", "reusableByLaterAttempt", "normalized", "crossEngine", "ranking", "selection", "contentDigest"],
  "properties": {
    "schema": {"const": "shieldkit-labs/p2/gate-b/cohort-attempt-accounting-v1/failure-receipt/v1"},
    "receiptId": {"const": "failure-receipt:execution-epoch-gate-b-v2:attempt-001:v1"},
    "attemptIndex": {"const": 1},
    "status": {"enum": ["failed", "incomplete"]},
    "authorizationBinding": {"$ref": "#/$defs/binding"},
    "contractBinding": {"$ref": "#/$defs/binding"},
    "epochBinding": {"$ref": "#/$defs/binding"},
    "retryBinding": {"$ref": "#/$defs/binding"},
    "claimBinding": {"$ref": "#/$defs/binding"},
    "endpointOrder": {"const": ["engine:native/primary", "engine:libauth/primary", "engine:bchn/primary", "engine:leanbch/primary", "engine:leanbch/secondary"]},
    "endpoints": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/endpoint"}},
    "causalStates": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/state"}},
    "observedExitCode": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/exitCode"}]},
    "observedSignal": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/signalName"}]},
    "observedCloseAtMonotonicNanoseconds": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/monotonicNanoseconds"}]},
    "observedOutcomeAttribution": {"anyOf": [{"type": "null"}, {"const": "not-attributed-to-requested-signal"}]},
    "terminalClosure": {"enum": ["module-error", "exit", "signal", "timeout", "capture-limit", "spawn-error", "executor-abort", "abrupt-unobserved", "parser-after-complete"]},
    "cap": {
      "type": "object", "additionalProperties": false,
      "required": ["maxBytesPerExternalEndpoint", "leanAggregateDeadlineMilliseconds", "terminationGraceMilliseconds", "externalEndpointObservedBytes", "leanAggregateObservedMilliseconds"],
      "properties": {
        "maxBytesPerExternalEndpoint": {"type": "integer", "minimum": 0},
        "leanAggregateDeadlineMilliseconds": {"type": "integer", "minimum": 0},
        "terminationGraceMilliseconds": {"type": "integer", "minimum": 0},
        "externalEndpointObservedBytes": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["endpoint", "byteLength"], "properties": {"endpoint": {"enum": ["engine:bchn/primary", "engine:leanbch/primary", "engine:leanbch/secondary"]}, "byteLength": {"type": "integer", "minimum": 0}}}},
        "leanAggregateObservedMilliseconds": {"type": "integer", "minimum": 0}
      }
    },
    "parser": {"type": "object", "additionalProperties": false, "required": ["status", "stage", "error"], "properties": {"status": {"enum": ["not-reached", "failed"]}, "stage": {"enum": ["parser", "none"]}, "error": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]}}},
    "agreementEligible": {"const": false},
    "reusableByLaterAttempt": {"const": false},
    "normalized": {"type": "null"},
    "crossEngine": {"type": "null"},
    "ranking": {"type": "null"},
    "selection": {"type": "null"},
    "contentDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "exitCode": {"type": "integer", "minimum": 0, "maximum": 255},
    "monotonicNanoseconds": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)$"},
    "signalName": {"enum": ["SIGABRT", "SIGALRM", "SIGBUS", "SIGCHLD", "SIGCONT", "SIGFPE", "SIGHUP", "SIGILL", "SIGINT", "SIGIO", "SIGIOT", "SIGKILL", "SIGPIPE", "SIGPOLL", "SIGPROF", "SIGPWR", "SIGQUIT", "SIGSEGV", "SIGSTKFLT", "SIGSTOP", "SIGSYS", "SIGTERM", "SIGTRAP", "SIGTSTP", "SIGTTIN", "SIGTTOU", "SIGURG", "SIGUSR1", "SIGUSR2", "SIGVTALRM", "SIGWINCH", "SIGXCPU", "SIGXFSZ"]},
    "digest": {"type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "domain", "frame", "value"], "properties": {"algorithm": {"const": "sha256"}, "canonicalization": {"const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"}, "domain": {"type": "string", "minLength": 1}, "frame": {"const": "utf8(domain)||0x00||canonical-json-utf8"}, "value": {"$ref": "#/$defs/sha"}}},
    "binding": {"type": "object", "additionalProperties": false, "required": ["path", "rawSha256", "contentDigest"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"}, "rawSha256": {"$ref": "#/$defs/sha"}, "contentDigest": {"$ref": "#/$defs/digest"}}},
    "endpoint": {"$ref": "https://shieldkit-labs.local/p2/gate-b/cohort-attempt-accounting-v1/future-endpoint.v1.schema.json#/$defs/endpoint"},
    "state": {"$ref": "https://shieldkit-labs.local/p2/gate-b/cohort-attempt-accounting-v1/future-endpoint.v1.schema.json#/$defs/state"}
  }
}
