{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-freeze-v2/engine.v2.schema.json",
  "oneOf": [
    {
      "$ref": "#/$defs/snapshotSet"
    },
    {
      "$ref": "#/$defs/artifact"
    }
  ],
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "abs": {
      "type": "string",
      "pattern": "^/[^\\u0000]*$"
    },
    "rel": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "realpath",
        "byteLength",
        "rawSha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/rel"
        },
        "realpath": {
          "$ref": "#/$defs/abs"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "rawSha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "realpath",
        "headCommit",
        "headTree",
        "authorityScope",
        "informationalWorktree"
      ],
      "properties": {
        "root": {
          "$ref": "#/$defs/abs"
        },
        "realpath": {
          "$ref": "#/$defs/abs"
        },
        "headCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "headTree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "authorityScope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "paths",
            "statusPorcelainSha256",
            "trackedDiffSha256",
            "untrackedPathListSha256"
          ],
          "properties": {
            "paths": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/rel"
              }
            },
            "statusPorcelainSha256": {
              "$ref": "#/$defs/sha"
            },
            "trackedDiffSha256": {
              "$ref": "#/$defs/sha"
            },
            "untrackedPathListSha256": {
              "$ref": "#/$defs/sha"
            }
          }
        },
        "informationalWorktree": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dirty",
            "statusPorcelainSha256",
            "excludedFromContentDigest"
          ],
          "properties": {
            "dirty": {
              "type": "boolean"
            },
            "statusPorcelainSha256": {
              "$ref": "#/$defs/sha"
            },
            "excludedFromContentDigest": {
              "const": true
            }
          }
        }
      }
    },
    "repoAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "realpath",
        "headCommit",
        "headTree",
        "authorityScope"
      ],
      "properties": {
        "root": {
          "$ref": "#/$defs/abs"
        },
        "realpath": {
          "$ref": "#/$defs/abs"
        },
        "headCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "headTree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "authorityScope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "paths",
            "statusPorcelainSha256",
            "trackedDiffSha256",
            "untrackedPathListSha256"
          ],
          "properties": {
            "paths": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/rel"
              }
            },
            "statusPorcelainSha256": {
              "$ref": "#/$defs/sha"
            },
            "trackedDiffSha256": {
              "$ref": "#/$defs/sha"
            },
            "untrackedPathListSha256": {
              "$ref": "#/$defs/sha"
            }
          }
        }
      }
    },
    "sourceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootPath",
        "rootRawSha256",
        "contentDigest",
        "plans",
        "planIndexSha256"
      ],
      "properties": {
        "rootPath": {
          "$ref": "#/$defs/rel"
        },
        "rootRawSha256": {
          "$ref": "#/$defs/sha"
        },
        "contentDigest": {
          "$ref": "#/$defs/sha"
        },
        "plans": {
          "const": 42
        },
        "planIndexSha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "argv",
        "cwd",
        "stdoutSha256",
        "firstLine"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/abs"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cwd": {
          "anyOf": [
            {
              "$ref": "#/$defs/abs"
            },
            {
              "type": "null"
            }
          ]
        },
        "stdoutSha256": {
          "$ref": "#/$defs/sha"
        },
        "firstLine": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "commandStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cwd",
        "argv",
        "environment"
      ],
      "properties": {
        "cwd": {
          "$ref": "#/$defs/abs"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "file",
        "argv"
      ],
      "properties": {
        "kind": {
          "enum": [
            "module",
            "external"
          ]
        },
        "file": {
          "$ref": "#/$defs/file"
        },
        "argv": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attestation",
        "inputs",
        "commands",
        "toolchain",
        "binary",
        "command",
        "compiler",
        "linker"
      ],
      "properties": {
        "attestation": {
          "enum": [
            "no-build-applicable",
            "package-integrity-source-pinned-ready",
            "fresh-build-attestation-pending",
            "fresh-build-attested-unexecuted"
          ]
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/commandStep"
          }
        },
        "toolchain": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tool"
          }
        },
        "binary": {
          "anyOf": [
            {
              "$ref": "#/$defs/file"
            },
            {
              "type": "null"
            }
          ]
        },
        "command": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "compiler": {
          "anyOf": [
            {
              "$ref": "#/$defs/tool"
            },
            {
              "type": "null"
            }
          ]
        },
        "linker": {
          "anyOf": [
            {
              "$ref": "#/$defs/tool"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "byteLength",
        "rawSha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "rawSha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "logDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "canonicalization",
        "domain",
        "frame",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "canonicalization": {
          "const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"
        },
        "domain": {
          "type": "string",
          "pattern": "^shieldkit-labs/p2/gate-b/execution-epoch/v2/build-attestation/engine:(?:bchn|leanbch)/logs$"
        },
        "frame": {
          "const": "utf8(domain)||0x00||canonical-json-utf8"
        },
        "value": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "buildAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "engineId",
        "status",
        "evidenceClassification",
        "executionAllowed",
        "vmEvidence",
        "cwd",
        "commands",
        "exitCode",
        "exitCodes",
        "inputs",
        "outputs",
        "toolchain",
        "logs",
        "logDigest"
      ],
      "properties": {
        "schema": {
          "const": "shieldkit-labs/p2/gate-b/cohort-freeze-v2/build-attestation/v1"
        },
        "engineId": {
          "enum": [
            "engine:bchn",
            "engine:leanbch"
          ]
        },
        "status": {
          "const": "fresh-build-attested-unexecuted"
        },
        "evidenceClassification": {
          "const": "build-attestation-only-not-vm-evidence"
        },
        "executionAllowed": {
          "const": false
        },
        "vmEvidence": {
          "type": "null"
        },
        "cwd": {
          "$ref": "#/$defs/abs"
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/commandStep"
          }
        },
        "exitCode": {
          "const": 0
        },
        "exitCodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "const": 0
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "toolchain": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/tool"
          }
        },
        "logs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/log"
          }
        },
        "logDigest": {
          "$ref": "#/$defs/logDigest"
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "supportPolicy",
        "terminalPolicy",
        "executionStatus",
        "unsupportedCountsAsExecution",
        "unsupportedCountsAsAgreement",
        "outerRejectionPhasePolicy",
        "commonComparisonInput",
        "profile"
      ],
      "properties": {
        "category": {
          "enum": [
            "semantic-reference-only",
            "bch-vm"
          ]
        },
        "supportPolicy": {
          "enum": [
            "required",
            "required-or-explicit-unsupported"
          ]
        },
        "terminalPolicy": {
          "const": "supported-or-explicit-unsupported"
        },
        "executionStatus": {
          "const": "execution-not-authorized"
        },
        "unsupportedCountsAsExecution": {
          "const": false
        },
        "unsupportedCountsAsAgreement": {
          "const": false
        },
        "outerRejectionPhasePolicy": {
          "const": "explicit-outer-transaction-or-token-phase-never-script-engine-agreement"
        },
        "commonComparisonInput": {
          "const": "exact-synthetic-one-input-one-output-p2sh32-transaction-v2"
        },
        "profile": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sharedCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminalPolicy",
        "unsupportedCannotCount",
        "relations",
        "categories",
        "preservesCaseIndex",
        "parserBeforeArithmetic"
      ],
      "properties": {
        "terminalPolicy": {
          "const": "supported-or-explicit-unsupported"
        },
        "unsupportedCannotCount": {
          "const": true
        },
        "relations": {
          "const": [
            "relation:e-mac",
            "relation:e-square-mac",
            "relation:e-inverse-check"
          ]
        },
        "categories": {
          "const": [
            "category:valid",
            "category:boundary",
            "category:random",
            "category:metamorphic",
            "category:malformed"
          ]
        },
        "preservesCaseIndex": {
          "const": true
        },
        "parserBeforeArithmetic": {
          "const": true
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engineId",
        "repositorySnapshots",
        "entrypoint",
        "stdinCodec",
        "environment",
        "runtime",
        "modules",
        "adapters",
        "build",
        "capability",
        "sourceSetBinding"
      ],
      "properties": {
        "engineId": {
          "enum": [
            "engine:native",
            "engine:libauth",
            "engine:bchn",
            "engine:leanbch"
          ]
        },
        "repositorySnapshots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/repo"
          }
        },
        "entrypoint": {
          "$ref": "#/$defs/entry"
        },
        "secondaryEntrypoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "stdinCodec": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "minProperties": 1
        },
        "runtime": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          },
          "minProperties": 3
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "adapters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "build": {
          "$ref": "#/$defs/build"
        },
        "capability": {
          "$ref": "#/$defs/capability"
        },
        "sourceSetBinding": {
          "$ref": "#/$defs/sourceSet"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "engineId": {
                "const": "engine:leanbch"
              }
            },
            "required": [
              "engineId"
            ]
          },
          "then": {
            "properties": {
              "environment": {
                "type": "object",
                "required": [
                  "LEANBCH_SECP"
                ],
                "properties": {
                  "LEANBCH_SECP": {
                    "enum": [
                      "reject",
                      "native"
                    ]
                  }
                }
              },
              "secondaryEntrypoints": {
                "type": "array",
                "minItems": 1
              }
            },
            "required": [
              "secondaryEntrypoints"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "engineId": {
                "const": "engine:native"
              }
            },
            "required": [
              "engineId"
            ]
          },
          "then": {
            "properties": {
              "build": {
                "type": "object",
                "properties": {
                  "attestation": {
                    "const": "no-build-applicable"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "engineId": {
                "const": "engine:libauth"
              }
            },
            "required": [
              "engineId"
            ]
          },
          "then": {
            "properties": {
              "build": {
                "type": "object",
                "properties": {
                  "attestation": {
                    "const": "package-integrity-source-pinned-ready"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "engineId": {
                "enum": [
                  "engine:bchn",
                  "engine:leanbch"
                ]
              }
            },
            "required": [
              "engineId"
            ]
          },
          "then": {
            "properties": {
              "build": {
                "type": "object",
                "properties": {
                  "attestation": {
                    "const": "fresh-build-attestation-pending"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "snapshotSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "sourceSetBinding",
        "engines"
      ],
      "properties": {
        "schema": {
          "const": "shieldkit-labs/p2/gate-b/engine-snapshot/v2"
        },
        "status": {
          "const": "snapshot-only-no-vm-execution-no-build"
        },
        "sourceSetBinding": {
          "$ref": "#/$defs/sourceSet"
        },
        "engines": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": false,
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/engine"
                },
                {
                  "type": "object",
                  "properties": {
                    "engineId": {
                      "const": "engine:native"
                    }
                  },
                  "required": [
                    "engineId"
                  ]
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/engine"
                },
                {
                  "type": "object",
                  "properties": {
                    "engineId": {
                      "const": "engine:libauth"
                    }
                  },
                  "required": [
                    "engineId"
                  ]
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/engine"
                },
                {
                  "type": "object",
                  "properties": {
                    "engineId": {
                      "const": "engine:bchn"
                    }
                  },
                  "required": [
                    "engineId"
                  ]
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/engine"
                },
                {
                  "type": "object",
                  "properties": {
                    "engineId": {
                      "const": "engine:leanbch"
                    }
                  },
                  "required": [
                    "engineId"
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "domain",
        "canonicalization",
        "frame",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "canonicalization": {
          "const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"
        },
        "frame": {
          "const": "utf8(domain)||0x00||canonical-json-utf8"
        },
        "value": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "artifactId",
        "path",
        "status",
        "evidenceClassification",
        "selection",
        "executionAllowed",
        "engineId",
        "role",
        "capabilityStatus",
        "capabilities",
        "sourceSetBinding",
        "repositoryAuthority",
        "entrypoint",
        "secondaryEntrypoints",
        "stdinCodec",
        "environment",
        "runtime",
        "sourceInputs",
        "adapterInputs",
        "build",
        "buildAttestation",
        "contentDigest"
      ],
      "properties": {
        "schema": {
          "const": "shieldkit-labs/p2/gate-b/cohort-freeze-v2/engine-artifact/v2"
        },
        "artifactId": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/rel"
        },
        "status": {
          "enum": [
            "no-build-applicable",
            "package-integrity-source-pinned-ready",
            "fresh-build-attestation-pending",
            "fresh-build-attested-unexecuted"
          ]
        },
        "evidenceClassification": {
          "const": "not-evidence"
        },
        "selection": {
          "type": "null"
        },
        "executionAllowed": {
          "const": false
        },
        "engineId": {
          "enum": [
            "engine:native",
            "engine:libauth",
            "engine:bchn",
            "engine:leanbch"
          ]
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "capabilityStatus": {
          "enum": [
            "required",
            "required-or-explicit-unsupported"
          ]
        },
        "capabilities": {
          "$ref": "#/$defs/sharedCapabilities"
        },
        "sourceSetBinding": {
          "$ref": "#/$defs/sourceSet"
        },
        "repositoryAuthority": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/repoAuthority"
          }
        },
        "entrypoint": {
          "$ref": "#/$defs/entry"
        },
        "secondaryEntrypoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "stdinCodec": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "object",
          "minProperties": 1
        },
        "runtime": {
          "type": "object",
          "minProperties": 3
        },
        "sourceInputs": {
          "type": "array",
          "minItems": 1,
          "items": {
