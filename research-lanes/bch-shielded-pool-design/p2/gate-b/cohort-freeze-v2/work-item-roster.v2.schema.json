{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/work-item-roster.v2.schema.json",
  "title": "Gate-B v2 normative work-item roster",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "artifactId", "path", "status", "evidenceClassification", "executionAllowed", "metricsAllowed", "ranking", "selection", "schemaPath", "schemaSha256", "contentDigest", "counts", "normativeArmOrder", "relationOrder", "categoryOrder", "engineOrder", "terminalCells", "workItems"],
  "properties": {
    "schema": { "const": "shieldkit-labs/p2/gate-b/execution-epoch/v2/work-item-roster" },
    "artifactId": { "const": "work-item-roster:gate-b-v2" },
    "path": { "const": "research-lanes/bch-shielded-pool-design/p2/gate-b/cohort-freeze-v2/work-item-roster.v2.json" },
    "schemaPath": { "const": "research-lanes/bch-shielded-pool-design/p2/gate-b/cohort-freeze-v2/work-item-roster.v2.schema.json" }, "schemaSha256": { "$ref": "#/$defs/sha" },
    "status": { "const": "frozen-normative-roster-path-ready" }, "evidenceClassification": { "const": "not-evidence" }, "executionAllowed": { "const": false }, "metricsAllowed": { "const": false }, "ranking": { "type": "null" }, "selection": { "type": "null" },
    "contentDigest": { "$ref": "#/$defs/digest" },
    "counts": { "type": "object", "additionalProperties": false, "required": ["terminalEnginePlanCells", "corpusCases", "armCasesPerEngine", "workItems"], "properties": { "terminalEnginePlanCells": { "const": 168 }, "corpusCases": { "const": 1288 }, "armCasesPerEngine": { "const": 4732 }, "workItems": { "const": 18928 } } },
    "normativeArmOrder": { "type": "array", "minItems": 14, "maxItems": 14, "items": { "type": "string", "minLength": 1 } },
    "relationOrder": { "const": ["relation:e-mac", "relation:e-square-mac", "relation:e-inverse-check"] },
    "categoryOrder": { "const": ["category:valid", "category:boundary", "category:random", "category:metamorphic", "category:malformed"] },
    "engineOrder": { "const": ["engine:native", "engine:libauth", "engine:bchn", "engine:leanbch"] },
    "terminalCells": { "type": "array", "minItems": 168, "maxItems": 168, "items": { "$ref": "#/$defs/terminalCell" } },
    "workItems": { "type": "array", "minItems": 18928, "maxItems": 18928, "items": { "$ref": "#/$defs/workItem" } }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "digest": { "type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "domain", "frame", "value"], "properties": { "algorithm": { "const": "sha256" }, "canonicalization": { "const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1" }, "domain": { "const": "shieldkit-labs/p2/gate-b/execution-epoch/v2/work-item-roster" }, "frame": { "const": "utf8(domain)||0x00||canonical-json-utf8" }, "value": { "$ref": "#/$defs/sha" } } },
    "terminalCell": { "type": "object", "additionalProperties": false, "required": ["terminalCellId", "planId", "engineId"], "properties": { "terminalCellId": { "type": "string", "minLength": 1 }, "planId": { "type": "string", "minLength": 1 }, "engineId": { "enum": ["engine:native", "engine:libauth", "engine:bchn", "engine:leanbch"] } } },
    "workItem": { "type": "object", "additionalProperties": false, "required": ["workItemId", "armId", "planId", "planBytecodeSha256", "constructionIndex", "constructionId", "relationId", "categoryId", "caseIndex", "caseKey", "caseDigest", "vectorAttempt", "fixtureKey", "engineId", "terminalCellId"], "properties": { "workItemId": { "type": "string", "minLength": 1 }, "armId": { "type": "string", "minLength": 1 }, "planId": { "type": "string", "minLength": 1 }, "planBytecodeSha256": { "$ref": "#/$defs/sha" }, "constructionIndex": { "type": "integer", "minimum": 0, "maximum": 3 }, "constructionId": { "type": "string", "minLength": 1 }, "relationId": { "enum": ["relation:e-mac", "relation:e-square-mac", "relation:e-inverse-check"] }, "categoryId": { "enum": ["category:valid", "category:boundary", "category:random", "category:metamorphic", "category:malformed"] }, "caseIndex": { "type": "integer", "minimum": 0 }, "caseKey": { "type": "string", "minLength": 1 }, "caseDigest": { "$ref": "#/$defs/sha" }, "vectorAttempt": { "type": "integer", "minimum": 0 }, "fixtureKey": { "type": "string", "minLength": 1 }, "engineId": { "enum": ["engine:native", "engine:libauth", "engine:bchn", "engine:leanbch"] }, "terminalCellId": { "type": "string", "minLength": 1 } } }
  }
}
