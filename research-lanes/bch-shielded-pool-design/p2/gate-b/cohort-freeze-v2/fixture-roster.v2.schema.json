{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/fixture-roster.v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "artifactId", "status", "evidenceClassification", "executionAllowed", "metricsAllowed", "ranking", "selection", "sourceSet", "corpus", "fixtureDerivation", "normativeArmOrder", "relationOrder", "categoryOrder", "engineOrder", "armCatalog", "counts", "records", "contentDigest"],
  "properties": {
    "schema": {"const": "shieldkit-labs/p2/gate-b/execution-epoch/v2/fixture-roster/v2"},
    "artifactId": {"const": "fixture-roster:gate-b-v2"},
    "status": {"const": "frozen-fixture-roster-no-vm-execution"},
    "evidenceClassification": {"const": "not-evidence"},
    "executionAllowed": {"const": false}, "metricsAllowed": {"const": false},
    "ranking": {"type": "null"}, "selection": {"type": "null"},
    "sourceSet": {"$ref": "#/$defs/sourceSetBinding"},
    "corpus": {"$ref": "#/$defs/corpusBinding"},
    "fixtureDerivation": {"$ref": "#/$defs/fixtureDerivation"},
    "normativeArmOrder": {"const": ["arm:canonical:m89-d2-canonical-schoolbook-v1", "arm:canonical:m61-d3-canonical-schoolbook-v1", "arm:canonical:m31-d5-canonical-schoolbook-v1", "arm:canonical:m31-d6-canonical-schoolbook-v1", "arm:optimized:m31-d6-tower3x2-quadratic-toom3-v1", "arm:optimized:m31-d6-direct-toom6-v1", "arm:optimized:m31-d6-pairwise-d6-v1", "arm:optimized:m61-d3-toom3-v1", "arm:optimized:m31-d5-toom5-v1", "arm:optimized:m31-d6-tower2x3-six-product-r18-v1", "arm:optimized:m31-d5-pairwise-d5-v1", "arm:optimized:m89-d2-karatsuba-special-square-v1", "arm:optimized:m61-d3-pairwise-d3-v1", "arm:optimized:m31-d6-tower2x3-outer-toom3-v1"]},
    "relationOrder": {"const": ["relation:e-mac", "relation:e-square-mac", "relation:e-inverse-check"]},
    "categoryOrder": {"const": ["category:valid", "category:boundary", "category:random", "category:metamorphic", "category:malformed"]},
    "engineOrder": {"const": ["engine:native", "engine:libauth", "engine:bchn", "engine:leanbch"]},
    "armCatalog": {"type": "array", "minItems": 14, "maxItems": 14, "items": {"$ref": "#/$defs/armCatalog"}},
    "counts": {"$ref": "#/$defs/counts"},
    "records": {"type": "array", "minItems": 4732, "maxItems": 4732, "items": {"$ref": "#/$defs/record"}},
    "contentDigest": {"$ref": "#/$defs/rootDigest"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rootDigest": {"type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "domain", "frame", "value"], "properties": {"algorithm": {"const": "sha256"}, "canonicalization": {"const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"}, "domain": {"const": "shieldkit-labs/p2/gate-b/execution-epoch/v2/fixture-roster"}, "frame": {"const": "utf8(domain)||0x00||canonical-json-utf8"}, "value": {"$ref": "#/$defs/sha"}}},
    "authorityDigest": {"type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "domain", "frame", "value"], "properties": {"algorithm": {"const": "sha256"}, "canonicalization": {"const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"}, "domain": {"type": "string", "minLength": 1}, "frame": {"const": "utf8(domain)||0x00||canonical-json-utf8"}, "value": {"$ref": "#/$defs/sha"}}},
    "recordDigest": {"type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "domain", "frame", "value"], "properties": {"algorithm": {"const": "sha256"}, "canonicalization": {"const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"}, "domain": {"type": "string", "pattern": "^shieldkit-labs/p2/gate-b/execution-epoch/v2/fixture/fixture:[0-9a-f]{64}$"}, "frame": {"const": "utf8(domain)||0x00||canonical-json-utf8"}, "value": {"$ref": "#/$defs/sha"}}},
    "sourceSetBinding": {"type": "object", "additionalProperties": false, "required": ["path", "rawSha256", "schemaPath", "schemaRawSha256", "contentDigest", "planCount"], "properties": {"path": {"const": "p2/source-set-v1/source-set.v1.json"}, "rawSha256": {"$ref": "#/$defs/sha"}, "schemaPath": {"const": "p2/source-set-v1/source-set.v1.schema.json"}, "schemaRawSha256": {"$ref": "#/$defs/sha"}, "contentDigest": {"$ref": "#/$defs/authorityDigest"}, "planCount": {"const": 42}}},
    "corpusBinding": {"type": "object", "additionalProperties": false, "required": ["path", "rawSha256", "schemaPath", "schemaRawSha256", "contentDigest", "caseCount"], "properties": {"path": {"const": "p2/gate-b/cohort-freeze-v2/canonical-corpus.v2.json"}, "rawSha256": {"$ref": "#/$defs/sha"}, "schemaPath": {"const": "p2/gate-b/cohort-freeze-v2/canonical-corpus.v2.schema.json"}, "schemaRawSha256": {"$ref": "#/$defs/sha"}, "contentDigest": {"$ref": "#/$defs/authorityDigest"}, "caseCount": {"const": 1288}}},
    "fixtureDerivation": {"type": "object", "additionalProperties": false, "required": ["path", "rawSha256", "recordSchema", "fixtureKeyDomain", "operandOrder", "executionCeilingBytes"], "properties": {"path": {"const": "p2/gate-b/cohort-freeze-v2/execution-fixture.mjs"}, "rawSha256": {"$ref": "#/$defs/sha"}, "recordSchema": {"const": "shieldkit-labs/p2/gate-b/cohort-freeze-v2/fixture-roster-record/v2"}, "fixtureKeyDomain": {"const": "shieldkit-labs/p2/gate-b/execution-epoch/v2/fixture-key"}, "operandOrder": {"const": "bottom-to-top-exact-raw-bytes-no-normalization"}, "executionCeilingBytes": {"const": 10000}}},
    "armCatalog": {"type": "object", "additionalProperties": false, "required": ["armId", "caseCount", "planIds"], "properties": {"armId": {"type": "string", "minLength": 1}, "caseCount": {"type": "integer", "minimum": 1}, "planIds": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string"}}}},
    "counts": {"type": "object", "additionalProperties": false, "required": ["corpusCases", "armCount", "uniquePlanCaseFixtures", "deduplicatedEngineWorkItems", "preflightReady", "preflightLimitViolations", "preflightLimitViolationScriptSig", "preflightLimitViolationRedeem"], "properties": {"corpusCases": {"const": 1288}, "armCount": {"const": 14}, "uniquePlanCaseFixtures": {"const": 4732}, "deduplicatedEngineWorkItems": {"const": 18928}, "preflightReady": {"const": 4608}, "preflightLimitViolations": {"const": 124}, "preflightLimitViolationScriptSig": {"const": 124}, "preflightLimitViolationRedeem": {"const": 124}}},
    "identity": {"type": "object", "additionalProperties": false, "required": ["constructionIndex", "constructionId", "planId", "caseKey", "caseDigest", "vectorAttempt"], "properties": {"constructionIndex": {"type": "integer", "minimum": 0, "maximum": 3}, "constructionId": {"type": "string", "minLength": 1}, "planId": {"type": "string", "minLength": 1}, "caseKey": {"type": "string", "minLength": 1}, "caseDigest": {"$ref": "#/$defs/sha"}, "vectorAttempt": {"type": "integer", "minimum": 0}}},
    "byteBinding": {"type": "object", "additionalProperties": false, "required": ["byteLength", "sha256"], "properties": {"byteLength": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha"}}},
    "byteBindings": {"type": "object", "additionalProperties": false, "required": ["operandsBottomToTop", "redeemBytecode", "operandUnlockingBytecode", "redeemPush", "unlockingBytecode", "sourceLockingBytecode", "transaction", "sourceOutputs", "outputLockingBytecode"], "properties": {"operandsBottomToTop": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"$ref": "#/$defs/byteBinding"}}, "redeemBytecode": {"$ref": "#/$defs/byteBinding"}, "operandUnlockingBytecode": {"$ref": "#/$defs/byteBinding"}, "redeemPush": {"$ref": "#/$defs/byteBinding"}, "unlockingBytecode": {"$ref": "#/$defs/byteBinding"}, "sourceLockingBytecode": {"$ref": "#/$defs/byteBinding"}, "transaction": {"$ref": "#/$defs/byteBinding"}, "sourceOutputs": {"$ref": "#/$defs/byteBinding"}, "outputLockingBytecode": {"$ref": "#/$defs/byteBinding"}}},
    "violation": {"type": "object", "additionalProperties": false, "required": ["verifiedExecutionCeilingBytes", "scriptSig", "redeem"], "properties": {"verifiedExecutionCeilingBytes": {"const": 10000}, "scriptSig": {"type": "boolean"}, "redeem": {"type": "boolean"}}},
    "executionCeiling": {"type": "object", "additionalProperties": false, "required": ["bytes", "sourcePath", "sourceSymbol"], "properties": {"bytes": {"const": 10000}, "sourcePath": {"const": "src/script/vm_limits.h"}, "sourceSymbol": {"const": "MAX_SCRIPT_SIZE"}}},
    "sourcePlanBinding": {"type": "object", "additionalProperties": false, "required": ["sourceSet", "executionCeiling"], "properties": {"sourceSet": {"type": "object", "additionalProperties": false, "required": ["rootPath", "rootRawSha256", "contentDigest", "planIndexEntrySha256"], "properties": {"rootPath": {"const": "source-set.v1.json"}, "rootRawSha256": {"$ref": "#/$defs/sha"}, "contentDigest": {"$ref": "#/$defs/sha"}, "planIndexEntrySha256": {"$ref": "#/$defs/sha"}}}, "executionCeiling": {"$ref": "#/$defs/executionCeiling"}}},
    "record": {"type": "object", "additionalProperties": false, "required": ["schema", "artifactId", "fixtureKey", "epochIdentity", "planId", "planOrder", "status", "executionAllowed", "sourceBinding", "byteBindings", "preflightLimitViolation", "contentDigest", "armId", "trackId", "relationId", "categoryId", "caseIndex", "engineWorkItemCount"], "properties": {"schema": {"const": "shieldkit-labs/p2/gate-b/cohort-freeze-v2/fixture-roster-record/v2"}, "artifactId": {"const": "artifact:gate-b:cohort-freeze-v2:execution-fixture"}, "fixtureKey": {"type": "string", "pattern": "^fixture:[0-9a-f]{64}$"}, "epochIdentity": {"$ref": "#/$defs/identity"}, "planId": {"type": "string", "minLength": 1}, "planOrder": {"type": "integer", "minimum": 0, "maximum": 41}, "status": {"enum": ["preflight-ready-no-vm-execution", "preflight-limit-violation"]}, "executionAllowed": {"const": false}, "sourceBinding": {"$ref": "#/$defs/sourcePlanBinding"}, "byteBindings": {"$ref": "#/$defs/byteBindings"}, "preflightLimitViolation": {"$ref": "#/$defs/violation"}, "contentDigest": {"$ref": "#/$defs/recordDigest"}, "armId": {"type": "string", "minLength": 1}, "trackId": {"enum": ["track:canonical", "track:optimized"]}, "relationId": {"enum": ["relation:e-mac", "relation:e-square-mac", "relation:e-inverse-check"]}, "categoryId": {"enum": ["category:valid", "category:boundary", "category:random", "category:metamorphic", "category:malformed"]}, "caseIndex": {"type": "integer", "minimum": 0}, "engineWorkItemCount": {"const": 4}}}
  }
}
