{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/campaign.v2.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "campaignId", "status", "evidenceClassification", "selection", "executionAllowed", "metricsAllowed", "rankingAllowed", "contentDigest", "seedHex", "dag", "bindings", "contract"],
  "properties": {
    "schema": {"const": "shieldkit-labs/p2/gate-b/campaign/v2"},
    "campaignId": {"const": "campaign:bch-shielded-pool-design-gate-b-v2"},
    "status": {"const": "contract-only-unmeasured"},
    "evidenceClassification": {"const": "not-evidence"}, "selection": {"type":"null"}, "executionAllowed": {"const": false}, "metricsAllowed": {"const": false}, "rankingAllowed": {"const": false},
    "contentDigest": {"$ref": "#/$defs/digest"}, "seedHex": {"const": "0123456789abcdef"},
    "dag": {"type":"object","additionalProperties":false,"required":["predecessor","successor","rule"],"properties":{"predecessor":{"type":"null"},"successor":{"const":"canonical-corpus:v2"},"rule":{"const":"additive-DAG-C-then-K(C)"}}},
    "bindings": {"type":"object","additionalProperties":false,"required":["scheduleFreeze","loweringFreeze","loweringArmIrFreeze","descriptors","legacyRelationContract","directExtension","executionProfile","sourceSet","planRoster"],"properties": {
      "scheduleFreeze": {"$ref":"#/$defs/freeze"}, "loweringFreeze": {"$ref":"#/$defs/freeze"},
      "loweringArmIrFreeze": {"allOf":[{"$ref":"#/$defs/freeze"},{"type":"object","required":["armCount","planCount"],"properties":{"armCount":{"const":14},"planCount":{"const":42}}}]},
      "descriptors": {"type":"array","minItems":4,"maxItems":4,"items":{"$ref":"#/$defs/pin"}},
      "legacyRelationContract": {"type":"object","additionalProperties":false,"required":["path","rawSha256","schemaPath","schemaSha256"],"properties":{"path":{"const":"p2/gate-b/equal-relation-experiment.v1.json"},"rawSha256":{"$ref":"#/$defs/sha"},"schemaPath":{"const":"p2/gate-b/equal-relation-experiment.schema.json"},"schemaSha256":{"$ref":"#/$defs/sha"}}},
      "directExtension": {"type":"object","additionalProperties":false,"required":["sourcePath","sourceSha256","testPath","testSha256"],"properties":{"sourcePath":{"const":"p2/reference/direct-extension.mjs"},"sourceSha256":{"$ref":"#/$defs/sha"},"testPath":{"const":"p2/reference/direct-extension.test.mjs"},"testSha256":{"$ref":"#/$defs/sha"}}},
      "executionProfile": {"type":"object","additionalProperties":false,"required":["path","rawSha256"],"properties":{"path":{"const":"profiles/bch-current-2026-08-08.json"},"rawSha256":{"$ref":"#/$defs/sha"}}},
      "sourceSet": {"type":"object","additionalProperties":false,"required":["root","schemas","armOrder","planCount","plans"],"properties":{"root":{"$ref":"#/$defs/rootPin"},"schemas":{"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"#/$defs/schemaPin"}},"armOrder":{"type":"array","minItems":14,"maxItems":14,"items":{"$ref":"#/$defs/arm"}},"planCount":{"const":42},"plans":{"type":"array","minItems":42,"maxItems":42,"items":{"$ref":"#/$defs/plan"}}}},
      "planRoster": {"type":"object","additionalProperties":false,"required":["records","contentDigest"],"properties":{"records":{"type":"array","minItems":42,"maxItems":42,"items":{"$ref":"#/$defs/plan"}},"contentDigest":{"$ref":"#/$defs/digest"}}}
    }},
    "contract": {"type":"object","additionalProperties":false,"required":["relationOrder","categoryOrder","constructionOrder","stackAbi","countFormulas","totalsByDegree","mutationFamilies","inverseRule"],"properties": {
      "relationOrder":{"const":["relation:e-mac","relation:e-square-mac","relation:e-inverse-check"]},"categoryOrder":{"const":["category:valid","category:boundary","category:random","category:metamorphic","category:malformed"]},"constructionOrder":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"string"}},"stackAbi":{"type":"object","additionalProperties":false,"required":["relationOperandOrder","orientation"],"properties":{"relationOperandOrder":{"type":"object","additionalProperties":false,"required":["relation:e-mac","relation:e-square-mac","relation:e-inverse-check"],"properties":{"relation:e-mac":{"const":["D","C","B","A"]},"relation:e-square-mac":{"const":["D","C","A"]},"relation:e-inverse-check":{"const":["H","A"]}}},"orientation":{"const":"bottom-to-top; push-left-then-right; binary operator consumes-right-then-left"}}},"countFormulas":{"type":"object","additionalProperties":false,"required":["valid","boundary","random","metamorphic","malformed"],"properties":{"valid":{"const":16},"boundary":{"const":"2*degree+6"},"random":{"const":32},"metamorphic":{"const":16},"malformed":{"const":"7*degree for e-mac/e-square-mac; 8*degree for e-inverse-check"}}},"totalsByDegree":{"const":[266,294,350,378]},"mutationFamilies":{"type":"array","minItems":8,"maxItems":8,"uniqueItems":true,"items":{"type":"string"}},"inverseRule":{"type":"string","minLength":1}
    }}
  },
  "$defs": {
    "sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},"digest":{"type":"object","additionalProperties":false,"required":["algorithm","canonicalization","domain","frame","value"],"properties":{"algorithm":{"const":"sha256"},"canonicalization":{"const":"recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"},"domain":{"type":"string","minLength":1},"frame":{"const":"utf8(domain)||0x00||canonical-json-utf8"},"value":{"$ref":"#/$defs/sha"}}},
    "pin":{"type":"object","additionalProperties":false,"required":["id","path","rawSha256","contentDigest"],"properties":{"id":{"type":"string"},"path":{"type":"string"},"rawSha256":{"$ref":"#/$defs/sha"},"contentDigest":{"$ref":"#/$defs/sha"}}},
    "freeze":{"type":"object","additionalProperties":false,"required":["path","rawSha256","contentDigest"],"properties":{"path":{"type":"string"},"rawSha256":{"$ref":"#/$defs/sha"},"contentDigest":{"$ref":"#/$defs/sha"},"armOrder":{"type":"array","minItems":14,"maxItems":14,"items":{"type":"string"}},"relationTargets":{"const":42},"armCount":{"const":14},"planCount":{"const":42}}},
    "rootPin":{"type":"object","additionalProperties":false,"required":["path","rawSha256","contentDigest"],"properties":{"path":{"const":"p2/source-set-v1/source-set.v1.json"},"rawSha256":{"$ref":"#/$defs/sha"},"contentDigest":{"$ref":"#/$defs/sha"}}},
    "schemaPin":{"type":"object","additionalProperties":false,"required":["path","rawSha256"],"properties":{"path":{"type":"string"},"rawSha256":{"$ref":"#/$defs/sha"}}},
    "arm":{"type":"object","additionalProperties":false,"required":["armId","plans"],"properties":{"armId":{"type":"string"},"plans":{"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/plan"}}}},
    "plan":{"type":"object","additionalProperties":false,"required":["orderIndex","planId","sourcePath","sourceSha256","mapPath","mapSha256","bytecodeSha256"],"properties":{"orderIndex":{"type":"integer","minimum":0,"maximum":41},"planId":{"type":"string"},"sourcePath":{"type":"string"},"sourceSha256":{"$ref":"#/$defs/sha"},"mapPath":{"type":"string"},"mapSha256":{"$ref":"#/$defs/sha"},"bytecodeSha256":{"$ref":"#/$defs/sha"}}}
  }
}
