{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-freeze-v2/manifest.v1.schema.json",
  "title": "ShieldKit Labs Gate-B0 cohort-freeze-v2 package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packageId",
    "status",
    "evidenceClassification",
    "executionAllowed",
    "metricsAllowed",
    "ranking",
    "selection",
    "counts",
    "contentDigests",
    "files"
  ],
  "properties": {
    "schema": { "const": "shieldkit-labs/p2/gate-b/cohort-freeze-v2/manifest/v1" },
    "packageId": { "const": "package:gate-b0-cohort-freeze-v2" },
    "status": { "const": "frozen-contract-only-unexecuted" },
    "evidenceClassification": { "const": "not-execution-evidence" },
    "executionAllowed": { "const": false },
    "metricsAllowed": { "const": false },
    "ranking": { "type": "null" },
    "selection": { "type": "null" },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constructions",
        "arms",
        "plans",
        "corpusCases",
        "uniquePlanCaseFixtures",
        "terminalEnginePlanCells",
        "armCasesPerEngine",
        "workItems",
        "preflightLimitViolations"
      ],
      "properties": {
        "constructions": { "const": 4 },
        "arms": { "const": 14 },
        "plans": { "const": 42 },
        "corpusCases": { "const": 1288 },
        "uniquePlanCaseFixtures": { "const": 4732 },
        "terminalEnginePlanCells": { "const": 168 },
        "armCasesPerEngine": { "const": 4732 },
        "workItems": { "const": 18928 },
        "preflightLimitViolations": { "type": "integer", "minimum": 1 }
      }
    },
    "contentDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign", "corpus", "fixtureRoster", "workItemRoster", "executionEpoch"],
      "properties": {
        "campaign": { "$ref": "#/$defs/sha" },
        "corpus": { "$ref": "#/$defs/sha" },
        "fixtureRoster": { "$ref": "#/$defs/sha" },
        "workItemRoster": { "$ref": "#/$defs/sha" },
        "executionEpoch": { "$ref": "#/$defs/sha" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 20,
      "items": { "$ref": "#/$defs/file" }
    }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orderIndex", "path", "byteCount", "fileDigest"],
      "properties": {
        "orderIndex": { "type": "integer", "minimum": 0 },
        "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
        "byteCount": { "type": "integer", "minimum": 0 },
        "fileDigest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "preimage", "value"],
          "properties": {
            "algorithm": { "const": "sha256" },
            "preimage": { "const": "exact-file-bytes" },
            "value": { "$ref": "#/$defs/sha" }
          }
        }
      }
    }
  }
}
