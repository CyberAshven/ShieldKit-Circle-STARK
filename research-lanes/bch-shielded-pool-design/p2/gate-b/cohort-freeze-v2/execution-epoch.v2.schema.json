{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/execution-epoch.v2.schema.json",
  "title": "ShieldKit Labs Gate-B execution epoch v2 frozen contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "epochId", "status", "evidenceClassification", "executionAllowed", "metricsAllowed", "sourceSet", "campaign", "corpus", "executionProfile", "engineRecords", "fixtureDerivation", "fixtureRoster", "workItemRoster", "physicalSchedule", "execution", "result", "metric", "ranking", "selection", "contentDigest"],
  "properties": {
    "schema": { "const": "shieldkit-labs/p2/gate-b/execution-epoch/v2" },
    "epochId": { "const": "execution-epoch:gate-b-v2" },
    "status": { "const": "frozen-contract-only-unexecuted" },
    "evidenceClassification": { "const": "not-evidence" }, "executionAllowed": { "const": false }, "metricsAllowed": { "const": false },
    "sourceSet": { "$ref": "#/$defs/binding" },
    "campaign": { "$ref": "#/$defs/binding" },
    "corpus": { "$ref": "#/$defs/binding" },
    "executionProfile": { "$ref": "#/$defs/binding" },
    "engineRecords": { "type": "array", "minItems": 4, "maxItems": 4, "prefixItems": [{ "$ref": "#/$defs/engineNative" }, { "$ref": "#/$defs/engineLibauth" }, { "$ref": "#/$defs/engineBchn" }, { "$ref": "#/$defs/engineLeanbch" }], "items": false },
    "fixtureDerivation": { "$ref": "#/$defs/binding" },
    "fixtureRoster": { "$ref": "#/$defs/binding" },
    "workItemRoster": { "$ref": "#/$defs/rosterBinding" },
    "physicalSchedule": { "$ref": "#/$defs/schedule" },
    "execution": { "type": "null" },
    "result": { "type": "null" },
    "metric": { "type": "null" },
    "ranking": { "type": "null" },
    "selection": { "type": "null" },
    "contentDigest": { "$ref": "#/$defs/rootDigest" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "provenanceString": { "type": "string", "minLength": 1, "not": { "enum": ["placeholder", "TODO", "unknown", "null"] } },
    "binding": {
      "type": "object", "additionalProperties": false, "required": ["artifactId", "path", "rawSha256"],
      "properties": { "artifactId": { "$ref": "#/$defs/provenanceString" }, "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" }, "rawSha256": { "$ref": "#/$defs/sha256" }, "schemaSha256": { "$ref": "#/$defs/sha256" }, "contentDigest": { "$ref": "#/$defs/sha256" } }
    },
    "digest": {
      "type": "object", "additionalProperties": false, "required": ["algorithm", "domain", "frame", "value"],
      "properties": { "algorithm": { "const": "sha256" }, "canonicalization": { "const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1" }, "domain": { "type": "string", "minLength": 1 }, "frame": { "const": "utf8(domain)||0x00||canonical-json-utf8" }, "value": { "$ref": "#/$defs/sha256" } }
    },
    "rootDigest": {
      "allOf": [{ "$ref": "#/$defs/digest" }, { "type": "object", "properties": { "domain": { "const": "shieldkit-labs/p2/gate-b/execution-epoch/v2/root" } } }]
    },
    "rosterDigest": {
      "allOf": [{ "$ref": "#/$defs/digest" }, { "type": "object", "properties": { "domain": { "const": "shieldkit-labs/p2/gate-b/execution-epoch/v2/work-item-roster" } } }]
    },
    "rosterBinding": {
      "type": "object", "additionalProperties": false, "required": ["schema", "artifactId", "path", "status", "evidenceClassification", "executionAllowed", "metricsAllowed", "ranking", "selection", "rawSha256", "contentDigest", "counts", "schemaPath", "schemaSha256"],
      "properties": {
        "schema": { "const": "shieldkit-labs/p2/gate-b/execution-epoch/v2/work-item-roster" }, "artifactId": { "const": "work-item-roster:gate-b-v2" }, "path": { "type": "string", "minLength": 1 }, "status": { "const": "frozen-normative-roster-path-ready" }, "evidenceClassification": { "const": "not-evidence" }, "executionAllowed": { "const": false }, "metricsAllowed": { "const": false }, "ranking": { "type": "null" }, "selection": { "type": "null" }, "rawSha256": { "$ref": "#/$defs/sha256" }, "contentDigest": { "$ref": "#/$defs/rosterDigest" }, "schemaPath": { "type": "string", "minLength": 1 }, "schemaSha256": { "$ref": "#/$defs/sha256" },
        "counts": { "type": "object", "additionalProperties": false, "required": ["terminalEnginePlanCells", "corpusCases", "armCasesPerEngine", "workItems"], "properties": { "terminalEnginePlanCells": { "const": 168 }, "corpusCases": { "const": 1288 }, "armCasesPerEngine": { "const": 4732 }, "workItems": { "const": 18928 } } }
      }
    },
    "capabilities": {
      "type": "object", "additionalProperties": false, "required": ["terminalPolicy", "unsupportedCannotCount", "relations", "categories", "preservesCaseIndex", "parserBeforeArithmetic"],
      "properties": {
        "terminalPolicy": { "const": "supported-or-explicit-unsupported" }, "unsupportedCannotCount": { "const": true },
        "relations": { "const": ["relation:e-mac", "relation:e-square-mac", "relation:e-inverse-check"] }, "categories": { "const": ["category:valid", "category:boundary", "category:random", "category:metamorphic", "category:malformed"] }, "preservesCaseIndex": { "const": true }, "parserBeforeArithmetic": { "const": true }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["repository", "commit", "sha256"],
      "properties": { "repository": { "$ref": "#/$defs/provenanceString" }, "commit": { "$ref": "#/$defs/provenanceString" }, "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "engine": {
      "type": "object", "additionalProperties": false, "required": ["engineId", "artifactId", "path", "rawSha256", "contentDigest", "schemaSha256", "capabilityStatus", "role"],
      "properties": { "engineId": { "type": "string", "enum": ["engine:native", "engine:libauth", "engine:bchn", "engine:leanbch"] }, "artifactId": { "$ref": "#/$defs/provenanceString" }, "path": { "type": "string", "minLength": 1 }, "rawSha256": { "$ref": "#/$defs/sha256" }, "contentDigest": { "$ref": "#/$defs/sha256" }, "schemaSha256": { "$ref": "#/$defs/sha256" }, "capabilityStatus": { "$ref": "#/$defs/provenanceString" }, "role": { "$ref": "#/$defs/provenanceString" }, "capabilities": { "$ref": "#/$defs/capabilities" } }
    },
    "engineNative": { "allOf": [{ "$ref": "#/$defs/engine" }, { "type": "object", "properties": { "engineId": { "const": "engine:native" } }, "required": ["engineId"] }] },
    "engineLibauth": { "allOf": [{ "$ref": "#/$defs/engine" }, { "type": "object", "properties": { "engineId": { "const": "engine:libauth" } }, "required": ["engineId"] }] },
    "engineBchn": { "allOf": [{ "$ref": "#/$defs/engine" }, { "type": "object", "properties": { "engineId": { "const": "engine:bchn" } }, "required": ["engineId"] }] },
    "engineLeanbch": { "allOf": [{ "$ref": "#/$defs/engine" }, { "type": "object", "properties": { "engineId": { "const": "engine:leanbch" } }, "required": ["engineId"] }] },
    "schedulePolicy": {
      "type": "object", "additionalProperties": false, "required": ["engineMajorBatches", "maxConcurrency", "warmups", "oneProcessOrModuleLifecyclePerEngineBatch", "automaticRetries", "timeoutMsPerExternalBatch", "cpuAffinity", "timingMetrics", "resultDependentScheduling", "incompleteBatchBlocksEpoch", "retryWholeIdenticalEpochOnly", "rawAttemptAccounting"],
      "properties": { "engineMajorBatches": { "const": true }, "maxConcurrency": { "const": 1 }, "warmups": { "const": 0 }, "oneProcessOrModuleLifecyclePerEngineBatch": { "const": true }, "automaticRetries": { "const": false }, "timeoutMsPerExternalBatch": { "const": 600000 }, "cpuAffinity": { "const": false }, "timingMetrics": { "const": false }, "resultDependentScheduling": { "const": false }, "incompleteBatchBlocksEpoch": { "const": true }, "retryWholeIdenticalEpochOnly": { "const": true }, "rawAttemptAccounting": { "const": true } }
    },
    "schedule": {
      "type": "object", "additionalProperties": false, "required": ["schema", "status", "policy", "batches"],
      "properties": {
        "schema": { "const": "shieldkit-labs/p2/gate-b/execution-epoch/v2/physical-schedule" }, "status": { "const": "frozen-physical-policy" }, "policy": { "$ref": "#/$defs/schedulePolicy" },
        "batches": { "type": "array", "minItems": 4, "maxItems": 4, "prefixItems": [{ "$ref": "#/$defs/batchNative" }, { "$ref": "#/$defs/batchLibauth" }, { "$ref": "#/$defs/batchBchn" }, { "$ref": "#/$defs/batchLeanbch" }], "items": false }
      }
    },
    "batch": { "type": "object", "additionalProperties": false, "required": ["engineId", "workItemIds"], "properties": { "engineId": { "type": "string" }, "workItemIds": { "type": "array", "items": { "type": "string", "minLength": 1 } } } },
    "batchNative": { "allOf": [{ "$ref": "#/$defs/batch" }, { "type": "object", "properties": { "engineId": { "const": "engine:native" } } }] },
    "batchLibauth": { "allOf": [{ "$ref": "#/$defs/batch" }, { "type": "object", "properties": { "engineId": { "const": "engine:libauth" } } }] },
    "batchBchn": { "allOf": [{ "$ref": "#/$defs/batch" }, { "type": "object", "properties": { "engineId": { "const": "engine:bchn" } } }] },
    "batchLeanbch": { "allOf": [{ "$ref": "#/$defs/batch" }, { "type": "object", "properties": { "engineId": { "const": "engine:leanbch" } } }] }
  }
}
