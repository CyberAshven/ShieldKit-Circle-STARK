{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-engine-runtime/v1/libauth-bundle-receipt.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "executionAllowed",
    "bundleMaterialized",
    "inputGraph",
    "requiredExports",
    "requiredSemantics",
    "bundlerSurvey",
    "inputGraphStaticScan",
    "recipe",
    "output",
    "blocker"
  ],
  "properties": {
    "schema": {
      "const": "shieldkit-labs/p2/gate-b/cohort-engine-runtime/v1/libauth-bundle-receipt"
    },
    "status": {
      "const": "fail-closed-no-installed-deterministic-bundler"
    },
    "executionAllowed": {
      "const": false
    },
    "bundleMaterialized": {
      "const": false
    },
    "inputGraph": {
      "const": "libauth-input-graph.v1.json"
    },
    "requiredExports": {
      "const": [
        "decodeTransaction",
        "decodeTransactionOutputs",
        "createVirtualMachineBch2026",
        "vm.evaluate",
        "vm.stateSuccess"
      ]
    },
    "requiredSemantics": {
      "const": {
        "standard": true,
        "verifyCall": false,
        "expectedCorpusInput": false,
        "exactFixtureTransactionAndSourceOutputs": true
      }
    },
    "bundlerSurvey": {
      "const": [
        {
          "tool": "esbuild",
          "status": "absent"
        },
        {
          "tool": "rollup",
          "status": "absent"
        },
        {
          "tool": "webpack",
          "status": "absent"
        }
      ]
    },
    "inputGraphStaticScan": {
      "const": {
        "status": "passed",
        "unresolvedStaticImports": [],
        "dynamicImports": [],
        "requireCalls": [],
        "hostImports": [],
        "nativeAddons": [],
        "networkCalls": []
      }
    },
    "recipe": {
      "const": {
        "entrypoints": [
          "message/transaction-encoding.js",
          "vm/instruction-sets/bch/2026/bch-2026-vm.js"
        ],
        "format": "esm",
        "platform": "node",
        "target": "node22.23",
        "singleFile": true,
        "inlineEmbeddedWasm": true,
        "externalModules": [],
        "forbiddenSourcePatterns": [
          "^\\s*import\\s*\\(",
          "\\brequire\\s*\\(",
          "node:(fs|net|http|https|child_process|dgram|tls)",
          "from ['\"](fs|net|http|https|child_process|dgram|tls)['\"]",
          "\\.node\\b",
          "\\bfetch\\s*\\("
        ],
        "postBundleChecks": [
          "no-unresolved-static-imports",
          "no-dynamic-import",
          "no-require",
          "no-fs-network",
          "no-native-addon",
          "bundle-byte-sha256",
          "export-surface-exact",
          "vm-evaluate-not-verify-static-check"
        ]
      }
    },
    "output": {
      "const": null
    },
    "blocker": {
      "const": "No acceptable installed deterministic bundler was found; no improvised bundler or runtime execution is permitted in this preflight."
    }
  }
}
