{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-engine-runtime/v1/libauth-input-graph.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "executionAllowed",
    "package",
    "entrypoints",
    "fileCount",
    "totalBytes",
    "sortedPathSizeSha256ListDigest",
    "files"
  ],
  "properties": {
    "schema": {
      "const": "shieldkit-labs/p2/gate-b/cohort-engine-runtime/v1/libauth-input-graph"
    },
    "status": {
      "const": "graph-bound-bundle-unmaterialized"
    },
    "executionAllowed": {
      "const": false
    },
    "package": {
      "const": {
        "name": "@bitauth/libauth",
        "version": "3.1.0-next.8",
        "packageJsonRawSha256": "6b4e3b7f062b80782c62cb7732ed01571c5f163fd786af877c0ae5fdc33ec65e",
        "packageLockRawSha256": "a8cbdaa33b94b73edb051a675387cb87171efd3f544ad2b5c5a68f8679026004"
      }
    },
    "entrypoints": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "const": "vm/instruction-sets/bch/2026/bch-2026-vm.js"
        },
        {
          "const": "message/transaction-encoding.js"
        }
      ],
      "items": false
    },
    "fileCount": {
      "const": 80
    },
    "totalBytes": {
      "const": 808913
    },
    "sortedPathSizeSha256ListDigest": {
      "const": "c957412296b6ddb5493a1fe44b8e50b2daceec89c8f5e12f660a7eb4ad222b92"
    },
    "files": {
      "type": "array",
      "minItems": 80,
      "maxItems": 80,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
