{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/equal-relation-arithmetic-cross-engine-summary.v1.schema.json",
  "title": "Gate-B arithmetic cross-engine byte and metric agreement",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "corpusDigest", "verdictAgreement", "metricCoverageAgreement", "cases", "metricAgreements"],
  "properties": {
    "schema": { "const": "shieldkit-labs/p2-gate-b/arithmetic-cross-engine-summary/v1" },
    "corpusDigest": { "$ref": "#/$defs/sha256" },
    "verdictAgreement": { "type": "boolean" },
    "metricCoverageAgreement": { "type": "boolean" },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" }, "uniqueItems": true },
    "metricAgreements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/metricAgreement" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "engineId": { "enum": ["engine:native", "engine:libauth", "engine:bchn", "engine:leanbch"] },
    "metricId": { "enum": ["verdict", "lockingBytes", "unlockingBytes", "sourceBytes", "opcodeHistogram", "mulByteProduct", "divByteProduct", "modByteProduct", "resultPushBytes", "vmCost", "opCost", "stackMax", "elementMax", "limits", "headroom"] },
    "verdict": { "enum": ["accept", "reject"] },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseKey", "fixtureDigest", "transactionDigest", "sourceOutputsDigest", "expectedVerdict", "engineVerdicts"],
      "properties": {
        "caseKey": { "type": "string", "minLength": 1 },
        "fixtureDigest": { "$ref": "#/$defs/sha256" },
        "transactionDigest": { "$ref": "#/$defs/sha256" },
        "sourceOutputsDigest": { "$ref": "#/$defs/sha256" },
        "expectedVerdict": { "$ref": "#/$defs/verdict" },
        "engineVerdicts": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/engineVerdict" }, "uniqueItems": true }
      }
    },
    "engineVerdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineId", "verdict"],
      "properties": { "engineId": { "$ref": "#/$defs/engineId" }, "verdict": { "$ref": "#/$defs/verdict" } }
    },
    "metricAgreement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseKey", "metricId", "status", "comparableEngineIds", "valueDigest"],
      "properties": {
        "caseKey": { "type": "string", "minLength": 1 },
        "metricId": { "$ref": "#/$defs/metricId" },
        "status": { "enum": ["agree", "not-comparable"] },
        "comparableEngineIds": { "type": "array", "items": { "$ref": "#/$defs/engineId" }, "uniqueItems": true },
        "valueDigest": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "agree" } }, "required": ["status"] },
          "then": { "properties": { "comparableEngineIds": { "type": "array", "minItems": 2 }, "valueDigest": { "$ref": "#/$defs/sha256" } } },
          "else": { "properties": { "valueDigest": { "type": "null" } } }
        }
      ]
    }
  }
}
