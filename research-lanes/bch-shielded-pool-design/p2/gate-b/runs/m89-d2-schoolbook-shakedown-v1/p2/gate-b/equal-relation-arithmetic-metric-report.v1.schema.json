{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/equal-relation-arithmetic-metric-report.v1.schema.json",
  "title": "Normalized Gate-B arithmetic metric accounting",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "corpusDigest", "cells"],
  "properties": {
    "schema": { "const": "shieldkit-labs/p2-gate-b/arithmetic-metric-report/v1" },
    "corpusDigest": { "$ref": "#/$defs/sha256" },
    "cells": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/cell" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "engineId": { "enum": ["engine:native", "engine:libauth", "engine:bchn", "engine:leanbch"] },
    "metricId": { "enum": ["verdict", "lockingBytes", "unlockingBytes", "sourceBytes", "opcodeHistogram", "mulByteProduct", "divByteProduct", "modByteProduct", "resultPushBytes", "vmCost", "opCost", "stackMax", "elementMax", "limits", "headroom"] },
    "status": { "enum": ["measured", "measured-noncomparable", "derived-common", "derived-engine", "not-reached", "not-exposed", "not-applicable"] },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceArtifactDigest", "method"],
      "properties": {
        "sourceArtifactDigest": { "$ref": "#/$defs/sha256" },
        "method": { "type": "string", "minLength": 1 }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineId", "caseKey", "fixtureDigest", "metricId", "status", "value", "provenance", "reason"],
      "properties": {
        "engineId": { "$ref": "#/$defs/engineId" },
        "caseKey": { "type": "string", "minLength": 1 },
        "fixtureDigest": { "$ref": "#/$defs/sha256" },
        "metricId": { "$ref": "#/$defs/metricId" },
        "status": { "$ref": "#/$defs/status" },
        "value": {},
        "provenance": { "anyOf": [{ "$ref": "#/$defs/provenance" }, { "type": "null" }] },
        "reason": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["measured", "measured-noncomparable", "derived-common", "derived-engine"] } }, "required": ["status"] },
          "then": { "properties": { "value": { "not": { "type": "null" } }, "provenance": { "$ref": "#/$defs/provenance" }, "reason": { "type": "null" } } },
          "else": { "properties": { "value": { "type": "null" }, "provenance": { "type": "null" }, "reason": { "type": "string", "minLength": 1 } } }
        }
        ,
        {
          "if": { "properties": { "metricId": { "const": "verdict" } }, "required": ["metricId"] },
          "then": { "properties": { "status": { "not": { "const": "measured-noncomparable" } } } }
        }
      ]
    }
  }
}
