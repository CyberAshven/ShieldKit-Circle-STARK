{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/equal-relation-arithmetic-engine-result.v1.schema.json",
  "title": "Byte-bound Gate-B arithmetic engine result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "engineId", "corpusDigest", "execution", "cases"],
  "properties": {
    "schema": { "const": "shieldkit-labs/p2-gate-b/arithmetic-engine-result/v1" },
    "engineId": { "enum": ["engine:native", "engine:libauth", "engine:bchn", "engine:leanbch"] },
    "corpusDigest": { "$ref": "#/$defs/sha256" },
    "execution": { "$ref": "#/$defs/execution" },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" }, "uniqueItems": true }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "sha256", "byteLength"],
      "properties": {
        "text": { "type": ["string", "null"] },
        "sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "byteLength": { "type": "integer", "minimum": 0 }
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "argv", "modulePath"],
      "properties": {
        "kind": { "enum": ["argv", "module"] },
        "argv": { "anyOf": [{ "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, { "type": "null" }] },
        "modulePath": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "argv" } }, "required": ["kind"] }, "then": { "properties": { "argv": { "type": "array", "minItems": 1 }, "modulePath": { "type": "null" } } }, "else": { "properties": { "argv": { "type": "null" }, "modulePath": { "type": "string", "minLength": 1 } } } }
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "mode", "entrypoint", "implementationDigest", "stdin", "stdout", "stderr", "evidenceBoundary"],
      "properties": {
        "status": { "const": "measured" },
        "mode": { "enum": ["in-process", "external"] },
        "entrypoint": { "$ref": "#/$defs/entrypoint" },
        "implementationDigest": { "$ref": "#/$defs/sha256" },
        "stdin": { "$ref": "#/$defs/stream" },
        "stdout": { "$ref": "#/$defs/stream" },
        "stderr": { "$ref": "#/$defs/stream" },
        "evidenceBoundary": { "const": "gate-b0-primitive-evidence-only" }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "external" } }, "required": ["mode"] },
          "then": { "type": "object", "properties": { "entrypoint": { "type": "object", "properties": { "kind": { "const": "argv" } } }, "stdin": { "$ref": "#/$defs/externalStream" }, "stdout": { "$ref": "#/$defs/externalStream" }, "stderr": { "$ref": "#/$defs/externalStream" } } },
          "else": { "type": "object", "properties": { "entrypoint": { "type": "object", "properties": { "kind": { "const": "module" } } }, "stdin": { "$ref": "#/$defs/inProcessStream" }, "stdout": { "$ref": "#/$defs/inProcessStream" }, "stderr": { "$ref": "#/$defs/inProcessStream" } } }
        }
      ]
    },
    "externalStream": { "allOf": [{ "$ref": "#/$defs/stream" }, { "type": "object", "properties": { "text": { "type": "string" }, "sha256": { "$ref": "#/$defs/sha256" }, "byteLength": { "type": "integer", "minimum": 0 } } }] },
    "inProcessStream": { "allOf": [{ "$ref": "#/$defs/stream" }, { "type": "object", "properties": { "text": { "type": "null" }, "sha256": { "type": "null" }, "byteLength": { "const": 0 } } }] },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseKey", "fixtureDigest", "transactionDigest", "sourceOutputsDigest", "verdict", "rawObservation"],
      "properties": {
        "caseKey": { "type": "string", "minLength": 1 },
        "fixtureDigest": { "$ref": "#/$defs/sha256" },
        "transactionDigest": { "$ref": "#/$defs/sha256" },
        "sourceOutputsDigest": { "$ref": "#/$defs/sha256" },
        "verdict": { "enum": ["accept", "reject"] },
        "rawObservation": { "type": "object", "minProperties": 1 }
      }
    }
  }
}
