cal and unilateral","withdrawalTargetComparison":"less-than","withdrawalTargetSeconds":60},"postQuantum":{"claimPolicy":"Do not claim the complete system is post-quantum while current BCH or any transaction component retains an unqualified classical dependency.","goal":"PQ-oriented proof and private spend path","guardrail":"Prefer mature hash-based or otherwise defensible PQ-oriented components, but do not weaken classical security, transaction binding, privacy, availability, standardness, or implementation assurance merely to remove an assumption.","requiredReview":"component-by-component assumption inventory covering proof soundness and zero knowledge, hashes, commitments, nullifiers, note authorization, wallet storage and recovery, transaction authorization, and the BCH settlement boundary"},"selectedAt":"2026-08-08T00:00:00Z","soundness":{"fallbackRule":"Select the strongest concretely derived parameter set at or above 100 bits that fits; never lower security silently or optimize an isolated proof component instead of the complete transaction.","fallbackTrigger":"A concretely derived 128-bit configuration cannot fit in one complete 100,000-byte standard BCH transaction after measured protocol, verifier, and encoding optimization.","minimumBits":100,"standardTransactionLimitBytes":100000,"targetBits":128},"status":"frozen","ticket":{"denomination":"0.1 BCH","denominationSatoshis":10000000,"feeFunding":"separate transparent non-pool input","feePrivacy":"out of scope","poolReserveDeltaSatoshis":10000000,"withdrawalPayoutSatoshis":10000000}},"promotionGate":{"requires":["responsibility-complete architecture decompositions","explicit fixed-denomination, ticket-count, conservation, uniqueness, membership, and transaction-binding relations","strict schema and cross-artifact validation with no fabricated evidence","current-BCH embodiment and standard-transaction reality gates","Circle FRI artifacts with measured soundness, zero knowledge, bytes, VM cost, and adversarial evidence","complete optimized 128-bit deposit and withdrawal transactions before any fallback authorization","trust, liveness, availability, privacy-leakage, and reconstructability review"],"status":"closed"},"proofBackendDecision":{"family":"Circle-domain FRI","id":"proof-backend:circle-fri","implementationScope":"A direct custom PoolActionFv1 AIR, proof protocol, prover, encoding, and BCH verifier; no generic VM or external prover stack is selected as a dependency.","inactiveComparators":["Groth16","conventional Goldilocks FRI","WHIR"],"priorArtPolicy":"Stwo and other implementations are evidence and comparison sources only, not protocol authorities or implementation bases.","required":["field, extension tower, and circle-domain selection derived from BCH verifier cost","concrete witness masking and zero-knowledge leakage analysis designed with the protocol","explicit Circle-FRI soundness parameters and derivation","BCH-oriented transcript and Merkle hash selection","canonical field encoding, extension arithmetic, and proof parsing","one complete standard BCH transaction per action","under-60-second withdrawal proving on the pinned desktop"],"researchMethod":"first-principles BCH co-design","selectedAt":"2026-08-08T00:00:00Z","status":"frozen"},"schema":"shieldkit-labs/p2/gate-b/gate-b1-typed-protocol-descriptor-schema/v1/lane-authority-projection/v0","scopeDecision":{"outOfScope":["private transfers","multi-user batching","change notes","variable amounts"],"profileRef":"profile:fixed-ticket-serial-pool","relation":"Transparent fixed-ticket deposit followed by one unilateral withdrawal to ordinary BCH.","required":["one deposit transaction per ticket","one withdrawal transaction per ticket","one user action and one action proof per transaction","full on-chain proof and conservation enforcement","public reconstructability","no required coordinator or private service"],"selectedAt":"2026-08-08T00:00:00Z","status":"frozen"},"sourceMapIntegration":{"b1ReentryBoundary