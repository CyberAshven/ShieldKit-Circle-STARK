{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shieldkit://live-executor-static/observation-receipt.v1",
  "description": "Structural requirement only; static v1 never accepts this shape as an observation or authorization.",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "jDigest", "journalIndexDigest", "journalEntriesDigest", "journalHeadDigest", "stdinBindingRootDigest", "streamBindingsDigest", "completedEndpointPrefix", "durablePrefixEntries"],
  "properties": {
    "schemaVersion": {"const": "live-executor-static-v1"}, "jDigest": {"$ref": "#/$defs/digest"}, "journalIndexDigest": {"$ref": "#/$defs/digest"}, "journalEntriesDigest": {"$ref": "#/$defs/digest"}, "journalHeadDigest": {"$ref": "#/$defs/digest"}, "stdinBindingRootDigest": {"$ref": "#/$defs/digest"}, "streamBindingsDigest": {"$ref": "#/$defs/digest"}, "completedEndpointPrefix": {"type": "integer", "minimum": 0, "maximum": 5}, "durablePrefixEntries": {"type": "integer", "minimum": 0, "maximum": 30}
  }, "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
