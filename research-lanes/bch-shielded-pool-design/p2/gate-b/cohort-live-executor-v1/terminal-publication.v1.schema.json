{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shieldkit://live-executor-static/terminal-publication.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "a0Digest", "a1Digest", "bDigest", "cDigest", "jDigest", "journalIndexDigest", "observationRequirementDigest", "publicationKind", "durablePrefixEntries", "suffixSelection", "commitMode", "writerImplemented", "legacy"],
  "properties": {
    "schemaVersion": {"const": "live-executor-static-v1"}, "a0Digest": {"$ref": "#/$defs/digest"}, "a1Digest": {"$ref": "#/$defs/digest"}, "bDigest": {"$ref": "#/$defs/digest"}, "cDigest": {"$ref": "#/$defs/digest"}, "jDigest": {"$ref": "#/$defs/digest"}, "journalIndexDigest": {"$ref": "#/$defs/digest"}, "observationRequirementDigest": {"$ref": "#/$defs/digest"}, "publicationKind": {"enum": ["success", "failure"]}, "durablePrefixEntries": {"type": "integer", "minimum": 0, "maximum": 30}, "suffixSelection": {"enum": ["success-final", "failure-after-prefix", "recovery-after-prefix"]}, "commitMode": {"const": "NOREPLACE"}, "writerImplemented": {"const": false},
    "legacy": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["success"], "properties": {"success": {"type": "object"}}}, {"type": "object", "additionalProperties": false, "required": ["failure"], "properties": {"failure": {"type": "object"}}}]}
  }, "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
