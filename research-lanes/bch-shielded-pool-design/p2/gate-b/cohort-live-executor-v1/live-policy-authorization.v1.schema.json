{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shieldkit://live-executor-static/live-policy-authorization.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "a0Digest", "packageManifestDigest", "packageSha256SumsDigest", "endpoints", "launchProjection", "limits", "paths", "qualification", "executionAllowed"],
  "properties": {
    "schemaVersion": {"const": "live-executor-static-v1"},
    "a0Digest": {"$ref": "#/$defs/digest"},
    "packageManifestDigest": {"$ref": "#/$defs/digest"},
    "packageSha256SumsDigest": {"$ref": "#/$defs/digest"},
    "endpoints": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["ordinal", "id", "role"], "properties": {"ordinal": {"type": "integer", "minimum": 0, "maximum": 4}, "id": {"type": "string"}, "role": {"enum": ["primary", "secondary"]}}}},
    "launchProjection": {"type": "object", "additionalProperties": false, "required": ["argv", "cwd", "environment"], "properties": {"argv": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "cwd": {"$ref": "#/$defs/path"}, "environment": {"type": "object", "additionalProperties": false, "patternProperties": {"^[A-Z][A-Z0-9_]*$": {"type": "string"}}}}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["maxEndpointCount", "maxReadyRows"], "properties": {"maxEndpointCount": {"const": 5}, "maxReadyRows": {"const": 4608}}},
    "paths": {"type": "object", "additionalProperties": false, "required": ["claimPath", "journalRoot", "outputRoot", "scratchRoot"], "properties": {"claimPath": {"$ref": "#/$defs/path"}, "journalRoot": {"$ref": "#/$defs/path"}, "outputRoot": {"$ref": "#/$defs/path"}, "scratchRoot": {"$ref": "#/$defs/path"}}},
    "qualification": {"type": "object", "additionalProperties": false, "required": ["containmentRequired", "failClosed", "journalRequired", "observationRequired"], "properties": {"containmentRequired": {"const": true}, "failClosed": {"const": true}, "journalRequired": {"const": true}, "observationRequired": {"const": true}}},
    "executionAllowed": {"const": false}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"}}
}
