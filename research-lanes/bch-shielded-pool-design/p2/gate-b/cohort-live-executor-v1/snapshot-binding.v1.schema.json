{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shieldkit://live-executor-static/snapshot-binding.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "a0Digest", "a1Digest", "snapshotDigest", "valuesRootDigest", "catalogBindingDigest", "runtimeExecutableProjection", "snapshotAdapterBranded", "externalBJoinStatus", "stdinBindings", "stdinBindingRootDigest", "recoveryStableDigest"],
  "properties": {
    "schemaVersion": {"const": "live-executor-static-v1"},
    "a0Digest": {"$ref": "#/$defs/digest"},
    "a1Digest": {"$ref": "#/$defs/digest"},
    "snapshotDigest": {"$ref": "#/$defs/digest"},
    "valuesRootDigest": {"$ref": "#/$defs/digest"},
    "catalogBindingDigest": {"$ref": "#/$defs/digest"},
    "runtimeExecutableProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "rawSha256", "byteLength", "executableIdentityDigest", "stat"],
      "properties": {
        "id": {"const": "/proc/self/exe"},
        "role": {"const": "runtime-executable"},
        "rawSha256": {"$ref": "#/$defs/digest"},
        "byteLength": {"type": "integer", "minimum": 0},
        "executableIdentityDigest": {"$ref": "#/$defs/digest"},
        "stat": {"$ref": "#/$defs/snapshotStat"}
      }
    },
    "snapshotAdapterBranded": {"const": false},
    "externalBJoinStatus": {"const": "PENDING_NONAUTHORIZING"},
    "stdinBindings": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ordinal", "id", "role", "codec", "readyRows", "sha256", "byteLength"],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 0, "maximum": 4},
          "id": {"type": "string"},
          "role": {"enum": ["primary", "secondary"]},
          "codec": {"type": "string", "minLength": 1},
          "readyRows": {"const": 4608},
          "sha256": {"$ref": "#/$defs/digest"},
          "byteLength": {"type": "integer", "minimum": 0}
        }
      }
    },
    "stdinBindingRootDigest": {"$ref": "#/$defs/digest"},
    "recoveryStableDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "snapshotStat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dev", "ino", "mode", "uid", "gid", "nlink", "size"],
      "properties": {
        "dev": {"$ref": "#/$defs/decimal"},
        "ino": {"$ref": "#/$defs/decimal"},
        "mode": {"type": "string", "pattern": "^[0-7]{3,4}$"},
        "uid": {"$ref": "#/$defs/decimal"},
        "gid": {"$ref": "#/$defs/decimal"},
        "nlink": {"const": "1"},
        "size": {"$ref": "#/$defs/decimal"}
      }
    },
    "decimal": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"}
  }
}
