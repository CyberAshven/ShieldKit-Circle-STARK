{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shieldkit://live-executor-static/journal-index.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "jDigest", "firstSequence", "nextSequence", "headDigest", "completedEndpointPrefix", "entries", "streamBindings", "indexDigest"],
  "properties": {
    "schemaVersion": {"const": "live-executor-static-v1"}, "jDigest": {"$ref": "#/$defs/digest"}, "firstSequence": {"const": 0}, "nextSequence": {"type": "integer", "minimum": 0, "maximum": 30}, "headDigest": {"anyOf": [{"const": "GENESIS"}, {"$ref": "#/$defs/digest"}]}, "completedEndpointPrefix": {"type": "integer", "minimum": 0, "maximum": 5}, "entries": {"type": "array", "maxItems": 30, "items": {"type": "object", "additionalProperties": false, "required": ["sequence", "entryDigest", "relativePath", "jDigest"], "properties": {"sequence": {"type": "integer", "minimum": 0}, "entryDigest": {"$ref": "#/$defs/digest"}, "relativePath": {"$ref": "#/$defs/path"}, "jDigest": {"$ref": "#/$defs/digest"}}}}, "streamBindings": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/indexStream"}}, "indexDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "decimal": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"}, "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"}, "streamStat": {"type": "object", "additionalProperties": false, "required": ["dev", "ino", "mode", "uid", "gid", "nlink", "size", "mtimeNs"], "properties": {"dev": {"$ref": "#/$defs/decimal"}, "ino": {"$ref": "#/$defs/decimal"}, "mode": {"type": "string", "pattern": "^[0-7]{3,4}$"}, "uid": {"$ref": "#/$defs/decimal"}, "gid": {"$ref": "#/$defs/decimal"}, "nlink": {"const": "1"}, "size": {"$ref": "#/$defs/decimal"}, "mtimeNs": {"$ref": "#/$defs/decimal"}}}, "indexStream": {"type": "object", "additionalProperties": false, "required": ["endpointOrdinal", "endpointId", "stream", "relativePath", "sha256", "byteLength", "stat", "fsynced"], "properties": {"endpointOrdinal": {"type": "integer", "minimum": 0, "maximum": 4}, "endpointId": {"type": "string"}, "stream": {"enum": ["stdout", "stderr"]}, "relativePath": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/digest"}, "byteLength": {"type": "integer", "minimum": 0}, "stat": {"$ref": "#/$defs/streamStat"}, "fsynced": {"const": true}}}}
}
