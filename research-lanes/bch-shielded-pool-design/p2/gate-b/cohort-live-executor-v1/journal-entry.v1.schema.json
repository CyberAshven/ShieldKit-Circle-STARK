{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shieldkit://live-executor-static/journal-entry.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "jDigest", "sequence", "monotonicTimeNs", "previousDigest", "endpointOrdinal", "endpointId", "event", "stdinBindingDigest", "streamBindings", "entryDigest"],
  "properties": {
    "schemaVersion": {"const": "live-executor-static-v1"}, "jDigest": {"$ref": "#/$defs/digest"}, "sequence": {"type": "integer", "minimum": 0}, "monotonicTimeNs": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"}, "previousDigest": {"anyOf": [{"const": "GENESIS"}, {"$ref": "#/$defs/digest"}]}, "endpointOrdinal": {"type": "integer", "minimum": 0, "maximum": 4}, "endpointId": {"type": "string"}, "event": {"enum": ["endpoint-input-durable", "endpoint-started", "stdout-durable", "stderr-durable", "endpoint-close-observed", "endpoint-sealed"]}, "stdinBindingDigest": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]}, "streamBindings": {"type": "array", "maxItems": 1, "items": {"$ref": "#/$defs/stream"}}, "entryDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "decimal": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"}, "streamStat": {"type": "object", "additionalProperties": false, "required": ["dev", "ino", "mode", "uid", "gid", "nlink", "size", "mtimeNs"], "properties": {"dev": {"$ref": "#/$defs/decimal"}, "ino": {"$ref": "#/$defs/decimal"}, "mode": {"type": "string", "pattern": "^[0-7]{3,4}$"}, "uid": {"$ref": "#/$defs/decimal"}, "gid": {"$ref": "#/$defs/decimal"}, "nlink": {"const": "1"}, "size": {"$ref": "#/$defs/decimal"}, "mtimeNs": {"$ref": "#/$defs/decimal"}}}, "stream": {"type": "object", "additionalProperties": false, "required": ["stream", "relativePath", "sha256", "byteLength", "stat", "fsynced"], "properties": {"stream": {"enum": ["stdout", "stderr"]}, "relativePath": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"}, "sha256": {"$ref": "#/$defs/digest"}, "byteLength": {"type": "integer", "minimum": 0}, "stat": {"$ref": "#/$defs/streamStat"}, "fsynced": {"const": true}}}}
}
