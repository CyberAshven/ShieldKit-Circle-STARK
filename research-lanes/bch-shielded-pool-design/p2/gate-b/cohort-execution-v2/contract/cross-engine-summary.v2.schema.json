{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-execution-v2/cross-engine-summary.v2.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "evidenceId", "epochId", "status", "normalizedArtifactDigests", "fixtureRows", "metricAgreementRows", "verdictAgreement", "metricCoverageAgreement", "ranking", "selection", "contentDigest"],
  "properties": {
    "schema": { "const": "shieldkit-labs/p2/gate-b/cohort-execution-v2/cross-engine-summary" }, "evidenceId": { "type": "string", "minLength": 1 }, "epochId": { "const": "execution-epoch:gate-b-v2" }, "status": { "enum": ["not-started", "complete", "incomplete", "failed"] }, "normalizedArtifactDigests": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/sha" } }, "fixtureRows": { "type": "array", "minItems": 4732, "maxItems": 4732, "items": { "$ref": "#/$defs/fixtureRow" } }, "metricAgreementRows": { "type": "array", "minItems": 70980, "maxItems": 70980, "items": { "$ref": "#/$defs/metricAgreement" } }, "verdictAgreement": { "enum": ["not-started", "complete-eligible-only", "incomplete", "disagreement"] }, "metricCoverageAgreement": { "enum": ["not-started", "complete-eligible-only", "incomplete", "disagreement"] }, "ranking": { "type": "null" }, "selection": { "type": "null" }, "contentDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "digest": { "type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "domain", "frame", "value"], "properties": { "algorithm": { "const": "sha256" }, "canonicalization": { "const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1" }, "domain": { "type": "string", "minLength": 1 }, "frame": { "const": "utf8(domain)||0x00||canonical-json-utf8" }, "value": { "$ref": "#/$defs/sha" } } },
    "engineId": { "enum": ["engine:native", "engine:libauth", "engine:bchn", "engine:leanbch"] },
    "engineVerdict": { "type": "object", "additionalProperties": false, "required": ["engineId", "workItemId", "terminalCellId", "terminalStatus", "observedVerdict", "comparable", "rawDigest", "normalizedDigest"], "properties": { "engineId": { "$ref": "#/$defs/engineId" }, "workItemId": { "type": "string", "minLength": 1 }, "terminalCellId": { "type": "string", "minLength": 1 }, "terminalStatus": { "enum": ["observed", "preflight-limit-unsupported", "process-failure", "timeout", "parser-failure", "engine-unsupported-incomplete", "not-run-incomplete"] }, "observedVerdict": { "anyOf": [{ "enum": ["accept", "reject"] }, { "type": "null" }] }, "comparable": { "type": "boolean" }, "rawDigest": { "$ref": "#/$defs/sha" }, "normalizedDigest": { "$ref": "#/$defs/sha" } } },
    "fixtureRow": { "type": "object", "additionalProperties": false, "required": ["fixtureKey", "terminalCellId", "fixtureRecordDigest", "expectedVerdict", "engines", "contentDigest"], "properties": { "fixtureKey": { "type": "string", "pattern": "^fixture:[0-9a-f]{64}$" }, "terminalCellId": { "type": "string", "minLength": 1 }, "fixtureRecordDigest": { "$ref": "#/$defs/sha" }, "expectedVerdict": { "enum": ["accept", "reject"] }, "engines": { "type": "array", "minItems": 4, "maxItems": 4, "prefixItems": [{ "$ref": "#/$defs/engineNative" }, { "$ref": "#/$defs/engineLibauth" }, { "$ref": "#/$defs/engineBchn" }, { "$ref": "#/$defs/engineLeanbch" }], "items": false }, "contentDigest": { "$ref": "#/$defs/digest" } } },
    "engineNative": { "allOf": [{ "$ref": "#/$defs/engineVerdict" }, { "type": "object", "properties": { "engineId": { "const": "engine:native" } } }] }, "engineLibauth": { "allOf": [{ "$ref": "#/$defs/engineVerdict" }, { "type": "object", "properties": { "engineId": { "const": "engine:libauth" } } }] }, "engineBchn": { "allOf": [{ "$ref": "#/$defs/engineVerdict" }, { "type": "object", "properties": { "engineId": { "const": "engine:bchn" } } }] }, "engineLeanbch": { "allOf": [{ "$ref": "#/$defs/engineVerdict" }, { "type": "object", "properties": { "engineId": { "const": "engine:leanbch" } } }] },
    "metricCell": { "type": "object", "additionalProperties": false, "required": ["engineId", "workItemId", "terminalCellId", "status", "comparable", "valueDigest", "normalizedRowDigest", "normalizedCellDigest"], "properties": { "engineId": { "$ref": "#/$defs/engineId" }, "workItemId": { "type": "string", "minLength": 1 }, "terminalCellId": { "type": "string", "minLength": 1 }, "status": { "enum": ["measured", "measured-noncomparable", "derived-common", "derived-engine", "not-reached", "not-exposed", "not-applicable", "preflight-limit-unsupported"] }, "comparable": { "type": "boolean" }, "valueDigest": { "anyOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] }, "normalizedRowDigest": { "$ref": "#/$defs/sha" }, "normalizedCellDigest": { "$ref": "#/$defs/sha" } } },
    "metricAgreement": { "type": "object", "additionalProperties": false, "required": ["fixtureKey", "metricOrdinal", "metricId", "cells", "agreementStatus", "comparableEngineIds", "incomparableEngineIds", "valueDigests", "contentDigest"], "properties": { "fixtureKey": { "type": "string", "pattern": "^fixture:[0-9a-f]{64}$" }, "metricOrdinal": { "type": "integer", "minimum": 0, "maximum": 14 }, "metricId": { "enum": ["verdict", "lockingBytes", "unlockingBytes", "sourceBytes", "opcodeHistogram", "mulByteProduct", "divByteProduct", "modByteProduct", "resultPushBytes", "vmCost", "opCost", "stackMax", "elementMax", "limits", "headroom"] }, "cells": { "type": "array", "minItems": 4, "maxItems": 4, "prefixItems": [{ "$ref": "#/$defs/metricNative" }, { "$ref": "#/$defs/metricLibauth" }, { "$ref": "#/$defs/metricBchn" }, { "$ref": "#/$defs/metricLeanbch" }], "items": false }, "agreementStatus": { "enum": ["agree", "disagree", "not-comparable", "incomplete", "preflight-unsupported"] }, "comparableEngineIds": { "type": "array", "items": { "$ref": "#/$defs/engineId" } }, "incomparableEngineIds": { "type": "array", "items": { "$ref": "#/$defs/engineId" } }, "valueDigests": { "type": "array", "items": { "anyOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] } }, "contentDigest": { "$ref": "#/$defs/digest" } } },
    "metricNative": { "allOf": [{ "$ref": "#/$defs/metricCell" }, { "type": "object", "properties": { "engineId": { "const": "engine:native" } } }] }, "metricLibauth": { "allOf": [{ "$ref": "#/$defs/metricCell" }, { "type": "object", "properties": { "engineId": { "const": "engine:libauth" } } }] }, "metricBchn": { "allOf": [{ "$ref": "#/$defs/metricCell" }, { "type": "object", "properties": { "engineId": { "const": "engine:bchn" } } }] }, "metricLeanbch": { "allOf": [{ "$ref": "#/$defs/metricCell" }, { "type": "object", "properties": { "engineId": { "const": "engine:leanbch" } } }] }
  }
}
