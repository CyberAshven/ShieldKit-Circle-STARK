{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-execution-v2/raw-engine-observation.v2.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "evidenceId", "epochId", "engineId", "engineBatchOrdinal", "shardIndex", "shardCount", "status", "workItemOrderDigest", "enginePin", "invocation", "logs", "rows", "contentDigest"],
  "properties": {
    "schema": { "const": "shieldkit-labs/p2/gate-b/cohort-execution-v2/raw-engine-observation" }, "evidenceId": { "type": "string", "minLength": 1 }, "epochId": { "const": "execution-epoch:gate-b-v2" },
    "engineId": { "enum": ["engine:native", "engine:libauth", "engine:bchn", "engine:leanbch"] }, "engineBatchOrdinal": { "type": "integer", "minimum": 0, "maximum": 3 }, "shardIndex": { "const": 0 }, "shardCount": { "const": 1 }, "status": { "enum": ["not-started", "complete", "incomplete", "failed"] }, "workItemOrderDigest": { "$ref": "#/$defs/digest" }, "enginePin": { "$ref": "#/$defs/pin" }, "invocation": { "$ref": "#/$defs/invocation" }, "logs": { "$ref": "#/$defs/logs" }, "rows": { "type": "array", "minItems": 4732, "maxItems": 4732, "items": { "$ref": "#/$defs/row" } }, "contentDigest": { "$ref": "#/$defs/digest" }
  },
  "allOf": [
    { "if": { "properties": { "engineId": { "const": "engine:native" } }, "required": ["engineId"] }, "then": { "type": "object", "properties": { "engineBatchOrdinal": { "const": 0 }, "invocation": { "$ref": "#/$defs/nonLeanInvocation" } } } },
    { "if": { "properties": { "engineId": { "const": "engine:libauth" } }, "required": ["engineId"] }, "then": { "type": "object", "properties": { "engineBatchOrdinal": { "const": 1 }, "invocation": { "$ref": "#/$defs/nonLeanInvocation" } } } },
    { "if": { "properties": { "engineId": { "const": "engine:bchn" } }, "required": ["engineId"] }, "then": { "type": "object", "properties": { "engineBatchOrdinal": { "const": 2 }, "invocation": { "$ref": "#/$defs/nonLeanInvocation" } } } },
    { "if": { "properties": { "engineId": { "const": "engine:leanbch" } }, "required": ["engineId"] }, "then": { "type": "object", "properties": { "engineBatchOrdinal": { "const": 3 }, "invocation": { "$ref": "#/$defs/leanInvocation" } } } }
  ],
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "digest": { "type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "domain", "frame", "value"], "properties": { "algorithm": { "const": "sha256" }, "canonicalization": { "const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1" }, "domain": { "type": "string", "minLength": 1 }, "frame": { "const": "utf8(domain)||0x00||canonical-json-utf8" }, "value": { "$ref": "#/$defs/sha" } } },
    "pin": { "type": "object", "additionalProperties": false, "required": ["engineId", "artifactPath", "artifactRawSha256", "artifactContentDigest", "schemaPath", "schemaSha256"], "properties": { "engineId": { "type": "string" }, "artifactPath": { "type": "string", "minLength": 1 }, "artifactRawSha256": { "$ref": "#/$defs/sha" }, "artifactContentDigest": { "$ref": "#/$defs/sha" }, "schemaPath": { "type": "string", "minLength": 1 }, "schemaSha256": { "$ref": "#/$defs/sha" } } },
    "endpoint": { "type": "object", "additionalProperties": false, "required": ["role", "path", "rawSha256", "argv", "stdin", "stdout", "stderr", "exitCode", "timedOut"], "properties": { "role": { "enum": ["primary", "secondary"] }, "path": { "type": "string", "minLength": 1 }, "rawSha256": { "$ref": "#/$defs/sha" }, "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "stdin": { "$ref": "#/$defs/stream" }, "stdout": { "$ref": "#/$defs/stream" }, "stderr": { "$ref": "#/$defs/stream" }, "exitCode": { "anyOf": [{ "type": "integer" }, { "type": "null" }] }, "timedOut": { "type": "boolean" } } },
    "nonLeanInvocation": { "type": "object", "properties": { "entrypointKind": { "not": { "const": "paired" } }, "entrypoints": { "type": "array", "minItems": 1, "maxItems": 1, "prefixItems": [{ "allOf": [{ "$ref": "#/$defs/endpoint" }, { "type": "object", "properties": { "role": { "const": "primary" } } }] }], "items": false } } },
    "leanInvocation": { "type": "object", "properties": { "entrypointKind": { "const": "paired" }, "entrypoints": { "type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{ "allOf": [{ "$ref": "#/$defs/endpoint" }, { "type": "object", "properties": { "role": { "const": "primary" } } }] }, { "allOf": [{ "$ref": "#/$defs/endpoint" }, { "type": "object", "properties": { "role": { "const": "secondary" } } }] }], "items": false } } },
    "invocation": { "type": "object", "additionalProperties": false, "required": ["entrypointKind", "entrypoints", "stdinCodec", "environment", "runtime", "implementationDigest"], "properties": { "entrypointKind": { "enum": ["module", "external", "paired"] }, "entrypoints": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/endpoint" } }, "stdinCodec": { "type": "string", "minLength": 1 }, "environment": { "$ref": "#/$defs/environment" }, "runtime": { "$ref": "#/$defs/runtime" }, "implementationDigest": { "$ref": "#/$defs/sha" } } },
    "environment": { "type": "object", "additionalProperties": false, "required": ["allowlistDigest", "variables"], "properties": { "allowlistDigest": { "$ref": "#/$defs/sha" }, "variables": { "type": "object", "additionalProperties": { "type": "string" } } } },
    "runtime": { "type": "object", "additionalProperties": false, "required": ["nodeVersion", "os", "arch", "cwd", "runtimeDigest"], "properties": { "nodeVersion": { "type": "string", "minLength": 1 }, "os": { "type": "string", "minLength": 1 }, "arch": { "type": "string", "minLength": 1 }, "cwd": { "type": "string", "minLength": 1 }, "runtimeDigest": { "$ref": "#/$defs/sha" } } },
    "stream": { "type": "object", "additionalProperties": false, "required": ["path", "rawSha256", "byteLength", "mediaType", "manifestPath", "manifestEntrySha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "rawSha256": { "$ref": "#/$defs/sha" }, "byteLength": { "type": "integer", "minimum": 0 }, "mediaType": { "const": "text/plain-utf8" }, "manifestPath": { "type": "string", "minLength": 1 }, "manifestEntrySha256": { "$ref": "#/$defs/sha" } } },
    "logs": { "type": "object", "additionalProperties": false, "required": ["stdin", "stdout", "stderr", "logSetDigest"], "properties": { "stdin": { "$ref": "#/$defs/stream" }, "stdout": { "$ref": "#/$defs/stream" }, "stderr": { "$ref": "#/$defs/stream" }, "logSetDigest": { "$ref": "#/$defs/digest" } } },
    "preflight": { "type": "object", "additionalProperties": false, "required": ["kind", "executionCeilingBytes", "scriptSig", "redeem", "reason"], "properties": { "kind": { "const": "preflight-limit" }, "executionCeilingBytes": { "const": 10000 }, "scriptSig": { "type": "boolean" }, "redeem": { "type": "boolean" }, "reason": { "const": "preflight-limit-unsupported-no-engine-invocation" } } },
    "unsupported": { "type": "object", "additionalProperties": false, "required": ["kind", "reason", "engineId", "eligible", "agreementEligible"], "properties": { "kind": { "const": "engine-unsupported-incomplete" }, "reason": { "const": "lean-costprobe-skip" }, "engineId": { "const": "engine:leanbch" }, "eligible": { "const": true }, "agreementEligible": { "const": false } } },
    "notRun": { "type": "object", "additionalProperties": false, "required": ["kind", "reason", "agreementEligible"], "properties": { "kind": { "const": "not-run-incomplete" }, "reason": { "const": "prior-engine-batch-failure" }, "agreementEligible": { "const": false } } },
    "structuredObservation": { "type": "object", "additionalProperties": false, "required": ["kind", "status", "rawObservationDigest", "exitCode", "parserStatus", "payload"], "properties": { "kind": { "const": "structured" }, "status": { "const": "observed" }, "rawObservationDigest": { "$ref": "#/$defs/digest" }, "exitCode": { "type": "integer" }, "parserStatus": { "enum": ["complete", "failure"] }, "payload": { "type": "object" } } },
    "fileSpanObservation": { "type": "object", "additionalProperties": false, "required": ["kind", "artifactPath", "artifactRawSha256", "byteStart", "byteEnd", "lineStart", "lineEnd", "spanSha256", "manifestPath", "manifestEntrySha256"], "properties": { "kind": { "const": "file-span" }, "artifactPath": { "type": "string", "minLength": 1 }, "artifactRawSha256": { "$ref": "#/$defs/sha" }, "byteStart": { "type": "integer", "minimum": 0 }, "byteEnd": { "type": "integer", "minimum": 1 }, "lineStart": { "type": "integer", "minimum": 1 }, "lineEnd": { "type": "integer", "minimum": 1 }, "spanSha256": { "$ref": "#/$defs/sha" }, "manifestPath": { "type": "string", "minLength": 1 }, "manifestEntrySha256": { "$ref": "#/$defs/sha" } } },
    "row": { "type": "object", "additionalProperties": false, "required": ["workItemId", "fixtureKey", "terminalCellId", "workItemOrdinal", "fixtureRecordDigest", "disposition", "preflightBinding", "unsupportedBinding", "notRunBinding", "rawObservation", "rawRowDigest"], "properties": { "workItemId": { "type": "string", "minLength": 1 }, "fixtureKey": { "type": "string", "pattern": "^fixture:[0-9a-f]{64}$" }, "terminalCellId": { "type": "string", "minLength": 1 }, "workItemOrdinal": { "type": "integer", "minimum": 0, "maximum": 4731 }, "fixtureRecordDigest": { "$ref": "#/$defs/sha" }, "disposition": { "enum": ["observed", "preflight-limit-unsupported", "engine-unsupported-incomplete", "not-run-incomplete"] }, "preflightBinding": { "anyOf": [{ "$ref": "#/$defs/preflight" }, { "type": "null" }] }, "unsupportedBinding": { "anyOf": [{ "$ref": "#/$defs/unsupported" }, { "type": "null" }] }, "notRunBinding": { "anyOf": [{ "$ref": "#/$defs/notRun" }, { "type": "null" }] }, "rawObservation": { "anyOf": [{ "$ref": "#/$defs/structuredObservation" }, { "$ref": "#/$defs/fileSpanObservation" }, { "type": "null" }] }, "rawRowDigest": { "$ref": "#/$defs/digest" } }, "allOf": [{ "if": { "properties": { "disposition": { "const": "preflight-limit-unsupported" } }, "required": ["disposition"] }, "then": { "properties": { "preflightBinding": { "$ref": "#/$defs/preflight" }, "unsupportedBinding": { "type": "null" }, "notRunBinding": { "type": "null" }, "rawObservation": { "type": "null" } } } }, { "if": { "properties": { "disposition": { "const": "engine-unsupported-incomplete" } }, "required": ["disposition"] }, "then": { "properties": { "preflightBinding": { "type": "null" }, "unsupportedBinding": { "$ref": "#/$defs/unsupported" }, "notRunBinding": { "type": "null" }, "rawObservation": { "anyOf": [{ "$ref": "#/$defs/structuredObservation" }, { "$ref": "#/$defs/fileSpanObservation" }] } } } }, { "if": { "properties": { "disposition": { "const": "not-run-incomplete" } }, "required": ["disposition"] }, "then": { "properties": { "preflightBinding": { "type": "null" }, "unsupportedBinding": { "type": "null" }, "notRunBinding": { "$ref": "#/$defs/notRun" }, "rawObservation": { "type": "null" } } } }, { "if": { "properties": { "disposition": { "const": "observed" } }, "required": ["disposition"] }, "then": { "properties": { "preflightBinding": { "type": "null" }, "unsupportedBinding": { "type": "null" }, "notRunBinding": { "type": "null" }, "rawObservation": { "anyOf": [{ "$ref": "#/$defs/structuredObservation" }, { "$ref": "#/$defs/fileSpanObservation" }] } } } }] }
  }
}
