{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-execution-v2/evidence-manifest.v2.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "manifestId", "status", "attemptIndex", "evidenceRootExcluded", "selfManifestExcluded", "files", "inventoryDigest", "contentDigest"],
  "properties": {
    "schema": { "const": "shieldkit-labs/p2/gate-b/cohort-execution-v2/evidence-manifest" }, "manifestId": { "const": "evidence-manifest:cohort-execution-v2:attempt-000" }, "status": { "enum": ["incomplete", "complete", "failed"] }, "attemptIndex": { "const": 0 }, "evidenceRootExcluded": { "const": true }, "selfManifestExcluded": { "const": true },
    "files": { "type": "array", "minItems": 25, "maxItems": 25, "items": { "$ref": "#/$defs/entry" } }, "inventoryDigest": { "$ref": "#/$defs/digest" }, "contentDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "digest": { "type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "domain", "frame", "value"], "properties": { "algorithm": { "const": "sha256" }, "canonicalization": { "const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1" }, "domain": { "type": "string", "minLength": 1 }, "frame": { "const": "utf8(domain)||0x00||canonical-json-utf8" }, "value": { "$ref": "#/$defs/sha" } } },
    "entry": { "type": "object", "additionalProperties": false, "required": ["ordinal", "kind", "engineId", "processRole", "role", "path", "rawSha256", "byteLength", "manifestEntrySha256"], "properties": { "ordinal": { "type": "integer", "minimum": 0, "maximum": 24 }, "kind": { "enum": ["raw-artifact", "raw-stream", "normalized-artifact", "cross-engine-summary", "authorization-binding"] }, "engineId": { "anyOf": [{ "enum": ["engine:native", "engine:libauth", "engine:bchn", "engine:leanbch"] }, { "type": "null" }] }, "processRole": { "anyOf": [{ "enum": ["primary", "secondary"] }, { "type": "null" }] }, "role": { "enum": ["artifact", "stdin", "stdout", "stderr", "authorization"] }, "path": { "type": "string", "minLength": 1 }, "rawSha256": { "$ref": "#/$defs/sha" }, "byteLength": { "type": "integer", "minimum": 0 }, "manifestEntrySha256": { "$ref": "#/$defs/digest" } } }
  }
}
