{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-execution-v2/evidence-root.v2.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "evidenceId", "epochId", "status", "contractDigest", "rawArtifacts", "normalizedArtifacts", "crossEngineSummary", "manifestBinding", "obligationAccounting", "ranking", "selection", "contentDigest"],
  "properties": {
    "schema": { "const": "shieldkit-labs/p2/gate-b/cohort-execution-v2/evidence-root" }, "evidenceId": { "type": "string", "minLength": 1 }, "epochId": { "const": "execution-epoch:gate-b-v2" }, "status": { "enum": ["incomplete", "complete", "failed"] }, "contractDigest": { "$ref": "#/$defs/sha" },
    "rawArtifacts": { "type": "array", "minItems": 4, "maxItems": 4, "prefixItems": [{ "$ref": "#/$defs/rawNative" }, { "$ref": "#/$defs/rawLibauth" }, { "$ref": "#/$defs/rawBchn" }, { "$ref": "#/$defs/rawLeanbch" }], "items": false },
    "normalizedArtifacts": { "type": "array", "minItems": 4, "maxItems": 4, "prefixItems": [{ "$ref": "#/$defs/normalizedNative" }, { "$ref": "#/$defs/normalizedLibauth" }, { "$ref": "#/$defs/normalizedBchn" }, { "$ref": "#/$defs/normalizedLeanbch" }], "items": false },
    "crossEngineSummary": { "$ref": "#/$defs/summaryArtifact" }, "manifestBinding": { "$ref": "#/$defs/manifestBinding" }, "obligationAccounting": { "const": { "total": 18928, "preflightUnsupported": 496, "executable": 18432 } }, "ranking": { "type": "null" }, "selection": { "type": "null" }, "contentDigest": { "$ref": "#/$defs/evidenceDigest" }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "digest": { "type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "domain", "frame", "value"], "properties": { "algorithm": { "const": "sha256" }, "canonicalization": { "const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1" }, "domain": { "type": "string", "minLength": 1 }, "frame": { "const": "utf8(domain)||0x00||canonical-json-utf8" }, "value": { "$ref": "#/$defs/sha" } } },
    "evidenceDigest": { "allOf": [{ "$ref": "#/$defs/digest" }, { "type": "object", "properties": { "domain": { "const": "shieldkit-labs/p2/gate-b/evidence-root/v2/root" } } }] },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["engineId", "batchOrdinal", "shardIndex", "shardCount", "path", "rawSha256", "contentDigest", "status"], "properties": { "engineId": { "enum": ["engine:native", "engine:libauth", "engine:bchn", "engine:leanbch"] }, "batchOrdinal": { "type": "integer", "minimum": 0, "maximum": 3 }, "shardIndex": { "const": 0 }, "shardCount": { "const": 1 }, "path": { "type": "string", "minLength": 1 }, "rawSha256": { "$ref": "#/$defs/sha" }, "contentDigest": { "$ref": "#/$defs/sha" }, "status": { "enum": ["not-started", "incomplete", "complete", "failed"] } } },
    "rawNative": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "type": "object", "properties": { "engineId": { "const": "engine:native" }, "batchOrdinal": { "const": 0 } } }] }, "rawLibauth": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "type": "object", "properties": { "engineId": { "const": "engine:libauth" }, "batchOrdinal": { "const": 1 } } }] }, "rawBchn": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "type": "object", "properties": { "engineId": { "const": "engine:bchn" }, "batchOrdinal": { "const": 2 } } }] }, "rawLeanbch": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "type": "object", "properties": { "engineId": { "const": "engine:leanbch" }, "batchOrdinal": { "const": 3 } } }] },
    "normalizedNative": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "type": "object", "properties": { "engineId": { "const": "engine:native" }, "batchOrdinal": { "const": 0 } } }] }, "normalizedLibauth": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "type": "object", "properties": { "engineId": { "const": "engine:libauth" }, "batchOrdinal": { "const": 1 } } }] }, "normalizedBchn": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "type": "object", "properties": { "engineId": { "const": "engine:bchn" }, "batchOrdinal": { "const": 2 } } }] }, "normalizedLeanbch": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "type": "object", "properties": { "engineId": { "const": "engine:leanbch" }, "batchOrdinal": { "const": 3 } } }] },
    "summaryArtifact": { "type": "object", "additionalProperties": false, "required": ["path", "rawSha256", "contentDigest", "status"], "properties": { "path": { "type": "string", "minLength": 1 }, "rawSha256": { "$ref": "#/$defs/sha" }, "contentDigest": { "$ref": "#/$defs/sha" }, "status": { "enum": ["not-started", "incomplete", "complete", "failed"] } } },
    "manifestBinding": { "type": "object", "additionalProperties": false, "required": ["path", "schemaPath", "rawSha256", "schemaSha256", "contentDigest", "inventoryDigest", "listedPayloadCount", "selfManifestExcluded", "evidenceRootExcluded"], "properties": { "path": { "type": "string", "minLength": 1 }, "schemaPath": { "type": "string", "minLength": 1 }, "rawSha256": { "$ref": "#/$defs/sha" }, "schemaSha256": { "$ref": "#/$defs/sha" }, "contentDigest": { "$ref": "#/$defs/sha" }, "inventoryDigest": { "$ref": "#/$defs/sha" }, "listedPayloadCount": { "const": 25 }, "selfManifestExcluded": { "const": true }, "evidenceRootExcluded": { "const": true } } }
  }
}
