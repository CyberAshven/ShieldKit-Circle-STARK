{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-execution-v2/manifest.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "manifestId", "status", "evidenceClassification", "executionAllowed", "metricsAllowed", "ranking", "selection", "executionGate", "contractDigest", "coverage", "files"],
  "properties": {
    "schema": { "const": "shieldkit-labs/p2/gate-b/cohort-execution-v2/manifest/v1" }, "manifestId": { "const": "manifest:cohort-execution-v2" }, "status": { "const": "frozen-unexecuted" }, "evidenceClassification": { "const": "contract-only-not-execution-evidence" }, "executionAllowed": { "const": false }, "metricsAllowed": { "const": false }, "ranking": { "type": "null" }, "selection": { "type": "null" }, "executionGate": { "const": { "status": "closed-contract-only", "permittedEpochId": "execution-epoch:gate-b-v2", "permittedAttemptIndex": 0, "permittedRetries": 0, "runnerBinding": null, "runnerBindingRequired": true } }, "contractDigest": { "$ref": "#/$defs/digest" }, "coverage": { "const": { "packageRoot": "research-lanes/bch-shielded-pool-design/p2/gate-b/cohort-execution-v2", "symlinksForbidden": true, "unmanifestedPayloads": [], "listedPayloadCount": 14, "selfManifestExcluded": true } }, "files": { "type": "array", "minItems": 14, "maxItems": 14, "items": { "$ref": "#/$defs/file" } }
  },
  "$defs": { "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "digest": { "type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "domain", "frame", "value"], "properties": { "algorithm": { "const": "sha256" }, "canonicalization": { "const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1" }, "domain": { "type": "string", "minLength": 1 }, "frame": { "const": "utf8(domain)||0x00||canonical-json-utf8" }, "value": { "$ref": "#/$defs/sha" } } }, "file": { "type": "object", "additionalProperties": false, "required": ["path", "byteLength", "rawSha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "byteLength": { "type": "integer", "minimum": 0 }, "rawSha256": { "$ref": "#/$defs/sha" } } } }
}
