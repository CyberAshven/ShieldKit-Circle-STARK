{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K runtime core closure v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "runtimeEntrypoint", "runtimeModules", "runtimeExports", "typeModules", "buildTimeOnlyLocators"],
  "properties": {
    "format": { "const": "K/runtime-core/1" },
    "runtimeEntrypoint": { "const": "src/contracts.mjs" },
    "runtimeModules": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["locator", "imports"],
        "properties": {
          "locator": { "type": "string" },
          "imports": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "runtimeExports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "typeModules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "const": "src/interfaces.d.ts" }
    },
    "buildTimeOnlyLocators": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string" }
    }
  }
}
