{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K dispatch plan input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["dispatchPlanRoot", "rowRoot", "executionAllowed", "workerRows"],
  "properties": {
    "dispatchPlanRoot": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "rowRoot": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "executionAllowed": { "const": false },
    "workerRows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "worker-row.v1.schema.json" }
    }
  }
}
