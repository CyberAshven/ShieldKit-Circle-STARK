{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K sealed metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "executionAllowed", "runtimeBinding", "policy", "authorization",
    "claim", "run", "evidence", "metrics", "ranking", "selection", "journal",
    "terminal", "capture", "concreteLocations", "runtimeCore", "entryCount", "entries", "entriesRoot",
    "manifestRoot", "packageRoot"
  ],
  "properties": {
    "format": { "const": "K/manifest/1" },
    "executionAllowed": { "const": false },
    "runtimeBinding": { "type": "null" },
    "policy": { "type": "null" },
    "authorization": { "type": "null" },
    "claim": { "type": "null" },
    "run": { "type": "null" },
    "evidence": { "type": "null" },
    "metrics": { "type": "null" },
    "ranking": { "type": "null" },
    "selection": { "type": "null" },
    "journal": { "type": "null" },
    "terminal": { "type": "null" },
    "capture": { "type": "null" },
    "concreteLocations": { "type": "null" },
    "runtimeCore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["closureLocator", "closureSha256", "runtimeEntrypoint", "buildTimeOnlyLocators"],
      "properties": {
        "closureLocator": { "const": "runtime-core.v1.json" },
        "closureSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "runtimeEntrypoint": { "const": "src/contracts.mjs" },
        "buildTimeOnlyLocators": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    },
    "entryCount": { "type": "integer", "minimum": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["locator", "sha256", "bytes"],
        "properties": {
          "locator": { "type": "string", "minLength": 1, "maxLength": 191 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "entriesRoot": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "manifestRoot": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "packageRoot": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
