{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K declarative private storage contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["executionAllowed", "privateDirectoryMode", "captureDirectoryMode", "createdFileMode", "openFlags", "objectRequirements", "terminalProtocol"],
  "properties": {
    "executionAllowed": { "const": false },
    "privateDirectoryMode": { "const": "0700" },
    "captureDirectoryMode": { "const": "0700" },
    "createdFileMode": { "const": "0600" },
    "openFlags": {
      "type": "array",
      "const": ["O_CREAT", "O_EXCL", "O_NOFOLLOW", "O_CLOEXEC"]
    },
    "objectRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "linkCount"],
      "properties": { "kind": { "const": "regular" }, "linkCount": { "const": 1 } }
    },
    "terminalProtocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primitive", "flag", "fallback"],
      "properties": {
        "primitive": { "const": "renameat2" },
        "flag": { "const": "RENAME_NOREPLACE" },
        "fallback": { "const": "fail-closed" }
      }
    }
  }
}
