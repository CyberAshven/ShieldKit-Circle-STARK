{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K journal entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["journalKey", "journalReceipt", "dispatchReceipt", "sequence", "kind", "previousRoot", "eventRoot", "entryRoot"],
  "properties": {
    "journalKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "journalReceipt": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "dispatchReceipt": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "previousRoot": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "eventRoot": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "entryRoot": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
