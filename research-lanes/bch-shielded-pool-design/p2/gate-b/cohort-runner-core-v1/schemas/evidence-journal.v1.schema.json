{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K evidence-only journal opening v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["journalKey", "dispatchPlanRoot", "journalRoot", "evidenceOnly", "grantsAuthority"],
  "properties": {
    "journalKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "dispatchPlanRoot": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "journalRoot": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evidenceOnly": { "const": true },
    "grantsAuthority": { "const": false }
  }
}
