{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K lifecycle state v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["phase", "externalActive", "executionAllowed"],
  "properties": {
    "phase": {
      "enum": [
        "retained", "claimed", "journaled", "admitted", "externally-active",
        "observed", "succeeded", "failed", "recovering", "terminal"
      ]
    },
    "externalActive": { "type": "boolean" },
    "executionAllowed": { "const": false }
  }
}
