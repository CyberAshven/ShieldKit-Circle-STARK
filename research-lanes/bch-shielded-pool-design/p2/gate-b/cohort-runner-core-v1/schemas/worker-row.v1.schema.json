{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K worker row v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workerId", "endpointId", "byteAuthority"],
  "properties": {
    "workerId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "endpointId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "byteAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentRoot", "byteCount"],
      "properties": {
        "contentRoot": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "byteCount": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    }
  }
}
