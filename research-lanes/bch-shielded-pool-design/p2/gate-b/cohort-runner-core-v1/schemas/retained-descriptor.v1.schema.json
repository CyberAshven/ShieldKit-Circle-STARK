{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K retained descriptor input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["descriptorKey", "revision", "subjectRoot", "envelopeRoot"],
  "properties": {
    "descriptorKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "subjectRoot": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "envelopeRoot": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
