{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shieldkit-labs/p2/gate-b/gate-b1-branch-slot-language/v1/branch-slot/v1",
  "title": "Gate B1 Opaque Branch Slot Language Branch Slot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordKind",
    "branchSlotId",
    "status",
    "relationRef",
    "relationSemanticsId",
    "authority",
    "credit"
  ],
  "properties": {
    "recordKind": {
      "type": "string",
      "const": "BRANCH_SLOT"
    },
    "branchSlotId": {
      "enum": [
        "branch-slot:0",
        "branch-slot:1"
      ]
    },
    "status": {
      "const": "OPAQUE_UNASSIGNED_NO_CREDIT"
    },
    "relationRef": {
      "type": "null",
      "const": null
    },
    "relationSemanticsId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value"
      ],
      "properties": {
        "status": {
          "const": "UNASSIGNED"
        },
        "value": {
          "type": "null",
          "const": null
        }
      }
    },
    "authority": {
      "const": "NONE"
    },
    "credit": {
      "const": "NONE"
    }
  },
  "allOf": [
    true
  ]
}
