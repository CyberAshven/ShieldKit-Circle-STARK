{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-commit-helper-v1/build-receipt.v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "receiptId", "status", "source", "assembler", "linker", "commands", "environment", "intermediateObject", "output", "checks", "contentDigest"],
  "properties": {
    "schema": {"const": "shieldkit-labs/p2/gate-b/cohort-commit-helper-v1/build-receipt/v1"},
    "receiptId": {"const": "build-receipt:renameat2-noreplace-dir-commit-x86_64-linux-v1"},
    "status": {"const": "reproducible-local-build"},
    "source": {"type": "object", "additionalProperties": false, "required": ["path", "rawSha256", "byteLength"], "properties": {"path": {"const": "renameat2-helper.S"}, "rawSha256": {"$ref": "#/$defs/sha"}, "byteLength": {"type": "integer", "minimum": 1}}},
    "assembler": {"$ref": "#/$defs/assembler"},
    "linker": {"$ref": "#/$defs/linker"},
    "commands": {"type": "object", "additionalProperties": false, "required": ["assemble", "link"], "properties": {"assemble": {"const": ["/usr/bin/as", "--64", "-o", "<temporary-object>", "renameat2-helper.S"]}, "link": {"const": ["/usr/bin/ld", "-m", "elf_x86_64", "--build-id=none", "-z", "noexecstack", "-e", "_start", "-o", "renameat2-helper", "<temporary-object>"]}}},
    "environment": {"type": "object", "additionalProperties": false, "required": ["LC_ALL", "LANG", "TZ", "SOURCE_DATE_EPOCH", "PATH"], "properties": {"LC_ALL": {"const": "C"}, "LANG": {"const": "C"}, "TZ": {"const": "UTC"}, "SOURCE_DATE_EPOCH": {"const": "0"}, "PATH": {"const": "/usr/bin:/bin"}}},
    "intermediateObject": {"type": "object", "additionalProperties": false, "required": ["pathToken", "pathPolicy", "rawSha256", "byteLength"], "properties": {"pathToken": {"const": "<temporary-object>"}, "pathPolicy": {"const": "mkdtemp-os-tmpdir-outside-package"}, "rawSha256": {"$ref": "#/$defs/sha"}, "byteLength": {"type": "integer", "minimum": 1}}},
    "output": {"type": "object", "additionalProperties": false, "required": ["path", "rawSha256", "byteLength"], "properties": {"path": {"const": "renameat2-helper"}, "rawSha256": {"$ref": "#/$defs/sha"}, "byteLength": {"type": "integer", "minimum": 1}}},
    "checks": {"type": "object", "additionalProperties": false, "required": ["machine", "interpreter", "dynamicSection", "neededLibraries", "buildId"], "properties": {"machine": {"const": "x86_64"}, "interpreter": {"const": null}, "dynamicSection": {"const": null}, "neededLibraries": {"const": []}, "buildId": {"const": null}}},
    "contentDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assembler": {"type": "object", "additionalProperties": false, "required": ["path", "rawSha256", "byteLength", "version"], "properties": {"path": {"const": "/usr/bin/as"}, "rawSha256": {"$ref": "#/$defs/sha"}, "byteLength": {"type": "integer", "minimum": 1}, "version": {"type": "string", "minLength": 1}}},
    "linker": {"type": "object", "additionalProperties": false, "required": ["path", "rawSha256", "byteLength", "version"], "properties": {"path": {"const": "/usr/bin/ld"}, "rawSha256": {"$ref": "#/$defs/sha"}, "byteLength": {"type": "integer", "minimum": 1}, "version": {"type": "string", "minLength": 1}}},
    "digest": {"type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "domain", "frame", "value"], "properties": {"algorithm": {"const": "sha256"}, "canonicalization": {"const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"}, "domain": {"const": "shieldkit-labs/p2/gate-b/cohort-commit-helper-v1/build-receipt/root"}, "frame": {"const": "utf8(domain)||0x00||canonical-json-utf8"}, "value": {"$ref": "#/$defs/sha"}}}
  }
}
