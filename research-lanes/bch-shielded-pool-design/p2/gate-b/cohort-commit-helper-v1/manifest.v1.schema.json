{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-commit-helper-v1/manifest.v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "status", "coverage", "files", "contentDigest"],
  "properties": {
    "schema": {"const": "shieldkit-labs/p2/gate-b/cohort-commit-helper-v1/manifest/v1"},
    "status": {"const": "reproducible-local-build"},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["selfManifestExcluded", "checksumsExcluded", "listedPayloadCount"], "properties": {"selfManifestExcluded": {"const": true}, "checksumsExcluded": {"const": true}, "listedPayloadCount": {"type": "integer", "const": 11}}},
    "files": {"type": "array", "minItems": 11, "maxItems": 11, "items": {"$ref": "#/$defs/file"}},
    "contentDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "rawSha256", "byteLength"], "properties": {"path": {"type": "string", "pattern": "^research-lanes/bch-shielded-pool-design/p2/gate-b/cohort-commit-helper-v1/[^/].*$"}, "rawSha256": {"$ref": "#/$defs/sha"}, "byteLength": {"type": "integer", "minimum": 1}}},
    "digest": {"type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "domain", "frame", "value"], "properties": {"algorithm": {"const": "sha256"}, "canonicalization": {"const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"}, "domain": {"const": "shieldkit-labs/p2/gate-b/cohort-commit-helper-v1/package-manifest/root"}, "frame": {"const": "utf8(domain)||0x00||canonical-json-utf8"}, "value": {"$ref": "#/$defs/sha"}}}
  }
}
