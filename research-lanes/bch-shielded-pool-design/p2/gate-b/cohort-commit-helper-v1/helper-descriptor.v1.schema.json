{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-commit-helper-v1/helper-descriptor.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "helperId", "platform", "syscall", "interface", "sourceBinding", "binaryPath", "contentDigest"],
  "properties": {
    "schema": {"const": "shieldkit-labs/p2/gate-b/cohort-commit-helper-v1/descriptor/v1"},
    "helperId": {"const": "renameat2-noreplace-dir-commit-x86_64-linux-v1"},
    "platform": {"const": "linux-x86_64"},
    "syscall": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "number", "oldParentFd", "newParentFd", "flags"],
      "properties": {
        "name": {"const": "renameat2"}, "number": {"const": 316},
        "oldParentFd": {"const": 3}, "newParentFd": {"const": 4},
        "flags": {"type": "object", "additionalProperties": false, "required": ["RENAME_NOREPLACE"], "properties": {"RENAME_NOREPLACE": {"const": 1}}}
      }
    },
    "interface": {
      "type": "object", "additionalProperties": false,
      "required": ["argv", "requiredInheritedFds", "basenameRules", "stdio", "exitCodes"],
      "properties": {
        "argv": {"const": ["<executable>", "<old-basename>", "<new-basename>"]},
        "requiredInheritedFds": {"const": [3, 4, 5]},
        "basenameRules": {"type": "object", "additionalProperties": false, "required": ["nonempty", "rejectDot", "rejectDotDot", "rejectSlash"], "properties": {"nonempty": {"const": true}, "rejectDot": {"const": true}, "rejectDotDot": {"const": true}, "rejectSlash": {"const": true}}},
        "stdio": {"type": "object", "additionalProperties": false, "required": ["stdoutByteLength", "stderrByteLength"], "properties": {"stdoutByteLength": {"const": 0}, "stderrByteLength": {"const": 0}}},
        "exitCodes": {"type": "object", "additionalProperties": false, "required": ["success", "existing", "crossDevice", "usageOrName", "otherErrno"], "properties": {"success": {"const": 0}, "existing": {"const": 17}, "crossDevice": {"const": 18}, "usageOrName": {"const": 64}, "otherErrno": {"const": 111}}},
        "sourceValidation": {"type": "object", "additionalProperties": false, "required": ["retainedSourceFd", "sourceType", "comparisonFields", "lookupFlags", "preRenameCheck", "postRenameCheck", "mismatchExit", "raceBoundary"], "properties": {"retainedSourceFd": {"const": 5}, "sourceType": {"const": "directory"}, "comparisonFields": {"const": ["st_dev", "st_ino", "st_mode", "st_uid", "st_gid"]}, "lookupFlags": {"const": "AT_SYMLINK_NOFOLLOW"}, "preRenameCheck": {"const": true}, "postRenameCheck": {"const": true}, "mismatchExit": {"const": 111}, "raceBoundary": {"const": "cooperative-same-uid-namespace-name-check-not-atomic"}}}
      }
    },
    "sourceBinding": {"$ref": "#/$defs/rawBinding"},
    "binaryPath": {"const": "renameat2-helper"},
    "contentDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rawBinding": {"type": "object", "additionalProperties": false, "required": ["path", "rawSha256", "byteLength"], "properties": {"path": {"const": "renameat2-helper.S"}, "rawSha256": {"$ref": "#/$defs/sha"}, "byteLength": {"type": "integer", "minimum": 1}}},
    "digest": {"type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "domain", "frame", "value"], "properties": {"algorithm": {"const": "sha256"}, "canonicalization": {"const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"}, "domain": {"const": "shieldkit-labs/p2/gate-b/cohort-commit-helper-v1/descriptor/root"}, "frame": {"const": "utf8(domain)||0x00||canonical-json-utf8"}, "value": {"$ref": "#/$defs/sha"}}}
  }
}
