{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/research-lanes/bch-shielded-pool-design/p2/gate-b/equal-relation-experiment.schema.json",
  "title": "Gate-B equal-relation experiment contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contractId",
    "status",
    "scope",
    "frontier",
    "selection",
    "preExecutionGates",
    "relationSuite",
    "corpusSemantics",
    "engines",
    "metricVector",
    "commandSlots",
    "artifactSlots",
    "promotion"
  ],
  "properties": {
    "schema": { "const": "shieldkit-labs/p2-gate-b/equal-relation-experiment/v1" },
    "contractId": { "const": "contract:gate-b-equal-relations-v1" },
    "status": { "const": "contract-only-unmeasured" },
    "scope": { "$ref": "#/$defs/scope" },
    "frontier": { "$ref": "#/$defs/frontier" },
    "selection": { "$ref": "#/$defs/selection" },
    "preExecutionGates": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/preExecutionGate" },
      "uniqueItems": true
    },
    "relationSuite": { "$ref": "#/$defs/relationSuite" },
    "corpusSemantics": { "$ref": "#/$defs/corpusSemantics" },
    "engines": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/engine" },
      "uniqueItems": true
    },
    "metricVector": { "$ref": "#/$defs/metricVector" },
    "commandSlots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/commandSlot" },
      "uniqueItems": true
    },
    "artifactSlots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifactSlot" },
      "uniqueItems": true
    },
    "promotion": { "$ref": "#/$defs/promotion" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*){1,8}$"
    },
    "path": { "type": "string", "minLength": 1 },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "gate", "relationRef", "purpose", "evidenceClassification"],
      "properties": {
        "phase": { "const": "P2" },
        "gate": { "const": "Gate-B" },
        "relationRef": { "const": "relation:pool-action-fv1" },
        "purpose": { "const": "Equal semantic relation corpus across native, standard Libauth, real unmodified BCHN, and LeanBCH support surfaces." },
        "evidenceClassification": { "const": "not-evidence" }
      }
    },
    "frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldContractPath", "fieldContractStatus", "compositionPath", "compositionStatus", "selectedTupleCount", "selectionStatus"],
      "properties": {
        "fieldContractPath": { "const": "research/field-frontier-contract.md" },
        "fieldContractStatus": { "const": "frozen-experiment-representation-boundary-v1" },
        "compositionPath": { "const": "research/circle-fri-candidate-matrix.v2.json" },
        "compositionStatus": { "const": "research-only-no-selection" },
        "selectedTupleCount": { "const": 0 },
        "selectionStatus": { "const": "closed" }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executionStatus", "selectedTupleCount", "frozenCandidateTupleCount", "candidateRoster", "candidateSpecificExecution"],
      "properties": {
        "executionStatus": { "const": "blocked" },
        "selectedTupleCount": { "const": 0 },
        "frozenCandidateTupleCount": { "const": 0 },
        "candidateSpecificExecution": { "const": "blocked-pending-frozen-descriptor-and-certificates" },
        "candidateRoster": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/candidateSlot" },
          "uniqueItems": true
        }
      }
    },
    "candidateSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateSlotId", "fieldSpecRef", "status", "frozenCandidateTupleRef", "executionAllowed"],
      "properties": {
        "candidateSlotId": { "$ref": "#/$defs/id" },
        "fieldSpecRef": { "$ref": "#/$defs/id" },
        "status": { "const": "blocked-missing-frozen-descriptor-or-certificate" },
        "frozenCandidateTupleRef": { "type": "null" },
        "executionAllowed": { "const": false }
      }
    },
    "preExecutionGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateId", "kind", "status", "requiredBeforeCandidateExecution", "passCondition"],
      "properties": {
        "gateId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["exact-polynomial-or-tower", "dual-certificate-replay", "typed-descriptor"] },
        "status": { "const": "blocked" },
        "requiredBeforeCandidateExecution": { "const": true },
        "passCondition": { "$ref": "#/$defs/nonEmptyString" },
        "replays": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/replaySlot" },
          "uniqueItems": true
        },
        "requiredDescriptorFields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "dual-certificate-replay" } }, "required": ["kind"] },
          "then": { "required": ["replays"], "properties": { "replays": { "type": "array" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "typed-descriptor" } }, "required": ["kind"] },
          "then": { "required": ["requiredDescriptorFields"], "properties": { "requiredDescriptorFields": { "type": "array" } } }
        }
      ]
    },
    "replaySlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replayId", "independenceRole", "status", "artifactSlotId"],
      "properties": {
        "replayId": { "$ref": "#/$defs/id" },
        "independenceRole": { "enum": ["repository-checker", "independent-cas-or-equivalently-reviewed-checker"] },
        "status": { "const": "required-unrun" },
        "artifactSlotId": { "$ref": "#/$defs/id" }
      }
    },
    "relationSuite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suiteId", "seedHex", "relations", "identicalAcrossEngines", "inputEncodingRule"],
      "properties": {
        "suiteId": { "const": "suite:gate-b-equal-relations-v1" },
        "seedHex": { "const": "0123456789abcdef" },
        "identicalAcrossEngines": { "const": true },
        "inputEncodingRule": { "const": "Every engine receives the same canonical fixed-width bytes for the same relation, case, and mutation; no host-side normalization precedes VM execution." },
        "relations": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/relation" },
          "uniqueItems": true
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationId", "label", "expression", "normalizedExpression", "operands", "casePlanRef", "mutationPlanRef"],
      "properties": {
        "relationId": { "enum": ["relation:e-mac", "relation:e-square-mac", "relation:e-inverse-check"] },
        "label": { "enum": ["E-MAC", "E-SQUARE-MAC", "E-INVERSE-CHECK"] },
        "expression": { "enum": ["D=A*B+C", "D=A^2+C", "A!=0 && A*H=1"] },
        "normalizedExpression": { "enum": ["eq(D,add(mul(A,B),C))", "eq(D,add(square(A),C))", "and(ne(A,0),eq(mul(A,H),1))"] },
        "operands": {
          "type": "array",
          "items": { "enum": ["A", "B", "C", "D", "H"] },
          "uniqueItems": true
        },
        "casePlanRef": { "const": "cases:gate-b-shared-v1" },
        "mutationPlanRef": { "const": "mutations:gate-b-shared-v1" }
      }
    },
    "corpusSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["casePlanId", "mutationPlanId", "seedHex", "categories", "caseSemantics", "mutationSemantics", "crossEngineIdentityRule"],
      "properties": {
        "casePlanId": { "const": "cases:gate-b-shared-v1" },
        "mutationPlanId": { "const": "mutations:gate-b-shared-v1" },
        "seedHex": { "const": "0123456789abcdef" },
        "categories": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/category" },
          "uniqueItems": true
        },
        "caseSemantics": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/caseSemantic" },
          "uniqueItems": true
        },
        "mutationSemantics": {
          "type": "array",
          "minItems": 8,
          "items": { "$ref": "#/$defs/mutationSemantic" },
          "uniqueItems": true
        },
        "crossEngineIdentityRule": { "const": "The same category, case semantic, mutation semantic, relation id, and deterministic case order are replayed by every engine; unsupported coverage is explicit and never synthesized." }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categoryId", "acceptancePolicy", "caseIdPrefix"],
      "properties": {
        "categoryId": { "enum": ["category:valid", "category:boundary", "category:random", "category:metamorphic", "category:malformed"] },
        "acceptancePolicy": { "enum": ["relation-defined", "relation-defined-with-boundary", "relation-defined-with-seed", "must-preserve-verdict", "must-reject"] },
        "caseIdPrefix": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "caseSemantic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "categoryId", "semanticRule"],
      "properties": {
        "caseId": { "$ref": "#/$defs/id" },
        "categoryId": { "$ref": "#/$defs/id" },
        "semanticRule": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "mutationSemantic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutationId", "family", "semanticRule", "expectedEffect"],
      "properties": {
        "mutationId": { "$ref": "#/$defs/id" },
        "family": { "enum": ["wrong-length", "truncation", "trailing-bytes", "out-of-range", "sign-alias", "swapped-limb", "wrong-relation-output", "zero-inverse-hint"] },
        "semanticRule": { "$ref": "#/$defs/nonEmptyString" },
        "expectedEffect": { "enum": ["reject", "reject-or-explicit-unsupported", "verdict-preserving"] }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineId", "engineKind", "mode", "executionPolicy", "supportPolicy", "status", "commandSlotId", "artifactSlotId"],
      "properties": {
        "engineId": { "enum": ["engine:native", "engine:libauth", "engine:bchn", "engine:leanbch"] },
        "engineKind": { "enum": ["native-reference", "standard-libauth", "real-unmodified-bchn", "leanbch"] },
        "mode": { "enum": ["reference", "standard", "standard-script-leg", "supported-or-explicit-unsupported"] },
        "executionPolicy": { "enum": ["contract-slot-only", "standard-library-pinned", "unmodified-build-only", "supported-or-explicit-unsupported"] },
        "supportPolicy": { "enum": ["required", "required-or-explicit-unsupported"] },
        "status": { "const": "not-run" },
        "commandSlotId": { "$ref": "#/$defs/id" },
        "artifactSlotId": { "$ref": "#/$defs/id" },
        "versionPin": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "metricVector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vectorId", "ordering", "metrics", "unsupportedRule", "headroomRule"],
      "properties": {
        "vectorId": { "const": "metrics:gate-b-exact-cross-engine-v1" },
        "ordering": {
          "const": ["verdict", "lockingBytes", "unlockingBytes", "sourceBytes", "opcodeHistogram", "mulByteProduct", "divByteProduct", "modByteProduct", "resultPushBytes", "vmCost", "opCost", "stackMax", "elementMax", "limits", "headroom"]
        },
        "metrics": {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "items": { "$ref": "#/$defs/metric" },
          "uniqueItems": true
        },
        "unsupportedRule": { "const": "Only LeanBCH may report explicit unsupported coverage; no engine may replace an unavailable metric with null, projection, or another engine's value." },
        "headroomRule": { "const": "For every applicable limit, headroom is limit minus the measured value, with the exact source profile and unit retained." }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metricId", "unit", "scope", "requiredForComparison"],
      "properties": {
        "metricId": { "enum": ["verdict", "lockingBytes", "unlockingBytes", "sourceBytes", "opcodeHistogram", "mulByteProduct", "divByteProduct", "modByteProduct", "resultPushBytes", "vmCost", "opCost", "stackMax", "elementMax", "limits", "headroom"] },
        "unit": { "$ref": "#/$defs/nonEmptyString" },
        "scope": { "enum": ["case", "transaction-source", "script", "resource-budget"] },
        "requiredForComparison": { "const": true },
        "definition": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "commandSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commandSlotId", "status", "argvTemplate", "workingDirectory", "deterministic", "seedArgument", "artifactSlotId"],
      "properties": {
        "commandSlotId": { "$ref": "#/$defs/id" },
        "status": { "const": "reserved-not-run" },
        "argvTemplate": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "workingDirectory": { "const": "repository-root" },
        "deterministic": { "const": true },
        "seedArgument": { "const": "--seed 0123456789abcdef" },
        "artifactSlotId": { "$ref": "#/$defs/id" }
      }
    },
    "artifactSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactSlotId", "kind", "status", "pathTemplate", "digestRequired", "digest"],
      "properties": {
        "artifactSlotId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["corpus", "descriptor", "certificate-replay", "engine-result", "metric-report", "cross-engine-summary"] },
        "status": { "const": "empty-contract-slot" },
        "pathTemplate": { "type": "string", "pattern": "^research-lanes/bch-shielded-pool-design/p2/gate-b/artifacts/[a-z0-9._{}-]+$" },
        "digestRequired": { "const": true },
        "digest": { "type": "null" }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectionStatus", "executionStatus", "evidenceStatus", "passRequires", "projectionPolicy"],
      "properties": {
        "selectionStatus": { "const": "closed" },
        "executionStatus": { "const": "blocked" },
        "evidenceStatus": { "const": "not-evidence" },
        "passRequires": {
          "const": ["exact polynomial or typed tower descriptor", "dual independent certificate replay", "typed frontier descriptor conformance", "same corpus and mutations across all engine slots", "complete metric vector with explicit unsupported coverage"]
        },
        "projectionPolicy": { "const": "Projected, synthetic, patched, or partial metrics cannot pass Gate B or qualify a candidate." }
      }
    }
  }
}
