{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/equal-relation-arithmetic-campaign.v1.schema.json",
  "title": "Additive Gate-B0 arithmetic campaign contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "campaignId",
    "status",
    "contentDigest",
    "preMeasurementCorrection",
    "selection",
    "tupleRef",
    "evidenceClassification",
    "gateBContractBinding",
    "matrixBinding",
    "sourcePins",
    "cohort",
    "tracks",
    "counterbalancedRunOrder",
    "corpusGenerator",
    "countFormulas",
    "engines",
    "metricVector"
  ],
  "properties": {
    "schema": { "const": "shieldkit-labs/p2-gate-b/equal-relation-arithmetic-campaign/v1" },
    "campaignId": { "const": "campaign:gate-b-arithmetic-v1" },
    "status": { "const": "contract-only-unmeasured" },
    "contentDigest": { "$ref": "#/$defs/contentDigest" },
    "preMeasurementCorrection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "supersededContentDigest", "reason", "resolution", "evidenceImpact"],
      "properties": {
        "status": { "const": "resolved-before-first-corpus-or-engine-run" },
        "supersededContentDigest": { "$ref": "#/$defs/sha256" },
        "reason": { "type": "string", "minLength": 1 },
        "resolution": { "type": "string", "minLength": 1 },
        "evidenceImpact": { "const": "none-no-corpus-hash-or-engine-result-existed" }
      }
    },
    "selection": { "const": "none" },
    "tupleRef": { "type": "null" },
    "evidenceClassification": { "const": "not-evidence" },
    "gateBContractBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractPath", "contractDigest", "schemaPath", "schemaDigest", "suiteId", "seedHex"],
      "properties": {
        "contractPath": { "const": "p2/gate-b/equal-relation-experiment.v1.json" },
        "contractDigest": { "$ref": "#/$defs/sha256" },
        "schemaPath": { "const": "p2/gate-b/equal-relation-experiment.schema.json" },
        "schemaDigest": { "$ref": "#/$defs/sha256" },
        "suiteId": { "const": "suite:gate-b-equal-relations-v1" },
        "seedHex": { "const": "0123456789abcdef" }
      }
    },
    "matrixBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "registryKind", "selectionStatus"],
      "properties": {
        "path": { "const": "research/circle-fri-candidate-matrix.v2.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "registryKind": { "const": "prequalification-component-registry" },
        "selectionStatus": { "const": "closed" }
      }
    },
    "sourcePins": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/sourcePin" }, "uniqueItems": true },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparisonFieldSpecs", "calibrationFieldSpec", "killedNegativeControl", "m89FirstStatus", "cohortRankingStatus"],
      "properties": {
        "comparisonFieldSpecs": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "calibrationFieldSpec": { "const": "field-spec:m31-d1" },
        "killedNegativeControl": { "const": "field-spec:m29-d5-invalid" },
        "m89FirstStatus": { "const": "non-ranking-harness-shakedown-only" },
        "cohortRankingStatus": { "const": "closed-until-all-four-descriptors-and-both-tracks-share-one-epoch" }
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trackId", "kind", "rankingPolicy"],
        "properties": {
          "trackId": { "enum": ["track:canonical-schoolbook", "track:optimized"] },
          "kind": { "enum": ["canonical-schoolbook", "optimized"] },
          "rankingPolicy": { "const": "component-measurement-only-no-field-or-protocol-selection" }
        }
      }
    },
    "counterbalancedRunOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "purpose"],
      "properties": {
        "rule": { "const": "first-byte(sha256(descriptor-content-digest-hex-ascii))&1;0=canonical-then-optimized;1=optimized-then-canonical" },
        "purpose": { "const": "counterbalance-track-order-without-ranking" }
      }
    },
    "corpusGenerator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "protocolUse", "seedHex", "domainTagAscii", "relationOrder", "categoryOrder", "frame", "digestInterpretation", "rejection", "categoryGeneration", "mutationFamilies", "mutationPlans"],
      "properties": {
        "algorithm": { "const": "sha256-counter-rejection-v2" },
        "protocolUse": { "const": "host-test-only-not-protocol-hash-or-sampler" },
        "seedHex": { "const": "0123456789abcdef" },
        "domainTagAscii": { "const": "shieldkit-gate-b-corpus-v2" },
        "relationOrder": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "enum": ["relation:e-mac", "relation:e-square-mac", "relation:e-inverse-check"] }, "uniqueItems": true },
        "categoryOrder": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "enum": ["category:valid", "category:boundary", "category:random", "category:metamorphic", "category:malformed"] }, "uniqueItems": true },
        "frame": { "const": "ascii(domainTag)||00||seed[8]||relationIndex:u8||categoryIndex:u8||operandIndex:u8||limbIndex:u16le||caseIndex:u32le||vectorAttempt:u32le||sampleRetry:u32le" },
        "digestInterpretation": { "const": "sha256(frame)-as-unsigned-little-endian-256-bit-integer" },
        "rejection": { "const": "threshold=floor(2^256/p)*p;accept-only-x<threshold;value=x-mod-p;increment-sampleRetry-u32le-for-that-coefficient;increment-vectorAttempt-and-resample-all-relation-inputs-when-a-declared-vector-postcondition-fails;reject-on-either-u32-overflow" },
        "categoryGeneration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["valid", "boundary", "random", "metamorphic", "malformed"],
          "properties": {
            "valid": { "const": "cases-0..15-use-scalar-(case+1)-in-c0-and-zero-other-limbs;E-MAC:B=scalar+1,C=scalar+2,D=A*B+C;E-SQUARE-MAC:C=scalar+1,D=A^2+C;E-INVERSE-CHECK:H=A^-1" },
            "boundary": { "const": "ordered-A-templates=[zero,one,all-p-minus-1,p,p-plus-1,sign-alias]||for-each-limb-j:[unit-j-p-minus-1,unit-j-p];other-inputs-one-or-zero;derive-D-or-H-when-defined;accept-iff-all-raw-operands-canonical-and-relation-true" },
            "random": { "const": "32-cases-draw-independent-relation-input-limbs-by-counter-rejection;derive-D-or-H;for-inverse-require-A-nonzero-or-increment-vectorAttempt-and-resample-all-A-limbs" },
            "metamorphic": { "const": "16-independent-random-valid-base-cases;E-MAC-swap-A-B-require-A-not-equal-B;E-SQUARE-MAC-negate-A-require-A-nonzero;E-INVERSE-CHECK-swap-A-H-require-A-not-equal-H;increment-vectorAttempt-and-resample-base-on-failed-postcondition;preserve-derived-output-and-accept-verdict" },
            "malformed": { "const": "caseIndex=mutationIndex*degree+j;draw-an-independent-valid-base-per-relation-family-and-coefficient-index;apply-the-exact-declared-mutation-plan;increment-vectorAttempt-and-resample-the-valid-base-until-the-mutation-is-not-a-no-op-and-the-mutated-case-rejects-at-the-declared-stage" }
          }
        },
        "mutationFamilies": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "enum": ["wrong-length", "truncation", "trailing-bytes", "out-of-range", "sign-alias", "swapped-limb", "wrong-relation-output", "zero-inverse-hint"] },
          "uniqueItems": true
        },
        "mutationPlans": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/mutationPlan" },
          "uniqueItems": true
        }
      }
    },
    "countFormulas": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/relationCount" }, "uniqueItems": true },
    "engines": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "enum": ["engine:native", "engine:libauth", "engine:bchn", "engine:leanbch"] }, "uniqueItems": true },
    "metricVector": { "type": "array", "minItems": 15, "maxItems": 15, "items": { "enum": ["verdict", "lockingBytes", "unlockingBytes", "sourceBytes", "opcodeHistogram", "mulByteProduct", "divByteProduct", "modByteProduct", "resultPushBytes", "vmCost", "opCost", "stackMax", "elementMax", "limits", "headroom"] }, "uniqueItems": true }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*){1,8}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "contentDigest": { "type": "object", "additionalProperties": false, "required": ["algorithm", "value"], "properties": { "algorithm": { "const": "sha256-jcs-omit-contentDigest" }, "value": { "$ref": "#/$defs/sha256" } } },
    "sourcePin": { "type": "object", "additionalProperties": false, "required": ["sourceId", "path", "sha256"], "properties": { "sourceId": { "$ref": "#/$defs/id" }, "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "mutationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "relations", "instances", "targetOperand", "transform", "expectedFailure"],
      "properties": {
        "family": { "enum": ["wrong-length", "truncation", "trailing-bytes", "out-of-range", "sign-alias", "swapped-limb", "wrong-relation-output", "zero-inverse-hint"] },
        "relations": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "enum": ["relation:e-mac", "relation:e-square-mac", "relation:e-inverse-check"] }, "uniqueItems": true },
        "instances": { "const": "one-per-coefficient-index-j-in-ascending-order" },
        "targetOperand": { "type": "string", "minLength": 1 },
        "transform": { "type": "string", "minLength": 1 },
        "expectedFailure": { "type": "string", "minLength": 1 }
      }
    },
    "relationCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationId", "operandCount", "categories"],
      "properties": {
        "relationId": { "enum": ["relation:e-mac", "relation:e-square-mac", "relation:e-inverse-check"] },
        "operandCount": { "type": "integer", "minimum": 2, "maximum": 4 },
        "categories": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/categoryCount" }, "uniqueItems": true }
      }
    },
    "categoryCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categoryId", "caseFormula"],
      "properties": {
        "categoryId": { "enum": ["category:valid", "category:boundary", "category:random", "category:metamorphic", "category:malformed"] },
        "caseFormula": { "$ref": "#/$defs/countExpression" }
      }
    },
    "countExpression": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["op", "value"], "properties": { "op": { "const": "constant" }, "value": { "type": "integer", "minimum": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["op"], "properties": { "op": { "enum": ["degree", "operands"] } } },
        { "type": "object", "additionalProperties": false, "required": ["op", "args"], "properties": { "op": { "enum": ["add", "multiply"] }, "args": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/countExpression" } } } }
      ]
    }
  }
}
