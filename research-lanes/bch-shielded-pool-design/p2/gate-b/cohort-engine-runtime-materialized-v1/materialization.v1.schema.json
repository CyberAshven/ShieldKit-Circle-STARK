{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-engine-runtime-materialized/v1/materialization.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "executionAllowed", "bundleSemanticQualification", "imageLaunchQualification", "downstreamAuthorization", "artifacts", "bindings", "roster", "blockers"],
  "properties": {
    "schema": {"const": "shieldkit-labs/p2/gate-b/cohort-engine-runtime-materialized/v1/materialization"},
    "status": {"const": "materialized-static-unqualified"},
    "executionAllowed": {"const": false},
    "bundleSemanticQualification": {"const": false},
    "imageLaunchQualification": {"const": false},
    "downstreamAuthorization": {"type": "null"},
    "artifacts": {"type": "object", "additionalProperties": false, "required": ["bundleReceipt", "runtimeImage", "licenseProvenance", "sourceGraph", "sourceClosure"], "properties": {"bundleReceipt": {"const": "libauth-bundle-receipt.v1.json"}, "runtimeImage": {"const": "runtime-image.v1.json"}, "licenseProvenance": {"const": "licenses/provenance.v1.json"}, "sourceGraph": {"const": "source/libauth-input-graph.v1.json"}, "sourceClosure": {"const": "source/external-runtime-closure.v1.json"}}},
    "bindings": {"type": "object", "additionalProperties": false, "required": ["graphRawSha256", "graphContentSha256", "runtimeClosureRawSha256", "runtimeClosureContentSha256"], "properties": {"graphRawSha256": {"const": "7da5740246da6938eaee95f7845a2e20a6f92810029f7845b79c09e78c78db6f"}, "graphContentSha256": {"const": "6de62f465f522433132757e125cff5e80bb54b853e03d1d3e98fc5cc7063d14a"}, "runtimeClosureRawSha256": {"const": "4a66addc21b8aacad170c301340293dbefe29f226318fd10660a1592dc931de5"}, "runtimeClosureContentSha256": {"const": "ee3e6b6a697e8a67e9209c475702969cec87a0ece5dc119f1541b3b1e36388a7"}}},
    "roster": {"type": "object", "additionalProperties": false, "required": ["artifacts", "artifactRosterSha256", "kats", "schemas"], "properties": {"artifacts": {"const": ["bundle/libauth-bundle.mjs", "bundle/libauth-bundle.metafile.json", "libauth-bundle-receipt.v1.json", "runtime-image.v1.json", "licenses/provenance.v1.json", "source/libauth-input-graph.v1.json", "source/libauth/**", "source/external-runtime-closure.v1.json", "toolchain/pnpm-lock.yaml", "MANIFEST.json", "SHA256SUMS"]}, "artifactRosterSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "kats": {"const": ["reproducibility.test.mjs", "mutation.test.mjs"]}, "schemas": {"const": ["libauth-bundle-receipt.v1.schema.json", "license-provenance.v1.schema.json", "manifest.v1.schema.json", "materialization.v1.schema.json", "runtime-image.v1.schema.json"]}}},
    "blockers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
