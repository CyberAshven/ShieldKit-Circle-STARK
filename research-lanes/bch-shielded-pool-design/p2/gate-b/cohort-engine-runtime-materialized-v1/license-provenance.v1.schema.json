{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-engine-runtime-materialized/v1/license-provenance.v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "status", "executionAllowed", "distributionLicenseClosure", "packages", "copiedNoticeFiles", "sourceLicenses", "referencePolicy"],
  "properties": {
    "schema": {"const": "shieldkit-labs/p2/gate-b/cohort-engine-runtime-materialized/v1/license-provenance"}, "status": {"const": "notice-mapping-fail-closed"}, "executionAllowed": {"const": false}, "distributionLicenseClosure": {"const": "incomplete-metadata-only-for-glibc-boost-gmp"},
    "packages": {"type": "array", "minItems": 13, "maxItems": 13, "items": {"type": "object", "additionalProperties": false, "required": ["id", "name", "version", "licenses", "noticeFiles", "distributionStatus", "licenseRefs"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "version": {"type": "string"}, "licenses": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "noticeFiles": {"type": "array", "items": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"}}, "distributionStatus": {"enum": ["notice-materialized", "incomplete-metadata-only"]}, "licenseRefs": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}},
    "copiedNoticeFiles": {"type": "array", "items": {"$ref": "#/$defs/file"}}, "sourceLicenses": {"type": "array", "items": {"$ref": "#/$defs/file"}}, "referencePolicy": {"type": "string", "minLength": 1}
  },
  "$defs": {"file": {"type": "object", "additionalProperties": false, "required": ["path", "source", "bytes", "sha256", "mode"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"}, "source": {"type": "string", "pattern": "^/"}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "mode": {"type": "integer", "minimum": 0}}}}
}
