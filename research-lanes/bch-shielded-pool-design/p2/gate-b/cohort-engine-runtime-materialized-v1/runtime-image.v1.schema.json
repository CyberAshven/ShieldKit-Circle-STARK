{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/gate-b/cohort-engine-runtime-materialized/v1/runtime-image.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["architecture", "root", "sourceClosure", "readelf", "loader", "executables", "dsos", "cwdTemplates", "cwdTemplatePolicy", "imageLaunchQualification", "executionAllowed", "downstreamAuthorization", "launch", "blocker"],
  "properties": {
    "architecture": {"const": {"platform": "linux", "arch": "x64"}},
    "root": {"const": "image/root"},
    "sourceClosure": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "rawSha256", "contentSha256"], "properties": {"path": {"const": "source/external-runtime-closure.v1.json"}, "bytes": {"const": 8580}, "rawSha256": {"const": "4a66addc21b8aacad170c301340293dbefe29f226318fd10660a1592dc931de5"}, "contentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "readelf": {"type": "object", "additionalProperties": false, "required": ["path", "realpath", "bytes", "sha256", "version"], "properties": {"path": {"const": "/usr/bin/readelf"}, "realpath": {"const": "/usr/bin/readelf"}, "bytes": {"const": 801752}, "sha256": {"const": "355fe7960d103964e6dfb141237bd51627943ff94218928addb42bed570246bb"}, "version": {"const": "GNU readelf (GNU Binutils) 2.46.1"}}},
    "loader": {"$ref": "#/$defs/imageFile"},
    "executables": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/imageFile"}},
    "dsos": {"type": "array", "minItems": 17, "maxItems": 17, "items": {"$ref": "#/$defs/imageFile"}},
    "cwdTemplates": {"const": ["image/workdirs/bchn", "image/workdirs/leanbch"]}, "cwdTemplatePolicy": {"const": "sealed package templates; future launch must create a separate per-attempt uid-owned 0700 fsynced cwd and must not write the package tree"},
    "imageLaunchQualification": {"const": false}, "executionAllowed": {"const": false}, "downstreamAuthorization": {"type": "null"},
    "launch": {"type": "object", "additionalProperties": false, "required": ["shell", "stdio", "inheritedEnvironment", "packageLocalRoot", "argv0EqualsImageExecutable", "extraInheritedFds", "externalCombinedOutputCapBytes", "terminationGraceMilliseconds", "bchnDeadlineMilliseconds", "leanSharedDeadlineMilliseconds", "leanRemainingConversion", "endpoints", "loaderInvocation", "loaderEnvironmentPolicy", "hostFallbackCheck", "dlopenClaim"], "properties": {
      "shell": {"const": false}, "stdio": {"const": {"0": "captured-stdin", "1": "captured-stdout", "2": "captured-stderr"}}, "inheritedEnvironment": {"const": false}, "packageLocalRoot": {"const": true}, "argv0EqualsImageExecutable": {"const": true}, "extraInheritedFds": {"const": []}, "externalCombinedOutputCapBytes": {"const": 134217728}, "terminationGraceMilliseconds": {"const": 5000}, "bchnDeadlineMilliseconds": {"type": ["integer", "null"]}, "leanSharedDeadlineMilliseconds": {"const": 600000}, "leanRemainingConversion": {"type": "string"}, "endpoints": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/endpoint"}},
      "loaderInvocation": {"type": "object", "additionalProperties": false, "required": ["mode", "loaderPath", "argvTemplate", "argsTemplate", "libraryPathPolicy", "executed"], "properties": {"mode": {"const": "direct-loader-inhibit-cache"}, "loaderPath": {"const": "image/root/lib64/ld-linux-x86-64.so.2"}, "argvTemplate": {"const": ["<package-absolute-root>/image/root/lib64/ld-linux-x86-64.so.2", "--inhibit-cache", "--library-path", "<package-absolute-root>/image/root/usr/lib"]}, "argsTemplate": {"const": ["--inhibit-cache", "--library-path", "<package-absolute-root>/image/root/usr/lib"]}, "libraryPathPolicy": {"const": "absolute package-root-derived path; no host fallback"}, "executed": {"const": false}}},
      "loaderEnvironmentPolicy": {"const": "exact replacement; no LD_LIBRARY_PATH, LD_PRELOAD, or inherited loader variables"}, "hostFallbackCheck": {"const": "not-run"}, "dlopenClaim": {"const": "unqualified"}
    }},
    "blocker": {"const": "Image is byte-materialized but launch is not qualified; no engine or VM was launched."}
  },
  "$defs": {
    "elf": {"type": "object", "additionalProperties": false, "required": ["ptInterp", "soname", "dtNeeded", "rpath", "runpath"], "properties": {"ptInterp": {"type": ["string", "null"]}, "soname": {"type": ["string", "null"]}, "dtNeeded": {"type": "array", "items": {"type": "string"}}, "rpath": {"type": ["string", "null"]}, "runpath": {"type": ["string", "null"]}}},
    "endpoint": {"type": "object", "additionalProperties": false, "required": ["id", "path", "source", "sourceRealpath", "bytes", "sha256", "argv", "argv0", "cwd", "environment", "deadlineMilliseconds"], "properties": {"id": {"enum": ["engine:bchn", "engine:leanbch:vmbconf", "engine:leanbch:costprobe"]}, "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"}, "source": {"type": "string", "pattern": "^/"}, "sourceRealpath": {"type": "string", "pattern": "^/"}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "argv0": {"type": "string"}, "cwd": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"}, "environment": {"type": "object", "additionalProperties": false, "properties": {"BCHN_DEBUG": {"const": "0"}, "LEANBCH_SECP": {"const": "reject"}}}, "deadlineMilliseconds": {"type": ["string", "null"]}}},
    "imageFile": {"type": "object", "additionalProperties": false, "required": ["role", "id", "path", "source", "sourceRealpath", "sourceBytes", "sourceSha256", "sourceMode", "imageBytes", "imageSha256", "imageMode", "bytes", "sha256", "mode", "elf", "licenseRefs"], "properties": {"role": {"enum": ["loader", "executable", "dso"]}, "id": {"type": "string"}, "requestedPath": {"type": "string", "pattern": "^/"}, "soname": {"type": "string"}, "usedBy": {"type": "array", "items": {"type": "string"}}, "sourceArgv": {"type": "array", "items": {"type": "string"}}, "sourceArgv0": {"type": "string", "pattern": "^/"}, "sourceCwd": {"type": "string", "pattern": "^/"}, "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"}, "source": {"type": "string", "pattern": "^/"}, "sourceRealpath": {"type": "string", "pattern": "^/"}, "sourceBytes": {"type": "integer", "minimum": 1}, "sourceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "sourceMode": {"type": "integer", "minimum": 0}, "imageBytes": {"type": "integer", "minimum": 1}, "imageSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "imageMode": {"type": "integer", "minimum": 0}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "mode": {"type": "integer", "minimum": 0}, "elf": {"$ref": "#/$defs/elf"}, "licenseRefs": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}
  }
}
