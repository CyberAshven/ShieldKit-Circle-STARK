{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.invalid/p2/lowering-arm-ir-freeze/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "artifactId", "status", "evidenceClassification", "selection", "tupleRef",
    "protocolBoundary", "executionBoundary", "digestAlgorithms", "upstreamBindings",
    "implementationBindings", "constructionOrder", "programIndex", "moduleIndex", "planIndex",
    "cardinalities", "validationContract", "downstreamBindings", "nonClaims", "contentDigest"
  ],
  "properties": {
    "schema": { "$ref": "#/$defs/schemaBinding" },
    "artifactId": { "const": "lowering-arm-ir-freeze:direct-arithmetic-symbolic-stack-v1" },
    "status": { "const": "frozen-host-validated-pre-source-ir" },
    "evidenceClassification": { "const": "not-execution-evidence" },
    "selection": { "const": "none" },
    "tupleRef": { "type": "null" },
    "protocolBoundary": { "const": "component-only" },
    "executionBoundary": { "$ref": "#/$defs/executionBoundary" },
    "digestAlgorithms": { "$ref": "#/$defs/digestAlgorithms" },
    "upstreamBindings": { "$ref": "#/$defs/upstreamBindings" },
    "implementationBindings": { "$ref": "#/$defs/implementationBindings" },
    "constructionOrder": {
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "programIndex": { "type": "array", "minItems": 28, "maxItems": 28, "items": { "$ref": "#/$defs/programRow" } },
    "moduleIndex": { "type": "array", "minItems": 19, "maxItems": 19, "items": { "$ref": "#/$defs/moduleRow" } },
    "planIndex": { "type": "array", "minItems": 42, "maxItems": 42, "items": { "$ref": "#/$defs/planRow" } },
    "cardinalities": { "$ref": "#/$defs/cardinalities" },
    "validationContract": { "$ref": "#/$defs/validationContract" },
    "downstreamBindings": { "$ref": "#/$defs/downstreamBindings" },
    "nonClaims": {
      "const": [
        "not BCH source or bytecode and not a BCH-VM-exact stack proof",
        "not Libauth, BCHN, LeanBCH, corpus, campaign, or benchmark execution evidence",
        "no byte size, operation cost, standardness, consensus-limit, proof-size, transaction-fit, or prover-time result",
        "no construction ranking, field selection, Circle-domain selection, query selection, protocol selection, or promotion",
        "no soundness, zero-knowledge, post-quantum, full-transaction, or release qualification claim"
      ]
    },
    "contentDigest": { "$ref": "#/$defs/packageDigest" }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableString": { "type": ["string", "null"] },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
    "rawDigest": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "preimage", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "preimage": { "const": "exact-file-bytes" },
        "value": { "$ref": "#/$defs/hex" }
      }
    },
    "packageDigest": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "domain", "frame", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "canonicalization": { "const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1" },
        "domain": { "type": "string", "pattern": "^shieldkit-labs/p2/lowering-arm-ir-freeze/v1/" },
        "frame": { "const": "utf8(domain)||00||canonical-json-utf8" },
        "value": { "$ref": "#/$defs/hex" }
      }
    },
    "upstreamDigest": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "domain", "value"],
      "properties": {
        "algorithm": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "value": { "$ref": "#/$defs/hex" }
      }
    },
    "schemaBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "fileDigest"],
      "properties": {
        "id": { "const": "shieldkit-labs/p2/lowering-arm-ir-freeze/v1" },
        "path": { "const": "research-lanes/bch-shielded-pool-design/p2/lowering-arm-ir-freeze/lowering-arm-ir-freeze.v1.schema.json" },
        "fileDigest": { "$ref": "#/$defs/rawDigest" }
      }
    },
    "executionBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["packageValidationRequired", "sourceEmissionAllowed", "bytecodeEmissionAllowed", "vmExecutionAllowed", "metricsAllowed"],
      "properties": {
        "packageValidationRequired": { "const": true },
        "sourceEmissionAllowed": { "const": false },
        "bytecodeEmissionAllowed": { "const": false },
        "vmExecutionAllowed": { "const": false },
        "metricsAllowed": { "const": false }
      }
    },
    "digestAlgorithms": {
      "type": "object", "additionalProperties": false,
      "required": ["rawFile", "packageObject", "upstreamAuthority"],
      "properties": {
        "rawFile": {
          "type": "object", "additionalProperties": false, "required": ["algorithm", "preimage"],
          "properties": { "algorithm": { "const": "sha256" }, "preimage": { "const": "exact-file-bytes" } }
        },
        "packageObject": {
          "type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "frame"],
          "properties": {
            "algorithm": { "const": "sha256" },
            "canonicalization": { "const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1" },
            "frame": { "const": "utf8(domain)||00||canonical-json-utf8" }
          }
        },
        "upstreamAuthority": {
          "type": "object", "additionalProperties": false, "required": ["algorithm", "note"],
          "properties": {
            "algorithm": { "const": "sha256-upstream-canonical-json-v1" },
            "note": { "const": "opaque upstream identity; package roots are independently domain-separated" }
          }
        }
      }
    },
    "filePin": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "role", "path", "byteCount", "fileDigest", "artifactIdentity", "contentDigest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/path" },
        "byteCount": { "type": "integer", "minimum": 1 },
        "fileDigest": { "$ref": "#/$defs/rawDigest" },
        "artifactIdentity": { "$ref": "#/$defs/nullableString" },
        "contentDigest": {
          "anyOf": [ { "type": "null" }, { "$ref": "#/$defs/upstreamDigest" } ]
        }
      }
    },
    "externalAuthority": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "repository", "commit", "path", "byteCount", "fileDigest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "path": { "$ref": "#/$defs/path" },
        "byteCount": { "type": "integer", "minimum": 1 },
        "fileDigest": { "$ref": "#/$defs/rawDigest" }
      }
    },
    "upstreamBindings": {
      "type": "object", "additionalProperties": false,
      "required": ["files", "externalAuthorities"],
      "properties": {
        "files": { "type": "array", "minItems": 17, "maxItems": 17, "items": { "$ref": "#/$defs/filePin" } },
        "externalAuthorities": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/externalAuthority" } }
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime", "version", "platform", "arch"],
      "properties": {
        "runtime": { "const": "node" },
        "version": { "const": "v22.23.1" },
        "platform": { "const": "linux" },
        "arch": { "const": "x64" }
      }
    },
    "repositorySnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["baseCommit", "sourceState", "authorityPathState", "note"],
      "properties": {
        "baseCommit": { "const": "8e55004e6be0c76bb6aa8aba4d9edbadf2c767f0" },
        "sourceState": { "const": "dirty-untracked-working-tree" },
        "authorityPathState": { "const": "untracked" },
        "note": { "const": "raw file digests are authoritative; baseCommit is provenance and intentionally not current-HEAD validation" }
      }
    },
    "implementationBindings": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime", "repositorySnapshot", "files"],
      "properties": {
        "runtime": { "$ref": "#/$defs/runtime" },
        "repositorySnapshot": { "$ref": "#/$defs/repositorySnapshot" },
        "files": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "$ref": "#/$defs/filePin" } }
      }
    },
    "nodeOps": {
      "type": "object", "additionalProperties": false,
      "required": ["add", "mul", "reduce", "scale", "square", "sub"],
      "properties": {
        "add": { "type": "integer", "minimum": 0 }, "mul": { "type": "integer", "minimum": 0 },
        "reduce": { "type": "integer", "minimum": 0 }, "scale": { "type": "integer", "minimum": 0 },
        "square": { "type": "integer", "minimum": 0 }, "sub": { "type": "integer", "minimum": 0 }
      }
    },
    "byScalarNodeOp": {
      "type": "object", "additionalProperties": false, "required": ["mul", "square"],
      "properties": { "mul": { "type": "integer", "minimum": 0 }, "square": { "type": "integer", "minimum": 0 } }
    },
    "variableBaseCounts": {
      "type": "object", "additionalProperties": false,
      "required": ["declared", "actual", "byScalarNodeOp", "interpretation"],
      "properties": {
        "declared": { "type": "integer", "minimum": 0 }, "actual": { "type": "integer", "minimum": 0 },
        "byScalarNodeOp": { "$ref": "#/$defs/byScalarNodeOp" }, "interpretation": { "type": "string", "minLength": 1 }
      }
    },
    "rangeSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["rowCount", "digest", "minimumInclusive", "maximumInclusive", "canonicalNodeCount"],
      "properties": {
        "rowCount": { "type": "integer", "minimum": 1 }, "digest": { "$ref": "#/$defs/packageDigest" },
        "minimumInclusive": { "type": "string", "pattern": "^-?[0-9]+$" },
        "maximumInclusive": { "type": "string", "pattern": "^-?[0-9]+$" },
        "canonicalNodeCount": { "type": "integer", "minimum": 0 }
      }
    },
    "programRow": {
      "type": "object", "additionalProperties": false,
      "required": [
        "orderIndex", "programId", "armId", "constructionId", "kind", "modulus", "degree",
        "inputCount", "outputCount", "nodeCount", "nodeOpCounts", "variableBaseCounts", "rangeLedger",
        "formulaOccurrenceCount", "matrixOccurrenceCount", "mapOccurrenceCount", "directReductionDisposition",
        "upstreamProgramDigest", "programDigest", "rowDigest"
      ],
      "properties": {
        "orderIndex": { "type": "integer", "minimum": 0, "maximum": 27 },
        "programId": { "type": "string", "minLength": 1 }, "armId": { "type": "string", "minLength": 1 },
        "constructionId": { "type": "string", "minLength": 1 }, "kind": { "enum": ["multiply", "square"] },
        "modulus": { "type": "string", "pattern": "^[0-9]+$" }, "degree": { "type": "integer", "minimum": 2 },
        "inputCount": { "type": "integer", "minimum": 1 }, "outputCount": { "type": "integer", "minimum": 1 },
        "nodeCount": { "type": "integer", "minimum": 1 }, "nodeOpCounts": { "$ref": "#/$defs/nodeOps" },
        "variableBaseCounts": { "$ref": "#/$defs/variableBaseCounts" }, "rangeLedger": { "$ref": "#/$defs/rangeSummary" },
        "formulaOccurrenceCount": { "type": "integer", "minimum": 0 }, "matrixOccurrenceCount": { "type": "integer", "minimum": 0 },
        "mapOccurrenceCount": { "type": "integer", "minimum": 0 }, "directReductionDisposition": { "type": "string", "minLength": 1 },
        "upstreamProgramDigest": { "$ref": "#/$defs/upstreamDigest" }, "programDigest": { "$ref": "#/$defs/packageDigest" },
        "rowDigest": { "$ref": "#/$defs/packageDigest" }
      }
    },
    "primitiveCount": {
      "type": "object", "additionalProperties": false, "required": ["primitive", "count"],
      "properties": { "primitive": { "type": "string", "minLength": 1 }, "count": { "type": "integer", "minimum": 1 } }
    },
    "moduleRow": {
      "type": "object", "additionalProperties": false,
      "required": [
        "orderIndex", "moduleId", "moduleKind", "constructionId", "codecId", "relationTargetId",
        "templateModuleId", "parserModuleId", "degree", "armProgramKind", "instructionTemplateCount",
        "primitiveCounts", "upstreamModuleDigest", "moduleDigest", "rowDigest"
      ],
      "properties": {
        "orderIndex": { "type": "integer", "minimum": 0, "maximum": 18 },
        "moduleId": { "type": "string", "minLength": 1 }, "moduleKind": { "type": "string", "minLength": 1 },
        "constructionId": { "$ref": "#/$defs/nullableString" }, "codecId": { "$ref": "#/$defs/nullableString" },
        "relationTargetId": { "$ref": "#/$defs/nullableString" }, "templateModuleId": { "$ref": "#/$defs/nullableString" },
        "parserModuleId": { "$ref": "#/$defs/nullableString" },
        "degree": { "type": ["integer", "null"], "minimum": 0 }, "armProgramKind": { "$ref": "#/$defs/nullableString" },
        "instructionTemplateCount": { "type": "integer", "minimum": 0 },
        "primitiveCounts": { "type": "array", "items": { "$ref": "#/$defs/primitiveCount" } },
        "upstreamModuleDigest": { "$ref": "#/$defs/upstreamDigest" }, "moduleDigest": { "$ref": "#/$defs/packageDigest" },
        "rowDigest": { "$ref": "#/$defs/packageDigest" }
      }
    },
    "parserInvocation": {
      "type": "object", "additionalProperties": false,
      "required": ["invocationKey", "invocationId", "parserModuleId", "rawRole", "rawValueId", "outputPrefix", "parseIndex"],
      "properties": {
        "invocationKey": { "type": "string", "minLength": 3 }, "invocationId": { "type": "string", "minLength": 1 },
        "parserModuleId": { "type": "string", "minLength": 1 }, "rawRole": { "type": "string", "minLength": 1 },
        "rawValueId": { "type": "string", "minLength": 1 }, "outputPrefix": { "type": "string", "minLength": 1 },
        "parseIndex": { "type": "integer", "minimum": 0 }
      }
    },
    "terminalItem": {
      "type": "object", "additionalProperties": false, "required": ["valueId", "type", "value"],
      "properties": { "valueId": { "type": "string", "minLength": 1 }, "type": { "type": "string", "minLength": 1 }, "value": { "type": "string" } }
    },
    "terminal": {
      "type": "object", "additionalProperties": false, "required": ["primary", "alt"],
      "properties": {
        "primary": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/terminalItem" } },
        "alt": { "type": "array", "maxItems": 0, "items": false }
      }
    },
    "planRow": {
      "type": "object", "additionalProperties": false,
      "required": [
        "orderIndex", "planId", "relationTargetId", "constructionId", "programId", "parserModuleId",
        "wrapperInstanceModuleId", "parserInvocations", "parserInvocationCount", "instructionCount", "traceRowCount",
        "initialPrimaryItems", "initialAltItems", "terminal", "maxPrimaryDepth", "maxAltDepth", "maxCombinedDepth",
        "upstreamPlanDigest", "planDigest", "instructionDigest", "traceDigest", "rowDigest"
      ],
      "properties": {
        "orderIndex": { "type": "integer", "minimum": 0, "maximum": 41 }, "planId": { "type": "string", "minLength": 1 },
        "relationTargetId": { "enum": ["relation:e-mac", "relation:e-square-mac", "relation:e-inverse-check"] },
        "constructionId": { "type": "string", "minLength": 1 }, "programId": { "type": "string", "minLength": 1 },
        "parserModuleId": { "type": "string", "minLength": 1 }, "wrapperInstanceModuleId": { "type": "string", "minLength": 1 },
        "parserInvocations": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/parserInvocation" } },
        "parserInvocationCount": { "type": "integer", "minimum": 2, "maximum": 4 },
        "instructionCount": { "type": "integer", "minimum": 1 }, "traceRowCount": { "type": "integer", "minimum": 1 },
        "initialPrimaryItems": { "type": "integer", "minimum": 2, "maximum": 4 }, "initialAltItems": { "const": 0 },
        "terminal": { "$ref": "#/$defs/terminal" }, "maxPrimaryDepth": { "type": "integer", "minimum": 1 },
        "maxAltDepth": { "type": "integer", "minimum": 0 }, "maxCombinedDepth": { "type": "integer", "minimum": 1 },
        "upstreamPlanDigest": { "$ref": "#/$defs/upstreamDigest" }, "planDigest": { "$ref": "#/$defs/packageDigest" },
        "instructionDigest": { "$ref": "#/$defs/packageDigest" }, "traceDigest": { "$ref": "#/$defs/packageDigest" },
        "rowDigest": { "$ref": "#/$defs/packageDigest" }
      }
    },
    "cardinalities": {
      "type": "object", "additionalProperties": false,
      "required": [
        "constructions", "arms", "programs", "ssaNodes", "rangeLedgerRows", "multiplyProgramNodes", "squareProgramNodes",
        "programInputs", "programOutputs", "formulaOccurrenceRows", "matrixOccurrenceRows", "mapOccurrenceRows", "nodeOps",
        "multiplyKindVariableBaseOps", "squareKindVariableBaseOps", "physicalRelationPlanOccurrences", "parserModules",
        "wrapperTemplates", "wrapperInstances", "physicalPlans", "parserInvocations", "instructions", "storedTraceRows",
        "initialPrimaryItems", "initialAltItems", "terminalBoolItems", "terminalAltItems", "maxPrimaryDepth", "maxAltDepth", "maxCombinedDepth"
      ],
      "properties": {
        "constructions": { "const": 4 }, "arms": { "const": 14 }, "programs": { "const": 28 }, "ssaNodes": { "const": 4806 },
        "rangeLedgerRows": { "const": 4806 }, "multiplyProgramNodes": { "const": 2648 }, "squareProgramNodes": { "const": 2158 },
        "programInputs": { "const": 192 }, "programOutputs": { "const": 128 }, "formulaOccurrenceRows": { "const": 528 },
        "matrixOccurrenceRows": { "const": 628 }, "mapOccurrenceRows": { "const": 90 },
        "nodeOps": { "const": { "add": 996, "mul": 297, "reduce": 2403, "scale": 748, "square": 41, "sub": 321 } },
        "multiplyKindVariableBaseOps": { "const": 192 }, "squareKindVariableBaseOps": { "const": 146 },
        "physicalRelationPlanOccurrences": { "const": 530 }, "parserModules": { "const": 4 }, "wrapperTemplates": { "const": 3 },
        "wrapperInstances": { "const": 12 }, "physicalPlans": { "const": 42 }, "parserInvocations": { "const": 126 },
        "instructions": { "const": 25098 }, "storedTraceRows": { "const": 25098 }, "initialPrimaryItems": { "const": 126 },
        "initialAltItems": { "const": 0 }, "terminalBoolItems": { "const": 42 }, "terminalAltItems": { "const": 0 },
        "maxPrimaryDepth": { "const": 392 }, "maxAltDepth": { "const": 24 }, "maxCombinedDepth": { "const": 392 }
      }
    },
    "digestSet": {
      "type": "object", "additionalProperties": false, "required": ["arms", "programs", "modules", "plans"],
      "properties": {
        "arms": { "$ref": "#/$defs/packageDigest" }, "programs": { "$ref": "#/$defs/packageDigest" },
        "modules": { "$ref": "#/$defs/packageDigest" }, "plans": { "$ref": "#/$defs/packageDigest" }
      }
    },
    "indexDigestSet": {
      "type": "object", "additionalProperties": false, "required": ["programs", "modules", "plans"],
      "properties": {
        "programs": { "$ref": "#/$defs/packageDigest" }, "modules": { "$ref": "#/$defs/packageDigest" }, "plans": { "$ref": "#/$defs/packageDigest" }
      }
    },
    "validationContract": {
      "type": "object", "additionalProperties": false,
      "required": [
        "verdict", "armOrder", "programOrder", "moduleOrder", "relationOrder", "planOrder", "parserInvocationIdentity",
        "completeAuthorityDigests", "compactIndexDigests", "sourceEmissionGate"
      ],
      "properties": {
        "verdict": { "const": "pass" },
        "armOrder": { "type": "array", "minItems": 14, "maxItems": 14, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "programOrder": { "const": "arm-major-then-multiply-square" },
        "moduleOrder": { "const": "parser-modules-then-wrapper-templates-then-wrapper-instances" },
        "relationOrder": { "const": ["relation:e-mac", "relation:e-square-mac", "relation:e-inverse-check"] },
        "planOrder": { "const": "arm-major-then-canonical-relation-order" },
        "parserInvocationIdentity": { "const": "(planId,invocationId)" },
        "completeAuthorityDigests": { "$ref": "#/$defs/digestSet" },
        "compactIndexDigests": { "$ref": "#/$defs/indexDigestSet" },
        "sourceEmissionGate": { "const": "a consumer must validate this exact artifact and refuse missing, stale, unknown, or non-pass package digests" }
      }
    },
    "downstreamBindings": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceSetV1", "campaignV2", "canonicalCorpusV2", "executionEpochV2"],
      "properties": {
        "sourceSetV1": { "type": "null" }, "campaignV2": { "type": "null" },
        "canonicalCorpusV2": { "type": "null" }, "executionEpochV2": { "type": "null" }
      }
    }
  }
}
