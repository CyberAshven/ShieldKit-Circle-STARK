{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/construction-freeze/construction-freeze.v1.schema.json",
  "title": "P2 premeasurement construction-freeze summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "artifactId", "status", "evidenceClassification", "selection", "tupleRef", "protocolBoundary", "searchContract", "transcriptBinding", "targets", "shakedownException", "provenance", "failClosedPolicy", "contentDigest"],
  "properties": {
    "schema": { "const": "shieldkit-labs/p2/construction-freeze/v1" },
    "artifactId": { "const": "construction-freeze:p2-direct-polynomial-small-integer-v1" },
    "status": { "const": "frozen-premeasurement-construction-heuristic" },
    "evidenceClassification": { "const": "not-evidence" },
    "selection": { "const": "none" },
    "tupleRef": { "type": "null" },
    "protocolBoundary": { "const": "component-only" },
    "searchContract": { "$ref": "#/$defs/searchContract" },
    "transcriptBinding": { "$ref": "#/$defs/transcriptBinding" },
    "targets": { "type": "array", "prefixItems": [{ "$ref": "#/$defs/targetSummary" }, { "$ref": "#/$defs/targetSummary" }, { "$ref": "#/$defs/targetSummary" }], "minItems": 3, "maxItems": 3 },
    "shakedownException": { "$ref": "#/$defs/shakedown" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "failClosedPolicy": { "$ref": "#/$defs/failClosedPolicy" },
    "contentDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "unsignedDecimal": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "signedDecimal": { "type": "string", "pattern": "^(0|-?[1-9][0-9]*)$" },
    "searchContract": {
      "type": "object", "additionalProperties": false,
      "required": ["modulusRule", "targets", "K", "monic", "lowerVectorSupport", "t0Nonzero", "signedMagnitudeOrder", "candidateOrder", "polynomialForm", "coefficientOrientation", "reductionRecurrence", "reductionRowOrder", "reductionCentering", "winnerOrientation", "scoreTupleOrder", "scoreMetricDefinitions", "irreducibleScoreDomain", "scoreInterpretation", "serialization"],
      "properties": {
        "modulusRule": { "const": "p=2^q-1" },
        "targets": { "type": "array", "prefixItems": [
          { "type": "object", "additionalProperties": false, "required": ["q", "degree"], "properties": { "q": { "const": 31 }, "degree": { "const": 5 } } },
          { "type": "object", "additionalProperties": false, "required": ["q", "degree"], "properties": { "q": { "const": 31 }, "degree": { "const": 6 } } },
          { "type": "object", "additionalProperties": false, "required": ["q", "degree"], "properties": { "q": { "const": 61 }, "degree": { "const": 3 } } }
        ], "minItems": 3, "maxItems": 3 },
        "K": { "const": 16 }, "monic": { "const": true }, "lowerVectorSupport": { "const": [1, 2] }, "t0Nonzero": { "const": true },
        "signedMagnitudeOrder": { "const": "-1,+1,-2,+2,...,-16,+16" },
        "candidateOrder": { "const": "target-order;support-1-before-support-2;support-2-secondary-index-k-ascending;within-support-t0-signed-order-then-tk-signed-order" },
        "polynomialForm": { "const": "f=x^d+sum(i=0..d-1,t_i*x^i)" },
        "coefficientOrientation": { "const": "tCentered-and-tCanonical-are-c0-through-c(d-1);monic-leading-coefficient-is-implicit-1" },
        "reductionRecurrence": { "const": "R_d[j]=center_p(-t_j);R_(k+1)[0]=center_p(R_k[d-1]*R_d[0]);R_(k+1)[j]=center_p(R_k[j-1]+R_k[d-1]*R_d[j]) for j=1..d-1; k=d..2d-3" },
        "reductionRowOrder": { "const": "rows-are-R_d-through-R_(2d-2);each-row-coefficients-are-c0-through-c(d-1);each-row-entry-is-canonical-centered-signed-decimal" },
        "reductionCentering": { "const": "center_p(z) is the unique integer in [-(p-1)/2,(p-1)/2] congruent to z modulo p" },
        "winnerOrientation": { "const": "minimum-lexicographic-numeric-score;ties-break-by-first-row-in-the-frozen-candidate-order" },
        "scoreTupleOrder": { "const": "nonZeroNonSignedUnitEntryCount,nonZeroEntryCount,bitLengthSum,peakBitLength,peakRowFanIn,polynomialMaxAbsCoefficient,polynomialSupport,polynomialL1,signedLexRanks(t0..t(d-1))" },
        "scoreMetricDefinitions": { "const": "over-all-reduction-row-entries:nonZeroNonSignedUnitEntryCount=count(abs(entry)>1);nonZeroEntryCount=count(entry!=0);bitLength(0)=0-and-otherwise-bitLength(abs(entry));bitLengthSum=sum(bitLength);peakBitLength=max(bitLength);peakRowFanIn=max-per-row-count(entry!=0);over-all-polynomial-coefficients-(t_0..t_(d-1),1):polynomialMaxAbsCoefficient=max(abs(coefficient));polynomialSupport=count(coefficient!=0);polynomialL1=sum(abs(coefficient));signedLexRank(0)=0,signedLexRank(-m)=2m-1,signedLexRank(+m)=2m" },
        "irreducibleScoreDomain": { "const": "only-candidates-whose-repository-Rabin-replay-classification-is-irreducible" },
        "scoreInterpretation": { "const": "symbolic-heuristic-not-BCH-cost-or-lower-bound" },
        "serialization": { "const": "UTF-8;object-keys-in-declaration-order;arrays-in-declared-order;transcript-minified;exactly-one-final-LF;no-CR" }
      }
    },
    "transcriptBinding": {
      "type": "object", "additionalProperties": false, "required": ["path", "schema", "rowCount", "byteCount", "sha256", "contentDigest"],
      "properties": {
        "path": { "const": "construction-freeze.normalized-transcript.v1.json" },
        "schema": { "const": "shieldkit-labs/p2/construction-freeze-normalized-transcript/v1" },
        "rowCount": { "const": 11360 }, "byteCount": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "#/$defs/sha256" }, "contentDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "targetSummary": {
      "type": "object", "additionalProperties": false, "required": ["q", "degree", "p", "testedCount", "irreducibleCount", "reducibleCount", "winnerCandidateIndex", "winner"],
      "properties": {
        "q": { "enum": [31, 61] }, "degree": { "enum": [3, 5, 6] }, "p": { "$ref": "#/$defs/unsignedDecimal" },
        "testedCount": { "type": "integer", "minimum": 1 }, "irreducibleCount": { "type": "integer", "minimum": 0 }, "reducibleCount": { "type": "integer", "minimum": 0 }, "winnerCandidateIndex": { "type": "integer", "minimum": 0 }, "winner": { "$ref": "#/$defs/winner" }
      }
    },
    "winner": {
      "type": "object", "additionalProperties": false, "required": ["candidateIndex", "support", "secondaryIndex", "tCentered", "tCanonical", "polynomialCanonical", "irreducible", "reductionExponents", "reductionRows", "score"],
      "properties": {
        "candidateIndex": { "type": "integer", "minimum": 0 }, "support": { "enum": [1, 2] }, "secondaryIndex": { "type": ["integer", "null"], "minimum": 1 }, "tCentered": { "type": "array", "items": { "type": "integer" } }, "tCanonical": { "type": "array", "items": { "$ref": "#/$defs/unsignedDecimal" } }, "polynomialCanonical": { "type": "array", "items": { "$ref": "#/$defs/unsignedDecimal" } }, "irreducible": { "const": true }, "reductionExponents": { "type": "array", "items": { "type": "integer", "minimum": 1 } }, "reductionRows": { "type": "array", "items": { "$ref": "#/$defs/reductionRow" } }, "score": { "$ref": "#/$defs/score" }
      }
    },
    "score": {
      "type": "object", "additionalProperties": false, "required": ["nonZeroNonSignedUnitEntryCount", "nonZeroEntryCount", "bitLengthSum", "peakBitLength", "peakRowFanIn", "polynomialMaxAbsCoefficient", "polynomialSupport", "polynomialL1", "signedLexRanks", "lexicographicTuple"],
      "properties": {
        "nonZeroNonSignedUnitEntryCount": { "type": "integer", "minimum": 0 }, "nonZeroEntryCount": { "type": "integer", "minimum": 0 }, "bitLengthSum": { "type": "integer", "minimum": 0 }, "peakBitLength": { "type": "integer", "minimum": 0 }, "peakRowFanIn": { "type": "integer", "minimum": 0 }, "polynomialMaxAbsCoefficient": { "type": "integer", "minimum": 0 }, "polynomialSupport": { "type": "integer", "minimum": 1 }, "polynomialL1": { "type": "integer", "minimum": 1 }, "signedLexRanks": { "type": "array", "items": { "type": "integer", "minimum": 0 } }, "lexicographicTuple": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
      }
    },
    "reductionRow": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/signedDecimal" } },
    "shakedown": { "type": "object", "additionalProperties": false, "required": ["id", "q", "degree", "p", "tCentered", "tCanonical", "polynomialCanonical", "status", "selection", "reason"], "properties": { "id": { "const": "shakedown:m89-d2-x2-plus-1" }, "q": { "const": 89 }, "degree": { "const": 2 }, "p": { "$ref": "#/$defs/unsignedDecimal" }, "tCentered": { "const": [1, 0] }, "tCanonical": { "const": ["1", "0"] }, "polynomialCanonical": { "const": ["1", "0", "1"] }, "status": { "const": "non-selected-outside-search" }, "selection": { "const": "none" }, "reason": { "type": "string" } } },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["bchnSourceCommit", "sourceFile", "sourceFileSha256", "sourceFact", "K16Rationale", "rabinGenerator", "rabinReplay", "legacyFilesModified"], "properties": { "bchnSourceCommit": { "const": "864c53ee34924cca6c6b6d96607ff2cedcdccf02" }, "sourceFile": { "const": "src/script/script.h" }, "sourceFileSha256": { "const": "fdd6f1326c72032b4eeb5cf6605b1153d47798e84f8a39a69a66d83a64fc52ed" }, "sourceFact": { "const": "OP_1=0x51 through OP_16=0x60." }, "K16Rationale": { "const": "K=16 is a design rationale for dedicated small-integer constants only; it is not a measured-cost or lower-bound claim." }, "rabinGenerator": { "const": "p2/field-cert/node/generate.mjs:generateRabinCertificate" }, "rabinReplay": { "const": "p2/field-cert/node/replay.mjs:replayRabinCertificate" }, "legacyFilesModified": { "const": false } } },
    "failClosedPolicy": { "type": "object", "additionalProperties": false, "required": ["eliminationScope", "familyPolicy", "measuredCostClaim", "protocolSelection"], "properties": { "eliminationScope": { "const": "A result can eliminate only the exact construction+codec+algorithm+track evaluated by this artifact." }, "familyPolicy": { "const": "No exact-construction result may eliminate an entire (p,d) family." }, "measuredCostClaim": { "const": "none" }, "protocolSelection": { "const": "none" } } }
  }
}
