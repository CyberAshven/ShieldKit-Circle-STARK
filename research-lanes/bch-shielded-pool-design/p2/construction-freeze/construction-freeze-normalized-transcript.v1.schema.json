{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/construction-freeze/construction-freeze-normalized-transcript.v1.schema.json",
  "title": "Checker-neutral normalized construction decision transcript",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "transcriptId", "rows", "rowCount", "contentDigest"],
  "properties": { "schema": { "const": "shieldkit-labs/p2/construction-freeze-normalized-transcript/v1" }, "transcriptId": { "const": "construction-freeze:normalized-decision-transcript-v1" }, "rows": { "type": "array", "minItems": 11360, "maxItems": 11360, "items": { "$ref": "#/$defs/row" } }, "rowCount": { "const": 11360 }, "contentDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
  "$defs": {
    "unsignedDecimal": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }, "signedDecimal": { "type": "string", "pattern": "^(0|-?[1-9][0-9]*)$" },
    "row": { "type": "object", "additionalProperties": false, "required": ["targetOrderIndex", "candidateIndex", "globalOrderIndex", "support", "secondaryIndex", "q", "degree", "p", "tCentered", "tCanonical", "polynomialCanonical", "irreducible", "reductionExponents", "reductionRows", "score"], "properties": { "targetOrderIndex": { "enum": [0, 1, 2] }, "candidateIndex": { "type": "integer", "minimum": 0 }, "globalOrderIndex": { "type": "integer", "minimum": 0 }, "support": { "enum": [1, 2] }, "secondaryIndex": { "type": ["integer", "null"], "minimum": 1 }, "q": { "enum": [31, 61] }, "degree": { "enum": [3, 5, 6] }, "p": { "$ref": "#/$defs/unsignedDecimal" }, "tCentered": { "type": "array", "items": { "type": "integer" } }, "tCanonical": { "type": "array", "items": { "$ref": "#/$defs/unsignedDecimal" } }, "polynomialCanonical": { "type": "array", "items": { "$ref": "#/$defs/unsignedDecimal" } }, "irreducible": { "type": "boolean" }, "reductionExponents": { "type": "array", "items": { "type": "integer", "minimum": 1 } }, "reductionRows": { "type": "array", "items": { "$ref": "#/$defs/reductionRow" } }, "score": { "$ref": "#/$defs/score" } } },
    "reductionRow": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/signedDecimal" } },
    "score": { "type": "object", "additionalProperties": false, "required": ["nonZeroNonSignedUnitEntryCount", "nonZeroEntryCount", "bitLengthSum", "peakBitLength", "peakRowFanIn", "polynomialMaxAbsCoefficient", "polynomialSupport", "polynomialL1", "signedLexRanks", "lexicographicTuple"], "properties": { "nonZeroNonSignedUnitEntryCount": { "type": "integer", "minimum": 0 }, "nonZeroEntryCount": { "type": "integer", "minimum": 0 }, "bitLengthSum": { "type": "integer", "minimum": 0 }, "peakBitLength": { "type": "integer", "minimum": 0 }, "peakRowFanIn": { "type": "integer", "minimum": 0 }, "polynomialMaxAbsCoefficient": { "type": "integer", "minimum": 0 }, "polynomialSupport": { "type": "integer", "minimum": 1 }, "polynomialL1": { "type": "integer", "minimum": 1 }, "signedLexRanks": { "type": "array", "items": { "type": "integer", "minimum": 0 } }, "lexicographicTuple": { "type": "array", "items": { "type": "integer", "minimum": 0 } } } }
  }
}
