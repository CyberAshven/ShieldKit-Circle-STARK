{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/algebra-component/algebra-component-descriptor.v2.schema.json",
  "title": "Gate-B0 direct algebra component descriptor v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "descriptorId",
    "status",
    "contentDigest",
    "qualification",
    "lineage",
    "descriptorSchemaBinding",
    "constructionFreezeBinding",
    "scheduleFreezeBinding",
    "certificateSetBinding",
    "externalReviewBinding",
    "certificateBinding",
    "directQuotient",
    "canonicalCodec",
    "relationSemantics",
    "symbolicBounds",
    "sourcePins",
    "executionProfileBinding",
    "scheduleArmBindings",
    "protocolBoundary",
    "executionBoundary",
    "legacyLineage"
  ],
  "properties": {
    "schema": { "const": "shieldkit-labs/p2-algebra-component-descriptor/v2" },
    "descriptorId": { "$ref": "#/$defs/id" },
    "status": { "const": "frozen-cohort-formula-bound-nonexecutable" },
    "contentDigest": { "$ref": "#/$defs/contentDigest" },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "artifactClassification", "executionEvidenceClassification", "selection", "tupleRef", "fieldRanking", "proofSystemRanking", "protocolRanking"],
      "properties": {
        "status": { "const": "gate-b0-component-only-unqualified" },
        "artifactClassification": { "const": "descriptor-contract" },
        "executionEvidenceClassification": { "const": "not-execution-evidence" },
        "selection": { "const": "none" },
        "tupleRef": { "type": "null" },
        "fieldRanking": { "const": "none" },
        "proofSystemRanking": { "const": "none" },
        "protocolRanking": { "const": "none" }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldSpecRef", "constructionId", "certificateEntryId", "fieldSpecRefRole", "candidateMatrixBinding"],
      "properties": {
        "fieldSpecRef": { "$ref": "#/$defs/id" },
        "constructionId": { "$ref": "#/$defs/id" },
        "certificateEntryId": { "$ref": "#/$defs/id" },
        "fieldSpecRefRole": { "const": "lineage-label-only-not-an-authoritative-candidate-matrix-binding" },
        "candidateMatrixBinding": { "type": "null" }
      }
    },
    "descriptorSchemaBinding": { "$ref": "#/$defs/schemaBinding" },
    "constructionFreezeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "normalizedTranscript", "bindingRole", "targetBinding"],
      "properties": {
        "summary": { "$ref": "#/$defs/jsonArtifactBinding" },
        "normalizedTranscript": { "$ref": "#/$defs/jsonArtifactBinding" },
        "bindingRole": { "enum": ["frozen-direct-construction-target", "cohort-context-only-m89-legacy-shakedown-not-a-selection"] },
        "targetBinding": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["q", "degree", "p", "polynomialCanonical"],
              "properties": {
                "q": { "$ref": "#/$defs/safePositiveInteger" },
                "degree": { "$ref": "#/$defs/safePositiveInteger" },
                "p": { "$ref": "#/$defs/unsignedDecimal" },
                "polynomialCanonical": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/unsignedDecimal" } }
              }
            }
          ]
        }
      }
    },
    "scheduleFreezeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "orderingOwner", "resolvedPermutation"],
      "properties": {
        "artifact": { "$ref": "#/$defs/jsonArtifactBinding" },
        "orderingOwner": { "const": "schedule-freeze-ordering-rule-only" },
        "resolvedPermutation": { "type": "null" }
      }
    },
    "certificateSetBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "repositoryReplay", "repositoryReplaySource"],
      "properties": {
        "artifact": { "$ref": "#/$defs/jsonArtifactBinding" },
        "repositoryReplay": { "$ref": "#/$defs/fileBinding" },
        "repositoryReplaySource": { "$ref": "#/$defs/fileBinding" }
      }
    },
    "externalReviewBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "certificateSetFileSha256", "certificateSetContentDigest", "allPass", "checkerMethods", "sourceBindings"],
      "properties": {
        "artifact": { "$ref": "#/$defs/jsonArtifactBinding" },
        "certificateSetFileSha256": { "$ref": "#/$defs/sha256" },
        "certificateSetContentDigest": { "$ref": "#/$defs/sha256" },
        "allPass": { "const": true },
        "checkerMethods": {
          "type": "array",
          "prefixItems": [
            { "const": "python-stdlib-certificate-replay" },
            { "const": "sympy-cas-irreducibility" }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "sourceBindings": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/fileBinding" } }
      }
    },
    "certificateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certificateId", "certificateDigest", "normalizedStatementDigest", "checkerFamilies"],
      "properties": {
        "certificateId": { "$ref": "#/$defs/id" },
        "certificateDigest": { "$ref": "#/$defs/sha256" },
        "normalizedStatementDigest": { "$ref": "#/$defs/sha256" },
        "checkerFamilies": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/checkerFamily" }
        }
      }
    },
    "directQuotient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "basis", "p", "q", "degree", "generatorSymbol", "definingPolynomialAscending", "monic", "quotientRelation", "towerPolicy"],
      "properties": {
        "kind": { "const": "direct-polynomial" },
        "basis": { "const": "direct-power-basis" },
        "p": { "$ref": "#/$defs/unsignedDecimal" },
        "q": { "$ref": "#/$defs/safePositiveInteger" },
        "degree": { "$ref": "#/$defs/safePositiveInteger" },
        "generatorSymbol": { "const": "x" },
        "definingPolynomialAscending": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/unsignedDecimal" } },
        "monic": { "const": true },
        "quotientRelation": { "type": "string", "minLength": 1 },
        "towerPolicy": { "const": "tower-schedules-internal-only-never-algebra-or-codec" }
      }
    },
    "canonicalCodec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codecId", "basis", "baseLimbEncoding", "coefficientOrder", "elementSplit", "baseLimbBytes", "elementBytes", "modulusBitLength", "unusedHighBits", "unusedHighBitMaskHex", "parserSteps", "signGuardConstruction", "coefficientRange", "numericEncode", "fullConsumption", "hostNormalization", "aliasPolicy", "zeroHex", "oneHex"],
      "properties": {
        "codecId": { "$ref": "#/$defs/id" },
        "basis": { "const": "direct-power-basis" },
        "baseLimbEncoding": { "const": "fixed-width-unsigned-little-endian" },
        "coefficientOrder": { "const": "c0-to-cd-minus-1" },
        "elementSplit": { "const": "exact-degree-contiguous-equal-width-limbs" },
        "baseLimbBytes": { "$ref": "#/$defs/safePositiveInteger" },
        "elementBytes": { "$ref": "#/$defs/safePositiveInteger" },
        "modulusBitLength": { "$ref": "#/$defs/safePositiveInteger" },
        "unusedHighBits": { "type": "integer", "minimum": 0, "maximum": 7 },
        "unusedHighBitMaskHex": { "type": "string", "pattern": "^[0-9a-f]{2}$" },
        "parserSteps": {
          "type": "array",
          "prefixItems": [
            { "const": "require-exact-extension-byte-length" },
            { "const": "split-c0-to-cd-minus-1-fixed-width-limbs" },
            { "const": "reject-unused-high-bits-before-one-byte-sign-guard-construction" },
            { "const": "construct-one-byte-00-by-op-1-op-1-op-xor-then-raw-cat-and-bin2num-per-limb" },
            { "const": "reject-unless-0<=coefficient<p" },
            { "const": "require-full-consumption" }
          ],
          "minItems": 6,
          "maxItems": 6
        },
        "signGuardConstruction": { "const": "exact-one-byte-00-produced-by-OP_1-OP_1-OP_XOR-not-empty-OP_0" },
        "coefficientRange": { "const": "reject-unless-0<=coefficient<p" },
        "numericEncode": { "const": "canonical-mod-p-then-op-num2bin-fixed-width-per-limb-concatenate-c0-to-cd-minus-1" },
        "fullConsumption": { "const": true },
        "hostNormalization": { "const": "prohibited-before-parser-and-arithmetic" },
        "aliasPolicy": { "const": "no-noncanonical-or-alternate-encoding-aliases" },
        "zeroHex": { "$ref": "#/$defs/hex" },
        "oneHex": { "$ref": "#/$defs/hex" }
      }
    },
    "relationSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations", "gateB", "parserBoundary"],
      "properties": {
        "operations": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "$ref": "#/$defs/relation" } },
        "gateB": {
          "type": "object",
          "additionalProperties": false,
          "required": ["eMac", "eSquareMac", "eInverseCheck"],
          "properties": {
            "eMac": { "const": "relation:e-mac=eq(D,add(mul(A,B),C));selected-arm-mul-once" },
            "eSquareMac": { "const": "relation:e-square-mac=eq(D,add(square(A),C));selected-arm-square-once" },
            "eInverseCheck": { "const": "relation:e-inverse-check=and(ne(A,zero),eq(mul(A,H),one));verify-supplied-hint-only-never-compute-inverse" }
          }
        },
        "parserBoundary": { "const": "all-malformed-inputs-reject-at-parser-before-selected-arm" }
      }
    },
    "symbolicBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "integerLift", "perArmCounts", "sourceLoweredMetrics", "opcodeMetrics", "byteMetrics", "stackMetrics", "vmMetrics"],
      "properties": {
        "classification": { "const": "formula-level-only-not-a-source-or-vm-measurement" },
        "integerLift": { "const": "symbolic-nonnegative-coefficient-lift-with-signed-formula-constants" },
        "perArmCounts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/armCounts" } },
        "sourceLoweredMetrics": { "const": null },
        "opcodeMetrics": { "const": null },
        "byteMetrics": { "const": null },
        "stackMetrics": { "const": null },
        "vmMetrics": { "const": null }
      }
    },
    "sourcePins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["referenceDirectExtension", "referenceDirectExtensionTest", "relationContract", "relationSchema"],
      "properties": {
        "referenceDirectExtension": { "$ref": "#/$defs/fileBinding" },
        "referenceDirectExtensionTest": { "$ref": "#/$defs/fileBinding" },
        "relationContract": { "$ref": "#/$defs/fileBinding" },
        "relationSchema": { "$ref": "#/$defs/fileBinding" }
      }
    },
    "executionProfileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profilePath", "profileFileSha256", "bchnCommit", "usage"],
      "properties": {
        "profilePath": { "const": "profiles/bch-current-2026-08-08.json" },
        "profileFileSha256": { "$ref": "#/$defs/sha256" },
        "bchnCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "usage": { "const": "source-pinned-execution-policy-only-no-lowering-or-vm-metric-claim" }
      }
    },
    "scheduleArmBindings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/armBinding" } },
    "protocolBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "protocolRoles", "circleDomain", "circleQuery", "deepStrategy", "embeddings", "challengeSamplers", "soundnessEventDag", "hashBindings", "airRole", "transcriptRole", "proofSystemRole"],
      "properties": {
        "capability": { "const": "gate-b0-field-arithmetic-only" },
        "protocolRoles": { "type": "array", "maxItems": 0, "items": false },
        "circleDomain": { "type": "null" },
        "circleQuery": { "type": "null" },
        "deepStrategy": { "type": "null" },
        "embeddings": { "type": "array", "maxItems": 0, "items": false },
        "challengeSamplers": { "type": "array", "maxItems": 0, "items": false },
        "soundnessEventDag": { "type": "null" },
        "hashBindings": { "type": "array", "maxItems": 0, "items": false },
        "airRole": { "type": "null" },
        "transcriptRole": { "type": "null" },
        "proofSystemRole": { "type": "null" }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executionState", "executionAllowed", "requiredDownstreamArtifacts", "presentDownstreamBindings", "prohibitedEvidence"],
      "properties": {
        "executionState": { "const": "closed" },
        "executionAllowed": { "const": false },
        "requiredDownstreamArtifacts": {
          "type": "array",
          "prefixItems": [
            { "const": "campaign-v2-content-binding" },
            { "const": "canonical-corpus-v2-content-binding" },
            { "const": "per-arm-lowering-source-contract-content-bindings" },
            { "const": "execution-epoch-binding" }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "presentDownstreamBindings": { "type": "array", "maxItems": 0, "items": false },
        "prohibitedEvidence": { "const": "no-execution-run-corpus-or-ranking-evidence-is-bound-by-this-descriptor" }
      }
    },
    "legacyLineage": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["descriptorPath", "descriptorFileSha256", "descriptorContentDigest", "classification", "cohortEvidenceEligible", "prohibitedArtifactUses"],
          "properties": {
            "descriptorPath": { "type": "string", "pattern": "^p2/algebra-component/descriptors/m89-d2-x2-plus-1\\.v1\\.json$" },
            "descriptorFileSha256": { "$ref": "#/$defs/sha256" },
            "descriptorContentDigest": { "$ref": "#/$defs/sha256" },
            "classification": { "const": "legacy-m89-shakedown-only" },
            "cohortEvidenceEligible": { "const": false },
            "prohibitedArtifactUses": { "const": "v1-corpus-and-v1-run-cannot-be-v2-cohort-evidence" }
          }
        }
      ]
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*){1,8}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "unsignedDecimal": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "hex": { "type": "string", "pattern": "^(?:[0-9a-f]{2})*$" },
    "safePositiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "contentDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": { "algorithm": { "const": "sha256-jcs-omit-contentDigest" }, "value": { "$ref": "#/$defs/sha256" } }
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": { "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" }, "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "schemaBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaId", "path", "fileSha256"],
      "properties": { "schemaId": { "const": "shieldkit-labs/p2-algebra-component-descriptor/v2" }, "path": { "const": "p2/algebra-component/algebra-component-descriptor.v2.schema.json" }, "fileSha256": { "$ref": "#/$defs/sha256" } }
    },
    "jsonArtifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "path", "fileSha256", "contentDigest", "schemaId", "schemaPath", "schemaFileSha256"],
      "properties": {
        "artifactId": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$" },
        "fileSha256": { "$ref": "#/$defs/sha256" },
        "contentDigest": { "$ref": "#/$defs/sha256" },
        "schemaId": { "type": "string", "minLength": 1 },
        "schemaPath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$" },
        "schemaFileSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "checkerFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "statementDigest", "artifactBinding"],
      "properties": {
        "family": { "enum": ["repository-rabin-replay", "external-python-sympy-review"] },
        "statementDigest": { "$ref": "#/$defs/sha256" },
        "artifactBinding": { "$ref": "#/$defs/fileBinding" }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "semantics"],
      "properties": { "operation": { "enum": ["add", "subtract", "negate", "multiply", "square", "equality", "inverse-hint"] }, "semantics": { "type": "string", "minLength": 1 } }
    },
    "armCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["armId", "multiplyVariableBaseFieldOps", "squareVariableBaseFieldOps", "countClassification"],
      "properties": {
        "armId": { "$ref": "#/$defs/id" },
        "multiplyVariableBaseFieldOps": { "$ref": "#/$defs/safePositiveInteger" },
        "squareVariableBaseFieldOps": { "$ref": "#/$defs/safePositiveInteger" },
        "countClassification": { "const": "declared-variable-base-field-operation-count-not-vm-or-rank-metric" }
      }
    },
    "armBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["armId", "trackId", "algorithmId", "constructionId", "codecId", "armDigest"],
      "properties": {
        "armId": { "$ref": "#/$defs/id" },
        "trackId": { "enum": ["track:canonical-schoolbook", "track:optimized"] },
        "algorithmId": { "$ref": "#/$defs/id" },
        "constructionId": { "$ref": "#/$defs/id" },
        "codecId": { "$ref": "#/$defs/id" },
        "armDigest": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
