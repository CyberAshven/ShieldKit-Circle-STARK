{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/algebra-component/algebra-component-descriptor.v1.schema.json",
  "title": "Gate-B0 algebra component descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "descriptorId",
    "status",
    "contentDigest",
    "qualification",
    "registryBinding",
    "protocolBoundary",
    "algebra",
    "canonicalCodec",
    "relations",
    "intermediateBounds",
    "certificateBundle",
    "sourcePins",
    "executionProfileBinding",
    "gateBContractBinding",
    "arithmeticCampaignBinding",
    "executionPolicy"
  ],
  "properties": {
    "schema": { "const": "shieldkit-labs/p2-algebra-component-descriptor/v1" },
    "descriptorId": { "$ref": "#/$defs/id" },
    "status": { "enum": ["draft", "frozen-gate-b0-arithmetic-admitted"] },
    "contentDigest": { "$ref": "#/$defs/contentDigest" },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidenceClassification", "selection", "tupleRef"],
      "properties": {
        "status": { "const": "gate-b0-arithmetic-only-unqualified" },
        "evidenceClassification": { "const": "not-evidence" },
        "selection": { "const": "none" },
        "tupleRef": { "type": "null" }
      }
    },
    "registryBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrixPath", "matrixDigest", "fieldSpecRef", "constructionId", "q", "p", "extensionDegree", "baseLimbBytes", "rawElementBytes"],
      "properties": {
        "matrixPath": { "const": "research/circle-fri-candidate-matrix.v2.json" },
        "matrixDigest": { "$ref": "#/$defs/sha256" },
        "fieldSpecRef": { "$ref": "#/$defs/id" },
        "constructionId": { "$ref": "#/$defs/id" },
        "q": { "type": "integer", "minimum": 2 },
        "p": { "$ref": "#/$defs/unsignedDecimal" },
        "extensionDegree": { "type": "integer", "minimum": 1 },
        "baseLimbBytes": { "type": "integer", "minimum": 1 },
        "rawElementBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "protocolBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "protocolRoles", "circleDomain", "deepStrategy", "embeddings", "challengeSamplers", "soundnessEventDag", "hashBindings", "prohibitedUntil"],
      "properties": {
        "capability": { "const": "gate-b0-field-arithmetic-only" },
        "protocolRoles": { "type": "array", "maxItems": 0, "items": false },
        "circleDomain": { "type": "null" },
        "deepStrategy": { "type": "null" },
        "embeddings": { "type": "array", "maxItems": 0, "items": false },
        "challengeSamplers": { "type": "array", "maxItems": 0, "items": false },
        "soundnessEventDag": { "type": "null" },
        "hashBindings": { "type": "array", "maxItems": 0, "items": false },
        "prohibitedUntil": { "const": "gate-b1-complete-protocol-descriptor" }
      }
    },
    "algebra": { "oneOf": [{ "$ref": "#/$defs/directPolynomial" }, { "$ref": "#/$defs/tower" }] },
    "canonicalCodec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseLimbEncoding",
        "coefficientOrder",
        "elementSplit",
        "baseLimbByteLength",
        "modulusBitLength",
        "unusedHighBits",
        "unusedHighBitMaskHex",
        "highBitPolicy",
        "coefficientRange",
        "numericDecode",
        "numericEncode",
        "extensionByteLength",
        "zeroHex",
        "oneHex",
        "fullConsumption",
        "typeTagPolicy",
        "hostNormalization"
      ],
      "properties": {
        "baseLimbEncoding": { "const": "fixed-width-unsigned-little-endian" },
        "coefficientOrder": { "const": "c0-to-cd-minus-1" },
        "elementSplit": { "const": "exact-degree-contiguous-equal-width-limbs" },
        "baseLimbByteLength": { "type": "integer", "minimum": 1 },
        "modulusBitLength": { "type": "integer", "minimum": 2 },
        "unusedHighBits": { "type": "integer", "minimum": 0, "maximum": 7 },
        "unusedHighBitMaskHex": { "type": "string", "pattern": "^[0-9a-f]{2}$" },
        "highBitPolicy": { "const": "reject-any-set-unused-high-bit-before-numeric-decode" },
        "coefficientRange": { "const": "reject-unless-0<=coefficient<p" },
        "numericDecode": { "const": "append-one-byte-00-sign-guard-then-op-bin2num-per-limb" },
        "numericEncode": { "const": "canonical-mod-p-then-op-num2bin-fixed-width-per-limb" },
        "extensionByteLength": { "type": "integer", "minimum": 1 },
        "zeroHex": { "$ref": "#/$defs/hex" },
        "oneHex": { "$ref": "#/$defs/hex" },
        "fullConsumption": { "const": true },
        "typeTagPolicy": { "const": "descriptor-context-bound-no-inline-element-tag" },
        "hostNormalization": { "const": "prohibited-before-vm" }
      }
    },
    "relations": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relation" }
    },
    "intermediateBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integerLift", "reductionSchedule", "executionProfileRef", "maxEncodedElementBytes", "maxArithmeticIntermediateBytes", "operations"],
      "properties": {
        "integerLift": { "const": "nonnegative-coefficient-integer-lift-with-signed-differences" },
        "reductionSchedule": { "const": "declared-stage-by-stage" },
        "executionProfileRef": { "const": "profile:bch-current-2026-08-08" },
        "maxEncodedElementBytes": { "type": "integer", "minimum": 1 },
        "maxArithmeticIntermediateBytes": { "type": "integer", "minimum": 1 },
        "operations": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/boundedOperation" }
        }
      }
    },
    "certificateBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basePrime", "extension", "checkerIndependence"],
      "properties": {
        "basePrime": { "$ref": "#/$defs/certificate" },
        "extension": { "$ref": "#/$defs/certificate" },
        "checkerIndependence": { "const": "repository-and-independent-external-cas" }
      }
    },
    "sourcePins": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/sourcePin" },
      "uniqueItems": true
    },
    "executionProfileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileRef", "path", "sha256", "sourceCommit", "maxStackElementBytes", "maxStackItems", "maxScriptBytes", "maxStandardTransactionBytes"],
      "properties": {
        "profileRef": { "const": "profile:bch-current-2026-08-08" },
        "path": { "const": "profiles/bch-current-2026-08-08.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "maxStackElementBytes": { "const": 10000 },
        "maxStackItems": { "const": 1000 },
        "maxScriptBytes": { "const": 10000 },
        "maxStandardTransactionBytes": { "const": 100000 }
      }
    },
    "gateBContractBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractPath", "contractDigest", "schemaPath", "schemaDigest", "suiteId", "seedHex"],
      "properties": {
        "contractPath": { "const": "p2/gate-b/equal-relation-experiment.v1.json" },
        "contractDigest": { "$ref": "#/$defs/sha256" },
        "schemaPath": { "const": "p2/gate-b/equal-relation-experiment.schema.json" },
        "schemaDigest": { "$ref": "#/$defs/sha256" },
        "suiteId": { "const": "suite:gate-b-equal-relations-v1" },
        "seedHex": { "const": "0123456789abcdef" }
      }
    },
    "arithmeticCampaignBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaignId", "campaignPath", "fileDigest", "contentDigest"],
      "properties": {
        "campaignId": { "const": "campaign:gate-b-arithmetic-v1" },
        "campaignPath": { "const": "p2/gate-b/equal-relation-arithmetic-campaign.v1.json" },
        "fileDigest": { "$ref": "#/$defs/sha256" },
        "contentDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "executionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enginePolicySource", "toolchainRecording", "admissionScope"],
      "properties": {
        "enginePolicySource": { "const": "content-pinned-gate-b-v1-contract-and-arithmetic-campaign" },
        "toolchainRecording": { "const": "per-run-source-commit-lockfile-build-command-and-raw-artifact-digests-required" },
        "admissionScope": { "const": "non-ranking-m89-harness-shakedown-then-full-precommitted-cohort" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*){1,8}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "hex": { "type": "string", "pattern": "^(?:[0-9a-f]{2})*$" },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
    "unsignedDecimal": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "contentDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256-jcs-omit-contentDigest" },
        "value": { "$ref": "#/$defs/sha256" }
      }
    },
    "directPolynomial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "semanticProfile", "basis", "generatorSymbol", "definingPolynomial", "quotientRelation"],
      "properties": {
        "kind": { "const": "direct-polynomial" },
        "semanticProfile": { "$ref": "#/$defs/id" },
        "basis": { "const": "power-basis-c0-to-cd-minus-1" },
        "generatorSymbol": { "type": "string", "pattern": "^[a-z]$" },
        "definingPolynomial": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/unsignedDecimal" } },
        "quotientRelation": { "const": "x^d=-sum(i=0..d-1,fi*x^i)-mod-p" }
      }
    },
    "tower": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "semanticProfile", "steps", "flattenedBasis", "flattenedMultiplicationRelation"],
      "properties": {
        "kind": { "const": "tower" },
        "semanticProfile": { "$ref": "#/$defs/id" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/towerStep" } },
        "flattenedBasis": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "flattenedMultiplicationRelation": { "const": "stepwise-reduce-then-flatten-in-declared-basis" }
      }
    },
    "towerStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stepId", "degree", "definingPolynomial", "irreducibilityCertificateDigest"],
      "properties": {
        "stepId": { "$ref": "#/$defs/id" },
        "degree": { "type": "integer", "minimum": 2 },
        "definingPolynomial": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/unsignedDecimal" } },
        "irreducibilityCertificateDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "formulaId", "equations"],
      "properties": {
        "operation": { "enum": ["add", "subtract", "negate", "multiply", "square", "equality", "inverse-hint"] },
        "formulaId": { "$ref": "#/$defs/id" },
        "equations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "boundedOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "stages"],
      "properties": {
        "operation": { "enum": ["add", "subtract", "negate", "multiply", "square", "equality", "inverse-hint"] },
        "stages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/boundStage" } }
      }
    },
    "boundStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stageId", "maxAbs", "formula", "maxSignedMagnitudeBytes", "stackElementLimitBytes", "headroomBytes"],
      "properties": {
        "stageId": { "$ref": "#/$defs/id" },
        "maxAbs": { "$ref": "#/$defs/unsignedDecimal" },
        "formula": { "$ref": "#/$defs/boundFormula" },
        "maxSignedMagnitudeBytes": { "type": "integer", "minimum": 0 },
        "stackElementLimitBytes": { "const": 10000 },
        "headroomBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "boundFormula": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["op"], "properties": { "op": { "const": "p-minus-1" } } },
        { "type": "object", "additionalProperties": false, "required": ["op"], "properties": { "op": { "const": "degree" } } },
        { "type": "object", "additionalProperties": false, "required": ["op", "value"], "properties": { "op": { "const": "constant" }, "value": { "$ref": "#/$defs/unsignedDecimal" } } },
        { "type": "object", "additionalProperties": false, "required": ["op", "args"], "properties": { "op": { "enum": ["add", "multiply"] }, "args": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/boundFormula" } } } }
      ]
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certificateKind", "certificateFixtureId", "certificateArtifactPath", "certificateArtifactDigest", "checkers"],
      "properties": {
        "certificateKind": { "enum": ["mersenne-primality", "direct-rabin-irreducibility", "tower-step-irreducibility"] },
        "certificateFixtureId": { "$ref": "#/$defs/id" },
        "certificateArtifactPath": { "$ref": "#/$defs/path" },
        "certificateArtifactDigest": { "$ref": "#/$defs/sha256" },
        "checkers": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/checker" } }
      }
    },
    "checker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkerRole",
        "checkerIdentity",
        "checkerVersion",
        "sourceManifestPath",
        "sourceManifestDigest",
        "commandPath",
        "commandDigest",
        "outputPath",
        "outputDigest",
        "canonicalCertificateDigest",
        "verdict"
      ],
      "properties": {
        "checkerRole": { "enum": ["repository-checker", "independent-external-cas"] },
        "checkerIdentity": { "type": "string", "minLength": 1 },
        "checkerVersion": { "type": "string", "minLength": 1 },
        "sourceManifestPath": { "$ref": "#/$defs/path" },
        "sourceManifestDigest": { "$ref": "#/$defs/sha256" },
        "commandPath": { "$ref": "#/$defs/path" },
        "commandDigest": { "$ref": "#/$defs/sha256" },
        "outputPath": { "$ref": "#/$defs/path" },
        "outputDigest": { "$ref": "#/$defs/sha256" },
        "canonicalCertificateDigest": { "$ref": "#/$defs/sha256" },
        "verdict": { "const": "pass" }
      }
    },
    "sourcePin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "path", "sha256", "kind"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "kind": { "enum": ["research-contract", "candidate-registry", "execution-profile", "certificate-fixture", "checker-manifest", "checker-command", "checker-output", "external-checker-report"] }
      }
    }
  }
}
