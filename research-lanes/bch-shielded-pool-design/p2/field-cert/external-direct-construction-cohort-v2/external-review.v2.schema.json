{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/field-cert/external-direct-construction-cohort-v2/external-review.v2.schema.json",
  "title": "Independent direct-construction cohort review v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "reviewId", "status", "evidenceClassification", "selection", "tupleRef", "boundary", "tool", "inputBindings", "repositoryReport", "sourceBindings", "entries", "finalVerdict", "contentDigest"],
  "properties": {
    "schema": {"const": "shieldkit-labs/p2/field-cert/external-direct-construction-cohort-v2/external-review/v2"},
    "reviewId": {"const": "external-direct-construction-cohort-v2"},
    "status": {"enum": ["all-independent-replays-passed", "review-failed"]},
    "evidenceClassification": {"const": "certificate-evidence-only"},
    "selection": {"const": "none"},
    "tupleRef": {"type": "null"},
    "boundary": {"type": "object", "additionalProperties": false, "required": ["permittedConclusion", "prohibitedConclusion"], "properties": {"permittedConclusion": {"const": "certificate-evidence-for-exact-prime-and-direct-polynomial-irreducibility-only"}, "prohibitedConclusion": {"const": "no-BCH-cost-field-family-proof-system-protocol-Circle-domain-systemic-soundness-tuple-or-selection-conclusion"}}},
    "tool": {"type": "object", "additionalProperties": false, "required": ["python", "platform", "sympy", "checkerFamilies"], "properties": {"python": {"type": "string", "minLength": 1}, "platform": {"type": "string", "minLength": 1}, "sympy": {"const": "1.14.0"}, "checkerFamilies": {"const": ["python-stdlib-certificate-replay", "sympy-cas-irreducibility"]}}},
    "inputBindings": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "byteCount", "contentDigest"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "byteCount": {"type": "integer", "minimum": 1}, "contentDigest": {"type": ["string", "null"]}}}},
    "repositoryReport": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "byteCount"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "byteCount": {"type": "integer", "minimum": 1}}},
    "sourceBindings": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "byteCount"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "byteCount": {"type": "integer", "minimum": 1}}}},
    "entries": {"type": "array", "prefixItems": [{"$ref": "#/$defs/entry"}, {"$ref": "#/$defs/entry"}, {"$ref": "#/$defs/entry"}, {"$ref": "#/$defs/entry"}], "minItems": 4, "maxItems": 4},
    "finalVerdict": {"enum": ["PASS", "FAIL"]},
    "contentDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "entry": {"type": "object", "additionalProperties": false, "required": ["scheduleIndex", "certificateEntryId", "constructionId", "fieldSpecRef", "q", "p", "degree", "polynomialCanonical", "repositoryCertificateDigest", "recomputedCertificateDigest", "statement", "statementDigest", "prime", "rabin", "sympy", "checkerVerdicts", "verdict"], "properties": {"scheduleIndex": {"type": "integer", "minimum": 0, "maximum": 3}, "certificateEntryId": {"type": "string"}, "constructionId": {"type": "string"}, "fieldSpecRef": {"type": "string"}, "q": {"type": "integer", "minimum": 2}, "p": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"}, "degree": {"type": "integer", "minimum": 1}, "polynomialCanonical": {"type": "array", "minItems": 2, "items": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"}}, "repositoryCertificateDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "recomputedCertificateDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "statement": {"type": "object"}, "statementDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "prime": {"type": "object"}, "rabin": {"type": "object"}, "sympy": {"type": "object"}, "checkerVerdicts": {"const": {"python-stdlib-certificate-replay": "PASS", "sympy-cas-irreducibility": "PASS"}}, "verdict": {"const": "PASS"}}}
  }
}
