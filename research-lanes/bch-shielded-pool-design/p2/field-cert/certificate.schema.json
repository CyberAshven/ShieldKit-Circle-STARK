{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/research-lanes/bch-shielded-pool-design/p2/field-cert/certificate.schema.json",
  "title": "Generic Fp Mersenne and Rabin certificate fixtures",
  "oneOf": [
    { "$ref": "#/$defs/primeFixture" },
    { "$ref": "#/$defs/rabinFixture" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*){1,8}$"
    },
    "unsignedDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "coefficients": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/unsignedDecimal" }
    },
    "primeCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mersenneExponent", "exponentPrime", "exponentPrimalityMethod", "modulus", "lucasLehmer", "classification"],
      "properties": {
        "mersenneExponent": { "$ref": "#/$defs/unsignedDecimal" },
        "exponentPrime": { "const": true },
        "exponentPrimalityMethod": { "const": "deterministic-trial-division" },
        "modulus": { "$ref": "#/$defs/unsignedDecimal" },
        "lucasLehmer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["iterations", "residue", "passed"],
          "properties": {
            "iterations": { "$ref": "#/$defs/unsignedDecimal" },
            "residue": { "$ref": "#/$defs/unsignedDecimal" },
            "passed": { "type": "boolean" }
          }
        },
        "classification": { "enum": ["prime", "rejected-composite"] }
      }
    },
    "rabinCertificate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certificateId", "mersennePrimeCheck", "modulus", "coefficientEncoding", "polynomial", "degree", "hPowers", "primeDivisors", "witnesses", "finalResidue", "conclusion"],
      "properties": {
        "certificateId": { "$ref": "#/$defs/id" },
        "mersennePrimeCheck": { "$ref": "#/$defs/primeCheck" },
        "modulus": { "$ref": "#/$defs/unsignedDecimal" },
        "coefficientEncoding": { "const": "unsigned-decimal-c0-to-cd" },
        "polynomial": { "$ref": "#/$defs/coefficients" },
        "degree": { "$ref": "#/$defs/unsignedDecimal" },
        "hPowers": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "coefficients"],
            "properties": {
              "index": { "$ref": "#/$defs/unsignedDecimal" },
              "coefficients": { "$ref": "#/$defs/coefficients" }
            }
          }
        },
        "primeDivisors": {
          "type": "array",
          "items": { "$ref": "#/$defs/unsignedDecimal" },
          "uniqueItems": true
        },
        "witnesses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["primeDivisor", "hIndex", "g", "gcd", "bezoutU", "bezoutV"],
            "properties": {
              "primeDivisor": { "$ref": "#/$defs/unsignedDecimal" },
              "hIndex": { "$ref": "#/$defs/unsignedDecimal" },
              "g": { "$ref": "#/$defs/coefficients" },
              "gcd": { "$ref": "#/$defs/coefficients" },
              "bezoutU": { "$ref": "#/$defs/coefficients" },
              "bezoutV": { "$ref": "#/$defs/coefficients" }
            }
          }
        },
        "finalResidue": { "$ref": "#/$defs/coefficients" },
        "conclusion": { "const": "irreducible" }
      }
    },
    "commonFixture": {
      "type": "object",
      "required": ["schema", "fixtureId", "kind", "status", "casReview", "evidenceClassification", "selection", "notes"],
      "properties": {
        "schema": { "const": "shieldkit-labs/field-cert/v1" },
        "fixtureId": { "$ref": "#/$defs/id" },
        "kind": { "type": "string" },
        "status": { "const": "generic-math-unqualified" },
        "casReview": { "const": "not-cas-reviewed" },
        "evidenceClassification": { "const": "not-evidence" },
        "selection": { "const": "none" },
        "notes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "primeFixture": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/commonFixture" },
        {
          "type": "object",
          "required": ["checks"],
          "properties": {
            "fixtureId": { "const": "fixture:frontier-mersenne-prime-checks-v1" },
            "kind": { "const": "mersenne-prime-check-fixture" },
            "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/primeCheck" } }
          }
        }
      ]
    },
    "rabinFixture": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/commonFixture" },
        {
          "type": "object",
          "required": ["certificate"],
          "properties": {
            "fixtureId": { "const": "fixture:m89-x2-plus-1-rabin-v1" },
            "kind": { "const": "rabin-irreducibility-fixture" },
            "certificate": { "$ref": "#/$defs/rabinCertificate" }
          }
        }
      ]
    }
  }
}
