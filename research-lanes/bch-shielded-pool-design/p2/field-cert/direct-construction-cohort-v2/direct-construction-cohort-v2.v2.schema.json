{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/field-cert/direct-construction-cohort-v2/direct-construction-cohort-v2.v2.schema.json",
  "title": "Generic math direct-construction Rabin certificate set v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "artifactId", "status", "evidenceClassification", "selection", "tupleRef", "protocolBoundary", "boundary", "inputBindings", "scheduleOrder", "importedSourceBindings", "repositoryEnvironment", "toolBinding", "replayReportBinding", "certificates", "contentDigest"],
  "properties": {
    "schema": { "const": "shieldkit-labs/p2/direct-construction-cohort-v2/v2" },
    "artifactId": { "const": "direct-construction-cohort-v2" },
    "status": { "const": "generic-math-certificate-set-frozen" },
    "evidenceClassification": { "const": "not-evidence" },
    "selection": { "const": "none" },
    "tupleRef": { "type": "null" },
    "protocolBoundary": { "const": "component-only" },
    "boundary": { "type": "object", "additionalProperties": false, "required": ["permittedConclusion", "prohibitedConclusion"], "properties": { "permittedConclusion": { "const": "base-prime-and-direct-polynomial-irreducibility-only-if-replay-passes" }, "prohibitedConclusion": { "const": "no-BCH-cost-field-family-proof-system-protocol-Circle-domain-or-systemic-soundness-conclusion" } } },
    "inputBindings": { "type": "array", "prefixItems": [{ "$ref": "#/$defs/input" }, { "$ref": "#/$defs/input" }, { "$ref": "#/$defs/input" }], "minItems": 3, "maxItems": 3 },
    "scheduleOrder": { "type": "array", "prefixItems": [{ "$ref": "#/$defs/schedule" }, { "$ref": "#/$defs/schedule" }, { "$ref": "#/$defs/schedule" }, { "$ref": "#/$defs/schedule" }], "minItems": 4, "maxItems": 4 },
    "importedSourceBindings": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/source" } },
    "repositoryEnvironment": { "type": "object", "additionalProperties": false, "required": ["nodeVersion", "platform", "arch", "policy"], "properties": { "nodeVersion": { "const": "v22.23.1" }, "platform": { "const": "linux" }, "arch": { "const": "x64" }, "policy": { "const": "certificate bytes are frozen for this recorded environment; a runtime mismatch is diagnostic and fail-closed for promotion, never silently incorporated into canonical bytes" } } },
    "toolBinding": { "type": "object", "additionalProperties": false, "required": ["generatorCommand", "replayCommand"], "properties": { "generatorCommand": { "const": "node generate.mjs" }, "replayCommand": { "const": "node repository-replay.mjs direct-construction-cohort-v2.v2.json" } } },
    "replayReportBinding": { "type": "object", "additionalProperties": false, "required": ["path", "byteCount", "sha256"], "properties": { "path": { "const": "repository-replay-report.v2.txt" }, "byteCount": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "certificates": { "type": "array", "prefixItems": [{ "$ref": "#/$defs/certificateEntry" }, { "$ref": "#/$defs/certificateEntry" }, { "$ref": "#/$defs/certificateEntry" }, { "$ref": "#/$defs/certificateEntry" }], "minItems": 4, "maxItems": 4 },
    "contentDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "unsignedDecimal": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*){1,8}$" },
    "input": { "type": "object", "additionalProperties": false, "required": ["path", "schema", "schemaPath", "schemaSha256", "fileSha256", "contentDigest", "byteCount", "schemaByteCount"], "properties": { "path": { "type": "string", "pattern": "^research-lanes/[^\\n]+$" }, "schema": { "type": "string", "minLength": 1 }, "schemaPath": { "type": "string", "pattern": "^research-lanes/[^\\n]+$" }, "schemaSha256": { "$ref": "#/$defs/sha256" }, "fileSha256": { "$ref": "#/$defs/sha256" }, "contentDigest": { "$ref": "#/$defs/sha256" }, "byteCount": { "type": "integer", "minimum": 1 }, "schemaByteCount": { "type": "integer", "minimum": 1 } } },
    "source": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "pattern": "^research-lanes/[^\\n]+$" }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "schedule": { "type": "object", "additionalProperties": false, "required": ["constructionId", "certificateEntryId", "fieldSpecRef", "q", "degree", "polynomialCanonical"], "properties": { "constructionId": { "$ref": "#/$defs/id" }, "certificateEntryId": { "$ref": "#/$defs/id" }, "fieldSpecRef": { "$ref": "#/$defs/id" }, "q": { "type": "integer", "minimum": 2 }, "degree": { "type": "integer", "minimum": 1 }, "polynomialCanonical": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/unsignedDecimal" } } } },
    "certificateEntry": { "type": "object", "additionalProperties": false, "required": ["certificateEntryId", "constructionId", "fieldSpecRef", "q", "degree", "p", "polynomialCanonical", "certificateId", "certificateDigest", "replayPassed", "establishes", "certificate"], "properties": { "certificateEntryId": { "$ref": "#/$defs/id" }, "constructionId": { "$ref": "#/$defs/id" }, "fieldSpecRef": { "$ref": "#/$defs/id" }, "q": { "type": "integer", "minimum": 2 }, "degree": { "type": "integer", "minimum": 1 }, "p": { "$ref": "#/$defs/unsignedDecimal" }, "polynomialCanonical": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/unsignedDecimal" } }, "certificateId": { "$ref": "#/$defs/id" }, "certificateDigest": { "$ref": "#/$defs/sha256" }, "replayPassed": { "const": true }, "establishes": { "const": "base-prime-and-direct-polynomial-irreducibility-only-if-replay-passes" }, "certificate": { "$ref": "#/$defs/rabinCertificate" } } },
    "rabinCertificate": { "type": "object", "additionalProperties": false, "required": ["certificateId", "mersennePrimeCheck", "modulus", "coefficientEncoding", "polynomial", "degree", "hPowers", "primeDivisors", "witnesses", "finalResidue", "conclusion"], "properties": { "certificateId": { "$ref": "#/$defs/id" }, "mersennePrimeCheck": { "$ref": "#/$defs/primeCheck" }, "modulus": { "$ref": "#/$defs/unsignedDecimal" }, "coefficientEncoding": { "const": "unsigned-decimal-c0-to-cd" }, "polynomial": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/unsignedDecimal" } }, "degree": { "$ref": "#/$defs/unsignedDecimal" }, "hPowers": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/hPower" } }, "primeDivisors": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/unsignedDecimal" } }, "witnesses": { "type": "array", "items": { "$ref": "#/$defs/witness" } }, "finalResidue": { "$ref": "#/$defs/coefficients" }, "conclusion": { "const": "irreducible" } } },
    "primeCheck": { "type": "object", "additionalProperties": false, "required": ["mersenneExponent", "exponentPrime", "exponentPrimalityMethod", "modulus", "lucasLehmer", "classification"], "properties": { "mersenneExponent": { "$ref": "#/$defs/unsignedDecimal" }, "exponentPrime": { "const": true }, "exponentPrimalityMethod": { "const": "deterministic-trial-division" }, "modulus": { "$ref": "#/$defs/unsignedDecimal" }, "lucasLehmer": { "type": "object", "additionalProperties": false, "required": ["iterations", "residue", "passed"], "properties": { "iterations": { "$ref": "#/$defs/unsignedDecimal" }, "residue": { "$ref": "#/$defs/unsignedDecimal" }, "passed": { "const": true } } }, "classification": { "const": "prime" } } },
    "coefficients": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/unsignedDecimal" } },
    "hPower": { "type": "object", "additionalProperties": false, "required": ["index", "coefficients"], "properties": { "index": { "$ref": "#/$defs/unsignedDecimal" }, "coefficients": { "$ref": "#/$defs/coefficients" } } },
    "witness": { "type": "object", "additionalProperties": false, "required": ["primeDivisor", "hIndex", "g", "gcd", "bezoutU", "bezoutV"], "properties": { "primeDivisor": { "$ref": "#/$defs/unsignedDecimal" }, "hIndex": { "$ref": "#/$defs/unsignedDecimal" }, "g": { "$ref": "#/$defs/coefficients" }, "gcd": { "const": ["1"] }, "bezoutU": { "$ref": "#/$defs/coefficients" }, "bezoutV": { "$ref": "#/$defs/coefficients" } } }
  }
}
