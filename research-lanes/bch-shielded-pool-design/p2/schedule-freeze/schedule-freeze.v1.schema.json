{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/p2/schedule-freeze/schedule-freeze.v1.schema.json",
  "title": "P2 Gate-B premeasurement formula schedule envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "artifactId", "status", "evidenceClassification", "qualification", "fieldConstructions", "arms", "relationMapping", "fairness", "provenance", "contentDigest"],
  "properties": {
    "schema": { "const": "shieldkit-labs/p2/schedule-freeze/v1" },
    "artifactId": { "const": "schedule-freeze:gate-b-direct-arithmetic-formula-envelope-v1" },
    "status": { "const": "formula-envelope-only-unimplemented-premeasurement" },
    "evidenceClassification": { "const": "not-evidence" },
    "qualification": { "$ref": "#/$defs/qualification" },
    "fieldConstructions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/fieldConstruction" }
    },
    "arms": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": { "$ref": "#/$defs/arm" }
    },
    "relationMapping": { "$ref": "#/$defs/relationMapping" },
    "fairness": { "$ref": "#/$defs/fairness" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "contentDigest": { "$ref": "#/$defs/contentDigest" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*){1,8}$" },
    "unsignedDecimal": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "signedDecimal": { "type": "string", "pattern": "^(0|-?[1-9][0-9]*)$" },
    "hex": { "type": "string", "pattern": "^(?:[0-9a-f]{2})*$" },
    "contentDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256-jcs-omit-contentDigest" },
        "value": { "$ref": "#/$defs/sha256" }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentScope", "selection", "tupleRef", "fieldRanking", "proofSystemRanking", "protocolRanking", "protocolRoles", "circleDomain", "deepStrategy", "soundnessEventDag"],
      "properties": {
        "componentScope": { "const": "gate-b-formula-envelope-only" },
        "selection": { "const": "none" },
        "tupleRef": { "type": "null" },
        "fieldRanking": { "const": "none" },
        "proofSystemRanking": { "const": "none" },
        "protocolRanking": { "const": "none" },
        "protocolRoles": { "type": "array", "maxItems": 0, "items": false },
        "circleDomain": { "type": "null" },
        "deepStrategy": { "type": "null" },
        "soundnessEventDag": { "type": "null" }
      }
    },
    "codec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codecId", "basis", "coefficientOrder", "baseLimbEncoding", "baseLimbBytes", "elementBytes", "modulusBitLength", "unusedHighBits", "unusedHighBitMaskHex", "highBitPolicy", "coefficientRange", "fullConsumption", "zeroHex", "oneHex", "towerCoordinates"],
      "properties": {
        "codecId": { "$ref": "#/$defs/id" },
        "basis": { "const": "direct-power-basis" },
        "coefficientOrder": { "const": "c0-to-cd-minus-1" },
        "baseLimbEncoding": { "const": "fixed-width-unsigned-little-endian" },
        "baseLimbBytes": { "type": "integer", "minimum": 1 },
        "elementBytes": { "type": "integer", "minimum": 1 },
        "modulusBitLength": { "type": "integer", "minimum": 2 },
        "unusedHighBits": { "type": "integer", "minimum": 0, "maximum": 7 },
        "unusedHighBitMaskHex": { "type": "string", "pattern": "^[0-9a-f]{2}$" },
        "highBitPolicy": { "const": "reject-before-numeric-decode" },
        "coefficientRange": { "const": "reject-unless-0<=coefficient<p" },
        "fullConsumption": { "const": true },
        "zeroHex": { "$ref": "#/$defs/hex" },
        "oneHex": { "$ref": "#/$defs/hex" },
        "towerCoordinates": { "const": "internal-only-never-wire-or-codec" }
      }
    },
    "fieldConstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constructionId", "fieldSpecRef", "futureDescriptorRef", "p", "q", "degree", "definingPolynomialAscending", "quotientRelation", "codec", "descriptorResolution"],
      "properties": {
        "constructionId": { "$ref": "#/$defs/id" },
        "fieldSpecRef": { "$ref": "#/$defs/id" },
        "futureDescriptorRef": { "type": "null" },
        "p": { "$ref": "#/$defs/unsignedDecimal" },
        "q": { "type": "integer", "minimum": 2 },
        "degree": { "type": "integer", "minimum": 2 },
        "definingPolynomialAscending": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/unsignedDecimal" } },
        "quotientRelation": { "type": "string", "minLength": 1 },
        "codec": { "$ref": "#/$defs/codec" },
        "descriptorResolution": { "const": "future-exact-descriptor-and-certificate-required-before-execution" }
      }
    },
    "constant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value", "role"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "value": { "$ref": "#/$defs/signedDecimal" },
        "role": { "type": "string", "minLength": 1 }
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrixId", "rows", "columns", "entryEncoding", "entries", "orientation"],
      "properties": {
        "matrixId": { "$ref": "#/$defs/id" },
        "rows": { "type": "integer", "minimum": 1 },
        "columns": { "type": "integer", "minimum": 1 },
        "entryEncoding": { "const": "canonical-residue-decimal-mod-p" },
        "entries": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/unsignedDecimal" } } },
        "orientation": { "type": "string", "minLength": 1 }
      }
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapId", "direction", "formula", "codecBoundary"],
      "properties": {
        "mapId": { "$ref": "#/$defs/id" },
        "direction": { "type": "string", "minLength": 1 },
        "formula": { "type": "string", "minLength": 1 },
        "codecBoundary": { "const": "internal-only-direct-power-basis-wire-unchanged" }
      }
    },
    "formula": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formulaId", "family", "dagSteps", "constants", "matrices", "maps", "countDerivation", "reduction", "divisionPolicy", "dagIntegrity"],
      "properties": {
        "formulaId": { "$ref": "#/$defs/id" },
        "family": { "enum": ["canonical-schoolbook", "karatsuba-quadratic", "pairwise", "toom3", "toom5", "toom6", "tower2x3-six-product", "tower2x3-toom3", "tower3x2-karatsuba-toom3"] },
        "dagSteps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "constants": { "type": "array", "items": { "$ref": "#/$defs/constant" } },
        "matrices": { "type": "array", "items": { "$ref": "#/$defs/matrix" } },
        "maps": { "type": "array", "items": { "$ref": "#/$defs/map" } },
        "countDerivation": { "type": "object", "additionalProperties": false, "required": ["multiply", "square"], "properties": { "multiply": { "$ref": "#/$defs/countExpression" }, "square": { "$ref": "#/$defs/countExpression" } } },
        "reduction": { "type": "object", "additionalProperties": false, "required": ["stage", "formula"], "properties": { "stage": { "const": "after-extension-product-before-relation-add-or-equality" }, "formula": { "type": "string", "minLength": 1 } } },
        "divisionPolicy": { "const": "fixed-canonical-inverse-scalar-multiplication-only;OP_DIV-forbidden" },
        "dagIntegrity": { "const": "every-declared-node-reaches-an-output;no-optional-cse-or-dead-node" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["multiply", "square", "interpretation"],
      "properties": {
        "multiply": { "type": "integer", "minimum": 1 },
        "square": { "type": "integer", "minimum": 1 },
        "interpretation": { "const": "variable-variable-base-Fp-multiplications-only-not-opcode-byte-stack-cost-or-rank-lower-bound" }
      }
    },
    "countExpression": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["op", "value"], "properties": { "op": { "const": "constant" }, "value": { "type": "integer", "minimum": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["op"], "properties": { "op": { "const": "degree" } } },
        { "type": "object", "additionalProperties": false, "required": ["op"], "properties": { "op": { "const": "pair-count" } } },
        { "type": "object", "additionalProperties": false, "required": ["op", "args"], "properties": { "op": { "enum": ["add", "multiply"] }, "args": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/countExpression" } } } }
      ]
    },
    "relationMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eMac", "eSquareMac", "eInverseCheck", "malformed"],
      "properties": {
        "eMac": { "const": "relation:e-mac=mul-once-then-add-C-and-compare-D" },
        "eSquareMac": { "const": "relation:e-square-mac=square-once-then-add-C-and-compare-D" },
        "eInverseCheck": { "const": "relation:e-inverse-check=reject-zero-A-then-verify-mul-A-H-equals-one-only-no-inverse-calculation" },
        "malformed": { "const": "all-malformed-cases-reject-at-parser-before-selected-arm" }
      }
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["armId", "constructionId", "fieldSpecRef", "codecId", "trackId", "algorithmId", "formula", "declaredVariableBaseCounts", "relationMapping", "parserBeforeArithmetic", "executionStatus", "proofObligations"],
      "properties": {
        "armId": { "$ref": "#/$defs/id" },
        "constructionId": { "$ref": "#/$defs/id" },
        "fieldSpecRef": { "$ref": "#/$defs/id" },
        "codecId": { "$ref": "#/$defs/id" },
        "trackId": { "enum": ["track:canonical-schoolbook", "track:optimized"] },
        "algorithmId": { "$ref": "#/$defs/id" },
        "formula": { "$ref": "#/$defs/formula" },
        "declaredVariableBaseCounts": { "$ref": "#/$defs/counts" },
        "relationMapping": { "$ref": "#/$defs/relationMapping" },
        "parserBeforeArithmetic": { "const": true },
        "executionStatus": { "const": "closed-unimplemented-premeasurement" },
        "proofObligations": { "type": "array", "minItems": 4, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "fairness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["armCount", "futureEpochBindings", "terminalAccounting", "silentDropPolicy", "failureScope", "optimizedConclusionGate", "crossEnginePolicy", "crossArmPolicy", "rerunPolicy", "phaseOrder"],
      "properties": {
        "armCount": { "const": 14 },
        "futureEpochBindings": { "type": "array", "minItems": 6, "items": { "type": "string", "minLength": 1 } },
        "terminalAccounting": { "const": "every-precommitted-arm-must-have-explicit-terminal-accounting" },
        "silentDropPolicy": { "const": "forbidden" },
        "failureScope": { "const": "failure-eliminates-only-exact-constructionId-codecId-algorithmId-trackId;never-whole-p-d-family-without-representation-independent-bound-or-precommitted-envelope-exhaustion" },
        "optimizedConclusionGate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "requiredArmSet", "onIncompleteOrFailure", "silentDrop", "terminalFailureScope", "wholeFamilyResult"],
          "properties": {
            "scope": { "const": "per-construction-per-epoch" },
            "requiredArmSet": { "const": "all-precommitted-optimized-arms-for-that-construction" },
            "onIncompleteOrFailure": { "const": "block-all-optimized-conclusions-for-that-construction-in-that-epoch" },
            "silentDrop": { "const": "forbidden" },
            "terminalFailureScope": { "const": "exact-constructionId-codecId-algorithmId-trackId-only" },
            "wholeFamilyResult": { "const": "forbidden-without-representation-independent-bound-or-precommitted-envelope-exhaustion" }
          }
        },
        "crossEnginePolicy": { "const": "agreement-only-within-arm-case-metric" },
        "crossArmPolicy": { "const": "only-after-complete-shared-epoch" },
        "rerunPolicy": { "const": "preserve-all-reruns-never-replace" },
        "phaseOrder": {
          "type": "object",
          "additionalProperties": false,
          "required": ["canonicalPhase", "canonicalArmOrder", "optimizedKey", "optimizedSort", "resolution"],
          "properties": {
            "canonicalPhase": { "const": "first" },
            "canonicalArmOrder": { "const": "fieldConstructions-array-order;exactly-one-canonical-arm-per-construction" },
            "optimizedKey": {
              "type": "object",
              "additionalProperties": false,
              "required": ["algorithm", "descriptorDigestEncoding", "descriptorDigestBinding", "delimiterHex", "armIdEncoding", "frame"],
              "properties": {
                "algorithm": { "const": "sha256" },
                "descriptorDigestEncoding": { "const": "lowercase-64-char-hex-ascii" },
                "descriptorDigestBinding": { "const": "exact-future-descriptor-content-digest-for-arm-construction" },
                "delimiterHex": { "const": "00" },
                "armIdEncoding": { "const": "utf-8" },
                "frame": { "const": "descriptor-content-digest-lowercase-hex-ascii-bytes||raw-0x00-byte||utf8-armId" }
              }
            },
            "optimizedSort": {
              "type": "object",
              "additionalProperties": false,
              "required": ["primary", "tieBreak"],
              "properties": {
                "primary": { "const": "unsigned-lexicographic-32-byte-sha256-key-ascending" },
                "tieBreak": { "const": "utf8-armId-byte-lexicographic-ascending" }
              }
            },
            "resolution": { "const": "descriptor-digests-unresolved-until-future-exact-descriptors" }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["r18Source", "adaptationStatus", "legacyFilesModified"],
      "properties": {
        "r18Source": { "type": "object", "additionalProperties": false, "required": ["repository", "gitCommit", "file", "sha256", "lines", "role"], "properties": { "repository": { "type": "string", "minLength": 1 }, "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "file": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" }, "lines": { "const": "39-69" }, "role": { "const": "rationale-only-for-arm:optimized:m31-d6-tower2x3-six-product-r18" } } },
        "adaptationStatus": { "const": "source-adaptation-unimplemented-not-evidence-not-selection" },
        "legacyFilesModified": { "const": false }
      }
    }
  }
}
