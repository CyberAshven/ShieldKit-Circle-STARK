{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shieldkit-labs/p2/source-set/plan-source-map/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaBinding", "planId", "planOrder", "source", "bytecode", "instructions", "sourceCoverage", "bytecodeCoverage", "stackLedger", "nonClaims", "contentDigest"],
  "properties": {
    "schema": {"const": "shieldkit-labs/p2/source-set/plan-source-map/v1"},
    "schemaBinding": {"$ref": "#/$defs/schemaPin"},
    "planId": {"type": "string", "minLength": 1},
    "planOrder": {"type": "integer", "minimum": 0, "maximum": 41},
    "source": {"$ref": "#/$defs/source"},
    "bytecode": {"$ref": "#/$defs/bytecode"},
    "instructions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/instruction"}},
    "sourceCoverage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceCoverage"}},
    "bytecodeCoverage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bytecodeCoverage"}},
    "stackLedger": {"$ref": "#/$defs/stackLedger"},
    "nonClaims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "contentDigest": {"$ref": "#/$defs/contentDigest"}
  },
  "$defs": {
    "evenHex": {"type": "string", "pattern": "^(?:[0-9a-f]{2})*$"},
    "nonemptyEvenHex": {"type": "string", "pattern": "^(?:[0-9a-f]{2})+$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schemaPin": {"type": "object", "additionalProperties": false, "required": ["id", "path", "byteCount", "rawSha256"], "properties": {"id": {"const": "shieldkit-labs/p2/source-set/plan-source-map/v1"}, "path": {"const": "research-lanes/bch-shielded-pool-design/p2/source-set-v1/plan-source-map.v1.schema.json"}, "byteCount": {"type": "integer", "minimum": 1}, "rawSha256": {"$ref": "#/$defs/hash"}}},
    "contentDigest": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "domain", "frame", "value"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "canonicalization": {"const": "recursive-lexicographic-object-key-sort-arrays-preserve-order-json-utf8-lf-v1"},
        "domain": {"type": "string", "minLength": 1},
        "frame": {"const": "utf8(domain)||0x00||canonical-json-utf8"},
        "value": {"$ref": "#/$defs/hash"}
      }
    },
    "span": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}}
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["encoding", "byteLength", "sha256"],
      "properties": {"encoding": {"const": "utf8-lf-one-physical-instruction-per-line"}, "byteLength": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/hash"}}
    },
    "bytecode": {
      "type": "object", "additionalProperties": false,
      "required": ["encoding", "byteLength", "sha256", "hex"],
      "properties": {"encoding": {"const": "raw-script-bytes-and-lowercase-hex"}, "byteLength": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/hash"}, "hex": {"$ref": "#/$defs/nonemptyEvenHex"}}
    },
    "sourceFragment": {"type": "object", "additionalProperties": false, "required": ["encoding", "byteLength", "sha256"], "properties": {"encoding": {"const": "utf8-lf-including-final-line-feed"}, "byteLength": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/hash"}}},
    "bytecodeFragment": {"type": "object", "additionalProperties": false, "required": ["encoding", "byteLength", "sha256"], "properties": {"encoding": {"const": "raw-bytecode-fragment"}, "byteLength": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/hash"}}},
    "tokenSpan": {
      "type": "object", "additionalProperties": false,
      "required": ["tokenIndex", "text", "kind", "start", "end"],
      "properties": {
        "tokenIndex": {"type": "integer", "minimum": 0}, "text": {"type": "string", "minLength": 1},
        "kind": {"enum": ["opcode", "push-opcode", "literal"]}, "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1},
        "literalSemanticId": {"type": "string", "minLength": 1}
      }
    },
    "smallScriptNumLiteral": {
      "type": "object", "additionalProperties": false,
      "required": ["semanticId", "kind", "canonical", "scriptNumHex", "encoding", "tokenCount"],
      "properties": {
        "semanticId": {"type": "string", "minLength": 1}, "kind": {"const": "minimal-scriptnum"},
        "canonical": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)$"}, "scriptNumHex": {"$ref": "#/$defs/evenHex"},
        "encoding": {"enum": ["opcode-OP_0", "opcode-OP_1NEGATE", "opcode-OP_1", "opcode-OP_2", "opcode-OP_3", "opcode-OP_4", "opcode-OP_5", "opcode-OP_6", "opcode-OP_7", "opcode-OP_8", "opcode-OP_9", "opcode-OP_10", "opcode-OP_11", "opcode-OP_12", "opcode-OP_13", "opcode-OP_14", "opcode-OP_15", "opcode-OP_16"]},
        "tokenCount": {"const": 1}
      }
    },
    "pushedScriptNumLiteral": {
      "type": "object", "additionalProperties": false,
      "required": ["semanticId", "kind", "canonical", "scriptNumHex", "encoding", "pushOpcode", "tokenCount"],
      "properties": {
        "semanticId": {"type": "string", "minLength": 1}, "kind": {"const": "minimal-scriptnum"},
        "canonical": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)$"}, "scriptNumHex": {"$ref": "#/$defs/nonemptyEvenHex"},
        "encoding": {"const": "explicit-push"}, "pushOpcode": {"type": "string", "pattern": "^OP_PUSHBYTES_(?:[1-9]|[1-6][0-9]|7[0-5])$"}, "tokenCount": {"const": 2}
      }
    },
    "rawLiteral": {
      "type": "object", "additionalProperties": false,
      "required": ["semanticId", "kind", "hex", "encoding", "pushOpcode", "tokenCount"],
      "properties": {
        "semanticId": {"type": "string", "minLength": 1}, "kind": {"const": "raw-bytes"}, "hex": {"$ref": "#/$defs/nonemptyEvenHex"},
        "encoding": {"const": "explicit-push"}, "pushOpcode": {"type": "string", "pattern": "^OP_PUSHBYTES_(?:[1-9]|[1-6][0-9]|7[0-5])$"}, "tokenCount": {"const": 2}
      }
    },
    "literal": {"oneOf": [{"$ref": "#/$defs/smallScriptNumLiteral"}, {"$ref": "#/$defs/pushedScriptNumLiteral"}, {"$ref": "#/$defs/rawLiteral"}]},
    "substep": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "tokenIndices", "primaryDelta", "altDelta", "transient", "primaryDepth", "altDepth"],
      "properties": {
        "label": {"type": "string", "minLength": 1}, "tokenIndices": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "integer", "minimum": 0}},
        "primaryDelta": {"type": "integer"}, "altDelta": {"type": "integer"}, "transient": {"type": "boolean"},
        "primaryDepth": {"type": "integer", "minimum": 0}, "altDepth": {"type": "integer", "minimum": 0}
      }
    },
    "parserInvocation": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["planId", "invocationId"], "properties": {"planId": {"type": "string", "minLength": 1}, "invocationId": {"type": "string", "minLength": 1}}}
      ]
    },
    "typedTransientItem": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "value", "provenance"],
      "properties": {"type": {"type": "string", "minLength": 1}, "value": {"type": "string"}, "provenance": {"type": "string", "minLength": 1}, "scriptNumHex": {"$ref": "#/$defs/evenHex"}}
    },
    "typedContract": {
      "type": "object", "additionalProperties": false,
      "required": ["consumes", "produces", "transientStackContract"],
      "properties": {
        "consumes": {"type": "array", "items": {"type": "string", "minLength": 1}}, "produces": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "transientStackContract": {
          "type": "object", "additionalProperties": false,
          "required": ["exactAtPrimitiveBoundary", "primaryAdditionalPeak", "altAdditionalPeak", "typedTransientItems", "description"],
          "properties": {
            "exactAtPrimitiveBoundary": {"const": true}, "primaryAdditionalPeak": {"type": "integer", "minimum": 0}, "altAdditionalPeak": {"const": 0},
            "typedTransientItems": {"type": "array", "items": {"$ref": "#/$defs/typedTransientItem"}}, "description": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "instruction": {
      "type": "object", "additionalProperties": false,
      "required": ["instructionOrder", "instructionId", "primitive", "planId", "planOrder", "parserInvocation", "macroVersion", "irTypedContract", "source", "sourceFragment", "bytecodeSpan", "bytecodeFragment", "literalSemantics", "substeps", "stackMicrotrace"],
      "properties": {
        "instructionOrder": {"type": "integer", "minimum": 0}, "instructionId": {"type": "string", "minLength": 1}, "primitive": {"type": "string", "minLength": 1}, "planId": {"type": "string", "minLength": 1}, "planOrder": {"type": "integer", "minimum": 0, "maximum": 41},
        "parserInvocation": {"$ref": "#/$defs/parserInvocation"}, "macroVersion": {"const": "bch-asm-physical-plan-recipe-v1"}, "irTypedContract": {"$ref": "#/$defs/typedContract"},
        "source": {"type": "object", "additionalProperties": false, "required": ["line", "span", "tokenSpans"], "properties": {"line": {"type": "integer", "minimum": 1}, "span": {"$ref": "#/$defs/span"}, "tokenSpans": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tokenSpan"}}}}, "sourceFragment": {"$ref": "#/$defs/sourceFragment"},
        "bytecodeSpan": {"$ref": "#/$defs/span"}, "bytecodeFragment": {"$ref": "#/$defs/bytecodeFragment"}, "literalSemantics": {"type": "array", "items": {"$ref": "#/$defs/literal"}}, "substeps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/substep"}},
        "stackMicrotrace": {"type": "object", "additionalProperties": false, "required": ["entryPrimaryDepth", "entryAltDepth", "exitPrimaryDepth", "exitAltDepth", "observedTransientAdditionalPeak", "declaredTransientAdditionalPeak", "sourceOnly"], "properties": {"entryPrimaryDepth": {"type": "integer", "minimum": 0}, "entryAltDepth": {"type": "integer", "minimum": 0}, "exitPrimaryDepth": {"type": "integer", "minimum": 0}, "exitAltDepth": {"type": "integer", "minimum": 0}, "observedTransientAdditionalPeak": {"type": "integer", "minimum": 0}, "declaredTransientAdditionalPeak": {"type": "integer", "minimum": 0}, "sourceOnly": {"const": true}}}
      }
    },
    "sourceCoverage": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["start", "end", "kind", "instructionOrder", "tokenIndex"], "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}, "kind": {"const": "token"}, "instructionOrder": {"type": "integer", "minimum": 0}, "tokenIndex": {"type": "integer", "minimum": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["start", "end", "kind", "instructionOrder"], "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}, "kind": {"const": "separator"}, "instructionOrder": {"type": "integer", "minimum": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["start", "end", "kind", "instructionOrder"], "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}, "kind": {"const": "line-ending"}, "instructionOrder": {"type": "integer", "minimum": 0}}}
      ]
    },
    "bytecodeCoverage": {"type": "object", "additionalProperties": false, "required": ["start", "end", "instructionOrder"], "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}, "instructionOrder": {"type": "integer", "minimum": 0}}},
    "terminalProvenance": {
      "type": "object", "additionalProperties": false,
      "required": ["derivedBy", "primitive", "leftSlotId", "rightSlotId", "operandValueIds"],
      "properties": {"derivedBy": {"type": "string", "minLength": 1}, "primitive": {"type": "string", "minLength": 1}, "leftSlotId": {"type": "string", "minLength": 1}, "rightSlotId": {"type": "string", "minLength": 1}, "operandValueIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
    },
    "stackItem": {"type": "object", "additionalProperties": false, "required": ["slotId", "valueId", "type", "value", "provenance"], "properties": {"slotId": {"type": "string", "minLength": 1}, "valueId": {"type": "string", "minLength": 1}, "type": {"type": "string", "minLength": 1}, "value": {"type": "string"}, "provenance": {"$ref": "#/$defs/terminalProvenance"}}},
    "terminal": {"type": "object", "additionalProperties": false, "required": ["primary", "alt"], "properties": {"primary": {"type": "array", "items": {"$ref": "#/$defs/stackItem"}}, "alt": {"type": "array", "items": {"$ref": "#/$defs/stackItem"}}}},
    "stackLedger": {"type": "object", "additionalProperties": false, "required": ["kind", "sourceMaxPrimary", "sourceMaxAlt", "sourceMaxCombined", "refreshedIrSymbolicMax", "terminalTypedBoundary", "equalToRefreshedIrSymbolicMax"], "properties": {"kind": {"const": "symbolic-source-macro-only-not-bch-vm-execution"}, "sourceMaxPrimary": {"type": "integer", "minimum": 0}, "sourceMaxAlt": {"type": "integer", "minimum": 0}, "sourceMaxCombined": {"type": "integer", "minimum": 0}, "refreshedIrSymbolicMax": {"type": "integer", "minimum": 0}, "terminalTypedBoundary": {"$ref": "#/$defs/terminal"}, "equalToRefreshedIrSymbolicMax": {"const": true}}}
  }
}
