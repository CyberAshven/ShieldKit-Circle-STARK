{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shieldkit-labs.local/research-lanes/bch-shielded-pool-design/vectors/pool-action-fv1/index.schema.json",
  "title": "PoolActionFv1 adversarial vector index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "indexId",
    "status",
    "relationRef",
    "profileRef",
    "sourceCommits",
    "toolchain",
    "artifactDigests",
    "requiredCategories",
    "cases"
  ],
  "properties": {
    "schema": { "const": "shieldkit-labs/vectors/pool-action-fv1/index/v1" },
    "indexId": { "$ref": "#/$defs/id" },
    "status": { "$ref": "#/$defs/status" },
    "relationRef": { "$ref": "#/$defs/ref" },
    "profileRef": { "$ref": "#/$defs/ref" },
    "sourceCommits": { "$ref": "#/$defs/sourceCommits" },
    "toolchain": { "$ref": "#/$defs/toolchain" },
    "artifactDigests": { "$ref": "#/$defs/artifactDigests" },
    "requiredCategories": {
      "const": ["semantic", "transaction", "topology", "parser", "proof", "zk", "recovery", "liveness"]
    },
    "cases": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/case" },
      "uniqueItems": true
    },
    "notes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  },
  "allOf": [
    { "properties": { "cases": { "type": "array", "contains": { "type": "object", "required": ["category"], "properties": { "category": { "const": "semantic" } } } } } },
    { "properties": { "cases": { "type": "array", "contains": { "type": "object", "required": ["category"], "properties": { "category": { "const": "transaction" } } } } } },
    { "properties": { "cases": { "type": "array", "contains": { "type": "object", "required": ["category"], "properties": { "category": { "const": "topology" } } } } } },
    { "properties": { "cases": { "type": "array", "contains": { "type": "object", "required": ["category"], "properties": { "category": { "const": "parser" } } } } } },
    { "properties": { "cases": { "type": "array", "contains": { "type": "object", "required": ["category"], "properties": { "category": { "const": "proof" } } } } } },
    { "properties": { "cases": { "type": "array", "contains": { "type": "object", "required": ["category"], "properties": { "category": { "const": "zk" } } } } } },
    { "properties": { "cases": { "type": "array", "contains": { "type": "object", "required": ["category"], "properties": { "category": { "const": "recovery" } } } } } },
    { "properties": { "cases": { "type": "array", "contains": { "type": "object", "required": ["category"], "properties": { "category": { "const": "liveness" } } } } } }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*){1,6}$" },
    "ref": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*){1,8}$" },
    "hex": { "type": "string", "pattern": "^(?:[0-9a-f]{2})*$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "status": { "enum": ["planned", "partial", "complete", "unmeasured", "blocked", "killed", "failed"] },
    "sourceCommits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "commit", "dirty", "paths"],
        "properties": {
          "repository": { "type": "string", "minLength": 1 },
          "commit": { "$ref": "#/$defs/commit" },
          "dirty": { "type": "boolean" },
          "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "compiler", "lockfileDigest"],
      "properties": {
        "runtime": { "type": "string", "minLength": 1 },
        "compiler": { "type": "string", "minLength": 1 },
        "lockfileDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifactDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "corpus"],
      "properties": {
        "relation": { "$ref": "#/$defs/sha256" },
        "corpus": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "transaction": { "$ref": "#/$defs/sha256" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "category",
        "status",
        "vectorAvailability",
        "actionKind",
        "mutationFamily",
        "expectedOutcome",
        "firstAttempt",
        "retries"
      ],
      "properties": {
        "caseId": { "$ref": "#/$defs/id" },
        "category": { "enum": ["semantic", "transaction", "topology", "parser", "proof", "zk", "recovery", "liveness"] },
        "status": { "$ref": "#/$defs/status" },
        "vectorAvailability": { "enum": ["planned", "present", "absent", "blocked", "killed"] },
        "actionKind": { "enum": ["deposit", "withdrawal", "both", "not-applicable"] },
        "mutationFamily": { "type": "string", "minLength": 1 },
        "expectedOutcome": { "enum": ["accept", "reject", "unmeasured"] },
        "expectedErrorClass": { "type": ["string", "null"] },
        "firstAttempt": { "type": "boolean" },
        "retries": { "type": "integer", "minimum": 0 },
        "provenance": { "$ref": "#/$defs/provenance" },
        "artifactDigests": { "$ref": "#/$defs/caseDigests" },
        "txHex": { "anyOf": [{ "$ref": "#/$defs/hex" }, { "type": "null" }] },
        "sourceOutputsHex": { "anyOf": [{ "$ref": "#/$defs/hex" }, { "type": "null" }] },
        "txDigest": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "sourceOutputsDigest": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "transaction": { "anyOf": [{ "$ref": "#/$defs/transaction" }, { "type": "null" }] },
        "observed": { "type": ["string", "null"] },
        "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "uniqueItems": true }
      },
      "allOf": [
        {
          "if": { "properties": { "vectorAvailability": { "const": "present" } } },
          "then": {
            "required": ["provenance", "artifactDigests", "txHex", "sourceOutputsHex", "txDigest", "sourceOutputsDigest", "transaction", "observed", "evidenceRefs"],
            "properties": {
              "status": { "enum": ["measured", "complete", "failed"] },
              "provenance": { "$ref": "#/$defs/presentProvenance" },
              "txHex": { "type": "string", "pattern": "^(?:[0-9a-f]{2})+$" },
              "sourceOutputsHex": { "type": "string", "pattern": "^(?:[0-9a-f]{2})+$" },
              "txDigest": { "$ref": "#/$defs/sha256" },
              "sourceOutputsDigest": { "$ref": "#/$defs/sha256" },
              "transaction": {
                "allOf": [
                  { "$ref": "#/$defs/transaction" },
                  {
                    "type": "object",
                    "properties": {
                      "standardChecked": { "const": true }
                    }
                  }
                ]
              },
              "observed": { "type": "string", "minLength": 1 },
              "evidenceRefs": { "type": "array", "minItems": 1 },
              "artifactDigests": {
                "type": "object",
                "required": ["case", "mutation", "expected"],
                "properties": {
                  "case": { "$ref": "#/$defs/sha256" },
                  "mutation": { "$ref": "#/$defs/sha256" },
                  "expected": { "$ref": "#/$defs/sha256" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "vectorAvailability": { "enum": ["planned", "absent", "blocked", "killed"] } } },
          "then": {
            "properties": {
              "txHex": { "type": "null" },
              "sourceOutputsHex": { "type": "null" },
              "txDigest": { "type": "null" },
              "sourceOutputsDigest": { "type": "null" },
              "transaction": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "vectorAvailability": { "const": "present" } } },
          "then": { "properties": { "firstAttempt": { "const": true }, "retries": { "const": 0 } } }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceKind", "sourcePath", "sourceDigest"],
      "properties": {
        "sourceKind": { "enum": ["planned", "measured", "compiled", "derived", "fixture", "unmeasured"] },
        "sourcePath": { "type": "string", "minLength": 1 },
        "sourceDigest": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "command": { "type": ["string", "null"] }
      }
    },
    "presentProvenance": {
      "allOf": [
        { "$ref": "#/$defs/provenance" },
        {
          "type": "object",
          "properties": {
            "sourceKind": { "enum": ["measured", "compiled", "fixture"] },
            "sourceDigest": { "$ref": "#/$defs/sha256" },
            "command": { "type": "string", "minLength": 1 }
          },
          "required": ["command"]
        }
      ]
    },
    "caseDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case", "mutation", "expected"],
      "properties": {
        "case": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "mutation": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "expected": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "proof": { "$ref": "#/$defs/sha256" },
        "zk": { "$ref": "#/$defs/sha256" }
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completeTxBytes", "inputCount", "outputCount", "underStandardLimit", "standardChecked"],
      "properties": {
        "completeTxBytes": { "type": "integer", "minimum": 1 },
        "inputCount": { "type": "integer", "minimum": 1 },
        "outputCount": { "type": "integer", "minimum": 1 },
        "underStandardLimit": { "type": "boolean" },
        "standardChecked": { "type": "boolean" }
      }
    }
  }
}
